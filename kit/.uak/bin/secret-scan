#!/usr/bin/env bash
# Minimal built-in patterns; Bash 3.2+, Git and POSIX tools. Never prints values.
set -u
set -o pipefail
# Git Bash rewrites "rev:.path" arguments for native git unless told not to (the same list as uak).
MSYS2_ARG_CONV_EXCL="refs/;origin/;${UAK_REMOTE:-origin}/;HEAD;FETCH_HEAD;:"; export MSYS2_ARG_CONV_EXCL
LC_ALL=C; export LC_ALL
mode=tracked decisions= scan_root= temp= failures=0 count=0
usage() { printf '%s\n' 'Usage: secret-scan [--tracked|--staged|--directory DIR] [--decisions FILE]'; }
while [ "$#" -gt 0 ]; do
  case "$1" in
    --tracked) mode=tracked; shift;;
    --staged) mode=staged; shift;;
    --directory) [ "$#" -gt 1 ] || { usage >&2; exit 2; }; mode=directory; scan_root=$2; shift $(($# > 1 ? 2 : 1));;
    --decisions) [ "$#" -gt 1 ] || { usage >&2; exit 2; }; decisions=$2; shift $(($# > 1 ? 2 : 1));;
    *) usage >&2; exit 2;;
  esac
done
if [ "$mode" = directory ]; then
  ROOT=$(cd "$scan_root" 2>/dev/null && pwd -P) || exit 2
else
  ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || { printf '%s\n' 'SECRET_SCAN_UNVERIFIED: no Git repository.' >&2; exit 2; }
fi
cd "$ROOT" || exit 2
temp=$(mktemp -d "${TMPDIR:-/tmp}/hack-secrets.XXXXXX") || exit 2
cleanup() { [ -n "$temp" ] && rm -rf "$temp"; }
trap cleanup EXIT
trap 'exit 130' INT TERM
mkdir "$temp/blobs" || exit 2
if [ "$mode" = staged ]; then
  git diff --cached --name-only -z --diff-filter=ACMR > "$temp/paths" || exit 2
elif [ "$mode" = tracked ]; then
  git ls-files -z > "$temp/paths" || exit 2
else
  find . -name .git -prune -o -type f -print0 > "$temp/paths" || exit 2
fi
loaded=no
load_decisions() {
  [ "$loaded" = no ] || return 0
  loaded=yes
  if [ -n "$decisions" ]; then
    [ -f "$decisions" ] && cp "$decisions" "$temp/decisions"
    return 0
  fi
  # Reads the remote only when a finding needs an exception. Never changes local refs.
  remote=${UAK_REMOTE:-origin}
  url=$(git config --get "remote.$remote.url" 2>/dev/null) || return 0
  case "$url" in /*|[A-Za-z]:*|*://*|*@*:*) ;; *) url="$ROOT/$url";; esac
  mkdir "$temp/state" || return 0
  git -C "$temp/state" init -q > "$temp/remote-log" 2>&1 || return 0
  git -C "$temp/state" fetch -q "$url" refs/heads/claims >> "$temp/remote-log" 2>&1 || return 0
  git -C "$temp/state" show FETCH_HEAD:DECISIONS.md > "$temp/decisions" 2>/dev/null || true
}
allowed() {
  load_decisions
  [ -s "$temp/decisions" ] || return 1
  UAK_SECRET_PATH="$path" UAK_SECRET_RULE="$rule" UAK_SECRET_BLOB="$blob" awk '
    /^Secret-Exception: / {
      s=substr($0,19); n=split(s,a,"|");
      if(n==7 && a[1] ~ /^[A-Z][A-Z0-9]*-[0-9][0-9][0-9]+$/ && a[2]==ENVIRON["UAK_SECRET_PATH"] &&
         a[3]==ENVIRON["UAK_SECRET_RULE"] && a[4]==ENVIRON["UAK_SECRET_BLOB"] &&
         a[5] ~ /^[A-Za-z0-9_.-]+$/ && a[6]=="approved" && a[7] ~ /^[0-9]+$/) {ok=1}
    } END {exit !ok}' "$temp/decisions"
}
# One pass per rule over every file, not ~20 processes per file. Why (v5.11, Windows CI): a process costs 20-50 ms on
# Git Bash, the merge gate scans twice, and every tracked file added about 17 s to each merge; a project with 2,000
# files paid tens of thousands of processes per merge. Tracked and staged files are read from the index (git grep
# --cached: the staged blob, as `git show :path` was), a directory from disk. The output is the same, path by path.
# grep -E, not awk: mawk (Debian/Ubuntu default awk) ignores {n} intervals and would let everything pass.
TAB=$'\t' NL=$'\n'
RULES='SEC_PRIVATE_KEY|-E|-----BEGIN ([A-Z0-9 ]+ )?PRIVATE KEY-----
SEC_CLOUD_ACCESS|-E|(AKIA|ASIA)[A-Z0-9]{16}|AIza[A-Za-z0-9_-]{35}
SEC_GITHUB|-E|gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{40,}
SEC_ANTHROPIC|-E|sk-ant-[A-Za-z0-9_-]{20,}
SEC_OPENAI|-E|sk-proj-[A-Za-z0-9_-]{20,}|sk-svcacct-[A-Za-z0-9_-]{20,}|sk-[A-Za-z0-9]{20,}
SEC_CLOUD_SECRET|-iE|(aws_secret_access_key|aws_session_token|accountkey)[[:space:]"'"'"'=:]+[a-z0-9+/=]{40,}'
# The index entries (mode, blob) of the listed paths: a submodule has no content to scan (an error, as before), and
# the blob is what a secret exception names.
if [ "$mode" != directory ]; then
  git ls-files -s -z > "$temp/index" || exit 2
fi
: > "$temp/found"
# Every listed path: counted, and an .env by its name.
while IFS= read -r -d '' path; do
  path=${path#./}; count=$((count + 1))
  name=${path##*/}
  case "$name" in
    .env|.env.*) case "$name" in .env.example|.env.sample|.env.template|.env.dist) ;; *) printf '%q\tSEC_ENV|1\n' "$path" >> "$temp/found";; esac;;
  esac
  if [ "$mode" = directory ] && [ ! -r "$path" ]; then failures=$((failures + 1)); fi
done < "$temp/paths"
if [ "$mode" != directory ]; then
  # Submodules (mode 160000): `git show :path` could not read them, and that stays an error.
  while IFS= read -r -d '' entry; do
    case "$entry" in 160000\ *) e_path=${entry#*"$TAB"}
      if [ "$mode" = tracked ] || tr '\0' '\n' < "$temp/paths" | grep -qxF -- "$e_path"; then
        printf 'SECRET_SCAN_ERROR: %q index not available\n' "$e_path" >&2; failures=$((failures + 1))
      fi;;
    esac
  done < "$temp/index"
fi
# Each rule once: "path NUL line NUL match". --text: a binary file still gets line numbers.
while IFS='|' read -r rule flags pattern; do
  [ -n "$rule" ] || continue
  if [ "$mode" = directory ]; then
    xargs -0 grep -H -n -o --null -a "$flags" -e "$pattern" -- < "$temp/paths" 2>/dev/null
  elif [ "$mode" = tracked ]; then
    git -c color.grep=never -c grep.lineNumber=false -c grep.fullName=false grep --cached --full-name --text -z -n -o "$flags" -e "$pattern" 2>/dev/null
  else
    [ ! -s "$temp/paths" ] ||
      xargs -0 git --literal-pathspecs -c color.grep=never grep --cached --full-name --text -z -n -o "$flags" -e "$pattern" -- < "$temp/paths" 2>/dev/null
  fi > "$temp/hits"
  # grep --null puts NUL after the name only ("path NUL line:match"); git grep -z after the line too.
  while IFS= read -r -d '' path; do
    if [ "$mode" = directory ]; then IFS= read -r rest || break; line=${rest%%:*}
    else IFS= read -r -d '' line || break; IFS= read -r rest; fi
    printf '%q\t%s|%s\n' "${path#./}" "$rule" "$line" >> "$temp/found"
  done < "$temp/hits"
done <<EOF_RULES
$RULES
EOF_RULES
# Path by path in the listed order (as before), each path's findings sorted as before (sort -u of RULE|line). Paths are
# kept as %q (one line each, even with a newline in the name); the few with findings are matched in the list.
sort -u "$temp/found" > "$temp/unique"
hit_paths=$(cut -f 1 "$temp/unique" | uniq)
: > "$temp/ordered"
if [ -n "$hit_paths" ]; then
  while IFS= read -r -d '' path; do
    printf -v q '%q' "${path#./}"
    case "$NL$hit_paths$NL" in *"$NL$q$NL"*)
      while IFS="$TAB" read -r qpath finding; do [ "$qpath" != "$q" ] || printf '%s\t%s\n' "$qpath" "$finding"; done < "$temp/unique" >> "$temp/ordered"
      hit_paths=$(printf '%s\n' "$hit_paths" | grep -vxF -- "$q");;
    esac
  done < "$temp/paths"
fi
while IFS="$TAB" read -r qpath finding; do
  [ -n "$finding" ] || continue
  eval "path=$qpath"   # %q round trip: the exact name, even with spaces or newlines
  rule=${finding%%|*}; line=${finding#*|}
  if [ "$mode" = directory ]; then
    blob=$(git hash-object -- "$path" 2>/dev/null) || { failures=$((failures + 1)); continue; }
  else
    blob=
    while IFS= read -r -d '' entry; do
      [ "${entry#*"$TAB"}" != "$path" ] || { blob=${entry#* }; blob=${blob%% *}; break; }
    done < "$temp/index"
  fi
  if allowed; then
    printf 'SECRET_EXCEPTION: %q:%s %s blob=%s\n' "$path" "$line" "$rule" "$blob"
  else
    printf 'SECRET_FOUND: %q:%s %s\n' "$path" "$line" "$rule" >&2
    failures=$((failures + 1))
  fi
done < "$temp/ordered"
# Extra tools: output captured so values are never printed.
if command -v gitleaks >/dev/null 2>&1; then
  if [ "$mode" = staged ]; then
    gitleaks protect --source "$ROOT" --staged --no-banner --redact > "$temp/external" 2>&1
  else
    gitleaks detect --source "$ROOT" --no-banner --redact > "$temp/external" 2>&1
  fi
  code=$?
  printf 'SECRET_EXTERNAL: gitleaks exit=%s\n' "$code"
  [ "$code" -eq 0 ] || failures=$((failures + 1))
fi
if command -v trufflehog >/dev/null 2>&1; then
  # trufflehog scans files: the scanned contents, one per path (only when it is installed).
  n=0; while IFS= read -r -d '' path; do n=$((n + 1))
    if [ "$mode" = directory ]; then cp "$ROOT/${path#./}" "$temp/blobs/blob-$n" 2>/dev/null; else git show ":${path#./}" > "$temp/blobs/blob-$n" 2>/dev/null; fi
  done < "$temp/paths"
  trufflehog filesystem "$temp/blobs" --no-update --no-verification --fail > "$temp/external" 2>&1
  code=$?
  printf 'SECRET_EXTERNAL: trufflehog exit=%s\n' "$code"
  [ "$code" -eq 0 ] || failures=$((failures + 1))
fi
if [ "$failures" -gt 0 ]; then
  printf 'SECRET_SCAN_FAILED findings=%s\n' "$failures" >&2
  # The way out of a false positive, at the moment it blocks (secret-exception had 0 uses at MLB).
  printf '%s\n' 'A real secret: remove it from the file (and rotate it if it was ever pushed). A false positive (test fixture, public key): a human records it once: UAK_HUMAN=NAME bash .uak/bin/uak secret-exception ID --path FILE --rule RULE --reason TEXT' >&2
  exit 1
fi
printf 'SECRET_SCAN_PASS files=%s mode=%s\n' "$count" "$mode"
