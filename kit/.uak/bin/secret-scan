#!/usr/bin/env bash
# Minimal built-in patterns; Bash 3.2+, Git and POSIX tools. Never prints values.
set -u
set -o pipefail
LC_ALL=C; export LC_ALL
mode=tracked decisions= scan_root= temp= failures=0 count=0
usage() { printf '%s\n' 'Usage: secret-scan [--tracked|--staged|--directory DIR] [--decisions FILE]'; }
while [ "$#" -gt 0 ]; do
  case "$1" in
    --tracked) mode=tracked; shift;;
    --staged) mode=staged; shift;;
    --directory) [ "$#" -gt 1 ] || { usage >&2; exit 2; }; mode=directory; scan_root=$2; shift 2;;
    --decisions) [ "$#" -gt 1 ] || { usage >&2; exit 2; }; decisions=$2; shift 2;;
    *) usage >&2; exit 2;;
  esac
done
if [ "$mode" = directory ]; then
  ROOT=$(cd "$scan_root" 2>/dev/null && pwd -P) || exit 2
else
  ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || { printf '%s\n' 'SECRET_SCAN_UNVERIFIED: no Git repository.' >&2; exit 2; }
fi
cd "$ROOT" || exit 2
temp=$(mktemp -d "${TMPDIR:-/tmp}/hack-secrets.XXXXXX") || exit 2
cleanup() { [ -n "$temp" ] && rm -rf "$temp"; }
trap cleanup EXIT
trap 'exit 130' INT TERM
mkdir "$temp/blobs" || exit 2
if [ "$mode" = staged ]; then
  git diff --cached --name-only -z --diff-filter=ACMR > "$temp/paths" || exit 2
elif [ "$mode" = tracked ]; then
  git ls-files -z > "$temp/paths" || exit 2
else
  find . -name .git -prune -o -type f -print0 > "$temp/paths" || exit 2
fi
loaded=no
load_decisions() {
  [ "$loaded" = no ] || return 0
  loaded=yes
  if [ -n "$decisions" ]; then
    [ -f "$decisions" ] && cp "$decisions" "$temp/decisions"
    return 0
  fi
  # Reads the remote only when a finding needs an exception. Never changes local refs.
  remote=${UAK_REMOTE:-origin}
  url=$(git config --get "remote.$remote.url" 2>/dev/null) || return 0
  case "$url" in /*|[A-Za-z]:*|*://*|*@*:*) ;; *) url="$ROOT/$url";; esac
  mkdir "$temp/state" || return 0
  git -C "$temp/state" init -q > "$temp/remote-log" 2>&1 || return 0
  git -C "$temp/state" fetch -q "$url" refs/heads/claims >> "$temp/remote-log" 2>&1 || return 0
  git -C "$temp/state" show FETCH_HEAD:DECISIONS.md > "$temp/decisions" 2>/dev/null || true
}
allowed() {
  load_decisions
  [ -s "$temp/decisions" ] || return 1
  UAK_SECRET_PATH="$path" UAK_SECRET_RULE="$rule" UAK_SECRET_BLOB="$blob" awk '
    /^Secret-Exception: / {
      s=substr($0,19); n=split(s,a,"|");
      if(n==7 && a[1] ~ /^[A-Z][A-Z0-9]*-[0-9][0-9][0-9]+$/ && a[2]==ENVIRON["UAK_SECRET_PATH"] &&
         a[3]==ENVIRON["UAK_SECRET_RULE"] && a[4]==ENVIRON["UAK_SECRET_BLOB"] &&
         a[5] ~ /^[A-Za-z0-9_.-]+$/ && a[6]=="approved" && a[7] ~ /^[0-9]+$/) {ok=1}
    } END {exit !ok}' "$temp/decisions"
}
while IFS= read -r -d '' path; do
  path=${path#./}; count=$((count + 1))
  content="$temp/blobs/blob-$count"
  if [ "$mode" = directory ]; then
    cp "$ROOT/$path" "$content" || { failures=$((failures + 1)); continue; }
  else
    git show ":$path" > "$content" 2>/dev/null || {
      printf 'SECRET_SCAN_ERROR: %q index not available\n' "$path" >&2
      failures=$((failures + 1)); continue
    }
  fi
  blob=$(git hash-object "$content" 2>/dev/null) || { failures=$((failures + 1)); continue; }
  : > "$temp/findings"
  name=${path##*/}
  case "$name" in
    .env|.env.*) case "$name" in .env.example|.env.sample|.env.template|.env.dist) ;; *) printf '%s\n' 'SEC_ENV|1' >> "$temp/findings";; esac;;
  esac
  # grep -E, not awk: mawk (Debian/Ubuntu default awk) ignores {n} intervals and let everything pass.
  scan_rule() { grep -nE -e "$2" "$content" 2>/dev/null | cut -d: -f1 | sed "s/^/$1|/" >> "$temp/findings"; }
  scan_rule SEC_PRIVATE_KEY '-----BEGIN ([A-Z0-9 ]+ )?PRIVATE KEY-----'
  scan_rule SEC_CLOUD_ACCESS '(AKIA|ASIA)[A-Z0-9]{16}|AIza[A-Za-z0-9_-]{35}'
  scan_rule SEC_GITHUB 'gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{40,}'
  scan_rule SEC_ANTHROPIC 'sk-ant-[A-Za-z0-9_-]{20,}'
  scan_rule SEC_OPENAI 'sk-proj-[A-Za-z0-9_-]{20,}|sk-svcacct-[A-Za-z0-9_-]{20,}|sk-[A-Za-z0-9]{20,}'
  grep -niE "(aws_secret_access_key|aws_session_token|accountkey)[[:space:]\"'=:]+[a-z0-9+/=]{40,}" "$content" 2>/dev/null |
    cut -d: -f1 | sed 's/^/SEC_CLOUD_SECRET|/' >> "$temp/findings"
  sort -u "$temp/findings" > "$temp/unique"
  while IFS='|' read -r rule line; do
    [ -n "$rule" ] || continue
    if allowed; then
      printf 'SECRET_EXCEPTION: %q:%s %s blob=%s\n' "$path" "$line" "$rule" "$blob"
    else
      printf 'SECRET_FOUND: %q:%s %s\n' "$path" "$line" "$rule" >&2
      failures=$((failures + 1))
    fi
  done < "$temp/unique"
done < "$temp/paths"
# Extra tools: output captured so values are never printed.
if command -v gitleaks >/dev/null 2>&1; then
  if [ "$mode" = staged ]; then
    gitleaks protect --source "$ROOT" --staged --no-banner --redact > "$temp/external" 2>&1
  else
    gitleaks detect --source "$ROOT" --no-banner --redact > "$temp/external" 2>&1
  fi
  code=$?
  printf 'SECRET_EXTERNAL: gitleaks exit=%s\n' "$code"
  [ "$code" -eq 0 ] || failures=$((failures + 1))
fi
if command -v trufflehog >/dev/null 2>&1; then
  trufflehog filesystem "$temp/blobs" --no-update --no-verification --fail > "$temp/external" 2>&1
  code=$?
  printf 'SECRET_EXTERNAL: trufflehog exit=%s\n' "$code"
  [ "$code" -eq 0 ] || failures=$((failures + 1))
fi
if [ "$failures" -gt 0 ]; then printf 'SECRET_SCAN_FAILED findings=%s\n' "$failures" >&2; exit 1; fi
printf 'SECRET_SCAN_PASS files=%s mode=%s\n' "$count" "$mode"
