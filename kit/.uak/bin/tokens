#!/usr/bin/env bash
# uak tokens: what the agents of this project really spent, per task, harness, model and lead vs subagent.
#   tokens [--team] [--by task|harness|model|scope|agent|step] [--since DAYS] [--publish] [--quiet] [--json]
#   tokens --budget-check ID   one line when the task's tokens crossed `Token-Budget: N` of PROJECT.md, nothing otherwise
# Reads the local transcripts that Claude Code and Codex already write. No API key, no network for the local view:
#   Claude Code  ~/.claude/projects/<encoded cwd>/*.jsonl (+ <session>/subagents/*.jsonl): message.usage, deduped by id
#   Codex        ~/.codex/sessions/**/rollout-*.jsonl: the last token_count (total_token_usage) of each session
#   Cursor       no local token log: read the Cursor dashboard (uak pace set covers plan pacing)
# A transcript belongs to this project when its cwd is the main checkout or a worktree under <repo>-wt/ (where
# `wt new` puts them), so a removed worktree still counts. The task is the worktree name (hack-016 → HACK-016).
# A session that started elsewhere (the home directory: the usual place to drive a repo from) counts too, from the
# moment its calls run in the main checkout or in a worktree: each message goes to the place of its tool calls (their
# paths and `cd`, or the cwd the line records), so its subagents land on the task whose worktree they worked in.
# Step of a task: author (work in its worktree), review (`uak review ID`), merge (`uak merge ID`: the gate), lead
# (coordination: the main checkout, `uak claim|done|status … ID` from there). Only counts, model names and task IDs
# are read out of a transcript, never its text.
# --publish writes this machine's totals to claims:tokens/<machine>.md (one file per machine, replaced); a failed
# publish leaves one black box line with the reason. --team adds every machine's file (the agent column comes from the
# task owner on claims), names the machines that worked but never published, and shows the main checkout's share.
# Why: "it burns tokens reading the same stuff again and again" was the top complaint at Reap and MLB, and the
# kit could only count calls; tiers, the output cap and dedupe are only real if the bill shows it.
set -u
MSYS2_ARG_CONV_EXCL="refs/;origin/;HEAD;FETCH_HEAD;:"; export MSYS2_ARG_CONV_EXCL
LC_ALL=C; export LC_ALL
say() { printf '%s\n' "$*"; }
die() { printf 'tokens: %s\n' "$*" >&2; exit 2; }
team=no by=task since=30 publish=no quiet=no json=no budget_id=
while [ "$#" -gt 0 ]; do
  case "$1" in
    --team) team=yes;;
    --by) by=${2:-}; shift; case "$by" in task|harness|model|scope|agent|step) ;; *) die "--by task|harness|model|scope|agent|step";; esac;;
    --budget-check) budget_id=${2:-}; shift; case "$budget_id" in [A-Za-z]*-[0-9]*) ;; *) die "--budget-check takes a task ID (UAK-124)";; esac;;
    --since) since=${2:-}; shift; case "$since" in ''|*[!0-9]*) die "--since takes days";; esac;;
    --publish) publish=yes;;
    --quiet) quiet=yes;;
    --json) json=yes;;
    -h|--help) sed -n '2,3p' "$0" | sed 's/^# *//'; exit 0;;
    *) die "unknown option $1 (tokens --help)";;
  esac; shift
done
top=$(git rev-parse --show-toplevel 2>/dev/null) || die "not a Git repository"
common=$(git -C "$top" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || common="$top/.git"
main=$(cd "$common/.." && pwd -P)
REMOTE=${UAK_REMOTE:-origin}
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$here/lib/config.sh"
tmp=$(mktemp -d "${TMPDIR:-/tmp}/uak-tokens.XXXXXX") || exit 2
trap 'rm -rf "$tmp"' EXIT
# The transcript directory name is the cwd with every non-alphanumeric character turned into "-", counted the
# way Claude Code counts them (UTF-16 units): é is one "-", an emoji two. Why: under LC_ALL=C sed saw é as two
# bytes, so a home like C:\Users\José never matched its transcripts.
enc() {
  local u4 u2; u4=$(printf '[\360-\367][\200-\277]*'); u2=$(printf '[\300-\357][\200-\277]*')
  printf '%s' "$1" | LC_ALL=C sed -e "s/$u4/--/g" -e "s/$u2/-/g" -e 's/[^A-Za-z0-9]/-/g'
}
prefixes() {
  local m=$main w
  printf '%s\n' "$(enc "$m")"
  w=$(cygpath -m "$m" 2>/dev/null) && [ -n "$w" ] && printf '%s\n' "$(enc "$w")"
}
# Rows: task|harness|model|scope|sessions|input|cache_write|cache_read|output|step (rows published by an older
# machine have no step: they fold under "")
scan_local() {
  local claude=${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects codex=${CODEX_HOME:-$HOME/.codex}/sessions p d name task f
  : > "$tmp/rows"
  if [ -d "$claude" ]; then
    # Where a transcript lives tells where its session started: the main checkout, a worktree of it, or elsewhere. A
    # session from elsewhere is read only when it names this repository at all (a plain grep of the paths).
    plist=$(prefixes | sort -u)
    { printf '%s\n' "$main"; w=$(cygpath -m "$main" 2>/dev/null) && [ -n "$w" ] && { printf '%s\n' "$w"; printf '%s\n' "$w" | sed 's,/,\\\\,g'; }; } > "$tmp/pats"
    find "$claude" -maxdepth 4 -name '*.jsonl' -mtime "-$since" 2>/dev/null | while IFS= read -r f; do
      rel=${f#"$claude"/}; name=${rel%%/*}; start=known
      for p in $plist; do
        case "$name" in
          "$p") start=main;;
          "$p"-wt-*) start=$(printf '%s' "${name#"$p"-wt-}" | sed -E 's/^([A-Za-z][A-Za-z0-9]*-[0-9]+).*/\1/' | tr '[:lower:]' '[:upper:]');;
        esac
        [ "$start" = known ] || break
      done
      if [ "$start" = known ]; then grep -q -F -f "$tmp/pats" "$f" 2>/dev/null || continue; start=; fi
      case "$f" in */subagents/*) scope=subagent;; *) scope=lead;; esac
      awk -v start="$start" -v scope="$scope" -v main="$main" -v wmain="$(cygpath -m "$main" 2>/dev/null)" '
        function norm(s) { gsub(/\\\\/, "/", s); return s }
        # A worktree name is a task (hack-016-app → HACK-016); a folder that is not a task name stays as it is.
        function task_of(t) {
          sub(/[\/"'"'"' \;)].*/, "", t)
          if (match(t, /^[A-Za-z][A-Za-z0-9]*-[0-9]+/)) t = substr(t, 1, RLENGTH)
          return toupper(t) }
        # The place of a path: "main" (the main checkout), a task ID (its worktree) or "". anchored: the path starts
        # the text (a cwd); otherwise the first mention of the repository anywhere in it (a tool call).
        function find_loc(s, anchored,   i, r, p, c, rest) {
          for (i = 1; i <= 2; i++) { r = (i == 1) ? main : wmain; if (r == "") continue
            if (anchored) { if (index(s, r "-wt/") == 1) return task_of(substr(s, length(r) + 5)); continue }
            p = index(s, r "-wt/"); if (p) return task_of(substr(s, p + length(r) + 4)) }
          for (i = 1; i <= 2; i++) { r = (i == 1) ? main : wmain; if (r == "") continue
            if (anchored) { if (s == r || index(s, r "/") == 1) return "main"; continue }
            rest = s
            while ((p = index(rest, r)) > 0) { c = substr(rest, p + length(r), 1)
              if (c !~ /[A-Za-z0-9_.-]/) return "main"
              rest = substr(rest, p + length(r)) } }
          return "" }
        # The first `uak COMMAND` of a tool call: review and merge by name, any other command with a task ID as
        # coordination. Sets sig and sigid.
        function uak_cmd(s,   c, rest) {
          sig = ""; sigid = ""
          if (!match(s, /(bin\/uak|[ "'"'"'`;(&|]uak)[ ]+[a-z][a-z-]*/)) return
          c = substr(s, RSTART, RLENGTH); sub(/^.*uak[ ]+/, "", c)
          rest = substr(s, RSTART + RLENGTH); sub(/["\\].*/, "", rest)
          if (match(rest, /[A-Z][A-Z0-9]*-[0-9][0-9]*/)) sigid = substr(rest, RSTART, RLENGTH)
          if (c == "merge" || c == "review") sig = c; else if (sigid != "") sig = "coord" }
        function str(key,   v) { if (!match($0, "\"" key "\": ?\"[^\"]+\"")) return ""; v = substr($0, RSTART, RLENGTH); sub(/^"[^"]*": ?"/, "", v); sub(/"$/, "", v); return v }
        function num(key,   v) { if (!match($0, "\"" key "\": ?[0-9]+")) return 0; v = substr($0, RSTART, RLENGTH); sub(/^"[^"]*": ?/, "", v); return v + 0 }
        BEGIN { cur = start }
        {
          isa = ($0 ~ /"type": ?"assistant"/ && index($0, "\"usage\"") > 0)
          loc = ""
          # The cwd the line records, then the paths of its tool calls: the call is where the work ran.
          if (match($0, /"cwd": ?"[^"]*"/)) { c = substr($0, RSTART, RLENGTH); sub(/^"cwd": ?"/, "", c); sub(/"$/, "", c); loc = find_loc(norm(c), 1) }
          tu = 0; sig = ""; sigid = ""
          if (isa && $0 ~ /"type": ?"tool_use"/) { tu = 1; L = norm($0); p = find_loc(L, 0); if (p != "") loc = p; uak_cmd(L) }
          # A call outside the repository takes the session out of it; a message with no call keeps the place of the
          # latest call, inside or outside.
          if (loc != "") cur = loc; else if (tu) cur = ""
          if (tu) {
            if (sig == "merge" || sig == "review") { if (sigid != "") cur = sigid; curstep = sig }
            else { curstep = ""; if (sig == "coord" && (loc == "main" || loc == "")) { if (cur == "main" || cur == "") { cur = sigid; } } }
          }
          if (!isa) next
          id = str("id"); if (id !~ /^msg_/) next
          if (!(id in m)) { it[id] = cur; is_[id] = curstep }
          if (tu) { it[id] = cur; if (sig == "merge" || sig == "review") is_[id] = sig; else if (sig == "coord" && it[id] == sigid) is_[id] = "lead" }
          model = str("model"); if (model == "") model = "?"
          m[id] = model
          in_[id] = num("input_tokens"); cw[id] = num("cache_creation_input_tokens")
          cr[id] = num("cache_read_input_tokens"); out[id] = num("output_tokens")
        }
        END { for (id in m) { t = it[id]; if (t == "") continue
                st = is_[id]; if (st == "") st = (t == "main") ? "lead" : "author"
                k = t "|" m[id] "|" st; I[k] += in_[id]; W[k] += cw[id]; R[k] += cr[id]; O[k] += out[id] }
              for (k in I) if (I[k] + W[k] + R[k] + O[k] > 0) { split(k, a, "|")
                printf "%s|claude-code|%s|%s|1|%d|%d|%d|%d|%s\n", a[1], a[2], scope, I[k], W[k], R[k], O[k], a[3] } }' "$f"
    done >> "$tmp/rows"
  fi
  if [ -d "$codex" ]; then
    find "$codex" -name 'rollout-*.jsonl' -mtime "-$since" 2>/dev/null | while IFS= read -r f; do
      awk -v main="$main" -v wmain="$(cygpath -m "$main" 2>/dev/null)" '
        function norm(s) { gsub(/\\\\/, "/", s); return s }
        function sval(s, key,   v) { if (!match(s, "\"" key "\": ?\"[^\"]+\"")) return ""; v = substr(s, RSTART, RLENGTH); sub(/^"[^"]*": ?"/, "", v); sub(/"$/, "", v); return v }
        function val(s, key,   v) { if (!match(s, "\"" key "\": ?[0-9]+")) return 0; v = substr(s, RSTART, RLENGTH); sub(/^"[^"]*": ?/, "", v); return v + 0 }
        # The task of a working directory: main, a task ID (its worktree) or "".
        function where(d,   i, r, t) {
          for (i = 1; i <= 2; i++) { r = (i == 1) ? main : wmain; if (r == "") continue
            if (d == r) return "main"
            if (index(d, r "-wt/") == 1) { t = substr(d, length(r) + 5); sub(/\/.*/, "", t); return toupper(t) } }
          return "" }
        cwd == "" && /"cwd"/ { cwd = norm(sval($0, "cwd")) }
        # A session started elsewhere: its first tool call (workdir) that ran in the repository decides.
        wloc == "" && /workdir/ && match($0, /workdir\\?": ?\\?"[^"\\]+/) {
          v = substr($0, RSTART, RLENGTH); sub(/^workdir\\?": ?\\?"/, "", v); wloc = where(norm(v)) }
        /"model"/ { v = sval($0, "model"); if (v != "") model = v }
        /"total_token_usage"/ {
          s = substr($0, index($0, "\"total_token_usage\""))
          I = val(s, "input_tokens"); C = val(s, "cached_input_tokens"); O = val(s, "output_tokens") }
        END {
          if (cwd == "" || I + O == 0) exit
          task = where(cwd); if (task == "") task = wloc
          if (task == "") exit
          printf "%s|codex|%s|lead|1|%d|0|%d|%d|%s\n", task, (model == "" ? "?" : model), I - C, C, O, (task == "main" ? "lead" : "author") }' "$f"
    done >> "$tmp/rows"
  fi
}
# Sums rows by key columns 1-4 and the step (sessions added too).
fold() { awk -F'|' '{k = $1 "|" $2 "|" $3 "|" $4 "|" $10; s[k] += $5; i[k] += $6; w[k] += $7; r[k] += $8; o[k] += $9}
  END {for (k in s) { split(k, a, "|"); printf "%s|%s|%s|%s|%d|%d|%d|%d|%d|%s\n", a[1], a[2], a[3], a[4], s[k], i[k], w[k], r[k], o[k], a[5] }}' | sort; }
machine() { (hostname 2>/dev/null || uname -n) | cksum | awk '{print $1 % 100000}'; }
publish_rows() {
  local url ok=1 rel attempt
  PUB_WHY=
  url=$(git -C "$top" config --get "remote.$REMOTE.url") || { PUB_WHY="no remote $REMOTE"; return 1; }
  case "$url" in /*|[A-Za-z]:*|*://*|*@*:*) ;; *) url="$main/$url";; esac
  rel="tokens/$(machine).md"
  git -C "$tmp" init -q repo && git -C "$tmp/repo" remote add origin "$url" &&
    git -C "$tmp/repo" config user.name "${UAK_AGENT:-uak}" && git -C "$tmp/repo" config user.email uak@localhost || { PUB_WHY="git init failed"; return 1; }
  for attempt in 1 2 3 4; do
    if git -C "$tmp/repo" ls-remote --exit-code --heads origin claims >/dev/null 2>&1; then
      git -C "$tmp/repo" fetch -q --depth 1 origin refs/heads/claims 2> "$tmp/pub-err" && git -C "$tmp/repo" checkout -q -B claims FETCH_HEAD || { PUB_WHY="fetch of claims failed: $(head -n 1 "$tmp/pub-err" 2>/dev/null)"; return 1; }
    else
      git -C "$tmp/repo" checkout -q --orphan claims 2>/dev/null || { PUB_WHY="no claims branch to publish to"; return 1; }
    fi
    mkdir -p "$tmp/repo/tokens"
    { printf '# Tokens · machine %s · updated %s · last %s days\n\n' "$(machine)" "$(date -u +%Y-%m-%dT%H:%MZ)" "$since"
      printf 'Root: %s\nRoot: %s-wt\n' "$main" "$main"
      printf 'task | harness | model | scope | sessions | input | cache_write | cache_read | output | step\n\n'
      sed 's/|/ | /g; s/^/- /' "$1"; } > "$tmp/repo/$rel"
    git -C "$tmp/repo" add "$rel"
    git -C "$tmp/repo" diff --cached --quiet && { ok=0; break; }
    git -C "$tmp/repo" commit -q -m "uak: tokens $(machine)" || { PUB_WHY="git commit failed"; return 1; }
    if git -C "$tmp/repo" push -q origin HEAD:refs/heads/claims 2> "$tmp/pub-err"; then ok=0; break; fi
    PUB_WHY="push to claims failed: $(grep -v '^[[:space:]]*$' "$tmp/pub-err" 2>/dev/null | head -n 1)"
    sleep "$attempt"
  done
  return "$ok"
}
team_rows() {
  local d
  git -C "$top" fetch -q "$REMOTE" claims 2>/dev/null || die "no remote claims branch"
  # Each directory on its own: a pathspec that matches nothing makes git archive fail and print nothing, and a claims
  # branch with no blackbox/ yet (or no tokens/ on an older one) must not take the others with it. bsdtar (macOS)
  # exits 0 on empty input, so the failure could not be told by the pipeline's status. Why (UAK-043, CI macos).
  for d in tokens tasks blackbox; do
    git -C "$top" cat-file -e "FETCH_HEAD:$d" 2>/dev/null || continue
    git -C "$top" archive FETCH_HEAD "$d" 2>/dev/null | tar -x -C "$tmp" 2>/dev/null
  done
  [ -d "$tmp/tokens" ] || die "no machine has published yet: bash .uak/bin/tokens --publish (the Stop hook does it every 30 min)"
  cat "$tmp"/tokens/*.md | sed -n 's/^- //p' | sed 's/ | /|/g' | fold
  for f in "$tmp"/tasks/*.md; do [ -f "$f" ] && printf '%s %s\n' "$(sed -n 's/^ID: //p' "$f" | head -n 1)" "$(sed -n 's/^Owner: //p' "$f" | head -n 1)"; done > "$tmp/owners"
}
# Machines that worked on the project (a black box file per day and machine; a task worktree outside every root a
# published file lists) without a tokens file of their own. Why (deus-ex-machina and DevDay, Nov 2026): tokens came
# from 1 of 3 Macs and read 100 % "main"; nobody could tell the other two had never published.
# Sets COV_PUBLISHED, COV_TOTAL and COV_TEXT (empty when every machine reported).
coverage() {
  local f h legacy=no pubs=' ' unrep_hosts= unrep_dirs= w d npub=0 nh=0 nd=0
  COV_PUBLISHED=0 COV_TOTAL=0 COV_TEXT=; : > "$tmp/roots"
  for f in "$tmp"/tokens/*.md; do
    [ -f "$f" ] || continue
    h=${f##*/}; pubs="$pubs${h%.md} "; npub=$((npub + 1))
    if grep -q '^Root: ' "$f"; then sed -n 's/^Root: //p' "$f" >> "$tmp/roots"; else legacy=yes; fi
  done
  for f in "$tmp"/blackbox/*.md; do
    [ -f "$f" ] || continue
    h=${f##*-}; h=${h%.md}
    case "$pubs$unrep_hosts" in *" $h "*) ;; *) unrep_hosts="$unrep_hosts$h "; nh=$((nh + 1));; esac
  done
  if [ "$legacy" = no ] && [ "$npub" -gt 0 ]; then
    for f in "$tmp"/tasks/*.md; do
      [ -f "$f" ] || continue
      w=$(sed -n 's/^Worktree: //p' "$f" | head -n 1); case "$w" in ''|-) continue;; esac
      case "$w" in /*|[A-Za-z]:*) ;; *) continue;; esac
      while IFS= read -r d; do case "$w" in "$d"|"$d"/*) continue 2;; esac; done < "$tmp/roots"
      d=${w%/*}
      case "$unrep_dirs|" in *"|$d|"*) ;; *) unrep_dirs="$unrep_dirs|$d"; nd=$((nd + 1));; esac
    done
  fi
  COV_PUBLISHED=$npub
  COV_TOTAL=$((npub + (nd > nh ? nd : nh)))
  [ "$COV_TOTAL" -gt "$npub" ] || return 0
  COV_TEXT="NOT REPORTED: $((COV_TOTAL - npub)) machine(s)"
  [ -z "$unrep_dirs" ] || COV_TEXT="$COV_TEXT (worktrees under $(printf '%s' "$unrep_dirs" | sed 's/^|//; s/|/, /g')$([ -z "$unrep_hosts" ] || printf '; black box hosts %s' "$(printf '%s' "$unrep_hosts" | sed 's/ $//; s/ /, /g')"))"
  [ -n "$unrep_dirs" ] || COV_TEXT="$COV_TEXT (black box hosts $(printf '%s' "$unrep_hosts" | sed 's/ $//; s/ /, /g'))"
  COV_TEXT="$COV_TEXT: run bash .uak/bin/tokens --publish there. Totals are from $COV_PUBLISHED of $COV_TOTAL machines."
}
# The main checkout's share of the spend: coordination and work outside tasks. Above 50 % the per-task cost is not
# measurable. Why (DevDay): 406 M tokens, 78 % in "main", one coordinator session alone 178 M cache reads.
main_share() { # view file
  awk -F'|' '{ t = $6 + $7 + $8 + $9; T += t; if ($1 == "main") M += t }
    END { if (T > 0 && M > 0) { p = int(100 * M / T + 0.5)
      printf "main (coordination and work outside tasks) %d%%", p
      if (p > 50) printf "\nWARNING: %d%% of the spend is not attributed to any task: start tasks with wt new ID so each has its own worktree, and keep the coordinator session short.", p
      printf "\n" } }' "$1"
}
report() {
  local col
  case "$by" in task) col=1;; harness) col=2;; model) col=3;; scope) col=4;; agent) col=0;; step) col=10;; esac
  awk -F'|' -v col="$col" -v owners="$tmp/owners" -v json="$json" '
    BEGIN { while ((getline l < owners) > 0) { split(l, a, " "); own[a[1]] = a[2] } }
    { key = (col == 0) ? (($1 == "main") ? "main" : (($1 in own) ? own[$1] : "?")) : $col
      if (key == "") key = "unknown"
      s[key] += $5; i[key] += $6; w[key] += $7; r[key] += $8; o[key] += $9
      T += $6 + $7 + $8 + $9; TR += $8; TO += $9; TS += $5 }
    function h(n) { if (n >= 1e9) return sprintf("%.1fB", n / 1e9); if (n >= 1e6) return sprintf("%.1fM", n / 1e6); if (n >= 1e3) return sprintf("%.0fk", n / 1e3); return n "" }
    END {
      if (json == "yes") { printf "["; c = 0; for (k in s) { printf "%s{\"key\":\"%s\",\"sessions\":%d,\"input\":%d,\"cache_write\":%d,\"cache_read\":%d,\"output\":%d}", (c++ ? "," : ""), k, s[k], i[k], w[k], r[k], o[k] } print "]"; exit }
      if (T == 0) { print "TOKENS: no transcripts of this project found (Claude Code or Codex) in the window"; exit }
      printf "TOKENS total %s · output %s · cache hit %d%% · %d transcript(s)\n", h(T), h(TO), 100 * TR / T, TS
      printf "%-22s %8s %8s %8s %8s %8s %6s %6s\n", "", "input", "cache-w", "cache-r", "output", "total", "share", "hit%"
      n = 0; for (k in s) keys[++n] = k
      for (x = 1; x <= n; x++) for (y = x + 1; y <= n; y++) {
        tx = i[keys[x]] + w[keys[x]] + r[keys[x]] + o[keys[x]]; ty = i[keys[y]] + w[keys[y]] + r[keys[y]] + o[keys[y]]
        if (ty > tx) { t = keys[x]; keys[x] = keys[y]; keys[y] = t } }
      for (x = 1; x <= n && x <= 25; x++) { k = keys[x]; t = i[k] + w[k] + r[k] + o[k]
        printf "%-22s %8s %8s %8s %8s %8s %5d%% %5d%%\n", substr(k, 1, 22), h(i[k]), h(w[k]), h(r[k]), h(o[k]), h(t), 100 * t / T, (t ? 100 * r[k] / t : 0) }
      if (n > 25) printf "... %d more\n", n - 25
    }' "$1"
}
# `Token-Budget: N` of .uak/PROJECT.md (per task; 500k, 1.5M or a plain number). One line when the task's tokens crossed
# it, nothing when there is no budget or the task is under it. The published totals of every machine when claims has
# them, this machine's transcripts otherwise. `uak next` and `uak status --task` call this to warn.
budget_check() { # ID
  local id limit used src=published
  id=$(printf '%s' "$1" | tr '[:lower:]' '[:upper:]')
  uak_cfg_var "$top/.uak/PROJECT.md" Token-Budget
  limit=$(printf '%s' "$CFG" | tr -d ' ,_' | awk '{ n = $0 + 0; u = tolower(substr($0, length($0))); if (u == "k") n *= 1e3; else if (u == "m") n *= 1e6; else if (u == "b") n *= 1e9; printf "%.0f", n }')
  case "$limit" in ''|0) return 0;; esac
  if ! ( team_rows ) > "$tmp/view" 2>/dev/null || [ ! -s "$tmp/view" ]; then scan_local; fold < "$tmp/rows" > "$tmp/view"; src="this machine"; fi
  used=$(awk -F'|' -v id="$id" '$1 == id { t += $6 + $7 + $8 + $9 } END { printf "%.0f", t }' "$tmp/view")
  [ "${used:-0}" -gt "$limit" ] || return 0
  say "TOKENS_BUDGET: $id spent $(awk -v n="$used" 'BEGIN { if (n >= 1e6) printf "%.1fM", n / 1e6; else printf "%.0fk", n / 1e3 }') tokens, over its Token-Budget of $CFG ($src; Token-Budget in .uak/PROJECT.md). Split it, narrow it or raise the budget with the human."
}
: > "$tmp/owners"
if [ -n "$budget_id" ]; then budget_check "$budget_id"; exit 0; fi
if [ "$team" = yes ]; then
  team_rows > "$tmp/view"
else
  scan_local; fold < "$tmp/rows" > "$tmp/view"
  if [ "$publish" = yes ]; then
    if publish_rows "$tmp/view"; then [ "$quiet" = yes ] || say "TOKENS: published to claims:tokens/$(machine).md"
    else
      [ "$quiet" = yes ] || say "TOKENS: could not publish: ${PUB_WHY:-unknown reason}" >&2
      # A silent background failure left a whole machine out of the bill. Why (deus-ex-machina): 1 of 3 Macs published.
      bash "$here/bb" add friction "tokens publish failed: ${PUB_WHY:-unknown reason}" --fix "tokens --publish must reach claims from every machine; check the remote and the claims branch permissions" --cmd "uak tokens --publish" > /dev/null 2>&1 || true
    fi
    [ "$quiet" = no ] || exit 0
  fi
fi
[ "$quiet" = yes ] && exit 0
report "$tmp/view"
[ "$json" = yes ] || { main_share "$tmp/view"; [ "$team" != yes ] || { coverage; [ -z "$COV_TEXT" ] || say "$COV_TEXT"; }; }
[ "$team" = yes ] || [ "$json" = yes ] || say "(this machine; --team adds every machine; Cursor keeps no local token log)"
