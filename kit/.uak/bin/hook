#!/usr/bin/env bash
# Claude Code hooks (.claude/settings.json). Never break the session: on error exit 0 silently.
# session-start: injects identity + `uak next` + inbox as initial context.
# tick (PostToolUse): heartbeat every lease/3 and a claims check every 20 s (inbox read when it moved), in background;
#   new actionable messages are injected as additional context on the next tool call.
# stop (Stop): blocks ending the turn once per batch of unhandled messages; flushes the black box.
# output (Claude Code PostToolUse Bash) · wrap [codex] (Cursor preToolUse Shell, Codex PreToolUse Bash): huge outputs
#   become head + tail (or a per-file diff index) + the log path.
# Pace: when plan usage changes level (surge/conserve/critical), one line is injected (uak pace).
# Why: agents forget heartbeats and miss mid-session requests from other tasks.
set -u
# Git Bash rewrites "rev:.path" arguments for native git unless told not to (the same list as uak).
MSYS2_ARG_CONV_EXCL="refs/;origin/;${UAK_REMOTE:-origin}/;HEAD;FETCH_HEAD;:"; export MSYS2_ARG_CONV_EXCL
# uak calls made by the hooks themselves (inbox peeks, heartbeats, next at session start) are counted as hook-CMD,
# so the black box tells the agent's own calls from the harness's. Why (MLB): status/inbox looked like half of all
# calls, but the hooks made many of them.
UAK_CALLER=hook; export UAK_CALLER
input=''
[ -t 0 ] || input=$(cat 2>/dev/null || true)
top=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$top" || exit 0
gd=$(git rev-parse --git-dir 2>/dev/null) || exit 0
env_value() { [ -f .uak-env ] && sed -n "s/^$1=//p" .uak-env | head -n 1 | tr -d '\r'; }
# Windows harnesses name files C:\Users\RUNNER~1\...; git names the top C:/Users/runneradmin/...: one form for both.
winpath() { { command -v cygpath >/dev/null 2>&1 && cygpath -m -l "$1" 2>/dev/null; } || printf '%s' "$1" | tr '\\' /; }
# The worktree's identity wins over an inherited export, as in uak (UAK_ENV_OVERRIDE=1 keeps the export).
task=$(env_value UAK_TASK); agent=$(env_value UAK_AGENT)
[ -n "$agent" ] && [ "${UAK_ENV_OVERRIDE:-}" != 1 ] || agent=${UAK_AGENT:-$agent}
fresh() { [ -f "$1" ] && [ -n "$(find "$1" -mmin "-$2" 2>/dev/null)" ]; }
# JSON string body: sed escapes (awk gsub of a backslash differs between mawk, gawk and BSD awk); control
# characters such as ANSI colors from test runners are invalid in JSON and are dropped.
json_text() { tr -d '\r' | tr '\t' ' ' | tr -d '\000-\010\013\014\016-\037' | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' | awk 'BEGIN {ORS=""} {if (NR > 1) print "\\n"; print}'; }
# JSON string body that keeps tabs and newlines (commands, paths).
json_cmd() { tab=$(printf '\t'); sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e "s/$tab/\\\\t/g" | tr -d '\r' | awk 'BEGIN {ORS=""} {if (NR > 1) print "\\n"; print}'; }
# Decode the JSON string at PARENT.KEY of the hook payload (or PARENT itself when it is a string).
# Handles \n \t \" \\ \/; \uXXXX is kept as is. No jq (Bash 3.2 + POSIX awk).
# Linear: one match() finds the end of the string, a split on backslashes decodes it and printf streams it. Why
# (audit, Oct 2026): a loop that added one character at a time took 70 s on a 1.3 MB output, past the 10 s hook
# timeout, so the whole output reached the model.
jdecode() {
  printf '%s' "$input" | awk -v p="\"$1\"" -v key="${2:-}" 'BEGIN {RS="\001"; bs = sprintf("%c", 92)} {
    i = index($0, p); if (!i) exit; s = substr($0, i + length(p))
    if (key != "") { k = "\"" key "\""; j = index(s, k); if (!j) exit; s = substr(s, j + length(k)) }
    sub(/^[[:space:]]*:[[:space:]]*/, "", s); if (substr(s, 1, 1) != "\"") exit; s = substr(s, 2)
    if (!match(s, /^([^"\\]|\\.)*/)) exit
    n = split(substr(s, 1, RLENGTH), part, bs)
    printf "%s", part[1]
    for (c_i = 2; c_i <= n; c_i++) {
      t = part[c_i]
      if (t == "") { printf "%s", bs; c_i++; if (c_i <= n) printf "%s", part[c_i]; continue }
      d = substr(t, 1, 1)
      if (d == "n") printf "\n"; else if (d == "t") printf "\t"; else if (d == "r") ; else if (d == "u") printf "%s", bs "u"; else printf "%s", d
      printf "%s", substr(t, 2)
    }
  }'
}
cap_chars() {
  c=$(sed -n 's/^[-* ]*Output-Cap-Chars:[* ]*//p' .uak/PROJECT.md 2>/dev/null | head -n 1 | tr -d '\r `')
  case "$c" in off|0) printf 0;; ''|*[!0-9]*) printf 12000;; *) printf '%s' "$c";; esac
}
sum() { cksum < "$1" 2>/dev/null | awk '{print $1}'; }
# Session id: Claude Code and Codex send session_id, Cursor conversation_id (BSD sed has no \| alternation).
sid=$(printf '%s' "$input" | sed -n 's/.*"session_id"[[:space:]]*:[[:space:]]*"\([A-Za-z0-9_.-]*\)".*/\1/p' | head -n 1)
[ -n "$sid" ] || sid=$(printf '%s' "$input" | sed -n 's/.*"conversation_id"[[:space:]]*:[[:space:]]*"\([A-Za-z0-9_.-]*\)".*/\1/p' | head -n 1)
# Reminder templates (.uak/reminders.md, "key: text"); {n} {m} {id} {files} {tasks} are filled by `remind`.
tmpl() { sed -n "s/^$1: //p" .uak/reminders.md 2>/dev/null; }
# coach: event-driven reminders at the moment of decision, each capped per session (OpenDev-style). Prints one
# reminder or nothing. State per session in <git dir>/uak-coach-<sid>/. Why: see .uak/reminders.md.
coach() {
  local d tool cmd n now key t f first
  [ "${UAK_COACH:-on}" != off ] || return 0
  d="$gd/uak-coach-$(printf '%s' "${sid:-nosid}" | tr -cd 'A-Za-z0-9_.-' | cut -c 1-60)"; mkdir -p "$d" 2>/dev/null || return 0
  tool=$(printf '%s' "$input" | sed -n 's/.*"tool_name"[[:space:]]*:[[:space:]]*"\([A-Za-z_]*\)".*/\1/p' | head -n 1)
  cmd=; case "$tool" in Bash|PowerShell|Shell|run_shell_command|shell) cmd=$(jdecode tool_input command);; esac
  fired() { [ "$(cat "$d/fired.$1" 2>/dev/null || echo 0)" -ge "$2" ]; }
  fire() { echo $(( $(cat "$d/fired.$1" 2>/dev/null || echo 0) + 1 )) > "$d/fired.$1"; }
  fill() { tmpl "$1" | head -n 1 | sed "s|{n}|${2:-}|g; s|{m}|${3:-}|g; s|{id}|${4:-}|g; s|{files}|${5:-}|g; s|{tasks}|${6:-}|g"; }
  # Calls since the last checkpoint (any tool).
  n=$(( $(cat "$d/calls" 2>/dev/null || echo 0) + 1 )); echo "$n" > "$d/calls"
  case "$cmd" in *"uak checkpoint"*|*"uak handoff"*|*"/uak-handoff"*) echo 0 > "$d/calls";; esac
  case "$cmd" in *"uak map"*|*".uak/bin/map"*) touch "$d/mapused";; esac
  case "$cmd" in *"uak msg"*) case "$cmd" in *contract*|*impact:*|*related:*) touch "$d/contract";; esac;; esac
  # 1. The kit kept failing the same way: invite one black box line, once.
  case "$input" in *'LOOP: the same error'*) fired friction 1 || { fire friction; fill friction; return 0; };; esac
  # 2. Shipped: wait, do not poll (once per task).
  if [ -n "$task" ] && printf '%s' "$cmd" | grep -Eq 'uak[" ]+done ' && printf '%s' "$input" | grep -q "OK done $task"; then
    fired "done.$task" 1 || { fire "done.$task"; fill done "" "" "$task"; return 0; }
  fi
  # 3. Pushed changes that other tasks import, with no contract message in this session (once per pushed HEAD).
  if [ -n "$task" ] && printf '%s' "$cmd" | grep -Eq '(^|[;&| ])git[[:space:]]+push' && [ ! -f "$d/contract" ]; then
    local head files tasks
    head=$(git rev-parse --short HEAD 2>/dev/null)
    if [ -n "$head" ] && ! fired "contract.$head" 1; then
      files=$(git diff --name-only "origin/${UAK_BASE:-main}...HEAD" 2>/dev/null | head -n 20)
      tasks=$( [ -z "$files" ] || bash .uak/bin/map impact --tasks $files 2>/dev/null | grep -v "^$task\$" | tr '\n' ' ')
      if [ -n "$tasks" ]; then fire "contract.$head"; fill contract "" "" "$task" "$(printf '%s' "$files" | head -n 3 | tr '\n' ' ')" "${tasks% }"; return 0; fi
    fi
  fi
  # 4. Polling status/inbox: the third look in 10 min suggests `uak wait` (twice per session at most).
  if printf '%s' "$cmd" | grep -Eq 'uak[" ]+(status|inbox|board|digest|next)([" ]|$)'; then
    now=$(date +%s); echo "$now" >> "$d/polls"
    n=$(awk -v now="$now" '$1 >= now - 600' "$d/polls" | wc -l | tr -d ' ')
    if [ "$n" -ge 3 ] && ! fired poll 2; then fire poll; : > "$d/polls"; fill poll "$n" 10 "${task:+$task }"; return 0; fi
  fi
  # 5. An exploration spiral without the code map: 5 reads in a row (twice per session at most).
  first=$(printf '%s' "$cmd" | sed 's/^[[:space:]]*//' | awk '{print $1}')
  case "$tool:$first" in
    Read:*|Grep:*|Glob:*|read_file:*|read_many_files:*|grep_search:*|glob:*|list_directory:*|*:cat|*:rg|*:grep|*:find|*:head|*:tail|*:ls|*:sed|*:wc)
      n=$(( $(cat "$d/explore" 2>/dev/null || echo 0) + 1 )); echo "$n" > "$d/explore"
      if [ "$n" -ge 5 ] && [ ! -f "$d/mapused" ] && ! fired explore 2; then fire explore; echo 0 > "$d/explore"; fill explore "$n"; return 0; fi;;
    *) echo 0 > "$d/explore";;
  esac
  # 6. Long stretch on a claimed task without a checkpoint (twice per session at most).
  n=$(cat "$d/calls" 2>/dev/null || echo 0)
  if [ -n "$task" ] && [ "$n" -ge "${UAK_COACH_CHECKPOINT:-40}" ] && ! fired checkpoint 2; then fire checkpoint; echo 0 > "$d/calls"; fill checkpoint "$n" "" "$task"; return 0; fi
}
# lens: the code map at the moment of a search or a read. After Grep/Read (or grep/rg/cat/sed on a file in a shell),
# one line from the map index: where a symbol is defined and who calls it from other files, or who imports a file,
# whether it is a hub, and whether it lies outside the task's Paths. Each symbol/file once per session, at most
# UAK_LENS_MAX (25) lines. Never builds the index here: a missing index is built once in the background.
# Why (MLB hackathon, v5 week): agents called the map 9 times for 67 Claude Code tasks; a pilot study saw agents
# route 0-6% of lookups to a semantic tool when grep was there, and do better when the answer arrives as
# path:line next to the step they already take. Push the graph into the loop instead of waiting to be asked.
# The design gate right after an agent writes a UI file: its findings come back while the file is open, not at done.
# Why (Chilangatón): views built on their own colors and components were found 3 hours in; Impeccable runs its detector
# from a post-edit hook for the same reason.
uilint() {
  [ -f .uak/bin/design-lint ] || return 0
  local tool file out
  tool=$(printf '%s' "$input" | sed -n 's/.*"tool_name"[[:space:]]*:[[:space:]]*"\([A-Za-z_]*\)".*/\1/p' | head -n 1)
  case "$tool" in Edit|Write|MultiEdit|write_file|replace|edit_file|edit) ;; *) return 0;; esac
  file=$(jdecode tool_input file_path); [ -n "$file" ] || file=$(jdecode tool_input absolute_path); [ -n "$file" ] || file=$(jdecode tool_input path)
  case "$file" in *.tsx|*.jsx|*.ts|*.js|*.vue|*.svelte|*.css) ;; *) return 0;; esac
  case "$file" in [A-Za-z]:[\\/]*) file=$(winpath "$file");; esac
  out=$(bash .uak/bin/design-lint --file "$file" 2>/dev/null) && return 0
  printf '%s\n' "$out" | grep -q '^DESIGN_LINT_FAIL' || return 0
  printf 'UAK design-lint on %s: %s Fix it now with the tokens and the UI kit (skill product-ui).' "${file##*/}" \
    "$(printf '%s\n' "$out" | grep '^DESIGN_LINT [^_]' | head -n 3 | sed 's/^DESIGN_LINT [^ ]* · //' | tr '\n' ';' | sed 's/;$/./')"
}
lens() {
  [ "${UAK_LENS:-on}" != off ] || return 0
  local d tool cmd pat file name w prev wtop
  d="$gd/uak-coach-$(printf '%s' "${sid:-nosid}" | tr -cd 'A-Za-z0-9_.-' | cut -c 1-60)"; mkdir -p "$d" 2>/dev/null || return 0
  [ "$(wc -l < "$d/lens.seen" 2>/dev/null || echo 0)" -lt "${UAK_LENS_MAX:-25}" ] || return 0
  tool=$(printf '%s' "$input" | sed -n 's/.*"tool_name"[[:space:]]*:[[:space:]]*"\([A-Za-z_]*\)".*/\1/p' | head -n 1)
  pat= file=
  case "$tool" in
    Grep|grep_search|search_file_content) pat=$(jdecode tool_input pattern); [ -n "$pat" ] || pat=$(jdecode tool_input query);;
    Read|read_file) file=$(jdecode tool_input file_path); [ -n "$file" ] || file=$(jdecode tool_input absolute_path)
      [ -n "$file" ] || file=$(jdecode tool_input path); [ -n "$file" ] || file=$(jdecode tool_input target_file);;
    Bash|PowerShell|Shell|run_shell_command|shell)
      cmd=$(jdecode tool_input command | sed 's/[;&|].*//')
      set -f; set -- $cmd; set +f
      [ "${1:-}" != git ] || [ "${2:-}" != grep ] || shift
      case "${1:-}" in
        rg|grep|egrep|ag|ack)
          shift; prev=
          for w in "$@"; do
            case "$prev" in -e|--regexp) pat=$w; break;; -g|--glob|-t|--type|-A|-B|-C|-m|--max-count|-f|--file|--include|--exclude) prev=; continue;; esac
            case "$w" in -e|--regexp|-g|--glob|-t|--type|-A|-B|-C|-m|--max-count|-f|--file|--include|--exclude) prev=$w; continue;; -*) continue;; esac
            pat=$w; break
          done;;
        cat|head|tail|less|nl|bat|sed)
          for w in "$@"; do case "$w" in -*|*\'*|*\"*|[0-9]*p) ;; *) [ -f "$w" ] && { file=$w; break; };; esac; done;;
      esac;;
  esac
  pat=$(printf '%s' "$pat" | tr -d "'\"")
  if [ -n "$pat" ]; then
    name=$(printf '%s' "$pat" | sed -E 's/\\b//g; s/^\^//; s/^(def|class|function|func|fn|const|let|var|type|interface|struct)[[:space:]]+//; s/[\\(].*$//; s/[[:space:]].*$//')
    printf '%s' "$name" | grep -Eq '^[A-Za-z_][A-Za-z0-9_]{2,}$' || return 0
    key="s:$name"
  elif [ -n "$file" ]; then
    # macOS: the tool may name /var/... while git reports /private/var/...; compare physical paths.
    wtop=$top; case "$file" in [A-Za-z]:[\\/]*) file=$(winpath "$file"); wtop=$(winpath "$top");; esac
    case "$file" in "$wtop"/*) ;; /*) w=$(cd "$(dirname "$file")" 2>/dev/null && pwd -P) && file="$w/${file##*/}";; esac
    case "$file" in "$wtop"/*) file=${file#"$wtop"/};; /*|[A-Za-z]:/*) return 0;; esac
    key="f:$file"
  else return 0; fi
  ! grep -qxF -- "$key" "$d/lens.seen" 2>/dev/null || return 0
  if [ ! -s "$gd/uak-map/symbols.tsv" ]; then
    [ -f "$d/lens.building" ] || { touch "$d/lens.building"; nohup bash .uak/bin/map build > /dev/null 2>&1 & }
    return 0
  fi
  printf '%s\n' "$key" >> "$d/lens.seen"
  if [ -n "$pat" ]; then bash .uak/bin/map lens --symbol "$name" 2>/dev/null
  else bash .uak/bin/map lens --file "$file" ${task:+--task "$task"} 2>/dev/null; fi || return 0
  # Counted for the black box like a command call, so an autopsy can tell pushes from pulls.
  case "${UAK_BLACKBOX:-}" in off|0|no|false) ;; *) printf 'lens\n' >> "$(git rev-parse --git-common-dir 2>/dev/null)/uak-blackbox.calls" 2>/dev/null;; esac
}
case "${1:-}" in
  session-start)
    # Cursor's sessionStart hook takes JSON: {"additional_context": "..."}.
    if [ "${2:-}" = cursor ]; then
      out=$(printf '%s' "$input" | bash "$0" session-start 2>/dev/null)
      [ -z "$out" ] || printf '{"additional_context":"%s"}\n' "$(printf '%s' "$out" | json_text)"
      exit 0
    fi
    # Gemini CLI's SessionStart takes {"hookSpecificOutput":{"additionalContext": "..."}}.
    if [ "${2:-}" = gemini ]; then
      out=$(printf '%s' "$input" | UAK_HARNESS=gemini-cli bash "$0" session-start 2>/dev/null)
      [ -z "$out" ] || printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"}}\n' "$(printf '%s' "$out" | json_text)"
      exit 0
    fi
    # Remember the harness of this worktree for black box lines written by background jobs.
    h=$(bash .uak/bin/bb harness 2>/dev/null)
    if [ "$h" = other ] || [ -z "$h" ]; then
      case "$input" in *'"model":"gpt'*|*'"model": "gpt'*) h=codex;; *'"model":"claude'*|*'"model": "claude'*) h=claude-code;; *) h=;; esac
    fi
    [ -z "$h" ] || printf '%s\n' "$h" > "$gd/uak-harness" 2>/dev/null
    # Lines left pending by a crashed or offline session are published now, in background.
    common=$(git rev-parse --git-common-dir 2>/dev/null)
    [ -z "$common" ] || [ ! -s "$common/uak-blackbox.pending" ] || nohup bash .uak/bin/bb flush --quiet > /dev/null 2>&1 &
    # Two live sessions in one worktree overwrite each other (Reap buildathon: two Codex terminals on HACK-006).
    case "$input" in *'"source":"clear"'*|*'"source":"compact"'*|*'"source":"resume"'*|*'"source": "clear"'*|*'"source": "compact"'*|*'"source": "resume"'*) same_agent=yes;; *) same_agent=no;; esac
    if [ "$same_agent" = no ] && [ -n "$sid" ] && [ -s "$gd/uak-live" ] && fresh "$gd/uak-live" 3; then
      other=$(awk '{print $1}' "$gd/uak-live" 2>/dev/null)
      [ -z "$other" ] || [ "$other" = "$sid" ] ||
        printf '%s\n' "UAK WARNING: another agent session used this worktree less than 3 min ago. Two writers in one worktree overwrite each other: stop one of them, or start a new task with bash .uak/bin/wt new ID."
    fi
    [ -z "$sid" ] || printf '%s %s\n' "$sid" "$(date +%s)" > "$gd/uak-live" 2>/dev/null
    if [ -z "$agent" ]; then
      printf '%s\n' "UAK: checkout without .uak-env (planning/human). To implement: bash .uak/bin/uak next, then bash .uak/bin/wt new ID."
      # The human sees their queue (merges, decisions, messages) unasked.
      git config --get "remote.${UAK_REMOTE:-origin}.url" >/dev/null 2>&1 && bash .uak/bin/uak digest 2>/dev/null | head -n 25
      tmpl card
      exit 0
    fi
    # A new (or compacted) session has seen nothing: forget what earlier sessions were shown.
    rm -f "$gd"/uak-seen.* 2>/dev/null
    printf 'UAK: agent=%s task=%s worktree=%s\n' "$agent" "${task:--}" "$top"
    # Right after a compaction the summary on claims is older than what the agent just lost: write it now.
    # Why (MLB hackathon): 5 handoffs and 74 checkpoints for 130 claims; compactions went by with no summary.
    case "$input" in *'"source":"compact"'*|*'"source": "compact"'*)
      [ -z "$task" ] || printf 'UAK: the context was just compacted. Save where %s stands before going on (the next session reads it): bash .uak/bin/uak checkpoint %s --done … --decision … --why … --fails … --commands … --next …\n' "$task" "$task";;
    esac
    p=$(bash .uak/bin/pace 2>/dev/null); case "$p" in "PACE surge"*|"PACE conserve"*|"PACE critical"*) printf '%s\n' "$p";; esac
    git config --get "remote.${UAK_REMOTE:-origin}.url" >/dev/null 2>&1 || exit 0
    bash .uak/bin/uak next --full 2>&1 | head -n 18
    # The code map is rebuilt in background (0.2 s for ~120 files) so `uak map` queries answer at once.
    nohup bash .uak/bin/map build > /dev/null 2>&1 &
    # The quick card (Superpowers-style bootstrap): WHEN to use which part of the harness, at session start.
    tmpl card
    bash .uak/bin/uak inbox --peek > "$gd/uak-inbox.txt" 2>/dev/null
    if [ -s "$gd/uak-inbox.txt" ]; then
      # What was printed is what was shown: a cut list leaves the rest for the next tick (audit, Oct 2026: 15 messages,
      # 10 printed, all 15 marked seen and never injected).
      head -n 21 "$gd/uak-inbox.txt"
      shown=$(head -n 21 "$gd/uak-inbox.txt" | sed -n 's/^#\([0-9][0-9]*\) .*/\1/p' | sort -n | tail -n 1)
      more=$(sed -n '22,$p' "$gd/uak-inbox.txt" | grep -c '^#[0-9]')
      [ "$more" -eq 0 ] || printf '(+%s more: uak inbox)\n' "$more"
      [ -z "$shown" ] || printf '%s\n' "$shown" > "$gd/uak-inbox.shown-n"
    fi
    ;;
  tick)
    # Cursor's postToolUse takes {"additional_context": "..."}: the same tick, rewrapped. Why (MLB hackathon): Cursor
    # had no post-tool hook, so its heartbeats were manual and no message, reminder or map fact reached it mid-task.
    if [ "${2:-}" = cursor ]; then
      out=$(printf '%s' "$input" | bash "$0" tick 2>/dev/null)
      ctx=$(printf '%s' "$out" | sed -n 's/^{"hookSpecificOutput":{"hookEventName":"PostToolUse","additionalContext":\(".*"\)}}$/\1/p')
      [ -z "$ctx" ] || printf '{"additional_context":%s}\n' "$ctx"
      exit 0
    fi
    # Gemini's AfterTool takes the same additionalContext under its own event name.
    evname=PostToolUse; [ "${2:-}" != gemini ] || evname=AfterTool
    coach_note=$(coach 2>/dev/null)
    lens_note=$(lens 2>/dev/null)
    ui_note=$(uilint 2>/dev/null)
    [ -z "$ui_note" ] || coach_note="${ui_note}${coach_note:+
}$coach_note"
    # Upstream drift: at most every 5 min, in the background, fetch the base and ask the map whether it changed what
    # this branch edits or imports; say it once per change set. Why: STORM (arXiv 2605.20563), conflicts caught at
    # write time; at MLB they surfaced only in the merge gate.
    if [ -n "$task" ] && [ -n "$agent" ] && ! fresh "$gd/uak-drift.checked" 5; then
      touch "$gd/uak-drift.checked" 2>/dev/null
      ( git fetch -q "${UAK_REMOTE:-origin}" "${UAK_BASE:-main}" 2>/dev/null &&
          { bash .uak/bin/map drift --ref "${UAK_REMOTE:-origin}/${UAK_BASE:-main}" > "$gd/uak-drift.tmp" 2>/dev/null || : > "$gd/uak-drift.tmp"; } &&
          mv "$gd/uak-drift.tmp" "$gd/uak-drift.txt" ) > /dev/null 2>&1 &
    fi
    # GitHub feedback on this task's PR (failed checks, human comments) becomes a message to the task: the inbox
    # injection below delivers it. Every 5 min, in the background, only when gh is there.
    if [ -n "$task" ] && [ -n "$agent" ] && command -v "${UAK_GH:-gh}" >/dev/null 2>&1 && ! fresh "$gd/uak-prsync.checked" 5; then
      touch "$gd/uak-prsync.checked" 2>/dev/null
      # Every REVIEW task of this identity, not only the worktree's: an agent that moved on after done never synced
      # the PR it left in review (Hacktoberfest second autopsy: one pr-sync in 16 h, a merged PR 14 min in REVIEW).
      nohup bash -c 'bash .uak/bin/uak pr-sync "$1"
        bash .uak/bin/uak status --full 2>/dev/null | awk -F" [|] " -v a="$2" -v t="$1" "\$2==\"REVIEW\" && \$3==a && \$1!=t {print \$1}" |
        while read -r id; do bash .uak/bin/uak pr-sync "$id"; done' _ "$task" "$agent" > /dev/null 2>&1 &
    fi
    if [ -s "$gd/uak-drift.txt" ] && [ "$(sum "$gd/uak-drift.txt")" != "$(cat "$gd/uak-drift.shown" 2>/dev/null)" ]; then
      sum "$gd/uak-drift.txt" > "$gd/uak-drift.shown"
      lens_note="$(cat "$gd/uak-drift.txt")${lens_note:+
}$lens_note"
    fi
    [ -z "$lens_note" ] || coach_note="${lens_note}${coach_note:+
}$coach_note"
    if [ -z "$agent" ]; then
      [ -z "$coach_note" ] || printf '{"hookSpecificOutput":{"hookEventName":"%s","additionalContext":"%s"}}\n' "$evname" "$(printf '%s' "$coach_note" | json_text)"
      exit 0
    fi
    [ -z "$sid" ] || printf '%s %s\n' "$sid" "$(date +%s)" > "$gd/uak-live" 2>/dev/null
    # Heartbeat every lease/3 (8..20 min), and the REVIEW tasks of other worktrees at most every 30 min.
    # Why (Reap buildathon): 11 agents heartbeating every 8 min plus a status per beat kept the claims branch
    # busy; approvals then needed up to 14 attempts. A 45-min sprint lease is safe with a 15-min beat.
    hb=$(sed -n 's/^[-* ]*Lease-Seconds:[* ]*//p' .uak/PROJECT.md 2>/dev/null | head -n 1 | tr -cd '0-9')
    hb=$(( ${hb:-2700} / 180 )); [ "$hb" -ge 8 ] || hb=8; [ "$hb" -le 20 ] || hb=20
    # A task handed over (or released) from another machine is no longer this worktree's: one heartbeat says so, then
    # the beats stop and the agent hears it once. Why (Chilangatón): after a Windows → macOS handover the old
    # session kept beating PB-027 ("belongs to", "has no active claim") into the black box.
    gone=$(cat "$gd/uak-task-gone" 2>/dev/null)
    if [ -n "$task" ] && [ "$gone" = "$task" ] && [ "$(cat "$gd/uak-task-gone.told" 2>/dev/null)" != "$task" ]; then
      printf '%s' "$task" > "$gd/uak-task-gone.told" 2>/dev/null
      coach_note="UAK: $task is no longer this worktree's ($(tail -n 1 "$gd/uak-heartbeat.log" 2>/dev/null | cut -c 1-160)). Stop editing it; run uak next.${coach_note:+
}$coach_note"
    fi
    if [ -n "$task" ] && [ "$gone" != "$task" ] && ! fresh "$gd/uak-heartbeat" "$hb"; then
      touch "$gd/uak-heartbeat" 2>/dev/null
      reviews=no; fresh "$gd/uak-heartbeat.reviews" 30 || { reviews=yes; touch "$gd/uak-heartbeat.reviews" 2>/dev/null; }
      # REVIEW tasks in other worktrees need a live lease for uak merge.
      nohup bash -c 'out=$(bash .uak/bin/uak heartbeat "$1" 2>&1); printf "%s\n" "$out"
        case "$out" in *"belongs to "*|*"has no active claim"*) printf "%s" "$1" > "$4/uak-task-gone";; esac
        [ "$3" = yes ] || exit 0
        bash .uak/bin/uak status --full 2>/dev/null | awk -F" [|] " -v a="$2" -v t="$1" "\$2==\"REVIEW\" && \$3==a && \$1!=t {print \$1}" |
          while read -r id; do bash .uak/bin/uak heartbeat "$id"; done' _ "$task" "$agent" "$reviews" "$gd" > "$gd/uak-heartbeat.log" 2>&1 &
    fi
    # Poll in background, never blocking the agent: a cheap `ls-remote` of claims every 20 s, and the inbox is read
    # only when the claims tip moved (or every 5 min). Why: the old 2-min full read was the message latency; an
    # answer to a contract question took up to 2 min to reach the asker, and most reads found nothing new.
    . .uak/bin/lib/net.sh 2>/dev/null && ssh_mux
    now_s=$(date +%s); last_s=$(cat "$gd/uak-inbox.poll" 2>/dev/null); case "$last_s" in ''|*[!0-9]*) last_s=0;; esac
    if [ $((now_s - last_s)) -ge "${UAK_POLL_SECONDS:-20}" ]; then
      printf '%s' "$now_s" > "$gd/uak-inbox.poll" 2>/dev/null
      ( tip=$(git ls-remote "${UAK_REMOTE:-origin}" refs/heads/claims 2>/dev/null | awk '{print $1; exit}')
        if [ -n "$tip" ] && { [ "$tip" != "$(cat "$gd/uak-claims.tip" 2>/dev/null)" ] || ! fresh "$gd/uak-inbox.txt" 5; }; then
          bash .uak/bin/uak inbox --peek > "$gd/uak-inbox.tmp" 2>/dev/null && mv "$gd/uak-inbox.tmp" "$gd/uak-inbox.txt" &&
            printf '%s' "$tip" > "$gd/uak-claims.tip"
        fi ) > /dev/null 2>&1 &
    fi
    # Pace check every ~5 min; speak only when the level changes. Why: the agent can't see /usage.
    pace_note=
    if ! fresh "$gd/uak-pace.seen" 5; then
      touch "$gd/uak-pace.seen" 2>/dev/null
      lvl=$(bash .uak/bin/pace --caps 2>/dev/null | awk '{print $1}')
      if [ -n "$lvl" ] && [ "$lvl" != "$(cat "$gd/uak-pace.level" 2>/dev/null)" ]; then
        printf '%s' "$lvl" > "$gd/uak-pace.level"
        case "$lvl" in surge|conserve|critical) pace_note=$(bash .uak/bin/pace 2>/dev/null);; esac
      fi
    fi
    [ -z "$coach_note" ] || pace_note="${pace_note}${pace_note:+
}$coach_note"
    if [ -n "$pace_note" ] && [ ! -s "$gd/uak-inbox.txt" ]; then
      printf '{"hookSpecificOutput":{"hookEventName":"%s","additionalContext":"%s"}}\n' "$evname" "$(printf '%s' "$pace_note" | json_text)"
      exit 0
    fi
    if [ -s "$gd/uak-inbox.txt" ]; then
      # Only messages newer than the last injected one: never resend what was seen.
      last=$(cat "$gd/uak-inbox.shown-n" 2>/dev/null); case "$last" in ''|*[!0-9]*) last=0;; esac
      delta=$(awk -v last="$last" '/^#[0-9]/ {n=substr($1, 2) + 0; keep=(n > last)} /^#[0-9]/ || /^  / {if (keep) print}' "$gd/uak-inbox.txt")
      if [ -z "$delta" ]; then
        [ -z "$pace_note" ] || printf '{"hookSpecificOutput":{"hookEventName":"%s","additionalContext":"%s"}}\n' "$evname" "$(printf '%s' "$pace_note" | json_text)"
        exit 0
      fi
      # Only actionable kinds enter context in full; info/integrated become one line.
      # Why: every injected message is re-sent on every later turn (tokens).
      # At most 12 actionable messages per tick; shown-n is the last message this tick covers, so the rest come on the
      # next one. Why (audit, Oct 2026): 15 requests, 12 injected, shown-n 15, and #13-15 never reached the agent.
      upto=$(printf '%s\n' "$delta" | awk '/^#[0-9]/ {n = substr($1, 2) + 0; if ($0 ~ / · (request|contract|reject|approve|review|reply|blocker|human) · /) { a++; if (a > 12) { print last; exit } } last = n}
        END { if (a <= 12) print last }')
      case "$upto" in ''|*[!0-9]*) upto=$(printf '%s' "$delta" | sed -n 's/^#\([0-9][0-9]*\) .*/\1/p' | sort -n | tail -n 1);; esac
      left=$(printf '%s\n' "$delta" | awk -v u="$upto" '/^#[0-9]/ && substr($1, 2) + 0 > u {n++} END {print n+0}')
      delta=$(printf '%s\n' "$delta" | awk -v u="$upto" '/^#[0-9]/ {keep = (substr($1, 2) + 0 <= u)} keep {print}')
      printf '%s\n' "$upto" > "$gd/uak-inbox.shown-n"
      act=$(printf '%s\n' "$delta" | awk '/^#[0-9]/ {k=$0; keep=(k ~ / · (request|contract|reject|approve|review|reply|blocker|human) · /)} keep {print}')
      quiet=$(printf '%s\n' "$delta" | awk '/^#[0-9]/ && !/ · (request|contract|reject|approve|review|reply|blocker|human) · / {n++} END {print n+0}')
      [ -z "$pace_note" ] || act="$pace_note
$act"
      if [ -z "$act" ] && [ "$quiet" -eq 0 ]; then
        [ -z "$pace_note" ] || printf '{"hookSpecificOutput":{"hookEventName":"%s","additionalContext":"%s"}}\n' "$evname" "$(printf '%s' "$pace_note" | json_text)"
        exit 0
      fi
      [ "$quiet" -eq 0 ] || act="${act}${act:+
}(${quiet} info/integrated notice(s): read with uak inbox after the current criterion)"
      [ "$left" -eq 0 ] || act="${act}
(+${left} more: the next tool call shows them, or uak inbox)"
      printf '{"hookSpecificOutput":{"hookEventName":"%s","additionalContext":"%s"}}\n' "$evname" \
        "$(printf 'UAK new inbox (handle per AGENTS.md §5; then uak inbox --ack):\n%s' "$act" | json_text)"
    fi
    ;;
  session-end)
    # The session closed (Claude Code SessionEnd, Cursor sessionEnd, Gemini SessionEnd): `uak away` takes the identity
    # out of the reviewer rotation now and writes where its task stands. Not on /clear: the agent goes on.
    [ -n "$agent" ] || exit 0
    case "$input" in *'"reason":"clear"'*|*'"reason": "clear"'*) exit 0;; esac
    bash .uak/bin/uak away > /dev/null 2>&1 || true
    ;;
  stop)
    # Black box: publish pending lines at most every 10 min, in background (never slows the turn).
    common=$(git rev-parse --git-common-dir 2>/dev/null)
    if [ -n "$common" ] && [ -s "$common/uak-blackbox.pending" ] && ! fresh "$common/uak-blackbox.flushed" 10; then
      touch "$common/uak-blackbox.flushed" 2>/dev/null
      nohup bash .uak/bin/bb flush --quiet > /dev/null 2>&1 &
    fi
    # Token spend of this machine (Claude Code and Codex transcripts) to claims:tokens/, at most every 30 min.
    if [ -n "$common" ] && ! fresh "$common/uak-tokens.published" 30; then
      touch "$common/uak-tokens.published" 2>/dev/null
      nohup bash .uak/bin/tokens --publish --quiet > /dev/null 2>&1 &
    fi
    [ -n "$agent" ] || exit 0
    case "$input" in *'"stop_hook_active":true'*|*'"stop_hook_active": true'*) exit 0;; esac
    bash .uak/bin/uak inbox --peek > "$gd/uak-inbox.tmp" 2>/dev/null && mv "$gd/uak-inbox.tmp" "$gd/uak-inbox.txt"
    [ -s "$gd/uak-inbox.txt" ] || exit 0
    # The batch is its message numbers, not the text: "#3 · 5m ago" changes every minute and blocked again each time
    # (audit, Oct 2026).
    now_sum=$(sed -n 's/^#\([0-9][0-9]*\) .*/\1/p' "$gd/uak-inbox.txt" | tr '\n' ' ')
    [ "$now_sum" != "$(cat "$gd/uak-inbox.stopped" 2>/dev/null)" ] || exit 0
    printf '%s' "$now_sum" > "$gd/uak-inbox.stopped"
    sed -n 's/^#\([0-9][0-9]*\) .*/\1/p' "$gd/uak-inbox.txt" | sort -n | tail -n 1 > "$gd/uak-inbox.shown-n"
    printf '{"decision":"block","reason":"%s"}\n' \
      "$(printf 'Unhandled messages: handle them (AGENTS.md §5), reply with uak msg and run uak inbox --ack before stopping.\n%s' "$(grep -E '^#[0-9]|^  ' "$gd/uak-inbox.txt" | head -n 20)" | json_text)"
    ;;
  output)
    # Huge shell output never reaches the model whole: head 30 + tail 50 + the path of the full log.
    # Why: one test run or `git log -p` can add 30k+ tokens that are re-sent on every later turn; a teammate on
    # Cursor put it as "tool calling hogs the whole context". Cap: Output-Cap-Chars (default 12000, off).
    #   output         Claude Code PostToolUse(Bash): updatedToolOutput replaces what the model sees.
    #   output codex   legacy (v4.2 installs): Codex PostToolUse "block" replaces the result; v4.3 uses `wrap codex`.
    #                  (the command already ran; no permission or sandbox decision is involved).
    # Cursor cannot replace a shell result after it runs: see `wrap` (preToolUse).
    harness=${2:-claude}
    cap=$(cap_chars); [ "$cap" -gt 0 ] || exit 0
    [ "${#input}" -gt "$cap" ] || exit 0
    case "$input" in *'"tool_name":"Bash"'*|*'"tool_name": "Bash"'*|*'"tool_name":"PowerShell"'*|*'"tool_name": "PowerShell"'*) ;; *) exit 0;; esac
    case "$(jdecode tool_input command)" in *UAK_RAW=1*) exit 0;; esac
    out_dir="$gd/uak-out"; mkdir -p "$out_dir" 2>/dev/null || exit 0
    id="$(date +%s)-$$"; log="$out_dir/$id.log"
    if [ "$harness" = codex ]; then
      # tool_response is the model-facing output: a string, or an object with stdout/output.
      jdecode tool_response > "$log" 2>/dev/null
      [ -s "$log" ] || jdecode tool_response stdout > "$log" 2>/dev/null
      [ -s "$log" ] || jdecode tool_response output > "$log" 2>/dev/null
    else
      jdecode tool_response stdout > "$log" 2>/dev/null
      jdecode tool_response stderr > "$log.err" 2>/dev/null
    fi
    size=$(wc -c < "$log" | tr -d ' ')
    esize=$(wc -c < "$log.err" 2>/dev/null | tr -d ' '); esize=${esize:-0}
    # stdout and stderr together: 150 KB of compiler warnings on stderr reached the model whole (audit, Oct 2026).
    [ $((size + esize)) -gt "$cap" ] && { [ "$size" -gt "$cap" ] || [ "$esize" -gt 4000 ]; } || { rm -f "$log" "$log.err"; exit 0; }
    if [ "$size" -gt "$cap" ]; then short=$(bash .uak/bin/cap --shape "$log"); else short=$(cat "$log"); fi
    ls -t "$out_dir"/*.log 2>/dev/null | tail -n +21 | while IFS= read -r old; do rm -f "$old"; done
    if [ "$harness" = codex ]; then
      printf '{"decision":"block","reason":"%s"}\n' \
        "$(printf '[uak output cap: the command ran normally; this is its output, shortened]\n%s' "$short" | json_text)"
      exit 0
    fi
    if [ "$esize" -gt 4000 ]; then
      elog="$out_dir/$id.stderr.log"; mv "$log.err" "$elog"
      err=$(bash .uak/bin/cap --shape "$elog")
    else err=$(cat "$log.err" 2>/dev/null); rm -f "$log.err"; fi
    [ "$size" -gt "$cap" ] || rm -f "$log"
    intr=false; case "$input" in *'"interrupted":true'*|*'"interrupted": true'*) intr=true;; esac
    printf '{"hookSpecificOutput":{"hookEventName":"PostToolUse","updatedToolOutput":{"stdout":"%s","stderr":"%s","interrupted":%s,"isImage":false}}}\n' \
      "$(printf '%s' "$short" | json_text)" "$(printf '%s' "$err" | json_text)" "$intr"
    ;;
  wrap)
    # preToolUse rewrite of a NOISY, LOW-RISK command so its output goes to a log and `cap` prints it whole when
    # small, or cut when huge (a diff becomes a per-file index). Only tests, builds, linters, type checks and
    # read-only git/search commands, after the guard allows them ("allow" is the only way to pass a rewrite).
    #   wrap         Cursor (Shell). bash/zsh: the command runs in a { } group of the same shell, so cd/export
    #                persist. Windows: the agent shell is PowerShell, so the command goes base64 to `cap --b64`,
    #                which runs it in bash (only commands both shells read the same: no $, \, backticks, cd).
    #   wrap codex   Codex PreToolUse(Bash): permissionDecision allow + updatedInput.command, always base64.
    #   wrap gemini  Gemini CLI BeforeTool(run_shell_command): hookSpecificOutput.tool_input.command, base64.
    #   On Windows every harness runs PowerShell, so only commands both shells read alike are wrapped.
    # Why (MLB hackathon): the Windows skip meant the 4 Windows laptops never got a cap in Cursor; Codex's
    # PostToolUse "block" cut documentation reads and "interrupted the tool batch".
    harness=${2:-cursor}
    cap=$(cap_chars); [ "$cap" -gt 0 ] || exit 0
    # Codex: hooks.json matches Bash; the payload must carry tool_input.command (a string).
    case "$harness:$input" in cursor:*'"tool_name":"Shell"'*|cursor:*'"tool_name": "Shell"'*|codex:*|gemini:*'"tool_name":"run_shell_command"'*|gemini:*'"tool_name": "run_shell_command"'*) ;; *) exit 0;; esac
    case "${SHELL:-}" in *fish) [ "$harness" = codex ] || exit 0;; esac
    windows=no; case "$(uname -s 2>/dev/null)" in MINGW*|MSYS*|CYGWIN*) windows=yes;; esac
    [ "${UAK_TEST_WINDOWS:-}" != 1 ] || windows=yes
    cmd=$(jdecode tool_input command); [ -n "$cmd" ] || exit 0
    wd=$(jdecode tool_input working_directory)
    case "$cmd" in *UAK_RAW=1*|*.uak/bin/q*|*.uak/bin/cap*) exit 0;; esac
    printf '%s\n' "$cmd" | grep -Eq '(^|[^&>])&([^&>]|$)|(^|[;&|[:space:]])(exit|exec|read|vim|vi|nano|less|more|top|htop|watch|ssh)([[:space:]]|$)|tail[[:space:]]+-[a-zA-Z]*f|--watch|--follow|(npm|pnpm|yarn|bun)[[:space:]]+(run[[:space:]]+)?(dev|start|serve)|uvicorn|gunicorn|flask[[:space:]]+run|http\.server|nodemon|next[[:space:]]+(dev|start)|docker(-|[[:space:]])compose[[:space:]]+up|rails[[:space:]]+s|streamlit[[:space:]]+run' && exit 0
    printf '%s\n' "$cmd" | grep -Eq '(^|[;&|([:space:]])(pytest|py\.test|tox|nox|jest|vitest|mocha|tsc|eslint|ruff|mypy|pyright|flake8|pylint|rg|tree|du|make)([[:space:]]|$)|python3?[[:space:]]+-m[[:space:]]+(pytest|unittest)|playwright[[:space:]]+test|cypress[[:space:]]+run|go[[:space:]]+(test|build|vet)|cargo[[:space:]]+(test|build|check|clippy)|(mvn|gradle|gradlew)[[:space:]]|(npm|pnpm|yarn|bun)[[:space:]]+(run[[:space:]]+)?(test|build|lint|typecheck|check|format:check)|(uv|poetry)[[:space:]]+run[[:space:]]+(pytest|python|mypy|ruff)|git[[:space:]]+(log|diff|show|blame|status)|grep[[:space:]]+-[a-zA-Z]*r|find[[:space:]]|ls[[:space:]]+-[a-zA-Z]*R|\.uak/bin/(smoke|uak[[:space:]]+(status|board|digest|stats|graph))' || exit 0
    # The guard decides first; a blocked command is left untouched so the deny hook blocks it.
    bash .uak/bin/guard check "$cmd" >/dev/null 2>&1 || exit 0
    # The wrapper answers "allow" (the harness needs it to take the new command), so EVERY segment must be a noisy
    # read/test/build command; anything else keeps the harness's own approval. Why (audit, Oct 2026): one keyword
    # anywhere wrapped and auto-approved `git status; touch X` and `gh api -X DELETE …; git status`.
    # A redirection to a file writes; 2>&1 and >/dev/null do not.
    case "$(printf '%s' "$cmd" | sed 's@[0-9]*>&[0-9]@@g; s@[0-9]*>[[:space:]]*/dev/null@@g')" in *'>'*) exit 0;; esac
    printf '%s\n' "$cmd" | awk '{ gsub(/&&|\|\||;|\|/, "\n"); print }' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//' | grep -v '^$' |
      grep -Evq '^((cd|pushd)[[:space:]]+[^[:space:]]+|export[[:space:]]+[A-Za-z_][A-Za-z0-9_]*=[^[:space:]]*|(pytest|py\.test|tox|nox|jest|vitest|mocha|tsc|eslint|ruff|mypy|pyright|flake8|pylint|rg|tree|du|make|grep|find|ls|head|tail|wc|sort|uniq|cat|seq|true|false|echo|printf|pwd|date)([[:space:]]|$)|python3?[[:space:]]+-m[[:space:]]+(pytest|unittest)|npx[[:space:]]+(playwright|cypress|jest|vitest|tsc|eslint)([[:space:]]|$)|playwright[[:space:]]+test|cypress[[:space:]]+run|go[[:space:]]+(test|build|vet)|cargo[[:space:]]+(test|build|check|clippy)|(mvn|gradle|\./gradlew|gradlew)([[:space:]]|$)|(npm|pnpm|yarn|bun)[[:space:]]+(run[[:space:]]+)?(test|build|lint|typecheck|check|format:check)([[:space:]]|$)|(uv|poetry)[[:space:]]+run[[:space:]]+(pytest|mypy|ruff)([[:space:]]|$)|git[[:space:]]+(log|diff|show|blame|status)([[:space:]]|$)|bash[[:space:]]+\.uak/bin/(smoke|uak[[:space:]]+(status|board|digest|stats|graph))([[:space:]]|$))' && exit 0
    capbin="$(pwd -P)/.uak/bin/cap"
    if [ "$harness" != cursor ] || [ "$windows" = yes ]; then
      if [ "$windows" = yes ]; then
        # PowerShell and bash must read it the same way.
        case "$cmd" in *'$'*|*'\'*|*'`'*|*'%'*) exit 0;; esac
        printf '%s\n' "$cmd" | grep -Eq '(^|[;&|[:space:]])(cd|pushd|export|set|source)([[:space:]]|$)|(^|[;&|])[[:space:]]*\.[[:space:]]|[A-Z][a-z]+-[A-Z][a-z]+' && exit 0
        capbin=$(cygpath -m "$capbin" 2>/dev/null || printf '%s' "$capbin")
      fi
      case "$capbin" in *"'"*) exit 0;; esac
      b64=$(printf '%s' "$cmd" | base64 | tr -d '\n\r')
      wrapped="bash '$capbin' --b64 $b64"
    else
      out_dir="$(cd "$gd" && pwd -P)/uak-out"; mkdir -p "$out_dir" 2>/dev/null || exit 0
      log="$out_dir/$(date +%s)-$$.log"
      case "$log$capbin" in *"'"*) exit 0;; esac
      wrapped="{ $cmd
} > '$log' 2>&1; __uak_rc=\$?; bash '$capbin' '$log' \"\$__uak_rc\"; (exit \$__uak_rc)"
    fi
    if [ "$harness" = codex ]; then
      printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"allow","updatedInput":{"command":"%s"}}}\n' "$(printf '%s' "$wrapped" | json_cmd)"
      exit 0
    fi
    # Gemini CLI BeforeTool: hookSpecificOutput.tool_input merges over the model's arguments.
    if [ "$harness" = gemini ]; then
      printf '{"decision":"allow","hookSpecificOutput":{"hookEventName":"BeforeTool","tool_input":{"command":"%s"}}}\n' "$(printf '%s' "$wrapped" | json_cmd)"
      exit 0
    fi
    extra=; [ -z "$wd" ] || extra=",\"working_directory\":\"$(printf '%s' "$wd" | json_cmd)\""
    printf '{"permission":"allow","updated_input":{"command":"%s"%s}}\n' "$(printf '%s' "$wrapped" | json_cmd)" "$extra"
    ;;
  heartbeat) exec bash "$0" tick;;
esac
exit 0
