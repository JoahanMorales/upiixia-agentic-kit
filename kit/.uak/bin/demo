#!/usr/bin/env bash
# uak demo: a real 3-agent run in a temp repo with a local bare remote. No setup, no network, no AI keys.
#   demo [--keep] [--fast]
# Shows: graph waves → parallel claims → an overlapping claim rejected → a bounded fix loop →
# PR + review by another agent → gated merge → a dependent task unlocked → board + stats.
set -u
LC_ALL=C; export LC_ALL
keep=no pause=1
for a in "$@"; do case "$a" in --keep) keep=yes;; --fast) pause=0;; *) printf 'Usage: demo [--keep] [--fast]\n' >&2; exit 2;; esac; done
kit=$(cd "$(dirname "$0")/../.." && pwd)
D=$(mktemp -d "${TMPDIR:-/tmp}/uak-demo.XXXXXX") || exit 2
[ "$keep" = yes ] || trap 'rm -rf "$D"' EXIT
if [ -t 1 ]; then B=$(printf '\033[1m'); C=$(printf '\033[36m'); G=$(printf '\033[32m'); Y=$(printf '\033[33m'); R=$(printf '\033[0m'); else B= C= G= Y= R=; fi
step() { printf '\n%s▶ %s%s\n' "$B$C" "$*" "$R"; [ "$pause" -eq 0 ] || sleep "$pause"; }
say() { printf '  %s\n' "$*"; }
run() { # run DIR AGENT CMD... : show the command, print only its key lines
  dir=$1 who=$2; shift 2
  printf '  %s%s$%s %s\n' "$Y" "$who" "$R" "$*"
  (cd "$dir" && UAK_AGENT=$who UAK_HUMAN=demo "$@") > "$D/out" 2>&1; rc=$?
  grep -E '^(OK|WT_READY|CONFLICT|GRAPH|wave|LOOP_|HACK-[0-9]+ \||Next:|Idle|No eligible|UAK BOARD|CLAIMED|REVIEW|AVAILABLE|INTEGRATED|messages|reviews|UAK STATS|tasks:|MERGE|ERROR)' "$D/out" | head -n 8 | sed 's/^/    /'
  return $rc
}
git_q() { git -c user.name=Demo -c user.email=demo@example.invalid "$@"; }

step "A team repo with a backlog of 4 tasks (temp dir: $D)"
git init -q --bare "$D/remote.git"; git init -q -b main "$D/team"; T="$D/team"
mkdir -p "$T/src" "$T/tests" "$T/.github"
cp -R "$kit/.uak" "$T/.uak"; rm -rf "$T/.uak/tests" "$T/.uak/skills" "$T/.uak/stacks"
cp "$kit/AGENTS.md" "$T/"; cp -R "$kit/.githooks" "$T/"; cp "$kit/.github/pull_request_template.md" "$T/.github/"
printf '%s\n' .uak-env .claude/settings.local.json > "$T/.gitignore"
now=$(date +%s)
{ sed -n '/^```text$/,/^```$/p' "$kit/.uak/templates/PROJECT.sprint.md" | sed '1d;$d' |
  sed "s/^Backlog-Approved: no/Backlog-Approved: yes/; s/^Freeze-Epoch: 0/Freeze-Epoch: $((now + 21600))/"; } > "$T/.uak/PROJECT.md"
cat > "$T/.uak/TASKS.md" <<'EOT'
## HACK-001 · Search API
- **Priority:** P0
- **Estimate:** 30 min
- **Paths:** src/api.sh, tests/api_test.sh
- **Depends on:** None
- **Verify:** bash tests/api_test.sh

## HACK-002 · Results UI
- **Priority:** P0
- **Estimate:** 45 min
- **Paths:** src/ui.sh
- **Depends on:** None (renders the mock of HACK-001)
- **Uses contract:** HACK-001
- **Verify:** true

## HACK-003 · Ranking
- **Priority:** P0
- **Estimate:** 30 min
- **Paths:** src/rank.sh
- **Depends on:** HACK-001
- **Verify:** true

## HACK-004 · API cache
- **Priority:** P1
- **Paths:** src/api.sh
- **Depends on:** None
- **Verify:** true
EOT
printf '| Pattern | Owner task |\n|---|---|\n' > "$T/.uak/OWNERS.md"
printf '#!/usr/bin/env bash\necho "0 results for $1"\n' > "$T/src/api.sh"
printf '#!/usr/bin/env bash\nout=$(bash src/api.sh pompe)\n[ "$out" = "3 results for pompe" ] || { echo "expected 3 results, got: $out"; exit 1; }\necho "api ok"\n' > "$T/tests/api_test.sh"
(cd "$T" && git_q remote add origin "$D/remote.git" && git_q config core.hooksPath .githooks &&
  bash .uak/bin/uak init-smoke --command "bash -n src/api.sh" >/dev/null 2>&1 &&
  git_q add -A && git_q commit -qm "team: backlog" && git_q push -q -u origin main) || { printf 'demo: setup failed\n' >&2; exit 1; }
git -C "$T" config user.name Demo; git -C "$T" config user.email demo@example.invalid
run "$T" planner bash .uak/bin/uak graph

step "Three agents start at once — overlapping paths are rejected at claim time"
run "$T" ana-1 bash .uak/bin/wt new HACK-001 --agent ana-1
run "$T" bob-1 bash .uak/bin/wt new HACK-002 --agent bob-1
run "$T" cy-1 bash .uak/bin/wt new HACK-004 --agent cy-1 || say "${G}✓ cy-1 cannot take HACK-004: it overlaps ana-1's src/api.sh${R}"
run "$T" cy-1 bash .uak/bin/uak next
A="$D/team-wt/hack-001"; Bw="$D/team-wt/hack-002"
for w in "$A" "$Bw"; do git -C "$w" config user.name Demo; git -C "$w" config user.email demo@example.invalid; done
run "$T" human bash .uak/bin/board

step "ana-1 fixes the failing API with a bounded loop (fake agent: no AI key needed)"
cat > "$D/fake-agent.sh" <<'EOA'
#!/usr/bin/env bash
# Stands in for `claude -p`: reads the failure on stdin and edits the code (first a partial fix, then the real one).
grep -q 'got: 0 results' && n=2 || n=3
printf '#!/usr/bin/env bash\necho "%s results for $1"\n' "$n" > src/api.sh
EOA
run "$A" ana-1 bash .uak/bin/uak loop --verify "bash tests/api_test.sh" --agent "bash $D/fake-agent.sh" --max 5 --task HACK-001

step "ana-1 ships: push + PR + evidence → a reviewer is asked by rotation"
(cd "$A" && git_q add src/api.sh && git_q commit -qm "fix(api): count results" && git_q push -q -u origin HEAD) >/dev/null 2>&1
run "$A" ana-1 bash .uak/bin/uak done HACK-001 --pr https://github.com/example/demo/pull/1 --evidence "bash tests/api_test.sh exit 0"
sha=$(git -C "$A" rev-parse HEAD)

step "bob-1 (not the author) reviews the exact SHA, then the gated merge queue integrates it"
run "$Bw" bob-1 bash .uak/bin/uak review HACK-001 --sha "$sha" --verdict approve
run "$A" ana-1 bash .uak/bin/uak merge HACK-001

step "The dependent task unlocks by itself"
run "$T" cy-1 bash .uak/bin/uak next
run "$T" cy-1 bash .uak/bin/wt new HACK-003 --agent cy-1

step "What the human sees: one board, one set of numbers"
run "$T" human bash .uak/bin/board
run "$T" human bash .uak/bin/stats
printf '\n%s✓ Done: 3 agents, 1 conflict avoided, 1 bounded loop, 1 independent review, 1 gated merge.%s\n' "$G" "$R"
[ "$keep" = no ] || printf '  Explore it: cd %s\n' "$T"
printf '  Use it for real: bash install.sh --mode sprint <your-repo>\n'
