#!/usr/bin/env bash
# uak guards for agent hooks: Claude Code, Codex, Cursor and Gemini CLI (also callable by hand). Bash 3.2+, no jq.
#   guard bash     (PreToolUse/BeforeTool on the shell tool): blocks destructive or publishing commands
#                  even when chained (`cd x && git push --force`).
#   guard shell    (Cursor beforeShellExecution): the same rule on a top-level "command".
#   guard agent / agent-stop   subagent parallel cap + strong-model budget, scaled by `uak pace`.
#   guard prompt   (UserPromptSubmit): blocks human messages that contain secrets.
#   guard check "COMANDO"   manual test of the bash rule (exit 2 = blocked).
# Why: at Hack-Nation 2026 the settings.json deny list (prefix match) missed a chained force-push
# and `worktree remove --force`, and a human pasted an API key and a sudo password into the chat.
# Exit: 0 = allowed; 2 = blocked (Claude Code shows stderr to the agent or human).
set -u
LC_ALL=C; export LC_ALL
MSYS2_ARG_CONV_EXCL="refs/;origin/;HEAD;FETCH_HEAD;:"; export MSYS2_ARG_CONV_EXCL

# The first "Mode:" line of PROJECT.md, read with builtins (as sed | head | tr did).
mode_var() { # sets m: sprint or marathon
  m=sprint
  top=$(git rev-parse --show-toplevel 2>/dev/null) || return 0
  uak_cfg_var "$top/.uak/PROJECT.md" Mode
  # Trimmed by the reader, case-insensitive here: "Mode: Marathon" was not marathon for the guard (review of UAK-111).
  case "$CFG" in [Mm][Aa][Rr][Aa][Tt][Hh][Oo][Nn]) m=marathon;; esac
}
mode() { mode_var; printf '%s' "$m"; }

# The reasons for a push to the base or the claims branch, said by the text filter and by the pre-push hook alike.
push_base_msg() { printf 'a push to %s skips the merge gate. Push your feat/ branch; bash .uak/bin/uak merge ID lands it on %s.' "$1" "$1"; }
push_claims_msg() { printf 'the claims branch is written only by uak commands (claim, done, release…), never by a push of yours.'; }

# No dirname and no subshell: guard never changes directory, so the relative path works. Why (Windows): a process
# costs 20-50 ms in Git Bash, and guard runs before every command of the agent.
case $0 in */*|*\\*) here=${0%[/\\]*};; *) here=.;; esac   # a Windows caller may pass D:\a\…\guard
# The one PROJECT.md reader (builtins, no process).
. "$here/lib/config.sh" 2>/dev/null || . "$(dirname "$0")/lib/config.sh"
# Every block also goes to the black box: a rule that fires often is friction worth fixing.
SUBQ=
block() {
  [ -z "$SUBQ" ] || set -- "$* (If the text is inside double quotes: backticks and \$( ) inside double quotes run as a command; use single quotes or a heredoc with a quoted delimiter for the message.)"
  printf 'UAK_GUARD: blocked · %s\n' "$*" >&2; bash "$here/bb" auto guard guard "$*" >/dev/null 2>&1 || true; exit 2; }

# Split into segments on ; && || | and newlines (including JSON-escaped \n). `<` becomes a space: `cat<.env` is a read.
# Parameter expansion, not awk: no process. A doubled delimiter (|| or a lone & next to &&) only adds an empty
# segment, which no rule matches.
# The patterns are variables: bash 3.2 misparses ( ) < > & inside ${…}.
# ${s//…} with many matches costs matches × length on bash 3.2 (macOS): 0.6 s at 1.8 KB, 437 s at 18 KB (a 300-line
# heredoc outlasted the 5 s hook timeout). There tr always does it (a process is cheap on macOS); on bash 4+ only
# past 1 KB (a process costs 20-50 ms on Git Bash).
SHORT=1024; [ "${BASH_VERSINFO[0]}" -ge 4 ] || SHORT=0
SHORT=${UAK_TEST_SHORT:-$SHORT}   # the tests run the long paths on short input
NL=$'\n' P_LT='<' P_AND='&&' P_SEP='[;|]' P_RULE='[;|&()`<>]'
segments() { # sets SEGS
  local s=$1 bs='\'
  if [ "${#s}" -gt "$SHORT" ]; then   # the awk of v5.9.1: a heredoc of HTML has thousands of <
    SEGS=$(printf '%s\n' "$s" | awk '{ gsub(/</, " "); gsub(/\\n|&&|\|\||;|\|/, "\n"); print }'); return 0
  fi
  s=${s//$P_LT/ }; s=${s//"$bs"n/$NL}; s=${s//$P_AND/$NL}; s=${s//$P_SEP/$NL}   # kit-lint: ok (at most SHORT chars: longer went to awk)
  SEGS=$s
}
# Rule segments also split on ( ) & > and backticks: `(cd x && git push -f)`, `git push --force&`, `…>/dev/null`.
rule_segments() { # sets SEGS
  local s=$1 bs='\'
  if [ "${#s}" -gt "$SHORT" ]; then
    SEGS=$(printf '%s\n' "$s" | awk '{ gsub(/\\n|&&|\|\||;|\||&|\(|\)|`|<|>/, "\n"); print }'); return 0
  fi
  s=${s//"$bs"n/$NL}; s=${s//$P_RULE/$NL}   # kit-lint: ok (at most SHORT chars: longer went to awk)
  SEGS=$s
}
# A backtick is a substitution: it becomes " $( " so the rule split still cuts there and the segment keeps a $ the
# dynamic-ref check sees (the split removes backticks). Builtins only for short input.
bt_marks() { # sets rs
  rs=$1
  case "$rs" in *'`'*) ;; *) return 0;; esac
  if [ "${#rs}" -gt "$SHORT" ]; then
    rs=$(printf '%s' "$rs" | awk '{ o = ""; while ((i = index($0, "`")) > 0) { o = o substr($0, 1, i - 1) (k++ % 2 ? " ) " : " $( "); $0 = substr($0, i + 1) } print o $0 }'); return 0
  fi
  local o= open=1   # the opening backtick becomes " $( ", the closing one " ) "
  while case "$rs" in *'`'*) true;; *) false;; esac; do
    o=$o${rs%%'`'*}; rs=${rs#*'`'}
    if [ "$open" = 1 ]; then o="$o \$( "; open=0; else o="$o ) "; open=1; fi
  done
  rs=$o$rs
}
# The command as the rules read it. JSON escapes the hook payload keeps: a backslash-newline continuation (\\ + \n)
# and \t are spaces. Why (audit, Oct 2026): `git push \<newline> --force` and `git push<TAB>--force` passed.
norm_cmd() { # sets cmd
  local c=$1 bs='\'
  if [ "${#c}" -gt "$SHORT" ]; then   # a Makefile or Go heredoc has a tab on every line
    cmd=$(printf '%s' "$c" | awk 'BEGIN { RS = "\001"; ORS = "" } { gsub(/\\\\n/, " "); gsub(/\\\n/, " "); gsub(/\\t/, " "); gsub(/\t/, " "); print }')
    return 0
  fi
  c=${c//"$bs$bs"n/ }; c=${c//"$bs"$'\n'/ }; c=${c//"$bs"t/ }; c=${c//$'\t'/ }
  cmd=$c
}

# The command runs text as code (sh -c, bash -x -c, $SHELL -c, eval, ssh, xargs, a here-string, a pipe into a
# shell): its quoted text is code, not prose. Why (audit): `bash -x -c "cat .env …"`, `bash <<< "…"` and
# `echo "…" | bash` passed, because their quotes were read as a message.
runs_code() {
  # Each branch of the pattern needs one of these words: most commands have none, and grep is a process.
  case "$1" in *sh*|*SH*|*eval*|*xargs*|*'<<<'*) ;; *) return 1;; esac
  grep -Eq '(^|[[:space:]/])((ba|z|da)?sh|\$\{?(SHELL|BASH|shell|bash)\}?)([[:space:]]+-[A-Za-z]+)*[[:space:]]+-[A-Za-z]*c([[:space:]]|$)|(^|[[:space:]])(eval|ssh|xargs)([[:space:]]|$)|<<<|\|[[:space:]]*(sudo[[:space:]]+)?([^[:space:]]*/)?((ba|z|da)?sh|\$\{?(SHELL|BASH)\}?)([[:space:]]|$)' <<< "$1"
}
# The setup wizard performs a human's acts (register a reviewer, approve the plan, publish the kit), so an agent
# neither starts it nor drives a running one, in any mode. Why (audit, 2026-11-22): an agent started it, read the token
# from its output, named any human and pushed to main; the wizard strips UAK_*, so no hook saw an agent. The rule reads
# what the command MENTIONS, not which client it uses (curl is one of many): variables assigned in the same command
# are expanded, quotes, backslashes, %xx, `//` and `/./` are normalised, glob forms of setup.py are matched, and a
# wizard endpoint or the token header counts when a loopback host (any spelling) or a client program is in the same
# command. HONEST LIMIT: a text filter does not see inside a script file or a variable set elsewhere, so the wizard also
# refuses to start with an agent identity or without a terminal, and logs every act (SECURITY.md lists what is left).
# A running wizard writes "PID PORT" to uak-wizard.port in the project's git directory and removes it when it ends. The
# endpoint rule fires only when one is live for this project (a project's own /api/session on localhost is its own
# business); the token header and the start rules fire always.
wizard_live() { # sets WZ_LIVE (1 or empty), WZ_PORT and WZ_INGIT (1 when the shell stands inside the git directory)
  local f pid port
  WZ_LIVE= WZ_PORT= WZ_INGIT=$WZ_CWDGIT
  f=$WZ_PF; [ -n "$f" ] || return 0   # wizard_port_file found it with builtins, no git process
  pid= port=; read -r pid port < "$f" 2>/dev/null || true
  port=${port//$'\r'/}   # a file written on Windows ends its line with CR LF
  case "$pid$port" in ''|*[!0-9]*) return 0;; esac
  [ -n "$pid" ] && [ -n "$port" ] || return 0
  # A dead PID is no wizard. Git Bash on Windows cannot signal a Windows PID: the file stands (it names a dead port at worst).
  if ! kill -0 "$pid" 2>/dev/null; then
    case "$(uname -s 2>/dev/null)" in MINGW*|MSYS*|CYGWIN*) ;; *) return 0;; esac
  fi
  WZ_LIVE=1 WZ_PORT=$port
  return 0
}
# Where is the uak-wizard.port of the project of the working directory? Builtins only (no git, no process): sets WZ_PF
# (the file, or empty) and WZ_CWDGIT (1 when the working directory is inside the git directory that holds it). A
# linked worktree reads its .git file and commondir; GIT_DIR is honoured. With no port file a command costs what it cost
# before the file rules existed, and with one a command that has nothing to do with the wizard costs nothing more.
wizard_port_file() {
  local d=$PWD g c
  WZ_PF= WZ_CWDGIT=
  if [ -n "${GIT_DIR:-}" ] && [ -r "$GIT_DIR/uak-wizard.port" ]; then WZ_PF=$GIT_DIR/uak-wizard.port; return 0; fi
  while [ -n "$d" ]; do
    if [ -r "$d/uak-wizard.port" ]; then WZ_PF=$d/uak-wizard.port WZ_CWDGIT=1; return 0; fi
    if [ -d "$d/.git" ]; then [ ! -r "$d/.git/uak-wizard.port" ] || WZ_PF=$d/.git/uak-wizard.port; return 0; fi
    if [ -f "$d/.git" ]; then
      g= c=; read -r g < "$d/.git" 2>/dev/null || true
      g=${g#gitdir: }; g=${g//$'\r'/}
      read -r c < "$g/commondir" 2>/dev/null || true
      case "$c" in '') c=$g;; /*|[A-Za-z]:*) ;; *) c="$g/$c";; esac
      [ ! -r "$c/uak-wizard.port" ] || WZ_PF=$c/uak-wizard.port
      return 0
    fi
    case "$d" in */*) ;; *) return 0;; esac
    [ "$d" != / ] || return 0
    d=${d%/*}; [ -n "$d" ] || d=/
  done
  return 0
}
wizard_mentioned() { # $1 the command (heredocs dropped), $2 the same with quoted prose removed → WZ reason or empty
  local flat1 flat2
  wizard_live
  local nl=$'\n'
  flat1=${1//"$nl"/;}; flat2=${2//"$nl"/;}
  # ENVIRON, not -v: awk would read \a or \x75 in a -v value as an escape (cat .git/uak-wiz\ard.key passed)
  WZ=$(WZ_NL=$1 WZ_RAW=$flat1 WZ_PRO=$flat2 awk -v live="${WZ_LIVE:-0}" -v wport="${WZ_PORT:-0}" -v ingit="${WZ_INGIT:-0}" '
    function clean(s) { gsub(/[\\\047"`]/, "", s); return s }
    function collect(s,    t, name, val, m) {
      t = s
      while (match(t, /(^|[ \t;&|(])(export +|declare +|local +|readonly +)?[a-z_][a-z0-9_]*=[^ \t;&|)]*/)) {
        m = substr(t, RSTART, RLENGTH); t = substr(t, RSTART + RLENGTH)
        sub(/^[ \t;&|(]+/, "", m); sub(/^(export|declare|local|readonly) +/, "", m)
        name = substr(m, 1, index(m, "=") - 1); val = substr(m, index(m, "=") + 1); V[name] = val
      }
    }
    function expand(s,    n, name, ref, r) {
      for (n = 0; n < 40 && match(s, /\$(\{[a-z_][a-z0-9_]*\}|[a-z_][a-z0-9_]*)/); n++) {
        ref = substr(s, RSTART, RLENGTH); name = ref; gsub(/[${}]/, "", name)
        s = substr(s, 1, RSTART - 1) ((name in V) ? V[name] : (name ~ /^git_(common_)?dir$/ ? ".git" : "")) substr(s, RSTART + RLENGTH)
      }
      return s
    }
    function unpercent(s,    h, c, o) {
      h = "0123456789abcdef"
      while (match(s, /%[0-9a-f][0-9a-f]/)) {
        c = (index(h, substr(s, RSTART + 1, 1)) - 1) * 16 + index(h, substr(s, RSTART + 2, 1)) - 1
        o = (c >= 32 && c < 127) ? sprintf("%c", c) : " "
        s = substr(s, 1, RSTART - 1) o substr(s, RSTART + RLENGTH)
      }
      return s
    }
    function squash(s,    n) {
      for (n = 0; n < 40 && match(s, /[^:\/]\/\/+/); n++) s = substr(s, 1, RSTART) "/" substr(s, RSTART + RLENGTH)
      for (n = 0; n < 40 && index(s, "/./"); n++) { i = index(s, "/./"); s = substr(s, 1, i) substr(s, i + 3) }
      return s
    }
    # \xHH and \ooo (the text of a dollar-quoted string), then the git directory by its own command: $(git rev-parse --git-dir) is .git
    function unesc(s,    h, c, o) {
      h = "0123456789abcdef"
      while (match(s, /\\x[0-9a-f][0-9a-f]/)) {
        c = (index(h, substr(s, RSTART + 2, 1)) - 1) * 16 + index(h, substr(s, RSTART + 3, 1)) - 1
        o = (c >= 32 && c < 127) ? sprintf("%c", c) : " "
        s = substr(s, 1, RSTART - 1) o substr(s, RSTART + RLENGTH)
      }
      gsub(/\$\047/, "\047", s)
      # a Windows path: a backslash that opens .git or a record file, or follows .git, is a separator (the others are escapes)
      gsub(/\\\.git/, "/.git", s); gsub(/\.git\\/, ".git/", s); gsub(/\\uak-/, "/uak-", s)
      return s
    }
    function gitsub(s,    b, nme) {
      while (match(s, /(\$\(|`)git +rev-parse[^)`]*(git-dir|git-common-dir|git-path)[^)`]*(\)|`)/)) {
        b = substr(s, RSTART, RLENGTH); nme = ".git"
        if (match(b, /--git-path +[^ )`]+/)) { nme = substr(b, RSTART, RLENGTH); sub(/--git-path +/, "", nme); nme = ".git/" nme }
        s = substr(s, 1, index(s, b) - 1) nme substr(s, index(s, b) + length(b))
      }
      return s
    }
    function norm(s) { s = tolower(s); s = clean(gitsub(unesc(s))); collect(s); s = expand(s); return squash(unpercent(s)) }
    function globre(g,    out, i, c, inb) {
      out = ""; inb = 0
      for (i = 1; i <= length(g); i++) {
        c = substr(g, i, 1)
        if (inb) { out = out c; if (c == "]") inb = 0 }
        else if (c == "[") { out = out c; inb = 1 }
        else if (c == "*") out = out ".*"
        else if (c == "?") out = out "."
        else if (c ~ /[.+(){}|^$\\]/) out = out "\\" c
        else out = out c
      }
      return "^" out "$"
    }
    function literal(g,    x) { x = g; gsub(/[*?\[\]]/, "", x); return length(x) }
    function isshell(w) { return w ~ /^(python[0-9.]*|py|pypy[0-9]*|env|nohup|exec|sudo|time|command|setsid|timeout|nice|stdbuf|xargs|run)$/ }
    function isinterp(w) { return w ~ /^(python[0-9.]*|py|pypy[0-9]*)$/ }
    function runs_setup(n,    k, i, b, p, w, cnt, at, tok, dir, hasdir, prev, j) {
      gsub(/[;&|()]/, " ; ", n); cnt = split(n, tok, /[ \t]+/)
      for (i = 1; i <= cnt; i++) {
        w = tok[i]; if (w == "") continue
        hasdir = index(w, "/") > 0; b = w; sub(/.*\//, "", b)
        if (b != "setup.py" && !(b ~ /[*?\[]/ && literal(b) >= 3 && match("setup.py", globre(b)))) continue
        j = i - 1; while (j >= 1 && (tok[j] == "" || tok[j] ~ /^-/ || tok[j] ~ /^[a-z_][a-z0-9_]*=/)) j--
        prev = (j >= 1) ? tok[j] : ";"; sub(/.*\//, "", prev)
        if (!(prev == ";" || isshell(prev))) continue
        if (prev == ";" && !hasdir) continue
        if (hasdir ? w ~ /(^|\/)lib\// : n ~ /bin\/lib/) return 1
        if (n ~ /bin\/lib/) return 1
      }
      return 0
    }
    function hasglob(n, name,    k, cnt, tok, b) {
      gsub(/[;&|()]/, " ; ", n); cnt = split(n, tok, /[ \t]+/)
      for (k = 1; k <= cnt; k++) {
        b = tok[k]; sub(/.*\//, "", b)
        if (b == name || (b ~ /[*?\[]/ && literal(b) >= 3 && match(name, globre(b)))) return 1
      }
      return 0
    }
    # UAK-188. While a wizard is live: the reopen key (a second start presents it to /api/reopen for a fresh page), and
    # the three record files in the git directory (without the port file the rules above stop matching). A command is
    # judged only when it ADDRESSES those files in the git directory: a path with a .git component (or the git
    # directory by $GIT_DIR, $(git rev-parse --git-dir), --git-dir=), or a bare name or glob after `cd .git`,
    # `pushd .git`, `git -C .git`, a find rooted there, or with the working directory of the guard itself inside it. A message,
    # a note, a search pattern or a file of the project that merely holds the words or matches `*.key` is not an access.
    # The text is cut into segments at ; & | ( ) < > and each is judged by its command word (wrappers skipped).
    function bname(w,    b) { b = w; sub(/\/+$/, "", b); sub(/.*[\/=@:]/, "", b); return b }
    function nm(b, name) { return b == name || (b ~ /[*?\[]/ && literal(b) >= 3 && match(name, globre(b))) }
    function anyname(b) { return nm(b, "uak-wizard.key") || nm(b, "uak-wizard.port") || nm(b, "uak-wizard.children") }
    function iswrap(w) { return w ~ /^(sudo|doas|env|nohup|command|time|timeout|nice|ionice|setsid|stdbuf|exec|builtin)$/ }
    function gitpath(p,    d, k, c, cc) {   # a path whose directory part runs through the git directory
      sub(/^[-a-z0-9_.~$]*[=@:]/, "", p); if (index(p, "/") == 0) return 0
      d = p; sub(/\/[^\/]*$/, "", d); c = split(d, cc, /\/+/)
      for (k = 1; k <= c; k++) if (cc[k] == ".git" || cc[k] ~ /git-dir|git-common-dir/) return 1
      return 0
    }
    function barepath(p) { sub(/^[-a-z0-9_.~$]*[=@:]/, "", p); sub(/^\.\/+/, "", p); return index(p, "/") == 0 }
    function braces(t, out,    cur, nxt, cnt, nn, k, e, pre, body, post, alts, na, a, ch, pass) {
      cnt = 1; cur[1] = t
      for (pass = 0; pass < 6; pass++) {
        ch = 0; nn = 0
        for (k = 1; k <= cnt; k++) {
          e = cur[k]
          if (nn < 64 && match(e, /\{[^{}]*\}/) && RLENGTH > 2) {
            pre = substr(e, 1, RSTART - 1); body = substr(e, RSTART + 1, RLENGTH - 2); post = substr(e, RSTART + RLENGTH)
            na = split(body, alts, ","); if (na == 0) na = 1
            if (substr(body, length(body)) == ",") alts[++na] = ""
            for (a = 1; a <= na; a++) nxt[++nn] = pre alts[a] post
            ch = 1
          } else nxt[++nn] = e
        }
        for (k = 1; k <= nn; k++) cur[k] = nxt[k]; cnt = nn
        if (!ch) break
      }
      for (k = 1; k <= cnt; k++) out[k] = cur[k]
      return cnt
    }
    function benignexec(c) { return c ~ /^(ls|stat|echo|printf|file|test|wc|du|chmod|chown|touch|true)$/ }
    function files(n, cw0,    s, segs, ns, q, seg, tok, nt, i, j, k, fw, b, bn, cand, kh, rh, gh, hasx, hasclean, rem, cwdgit, ctx, kseen, fgit, fincl, fact, fpat, fexcl, nroots, endroots, w, ex, npat, pat_ok, nb, insub) {
      s = n; gsub(/\$\(|[<>]\(/, " ; @sub@ ", s); gsub(/[;&|()]/, " ; ", s); gsub(/>/, " ; > ", s); gsub(/</, " ; < ", s)
      ns = split(s, segs, /;/); cwdgit = (cw0 == 1); kseen = 0
      for (q = 1; q <= ns; q++) {
        seg = segs[q]; nt = split(seg, tok, /[ \t]+/); insub = (tok[2] == "@sub@" || tok[1] == "@sub@")
        i = 1
        while (i <= nt && (tok[i] == "" || tok[i] == "@sub@" || iswrap(bname(tok[i])) || tok[i] ~ /^-/ || tok[i] ~ /^[a-z_][a-z0-9_]*=/ || tok[i] ~ /^[0-9]+$/)) i++
        if (i > nt) continue
        fw = bname(tok[i]); rem = (fw ~ /^(rm|mv|unlink|truncate|shred|del|erase|rd|rmdir|ri|remove-item|mi|move-item|move)$/)
        if (fw ~ /^(cd|pushd|chdir|set-location|sl|push-location)$/) {   # the next segments run in the git directory, or no longer do
          cwdgit = 0
          for (j = i + 1; j <= nt; j++) if (tok[j] != "" && tok[j] !~ /^-/) {
            if (gitpath(tok[j] "/x") || tok[j] ~ /^\.git\/*$/ || tok[j] ~ /git-dir|git-common-dir/) cwdgit = 1
            break
          }
          continue
        }
        ctx = cwdgit; fgit = 0; fincl = 0; fact = 0; fexcl = 0; npat = 0; pat_ok = 0
        if (fw == "git") for (j = i + 1; j < nt; j++) if (tok[j] == "-c" && (gitpath(tok[j+1] "/x") || tok[j+1] ~ /^\.git\/*$/)) ctx = 1
        if (fw == "find") {
          nroots = 0; endroots = 0
          for (j = i + 1; j <= nt; j++) {
            w = tok[j]; if (w == "") continue
            if (!endroots && w !~ /^[-!]/) {
              nroots++
              if (w ~ /^(\.\/*|\.\.\/*|~\/*|\/+)$/ || w ~ /^(\.\.\/)+(\.\.?)?\/*$/) fincl = 1
              if (w ~ /^\.git\/*$/ || gitpath(w "/x")) { fgit = 1; ctx = 1 }
              continue
            }
            endroots = 1
            if (w ~ /^-(name|iname|path|ipath|wholename|iwholename)$/ && j < nt) {
              b = tok[j+1]; sub(/.*\//, "", b); npat++; if (anyname(b)) pat_ok = 1
              if (w ~ /path|wholename/ && tok[j+1] ~ /\.git/) fexcl = 1
            }
            if (w == "-delete") fact = 1
            if (w ~ /^-(exec|execdir|ok|okdir)$/ && j < nt) { ex = bname(tok[j+1]); if (!benignexec(ex)) fact = 1 }
          }
          if (nroots == 0) { fincl = 1; if (cwdgit) fgit = 1 }
          if (cwdgit && fincl) fgit = 1
          if (fincl && !fgit && seg ~ /-prune|\.git/) fexcl = 1
          # a find that names the key and feeds xargs is a read of it (seen below); one that acts is judged here
          if (fact && ((fgit && (npat == 0 || pat_ok)) || (fincl && !fexcl && !fgit && pat_ok)))
            return "removes or reads the wizard record files (uak-wizard.port, .key, .children) in the git directory"
          if (fgit && pat_ok) kseen = 1
        }
        kh = 0; rh = 0; gh = 0; hasx = 0; hasclean = 0
        for (j = i; j <= nt; j++) {
          nb = braces(tok[j], cand)
          for (k = 1; k <= nb; k++) {
            w = cand[k]; b = bname(w)
            if ((gitpath(w) || (ctx && barepath(w))) && anyname(b)) {
              if (nm(b, "uak-wizard.key")) { kh = 1; rh = 1 } else rh = 1
            }
            if (b == ".git") gh = 1
          }
          b = bname(tok[j])
          if (b == "clean") hasclean = 1
          if (tok[j] ~ /^-[a-z]*x[a-z]*$/) hasx = 1
        }
        if (kh) kseen = 1
        if (rh && (rem || fw ~ /^(cp|ln|tee|dd|install|rsync|xargs|perl|ruby|node|nodejs|php|awk|gawk|mawk|:|>|true)$/ || fw ~ /^(python[0-9.]*|py|pypy[0-9]*|sh|bash|zsh|dash|ksh|powershell|pwsh|cmd)$/ ||
                   fw ~ /^(del|erase|rd|rmdir|ri|remove-item|mi|move-item|move|ren|rename|rename-item|rni|copy|xcopy|robocopy|copy-item|set-content|sc|add-content|ac|out-file|clear-content|clc|new-item|ni)$/ ||
                   (fw == "sed" && seg ~ /[ \t](-[a-z]*i|--in-place)/) || (fw == "find" && seg ~ /[ \t]-(delete|exec|execdir|ok)/)))
          return "removes or rewrites the wizard record files (uak-wizard.port, .key, .children) in the git directory"
        if (kh && !rem && (insub || !(fw ~ /^(ls|stat|test|\[|\[\[|echo|printf|file)$/)))
          return "reads or copies the wizard reopen key (uak-wizard.key) in the git directory"
        if (kseen && fw ~ /^(xargs|parallel)$/)
          return "reads or copies the wizard reopen key (uak-wizard.key) in the git directory"
        if (gh && rem)
          return "removes the git directory that holds the wizard record files"
        if (fw == "git" && hasclean && hasx && (cwdgit || n ~ /\.git|git-dir/))
          return "cleans the git directory that holds the wizard record files"
      }
      return ""
    }
    # A command is cut into shell words (a word is its adjacent quoted and unquoted pieces, $-quote decoded), and a word
    # is decided by its POSITION, then scanned or skipped:
    #   PROSE, never scanned: the value of a message option (-m, --message, --note, --body, --title, --done, --summary,
    #     --reason, --evidence, --description, --next, also --opt=value), the here-document of -F -, the pattern of grep,
    #     rg, ag, ack and git grep, the arguments of echo and printf when no other command consumes their output, and a
    #     string that an inline interpreter only prints. A word that holds a command substitution is never prose.
    #   SCRIPT, judged as a command line (as far as three levels): the argument of sh, bash, zsh, dash, ksh after an option
    #     word with a c (-c, -ec, -lc), skipping -o NAME, -O NAME, --, --norc and the other long options; of eval, ssh HOST,
    #     su -c, script -c, watch, tmux, parallel, npx -c, powershell -c, cmd /c, also behind env, nohup, timeout, xargs,
    #     find -exec and docker; the here-string or here-document of a shell that has no -c; what echo or printf pipes into one.
    #   every other word is scanned as before (a quoted span of three words or more with no substitution is prose).
    function hexv(c) { return index("0123456789abcdef", tolower(c)) - 1 }
    function emit(T, W, QF, SF, IS, n, typ, text, qf, sf, ins) { n++; T[n] = typ; W[n] = text; QF[n] = qf; SF[n] = sf; IS[n] = ins; return n }
    function tokenize(s, T, W, QF, SF, IS,    n, i, len, ch, nx, cur, has, qf, sf, j, d, c, stk, ns, nS, bt, np, pd, pq, pdash, k, body, line, cmp, ins, q, isb, dl, dq, dash, e, x) {
      n = 0; i = 1; len = length(s); cur = ""; has = 0; qf = 0; sf = 0; ns = 0; nS = 0; bt = 0; np = 0
      split("", stk); split("", pd); split("", pq); split("", pdash)
      while (i <= len) {
        ch = substr(s, i, 1); nx = substr(s, i + 1, 1); ins = (bt || nS > 0)
        isb = (ch == " " || ch == "\t" || ch == "\n" || ch == ";" || ch == "&" || ch == "|" || ch == "(" || ch == ")" || ch == "`" ||
               (ch == "$" && nx == "(") || ((ch == "<" || ch == ">") && nx == "(") || (ch == "<" && nx == "<" && substr(s, i + 2, 1) != "<" && substr(s, i - 1, 1) != "<") || (ch == "<" && nx == "<" && substr(s, i + 2, 1) == "<" && substr(s, i - 1, 1) != "<"))
        if (isb && has) { n = emit(T, W, QF, SF, IS, n, "w", cur, qf, sf, ins); cur = ""; has = 0; qf = 0; sf = 0 }
        if (ch == "\047") {
          j = index(substr(s, i + 1), "\047")
          if (j == 0) { cur = cur substr(s, i + 1); i = len + 1 } else { cur = cur substr(s, i + 1, j - 1); i += j + 1 }
          has = 1; qf = 1; continue
        }
        if (ch == "$" && nx == "\047") {
          i += 2; has = 1; qf = 1
          while (i <= len) {
            c = substr(s, i, 1)
            if (c == "\047") break
            if (c == "\\" && i < len) {
              x = substr(s, i + 1, 1); i += 2
              if (x == "n") cur = cur "\n"; else if (x == "t") cur = cur "\t"; else if (x == "e") cur = cur " "
              else if (x == "x" && substr(s, i, 1) ~ /[0-9a-fA-F]/) {
                d = hexv(substr(s, i, 1)); i++
                if (substr(s, i, 1) ~ /[0-9a-fA-F]/) { d = d * 16 + hexv(substr(s, i, 1)); i++ }
                cur = cur sprintf("%c", d)
              } else if (x ~ /[0-7]/) {
                d = x + 0
                if (substr(s, i, 1) ~ /[0-7]/) { d = d * 8 + substr(s, i, 1); i++ }
                if (substr(s, i, 1) ~ /[0-7]/) { d = d * 8 + substr(s, i, 1); i++ }
                cur = cur sprintf("%c", d)
              } else cur = cur x
              continue
            }
            cur = cur c; i++
          }
          i++; continue
        }
        if (ch == "\"") {
          i++; has = 1; qf = 1
          while (i <= len) {
            c = substr(s, i, 1)
            if (c == "\\" && i < len && index("\"\\$`", substr(s, i + 1, 1)) > 0) { cur = cur substr(s, i + 1, 1); i += 2; continue }
            if (c == "\"") break
            if (c == "$" && substr(s, i + 1, 1) == "(") {
              sf = 1; d = 0
              while (i <= len) { c = substr(s, i, 1); cur = cur c; i++; if (c == "(") d++; else if (c == ")") { d--; if (d == 0) break } }
              continue
            }
            if (c == "`") {
              sf = 1; cur = cur c; i++
              while (i <= len && substr(s, i, 1) != "`") { cur = cur substr(s, i, 1); i++ }
              if (i <= len) { cur = cur "`"; i++ }
              continue
            }
            cur = cur c; i++
          }
          i++; continue
        }
        if (ch == "\\") {
          if (nx == "\n") { i += 2; continue }
          if (nx == "\047" || nx == "\"") { cur = cur nx; has = 1; i += 2; continue }
          cur = cur ch nx; has = 1; i += 2; continue
        }
        if (ch == "$" && nx == "(") { n = emit(T, W, QF, SF, IS, n, "open", "S", 0, 0, ins); stk[++ns] = "S"; nS++; i += 2; continue }
        if ((ch == "<" || ch == ">") && nx == "(") { n = emit(T, W, QF, SF, IS, n, "open", "S", 0, 0, ins); stk[++ns] = "S"; nS++; i += 2; continue }
        if (ch == "`") {
          if (bt) { n = emit(T, W, QF, SF, IS, n, "close", "", 0, 0, ins); bt = 0 }
          else { n = emit(T, W, QF, SF, IS, n, "open", "S", 0, 0, ins); bt = 1 }
          i++; continue
        }
        if (ch == "(") { n = emit(T, W, QF, SF, IS, n, "open", "P", 0, 0, ins); stk[++ns] = "P"; i++; continue }
        if (ch == ")") {
          if (ns > 0) { if (stk[ns] == "S") nS--; ns-- }
          n = emit(T, W, QF, SF, IS, n, "close", "", 0, 0, ins); i++; continue
        }
        if (ch == ";" || ch == "&") { n = emit(T, W, QF, SF, IS, n, "sep", "", 0, 0, ins); i++; continue }
        if (ch == "|") {
          if (nx == "|") { n = emit(T, W, QF, SF, IS, n, "sep", "", 0, 0, ins); i += 2; continue }
          n = emit(T, W, QF, SF, IS, n, "pipe", "", 0, 0, ins); i += (nx == "&" ? 2 : 1); continue
        }
        if (ch == "\n") {
          if (np > 0) {
            i++
            for (k = 1; k <= np; k++) {
              body = ""
              while (i <= len) {
                j = index(substr(s, i), "\n")
                if (j == 0) { line = substr(s, i); i = len + 1 } else { line = substr(s, i, j - 1); i += j }
                cmp = line; if (pdash[k]) sub(/^\t+/, "", cmp)
                if (cmp == pd[k]) break
                body = body line "\n"
              }
              n = emit(T, W, QF, SF, IS, n, "hd", body, pq[k], 0, ins)
            }
            np = 0
            n = emit(T, W, QF, SF, IS, n, "sep", "", 0, 0, ins); continue
          }
          n = emit(T, W, QF, SF, IS, n, "sep", "", 0, 0, ins); i++; continue
        }
        if (ch == " " || ch == "\t") { i++; continue }
        if (ch == "#" && !has) { while (i <= len && substr(s, i, 1) != "\n") i++; continue }
        if (ch == "<" && nx == "<" && substr(s, i + 2, 1) == "<" && substr(s, i - 1, 1) != "<") { n = emit(T, W, QF, SF, IS, n, "w", "<<<", 0, 0, ins); i += 3; continue }
        if (ch == "<" && nx == "<" && substr(s, i + 2, 1) != "<" && substr(s, i - 1, 1) != "<") {
          j = i + 2; dash = 0
          if (substr(s, j, 1) == "-") { dash = 1; j++ }
          while (substr(s, j, 1) == " " || substr(s, j, 1) == "\t") j++
          dq = 0; dl = ""
          while (j <= len && !(substr(s, j, 1) ~ /[ \t\n;&|()<>]/)) {
            c = substr(s, j, 1)
            if (c == "\047" || c == "\"") { dq = 1; e = index(substr(s, j + 1), c); if (e == 0) { dl = dl substr(s, j + 1); j = len + 1 } else { dl = dl substr(s, j + 1, e - 1); j += e + 1 } continue }
            if (c == "\\") { dq = 1; j++; continue }
            dl = dl c; j++
          }
          np++; pd[np] = dl; pq[np] = dq; pdash[np] = dash
          n = emit(T, W, QF, SF, IS, n, "w", "<<", 0, 0, ins); i = j; continue
        }
        cur = cur ch; has = 1; i++
      }
      if (has) n = emit(T, W, QF, SF, IS, n, "w", cur, qf, sf, ins)
      return n
    }
    # the command substitutions of text that the shell expands (an unquoted here-document): $(...) and backticks
    function substs(body, OUT,    n, i, len, c, d, st, e)
    {
      n = 0; i = 1; len = length(body)
      while (i <= len) {
        c = substr(body, i, 1)
        if (c == "$" && substr(body, i + 1, 1) == "(") {
          st = i + 2; d = 1; i += 2
          while (i <= len && d > 0) { c = substr(body, i, 1); if (c == "(") d++; else if (c == ")") d--; i++ }
          OUT[++n] = substr(body, st, i - st - 1); continue
        }
        if (c == "`") {
          e = index(substr(body, i + 1), "`")
          if (e == 0) break
          OUT[++n] = substr(body, i + 1, e - 1); i += e + 1; continue
        }
        i++
      }
      return n
    }
    function wbase(w,    b) { b = tolower(w); sub(/.*[\/\\]/, "", b); sub(/\.exe$/, "", b); return b }
    function isredir(w) { return w ~ /^[0-9]*(<<<|>>|>&|<&|>\||>|<)$/ }
    function ismsgopt(w) { return w ~ /^(-m|--message|--note|--body|--title|--done|--summary|--reason|--evidence|--description|--next|--msg|--grep|-S|-G)$/ }
    function issh(b) { return b ~ /^(sh|bash|zsh|dash|ksh|ash|rbash)$/ }
    function isrunwrap(b) { return b ~ /^(env|exec|command|sudo|doas|time|nohup|timeout|nice|ionice|setsid|stdbuf|builtin|busybox)$/ }
    # sh-family word at word position p of command c: the token of its script (-c), -1 when it reads standard input
    # (no -c, no file operand), -2 when it runs a file, 0 when p is not a shell
    function shparse(W, CWI, M, c, p,    j, w, seenc, t) {
      if (!issh(wbase(W[CWI[c, p]]))) return 0
      seenc = 0
      for (j = p + 1; j <= M[c]; j++) {
        t = CWI[c, j]; w = W[t]
        if (w == "<<") continue
        if (isredir(w)) { j++; continue }
        if (w == "--") continue
        if (w ~ /^--/) { if (w == "--rcfile" || w == "--init-file") j++; continue }
        if (w ~ /^[-+][A-Za-z]+$/) { if (substr(w, 1, 1) == "-" && w ~ /c/) seenc = 1; if (w ~ /[oO]$/) j++; continue }
        if (seenc) return t
        return -2
      }
      return seenc ? 0 : -1
    }
    function lastc(w) { return w ~ /^(-[a-z]?c|-command|\/[ck])$/ }
    function inlinecode(code, cw,    s, st, rest, e, q, g, n2) {
      s = code
      # a string literal handed to print, puts, say or console.log is text, not an access
      while (match(s, /(print|puts|say|console\.log|console\.error|warn|printf|echo|println)[ (]*["\047]/)) {
        st = RSTART + RLENGTH - 1; q = substr(s, st, 1); rest = substr(s, st + 1); e = index(rest, q)
        if (e == 0) { s = substr(s, 1, RSTART - 1) " "; break }
        s = substr(s, 1, RSTART - 1) " " substr(rest, e + 1)
      }
      n2 = norm(s)
      if (n2 ~ /(chdir|cd|set-location|sl|pushd|push-location)[ (]*\.git/ && (n2 ~ /uak-wizard\.(key|port|children)/ || n2 ~ /uak-[w*?\[]/))
        return "changes into the git directory and names a wizard record file (uak-wizard.key, .port, .children)"
      if (n2 ~ /(\.git|git-dir)\/+uak-(wizard|[*?\[w])/)
        return (n2 ~ /uak-wizard\.(key|k)|uak-[*?\[w]/) ? "reads or copies the wizard reopen key (uak-wizard.key) in the git directory" : "removes or rewrites the wizard record files (uak-wizard.port, .key, .children) in the git directory"
      if (cw == 1 && (n2 ~ /uak-wizard\.(key|port|children)/ || n2 ~ /uak-[w*?\[]/))
        return "names a wizard record file from inside the git directory (uak-wizard.key, .port, .children)"
      if (request(n2, 2)) return "sends a request to the running wizard"
      return ""
    }
    function judge(line, depth, cw0,    T, W, QF, SF, IS, n, i, k, a, nc, c, p, m, CS, CE, CB, FI, FW, M, CWI, PR, PAY, PCW, npay, cw, t, txt, r, w, b, j, pt, nsp, tmp, seenpat, pk, consumed, shk, tw, x, pcmd, KEEP, SUBS) {
      n = tokenize(gitsub(line), T, W, QF, SF, IS)
      nc = 0; a = 0
      for (i = 1; i <= n + 1; i++) {
        if (i > n || (T[i] != "w" && T[i] != "hd")) {
          if (a) { nc++; CS[nc] = a; CE[nc] = i - 1; CB[nc] = (i <= n) ? T[i] : ""; a = 0 }
        } else if (!a) a = i
      }
      for (c = 1; c <= nc; c++) {
        m = 0
        for (i = CS[c]; i <= CE[c]; i++) if (T[i] == "w") { m++; CWI[c, m] = i }
        M[c] = m
        p = 1
        while (p <= m) {
          w = W[CWI[c, p]]; b = wbase(w)
          if (w ~ /^[A-Za-z_][A-Za-z0-9_]*=/ || w ~ /^[0-9]+$/) { p++; continue }
          if (isrunwrap(b) && !issh(b)) {
            p++
            while (p <= m && W[CWI[c, p]] ~ /^-/) { if (W[CWI[c, p]] ~ /^-[ugnChpUT]$/) p++; p++ }
            if (b == "timeout" && p <= m && W[CWI[c, p]] ~ /^[0-9.]+[smhd]?$/) p++
            continue
          }
          break
        }
        FI[c] = p; FW[c] = (p <= m) ? wbase(W[CWI[c, p]]) : ""
      }
      npay = 0; cw = cw0; txt = ""
      for (c = 1; c <= nc; c++) {
        m = M[c]; p = FI[c]; b = FW[c]
        # message options
        for (k = 1; k <= m; k++) {
          t = CWI[c, k]; w = W[t]
          if (isredir(w)) { k++; continue }
          if (ismsgopt(w) && k < m && !SF[CWI[c, k + 1]] && !isredir(W[CWI[c, k + 1]])) PR[CWI[c, k + 1]] = 1
          else if (w ~ /^--(message|note|body|title|done|summary|reason|evidence|description|next|msg|grep)=/ && !SF[t]) PR[t] = 1
        }
        # grep family: the pattern
        pk = 0
        if (b ~ /^(grep|egrep|fgrep|rg|ag|ack)$/) pk = p
        else if (b == "git") { for (k = p + 1; k <= m; k++) if (W[CWI[c, k]] !~ /^-/) { if (W[CWI[c, k]] == "grep") pk = k; break } }
        if (pk) {
          seenpat = 0
          for (k = pk + 1; k <= m; k++) {
            t = CWI[c, k]; w = W[t]
            if (isredir(w)) { k++; continue }
            if (w == "-e" || w == "--regexp") { if (k < m && !SF[CWI[c, k + 1]]) PR[CWI[c, k + 1]] = 1; k++; seenpat = 1; continue }
            if (w ~ /^--regexp=/) { if (!SF[t]) PR[t] = 1; seenpat = 1; continue }
            if (w ~ /^-[ABCmfdDgtTM]$/ || w ~ /^--(include|exclude|exclude-dir|max-count|file|type|glob|context)$/) { k++; continue }
            if (w ~ /^-/) continue
            if (!seenpat) { if (!SF[t]) PR[t] = 1; seenpat = 1 }
            break
          }
        }
        # echo, printf: text, unless another command consumes it
        if (b == "echo" || b == "printf") {
          consumed = (IS[CWI[c, p]] || CB[c] == "pipe")
          shk = 0
          if (CB[c] == "pipe" && c < nc) { t = FI[c + 1]; if (t <= M[c + 1] && issh(FW[c + 1]) && shparse(W, CWI, M, c + 1, FI[c + 1]) == -1) shk = 1 }
          if (consumed && !shk) for (k = p + 1; k <= m; k++) KEEP[CWI[c, k]] = 1
          if (shk || !consumed) {
            pcmd = ""
            for (k = p + 1; k <= m; k++) {
              t = CWI[c, k]; w = W[t]
              if (isredir(w)) { k++; continue }
              if (w ~ /^[0-9]*[<>]/ || SF[t]) continue
              if (w ~ /^-[neE]+$/ && pcmd == "") continue
              PR[t] = 1; if (shk) pcmd = pcmd (pcmd == "" ? "" : " ") w
            }
            if (shk && pcmd != "") { gsub(/\\n/, "\n", pcmd); PAY[++npay] = pcmd; PCW[npay] = cw }
          }
        }
        # inline interpreter code
        if (b ~ /^(python[0-9.]*|py|pypy[0-9]*|perl|ruby|node|nodejs|deno|bun|php)$/) {
          for (k = p + 1; k < m; k++) {
            w = W[CWI[c, k]]
            if (w ~ /^-[A-Za-z]*[cerEp]$/ || w == "--eval") { t = CWI[c, k + 1]; PR[t] = 1; r = inlinecode(W[t], cw); if (r != "") return r; break }
          }
          for (k = CS[c]; k <= CE[c]; k++) if (T[k] == "hd") { PR[k] = 1; r = inlinecode(W[k], cw); if (r != "") return r }
        }
        if (b ~ /^(awk|gawk|mawk|nawk)$/) {
          for (k = p + 1; k <= m; k++) { w = W[CWI[c, k]]; if (w !~ /^-/) { PR[CWI[c, k]] = 1; r = inlinecode(W[CWI[c, k]], cw); if (r != "") return r; break } }
        }
        # runners: any word position (behind env, nohup, timeout, xargs, find -exec, docker...)
        for (k = 1; k <= m; k++) {
          t = CWI[c, k]
          if (PR[t]) continue
          w = W[t]; x = wbase(w)
          if (issh(x)) {
            pt = shparse(W, CWI, M, c, k)
            if (pt > 0) { PR[pt] = 1; PAY[++npay] = W[pt]; PCW[npay] = cw }
            else if (pt == -1) {
              for (i = CS[c]; i <= CE[c]; i++) {
                if (T[i] == "hd") { PR[i] = 1; PAY[++npay] = W[i]; PCW[npay] = cw }
                else if (T[i] == "w" && W[i] == "<<<" && i < CE[c] && T[i + 1] == "w") { PR[i + 1] = 1; PAY[++npay] = W[i + 1]; PCW[npay] = cw }
              }
            }
            continue
          }
          if (x == "eval" || x == "watch" || x == "tmux" || x == "parallel" || x == "ssh") {
            pcmd = ""; j = k + 1
            if (x == "ssh") { while (j <= m && W[CWI[c, j]] ~ /^-/) j += (W[CWI[c, j]] ~ /^-[pilofjbcdemqrswx]$/ ? 2 : 1); j++ }
            if (x == "tmux" && j <= m && W[CWI[c, j]] !~ /^-/) j++
            for (; j <= m; j++) {
              t = CWI[c, j]
              if (isredir(W[t])) { j++; continue }
              if (pcmd == "" && (W[t] ~ /^-/ || W[t] ~ /^[0-9.]+$/)) continue
              PR[t] = 1; pcmd = pcmd (pcmd == "" ? "" : " ") W[t]
            }
            if (pcmd != "") { PAY[++npay] = pcmd; PCW[npay] = cw }
          } else if (x == "su" || x == "script" || x == "npx" || x == "powershell" || x == "pwsh" || x == "cmd") {
            tw = 0
            for (j = k + 1; j <= m; j++) { if (lastc(tolower(W[CWI[c, j]]))) { tw = j + 1; break } if (W[CWI[c, j]] !~ /^[-\/]/) break }
            if (!tw || tw > m) continue
            pcmd = ""
            for (j = tw; j <= m; j++) {
              t = CWI[c, j]
              if (isredir(W[t])) { j++; continue }
              PR[t] = 1; pcmd = pcmd (pcmd == "" ? "" : " ") W[t]
              if (x == "su" || x == "script" || x == "npx") break
            }
            if (pcmd != "") { PAY[++npay] = pcmd; PCW[npay] = cw }
          }
        }
        # the working directory the next commands run in
        if (b ~ /^(cd|pushd|chdir|set-location|sl|push-location)$/) {
          cw = 0
          for (k = p + 1; k <= m; k++) if (W[CWI[c, k]] !~ /^-/) { x = norm(W[CWI[c, k]]); if (gitpath(x "/x") || x ~ /^\.git\/*$/ || x ~ /git-dir|git-common-dir/) cw = 1; break }
        }
        # a here-document that no runner or interpreter reads is text
        for (k = CS[c]; k <= CE[c]; k++) if (T[k] == "hd" && !PR[k]) {
          PR[k] = 1
          if (!QF[k]) { nsp = substs(W[k], SUBS); for (i = 1; i <= nsp; i++) { PAY[++npay] = SUBS[i]; PCW[npay] = cw } }
        }
      }
      # the text that is scanned: every word that is not prose, a script or code
      for (i = 1; i <= n; i++) {
        if (T[i] == "w") {
          if (PR[i]) { txt = txt " \"\""; continue }
          if (QF[i] && !SF[i] && !KEEP[i]) { nsp = split(W[i], tmp, /[ \t]+/); if (nsp >= 3) { txt = txt " \"\""; continue } }
          txt = txt " " W[i]
        } else if (T[i] == "sep") txt = txt " ; "
        else if (T[i] == "pipe") txt = txt " | "
        else if (T[i] == "open") txt = txt (W[i] == "S" ? " $( " : " ( ")
        else if (T[i] == "close") txt = txt " ) "
      }
      r = files(norm(txt), cw0)
      if (r == "" && request(norm(txt), 2)) r = "sends a request to the running wizard"
      if (r != "") return r
      if (depth < 4) for (k = 1; k <= npay; k++) { r = judge(PAY[k], depth + 1, PCW[k]); if (r != "") return r }
      return ""
    }
    # A request to the running wizard: its endpoints, from a client or to a loopback host, to its port or to a port the
    # command does not show. Only while a wizard is live for this project.
    function request(n, rt,    m, rest, seen, unreadable, loopre, client) {
      if (!live) return 0
      if (rt == 2 ? !(n ~ /\/api\/(reopen|closing)/) : !(n ~ /\/api\/(session|human|team|plan|publish-kit|install|repair|settings|idea|schedule|inspect|check|status|dashboard)/)) return 0
      loopre = "(localhost|127\\.[0-9][0-9.]*|\\[?::1?\\]?|0\\.0\\.0\\.0|2130706433|0x7f[0-9a-f]*|017700000001)"
      client = (n ~ /(^|[^a-z0-9_])(curl|wget|nc|ncat|netcat|socat|telnet|http|https|xh|node|nodejs|deno|bun|ruby|perl|php|python[0-9.]*|py|powershell|pwsh|invoke-webrequest|iwr|irm|openssl)([^a-z0-9_]|$)|urlopen|requests|httpx|aiohttp|http\.client|fetch|dev\/tcp/)
      m = n; seen = 0; unreadable = 0
      while (match(m, loopre)) {
        rest = substr(m, RSTART + RLENGTH); m = rest; seen = 1
        if (rest ~ /^:[0-9]/ || rest ~ /^\/[0-9]/ || rest ~ /^ +[0-9]/) continue
        if (rest ~ /^\/[^0-9]/) continue
        unreadable = 1
      }
      if (!seen && !client) return 0
      if (n ~ ("(^|[^0-9])" wport "([^0-9]|$)")) return 1
      return (!seen || unreadable)
    }
    function decide(n, p,    c) {
      if (n ~ /x-uak-token/) return "uses the wizard session header"
      if (n ~ /(^|[ ;])--wizard/ && p ~ /--wizard/ && (n ~ /install\.sh/ || hasglob(n, "install.sh"))) return "starts the wizard (--wizard)"
      if (runs_setup(n)) return "runs the wizard (setup.py)"
      if (n ~ /(python[0-9.]*|py|pypy[0-9]*)( +-[a-z0-9]+)* +-m +setup([^a-z0-9_]|$)/) return "runs the wizard (-m setup)"
      if (n ~ /(python[0-9.]*|py|pypy[0-9]*)( +-[a-z0-9]+)* +-c / && n ~ /((import|from) +setup([^a-z0-9_]|$)|runpy|import_module *\( *setup|bin\/lib|exec *\(.*open.*(setup|tup\.py))/) return "runs the wizard from Python code"
      if (request(n)) return "sends a request to the running wizard"
      return ""
    }
    BEGIN {
      rawcmd = ENVIRON["WZ_RAW"]; n = norm(rawcmd); p = norm(ENVIRON["WZ_PRO"]); r = decide(n, p)
      if (r == "") r = decide(p, p)
      if (r == "" && live) r = judge(ENVIRON["WZ_NL"], 1, ingit + 0)
      print r
    }' </dev/null)
}
# A segment that sets VAR for the command it runs: `VAR=x cmd`, `A=1 VAR=x cmd`, `env VAR=x cmd`,
# `export VAR=x`, `export VAR`, or the same inside `bash -c`. A search for the text (`rg UAK_NOW= bin/`) does not.
assigns() { # $1 VAR, $2 segment
  printf '%s' "$2" | grep -Eq "(^[[:space:]]*|[[:space:]]-[A-Za-z]*c[[:space:]]+)((export|env|declare|typeset|readonly|local|command|exec|nohup|time)([[:space:]]+-[A-Za-z-]+)*[[:space:]]+)*([A-Za-z_][A-Za-z0-9_]*=[^[:space:]]*[[:space:]]+)*$1=|(^|[[:space:]])(export|declare[[:space:]]+-[A-Za-z]*x[A-Za-z]*|typeset[[:space:]]+-[A-Za-z]*x[A-Za-z]*)([[:space:]]+[A-Za-z_][A-Za-z0-9_]*(=[^[:space:]]*)?)*[[:space:]]+$1([[:space:]]|$)"
}
# Human-only commands (UAK_HUMAN: plan, allow, retire, register-reviewer, handover of others' tasks, a human
# integrate) need the human's yes. Claude Code (`guard bash claude`): "ask", so the prompt shows even for an
# allow-listed `bash .uak/bin/uak`. Harnesses without "ask": blocked; the human runs it in their own terminal.
# Why (Hacktoberfest second autopsy): an agent prefixed UAK_HUMAN to record a human's approval and merge.
GUARD_HARNESS=
ask_human() {
  case "$GUARD_HARNESS" in
    claude)
      bash "$here/bb" auto guard guard "ask: $*" >/dev/null 2>&1 || true
      printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"ask","permissionDecisionReason":"UAK_GUARD: %s"}}\n' "$*"
      exit 0;;
    check) printf 'UAK_GUARD: ask · %s\n' "$*" >&2; exit 3;;
  esac
  block "$* This harness cannot ask the human, so the human runs it in their own terminal."
}

# The body of a heredoc with a quoted delimiter (<<'EOF', <<"EOF", <<\EOF) is data: nothing in it runs. Dropped,
# unless the command that reads it runs it (a shell, an interpreter, ssh, eval, xargs, sudo). Why (review of UAK-111):
# `git commit -F - <<'EOF'` with `git push` or backticks in the message must not block or ask. One awk, and only
# for a command with `<<` and a quote; JSON keeps \n as two characters, so those split lines too.
strip_heredocs() { # sets cmd
  cmd=$(printf '%s' "$1" | awk 'BEGIN { RS = "\001"; ORS = ""; q = sprintf("%c", 39)
    re = "<<-?[ \t]*(\\\\[A-Za-z_][A-Za-z0-9_]*|" q "[^" q "]*" q "|\"[^\"]*\")"
    ex = "(^|[^A-Za-z0-9_])(sh|bash|zsh|dash|ksh|ssh|eval|xargs|source|sudo|python[0-9.]*|node|perl|ruby|php)([^A-Za-z0-9_]|$)" }
  { gsub(/\\n/, "\n"); n = split($0, L, "\n"); inh = 0; out = ""
    for (i = 1; i <= n; i++) {
      line = L[i]
      if (inh) { t = line; if (dash) sub(/^\t+/, "", t); if (t == delim) inh = 0; continue }
      out = out (i > 1 ? "\n" : "") line
      if (match(line, re) && substr(line, RSTART - 1, 1) != "<" && substr(line, 1, RSTART - 1) !~ ex) {
        d = substr(line, RSTART, RLENGTH); dash = (substr(d, 3, 1) == "-")
        sub(/^<<-?[ \t]*/, "", d); gsub(/[\\"\047]/, "", d); delim = d; inh = 1
      }
    }
    print out }')
}
# A git push whose remote or refspec argument is dynamic (a $ or a backslash; a backtick became $). Only those
# arguments count: `git -C "$WT" push origin feat/x` is a plain push.
push_dynamic() { # $1 segment
  local t st=0 skip=0
  set -f; set -- $1; set +f
  for t; do
    if [ "$skip" = 1 ]; then skip=0; continue; fi
    case $st in
      0) case "$t" in git|*/git) st=1;; esac;;
      1) case "$t" in -C|-c|--git-dir|--work-tree|--namespace) skip=1;; -*) ;; push) st=2;; *) return 1;; esac;;
      2) case "$t" in -o|--push-option|--repo|--receive-pack|--exec) skip=1;; -*) ;; *'$'*|*'\'*) return 0;; esac;;
    esac
  done
  return 1
}
# A gh command whose subcommand word (gh [flags] pr [flags] VERB) is a variable or substitution.
gh_dynamic() { # $1 segment
  local t st=0 skip=0
  set -f; set -- $1; set +f
  for t; do
    if [ "$skip" = 1 ]; then skip=0; continue; fi
    case $st in
      0) case "$t" in gh|*/gh) st=1;; esac;;
      1|2) case "$t" in
             -R|--repo) skip=1;;
             -*) ;;
             *'$'*|*'\'*) return 0;;
             pr) [ "$st" = 1 ] && st=2 || return 1;;
             *) return 1;;
           esac;;
    esac
  done
  return 1
}
# The idioms that resolve to the current branch or directory read as HEAD and `.`: the existing HEAD rules apply.
idioms() { # sets rcmd
  # Only a command with one of the idioms gets here past the case: plain commands spawn nothing. Long input (and every
  # input on bash 3.2, where SHORT is 0) goes through sed: ${//} is quadratic there.
  case "$rcmd" in *'git branch --show-current'*|*'git rev-parse --abbrev-ref HEAD'*|*'pwd'*) ;; *) return 0;; esac
  if [ "${#rcmd}" -gt "$SHORT" ]; then
    rcmd=$(printf '%s' "$rcmd" | sed -e 's/\$(git branch --show-current)/HEAD/g' -e 's/`git branch --show-current`/HEAD/g' \
      -e 's/\$(git rev-parse --abbrev-ref HEAD)/HEAD/g' -e 's/`git rev-parse --abbrev-ref HEAD`/HEAD/g' \
      -e 's/\$(pwd)/./g' -e 's/`pwd`/./g')
    return 0
  fi
  rcmd=${rcmd//'$(git branch --show-current)'/HEAD}; rcmd=${rcmd//'`git branch --show-current`'/HEAD}   # kit-lint: ok (at most SHORT chars)
  rcmd=${rcmd//'$(git rev-parse --abbrev-ref HEAD)'/HEAD}; rcmd=${rcmd//'`git rev-parse --abbrev-ref HEAD`'/HEAD}   # kit-lint: ok (at most SHORT chars)
  rcmd=${rcmd//'$(pwd)'/.}; rcmd=${rcmd//'`pwd`'/.}   # kit-lint: ok (at most SHORT chars)
}

check_bash() {
  norm_cmd "$1"; m=
  # Quoted prose (3+ words: a commit message, a uak msg) is not a command, unless the command runs it as code.
  # Quotes go, so "--force" is --force. Why (audit): `git commit -m "fix: push -d flag parsing"` was blocked as a
  # remote branch delete, and `git push "--force"` passed.
  # Speed (Windows, a process costs 20-50 ms in Git Bash): each rule runs grep only when its words are in the
  # segment (case is a builtin), and a command with no quotes has no prose to strip.
  rcmd=$cmd code=no SUBQ=
  if runs_code "$cmd"; then code=yes; else
    case "$cmd" in *'<<'*[\"\'\\]*) strip_heredocs "$cmd"; rcmd=$cmd;; esac
    case "$cmd" in *'"'*'`'*|*'"'*'$('*) SUBQ=yes;; esac
    case "$cmd" in *[\"\']*) rcmd=$(strip_prose "$rcmd");; esac
  fi
  # envcmd: the .env checks read the command with its prose removed but its quotes kept.
  envcmd=$rcmd
  # The wizard: only commands that could mention it pay for the one awk (case-folded by the patterns).
  wizard_port_file
  wzg=
  case "$cmd" in *[Ww][Ii][Zz]*|*[Tt][Uu][Pp]*|*[Uu][Pp].[Pp][Yy]*|*[Aa][Pp][Ii]*|*[Uu][Aa][Kk]-[Tt]*|*[Rr][Uu][Nn][Pp][Yy]*|*bin/lib*|*[Ss][Ee][Tt][Uu]*|*%[0-9A-Fa-f][0-9A-Fa-f]*) wzg=1;; esac
  # While a wizard is live a command is read for its files only when its text can address them: .git, a git-dir
  # spelling, rev-parse, a uak- name, a find that acts, or when the working directory is inside the git directory (bare names). A command
  # with none of these (ls, git status, pytest, uak status) costs no process: the decision is a case, a builtin.
  if [ -z "$wzg" ] && [ -n "$WZ_PF" ]; then
    case "$cmd" in *[.][Gg][Ii][Tt]*|*[Gg][Ii][Tt][-_][Dd][Ii][Rr]*|*rev-parse*|*[Uu][Aa][Kk]-*|*find*-delete*|*find*-exec*|*find*-ok*) wzg=1;; *) [ -z "$WZ_CWDGIT" ] || wzg=1;; esac
  fi
  if [ -n "$wzg" ]; then
    wizard_mentioned "$cmd" "$envcmd"
    [ -z "$WZ" ] ||
      block "the setup wizard performs a human's acts (register a reviewer, approve the plan, publish the kit), so only a human starts it, in their own terminal (bash install.sh --wizard), and an agent never drives it. This command $WZ."
  fi
  if [ "${#rcmd}" -le "$SHORT" ]; then rcmd=${rcmd//[\"\']/}; else rcmd=$(printf '%s' "$rcmd" | tr -d "\"'"); fi
  human_cmd= dyn=
  base=${UAK_BASE:-main}
  case "$rcmd" in *'$('*|*'`'*) idioms;; esac
  # Only segments with a risky word go through the rules: a 300-line heredoc took 7.5 s, past the hook's 5 s
  # timeout (and a timed-out hook lets the command run). A command with none of them has no such segment.
  case "$rcmd" in *git*|*rm*|*kill*|*sudo*|*curl*|*wget*|*publish*|*upload*|*gh*|*docker*|*npm*|*pnpm*|*yarn*|*pip*|*uv*|*UAK_*) bt_marks "$rcmd"; rule_segments "$rs";; *) SEGS=;; esac
  # No segment, no here-document: Git Bash forks a child to feed one (Windows CI: 4 processes for `ls`).
  [ -z "$SEGS" ] || while IFS= read -r seg; do
    s=" $seg "
    case "$s" in *git*|*rm*|*kill*|*sudo*|*curl*|*wget*|*publish*|*upload*|*gh*|*docker*|*npm*|*pnpm*|*yarn*|*pip*|*uv*|*UAK_*) ;; *) continue;; esac
    # The clock is the engine's: a lease, a freeze or an offer window read at another time is a lie to everyone.
    case "$s" in *UAK_NOW*|*UAK_TEST_CLOCK*)
      { assigns UAK_NOW "$seg" || assigns UAK_TEST_CLOCK "$seg"; } &&
        block "UAK_NOW/UAK_TEST_CLOCK set the uak clock; only the test suite sets them. Run the command without it.";;
    esac
    case "$s" in *UAK_HUMAN*) assigns UAK_HUMAN "$seg" && human_cmd=yes;; esac
    # Merges reach main only through the gate (uak merge) or a human on the forge. Why (Hacktoberfest second
    # autopsy): 5 of 33 sprint merges were an agent's gh pr merge, and the only out-of-Paths merges were among them.
    case "$s" in *gh*merge*)
      # Flags (and their values) may sit between the words: gh -R o/r pr merge 3, gh pr --repo o/r merge 3.
      grep -Eq '(^|[[:space:]/])gh[[:space:]]+(-[^[:space:]]+[[:space:]]+([^-[:space:]][^[:space:]]*[[:space:]]+)?)*pr[[:space:]]+(-[^[:space:]]+[[:space:]]+([^-[:space:]][^[:space:]]*[[:space:]]+)?)*merge([[:space:]]|$)|(^|[[:space:]/])gh[[:space:]]+api[[:space:]].*pulls/[0-9]+/merge' <<< "$s" &&
        block "gh pr merge skips the merge gate. Run bash .uak/bin/uak merge ID (Verify, scope and review on the merged result); a human merges on GitHub themselves.";;
    esac
    # A ref the text filter cannot read (a variable, a substitution, a backslash) in a gh merge or a git push: the
    # human decides (audit #5). A backtick became " $( " before the split, so it shows as a $ here.
    case "$s" in *gh*)
      case "$s" in *'$'*|*'\'*)
        gh_dynamic "$s" &&
          dyn="a gh command whose subcommand is dynamic (variable, substitution, backslash): the guard cannot read it. Run it only if the human asked for exactly this.";;
      esac;;
    esac
    # A URL with user@ goes to the host after the @: `curl http://localhost:1@other-host/` passes an allow rule for
    # localhost (audit). A credential in a URL also lands in shell history and logs.
    case "$s" in *curl*@*|*wget*@*|*@*curl*|*@*wget*)
      grep -Eq '(^|[[:space:]/])(curl|wget)[[:space:]]' <<< "$s" && grep -Eq '[A-Za-z][A-Za-z0-9+.-]*://[^/[:space:]?#]*@' <<< "$s" &&
        block "a URL with user@host: it goes to the host after the @, and the credential lands in logs. Use the plain URL (curl -u reads a credential from .env through a variable).";;
    esac
    case "$s" in *git*push*)
      # Short flags cluster (-fu), long ones abbreviate (--for, --mirr): git accepts both.
      if grep -Eq -- '[[:space:]](-[A-Za-z]*f[A-Za-z]*|--for(c(e(-with-lease|-if-includes)?)?)?(=[^[:space:]]*)?|--mi(r(r(o(r)?)?)?)?)([[:space:]]|$)|[[:space:]]\+[A-Za-z0-9_./*:-]+|remote\.[^[:space:]]*\.mirror' <<< "$s"; then
        block "forced push rewrites shared history. Use git merge --no-edit origin/main and a normal push."
      fi
      if grep -Eq -- '[[:space:]](-[A-Za-z]*d[A-Za-z]*|--del(e(t(e)?)?)?|--prune)([[:space:]]|$)|[[:space:]]:[A-Za-z0-9_./-]+' <<< "$s"; then
        block "deleting remote branches is for the branch's human owner."
      fi
      grep -Eq -- "(^|[[:space:]/])git[[:space:]].*push[[:space:]].*[[:space:]:+](refs/heads/)?(main|master|$base)([[:space:]]|$)" <<< "$s" &&
        block "$(push_base_msg "$base")"
      # The claims branch holds the coordination state; only uak commands write it (their pushes skip this hook).
      grep -Eq -- '(^|[[:space:]/])git[[:space:]].*push[[:space:]].*[[:space:]:+](refs/heads/)?claims([[:space:]]|$)' <<< "$s" &&
        block "$(push_claims_msg)"
      case "$s" in *'$'*|*'\'*)
        push_dynamic "$s" &&
          dyn="a git push whose ref is dynamic (variable, substitution, backslash): the guard cannot read it. Run it only if the human asked for exactly this.";;
      esac;;
    esac
    case "$s" in *git*reset*--ha*)
      grep -Eq '(^|[[:space:]/])git[[:space:]].*reset[[:space:]](.*[[:space:]])?--ha(r(d)?)?([[:space:]]|$)' <<< "$s" &&
        block "git reset --hard destroys uncommitted work. Use git stash or a wip: commit.";;
    esac
    case "$s" in *git*clean*-*)
      grep -Eq '(^|[[:space:]/])git[[:space:]].*clean[[:space:]](.*[[:space:]])?(-[A-Za-z]*f[A-Za-z]*|--fo(r(c(e)?)?)?)([[:space:]]|$)' <<< "$s" &&
        block "git clean -f deletes untracked files (including .env). Delete your files one by one.";;
    esac
    case "$s" in *git*worktree*remove*)
      grep -Eq '(^|[[:space:]/])git[[:space:]].*worktree[[:space:]]+remove.*(--fo(r(c(e)?)?)?|[[:space:]]-[A-Za-z]*f[A-Za-z]*)([[:space:]]|$)' <<< "$s" &&
        block "worktree remove --force loses uncommitted changes. Use bash .uak/bin/wt rm ID (your task) or bash .uak/bin/wt rm --review PATH (a detached review checkout).";;
    esac
    # `branch` must be the git subcommand and -D a flag of its own: "git clone --branch X …/app-DATA.git" is not a
    # branch delete (MLB hackathon: a clone of the team repo was blocked). -d with -f/--force is -D.
    case "$s" in *-*git*branch*|*git*-*branch*|*git*branch*-*)
      if grep -Eq '(^|[[:space:]/])git([[:space:]]+(-[Cc][[:space:]]+[^[:space:]]+|--git-dir[= ][^[:space:]]+|--work-tree[= ][^[:space:]]+|-[^[:space:]]+))*[[:space:]]+branch[[:space:]]' <<< "$s"; then
        { grep -Eq '[[:space:]](-[A-Za-z]*D[A-Za-z]*)([[:space:]]|$)' <<< "$s" ||
          { grep -Eq '[[:space:]](-[A-Za-z]*d[A-Za-z]*|--del(e(t(e)?)?)?)([[:space:]]|$)' <<< "$s" &&
            grep -Eq '[[:space:]](-[A-Za-z]*f[A-Za-z]*|--fo(r(c(e)?)?)?)([[:space:]]|$)' <<< "$s"; }; } &&
          block "git branch -D: delete only your merged branches, with -d."
      fi;;
    esac
    case "$s" in *--no-verify*|*git*commit*-*)
      grep -Eq '(^|[[:space:]])--no-verify([[:space:]]|$)|(^|[[:space:]/])git[[:space:]].*commit[[:space:]](.*[[:space:]])?-[A-Za-z]*n[A-Za-z]*([[:space:]]|$)' <<< "$s" &&
        block "--no-verify skips the pre-commit secret scanner.";;
    esac
    case "$s" in *kill*)
      grep -Eq '(^|[[:space:]])(pkill[[:space:]]+(-[A-Za-z0-9]+[[:space:]]+)*(-[A-Za-z]*f|--full)|killall)([[:space:]]|$)' <<< "$s" &&
        block "pkill -f/killall match by pattern and can kill your own shell or other agents' servers (UpiixSol). Kill exact PIDs: bash .uak/bin/wt stop, or kill \$(lsof -ti tcp:\$UAK_PORT).";;
    esac
    case "$s" in *sudo*)
      grep -Eq '(^|[[:space:]])sudo([[:space:]]|$)' <<< "$s" &&
        block "sudo needs the human: ask them to run it themselves. Never ask for or use their password.";;
    esac
    # rm with -r anywhere among its flags and any argument that is /, ~, $HOME, .., .git or *.
    case "$s" in *-*rm*|*rm*-*)
      if grep -Eq '(^|[[:space:]/])rm[[:space:]]' <<< "$s" && grep -Eq '[[:space:]](-[A-Za-z]*[rR][A-Za-z]*|--recursive)([[:space:]]|$)' <<< "$s"; then
        grep -Eq '[[:space:]](/|~|~/[^[:space:]]*|\$HOME|\$\{HOME\}|\.\.|\.\./[^[:space:]]*|\.git|\.git/[^[:space:]]*|\*)/?([[:space:]]|$)' <<< "$s" &&
          block "rm -r outside your worktree or on .git. Delete concrete relative paths of your task."
      fi;;
    esac
    case "$s" in *curl*|*wget*)
      case "$cmd" in *'|'*)
        grep -Eq '(curl|wget)[[:space:]].*' <<< "$s" && grep -Eq '(curl|wget)[^|]*\|[[:space:]]*(sudo[[:space:]]+)?(ba|z|da)?sh([[:space:]]|$)' <<< "$cmd" &&
          block "curl | sh runs unreviewed remote code. Download, read, then run.";;
      esac;;
    esac
    case "$s" in *publish*|*upload*|*gh*|*docker*)
      grep -Eq '(npm|pnpm|yarn)[[:space:]]+publish|(uv|poetry)[[:space:]]+publish|twine[[:space:]]+upload|gh[[:space:]]+(repo[[:space:]]+(create|delete|edit)|release[[:space:]]+create)|docker[[:space:]]+push' <<< "$s" &&
        block "publishing outside the repo is a human action.";;
    esac
    # Marathon rules need the mode: read once, and only for a segment they could match.
    case "$s" in *git*push*|*npm*|*yarn*|*uv*|*pip*) [ -n "$m" ] || mode_var;; *) continue;; esac
    if [ "$m" = marathon ]; then
      # A refspec destination counts too (HEAD:main, feat/x:refs/heads/main). Why (audit): both pushed to main.
      case "$s" in *git*push*release*)
        grep -Eq 'git[[:space:]].*push[[:space:]].*[[:space:]:+](refs/heads/)?(release/[^[:space:]]*|release)([[:space:]]|$)' <<< "$s" &&
          block "marathon mode: main changes only via PR with green CI and human CODEOWNERS approval.";;
      esac
      case "$s" in *npm*|*yarn*|*uv*add*|*pip*install*)
        grep -Eq '(npm|pnpm|yarn)[[:space:]]+(install|add|i)([[:space:]]+-[^[:space:]]+)*[[:space:]]+[^-[:space:]]|uv[[:space:]]+add[[:space:]]|pip[[:space:]]+install([[:space:]]+-[^[:space:]]+)*[[:space:]]+[^-[:space:]]' <<< "$s" &&
          block "marathon mode: a new dependency needs uak decision (license, maintenance, audit) and approval.";;
      esac
    fi
  done <<UAK_SEGMENTS
$SEGS
UAK_SEGMENTS
  # .env reads, checked on the command with prose removed: a quoted text of 3+ words is a prompt or a message,
  # not a file operation, unless the command runs it as code (sh -c, eval, ssh).
  # Why (Reap buildathon): `codex exec "... never cat .env ..."` was blocked as a .env read.
  # Both checks need the text ".env".
  case "$envcmd" in *.env*) ;; *) envcmd=;; esac
  # Input redirection from .env, and git show REV:.env.
  [ -z "$envcmd" ] || ! grep -Eq '<[[:space:]]*["'"'"']?\.env(\.[a-z]+)?["'"'"']?([[:space:]]|$)|:\.env(\.[a-z]+)?([[:space:]]|$)' <<< "$envcmd" ||
    block ".env holds secrets and never enters context. Read .env.example or ask which variable exists."
  SEGS=; [ -z "$envcmd" ] || segments "$envcmd"
  [ -z "$SEGS" ] || while IFS= read -r seg; do
    # cp only when .env is the source: `cp .env.example .env` is the standard setup step (audit: it was blocked).
    case "$seg" in *.env*) ;; *) continue;; esac
    grep -Eq '(cat|less|more|head|tail|bat|grep|rg|sed|awk|scp|base64|xxd|strings|source|nl|tac|cut|od|hexdump|diff|paste|sort|\.)[[:space:]]([^#]*[[:space:]/"'"'"'])?["'"'"']?\.env(\.(local|production|prod|dev|development|staging|test))?\*?["'"'"']?([[:space:]]|$)|(^|[[:space:]])cp[[:space:]]+(-[A-Za-z]+[[:space:]]+)*["'"'"']?\.env(\.(local|production|prod|dev|development|staging|test))?["'"'"']?[[:space:]]' <<< " $seg " &&
      block ".env holds secrets and never enters context. Read .env.example or ask which variable exists."
  done <<UAK_SEGMENTS
$SEGS
UAK_SEGMENTS
  [ -z "$dyn" ] || ask_human "$dyn"
  [ -z "$human_cmd" ] || ask_human "UAK_HUMAN is human authority (plan, allow, retire, register-reviewer, handover of another agent's task, a human integrate). Run it only if the human asked for exactly this."
  return 0
}
strip_prose() {
  awk 'BEGIN { q = sprintf("%c", 39); re = "\"[^\"]*\"|" q "[^" q "]*" q }
  {
    s = $0; out = ""
    while (match(s, re)) {
      t = substr(s, RSTART, RLENGTH); n = split(t, w, /[[:space:]]+/)
      # A double-quoted span with $( or a backtick runs a command: the rules read it (audit of v6.5.0, #3).
      sub_ = (substr(t, 1, 1) == "\"" && (index(t, "$(") || index(t, "`")))
      out = out substr(s, 1, RSTART - 1) (n >= 3 && !sub_ ? "\"\"" : t); s = substr(s, RSTART + RLENGTH)
    }
    print out s }' <<< "$1"
}

check_prompt() {
  text=$1
  hit=
  # A key starts at a word boundary and mixes in digits: "task-assignment-notification-service" is a word, not
  # sk-… (audit, Oct 2026: three feature names were blocked as keys). sk_live_/rk_test_: Stripe.
  # Each grep runs only when its literal prefix is in the text (case is a builtin; most messages have none).
  case "$text" in *sk-*|*sk_*|*rk_*)
    grep -Eq '(^|[^A-Za-z0-9])(sk-(proj|ant|live|test|svcacct|admin)[-_]|[sr]k_(live|test)_)[A-Za-z0-9_-]{16,}' <<< "$text" && hit='API key (sk-…)';;
  esac
  case "$text" in *sk-*)
    grep -Eo '(^|[^A-Za-z0-9])sk-[A-Za-z0-9_-]{20,}' <<< "$text" | grep -q '[0-9]' && hit='API key (sk-…)';;
  esac
  case "$text" in *gh[pousr]_*|*github_pat_*)
    grep -Eq 'gh[pousr]_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{30,}' <<< "$text" && hit='GitHub token';;
  esac
  case "$text" in *AKIA*|*ASIA*) grep -Eq 'AKIA[0-9A-Z]{16}|ASIA[0-9A-Z]{16}' <<< "$text" && hit='AWS key';; esac
  case "$text" in *AIza*) grep -Eq 'AIza[0-9A-Za-z_-]{35}' <<< "$text" && hit='Google API key';; esac
  case "$text" in *xox*) grep -Eq 'xox[abprs]-[A-Za-z0-9-]{10,}' <<< "$text" && hit='Slack token';; esac
  case "$text" in *'PRIVATE KEY-----'*) grep -Eq -- '-----BEGIN [A-Z ]*PRIVATE KEY-----' <<< "$text" && hit='private key';; esac
  # A password is a whole word, then `:`, `=`, or the word is/es/of sudo…, then a value with a digit or a symbol:
  # "the password reset email is broken" is a bug report (audit: blocked, and so was "La contraseña es obligatoria").
  # The prefilter folds ASCII case as grep -i does in the C locale.
  case "$text" in *[Pp][Aa][Ss][Ss][Ww]*|*[Cc][Ll][Aa][Vv][Ee]*|*[Cc][Oo][Nn][Tt][Rr][Aa][Ss][Ee]*)
    grep -Eio '(^|[^A-Za-z])(contrase(n|ñ|\\u00f1)a|password|passwd|clave)([[:space:]]+(de|of|for|del|para)[[:space:]]+[^[:space:]]+)?[[:space:]]*(:|=|[[:space:]](es|is|sudo|root|admin)[[:space:]:=]+)[[:space:]]*[^[:space:]]{6,}' <<< "$text" |
      sed 's/.*[[:space:]:=]//' | grep -q '[0-9!@#$%^&*_+?~-]' && hit='password';;
  esac
  [ -z "$hit" ] && return 0
  printf 'UAK_GUARD: your message looks like it contains a secret (%s); it was NOT sent to the agent.\n' "$hit" >&2
  printf '%s\n' '- Put it in .env (git-ignored) from your editor; the agent only needs the variable name.' \
    '- If you already pasted it elsewhere, rotate it.' \
    '- Run sudo commands yourself; the agent never needs your password.' >&2
  exit 2
}

# Extract a string field from flat JSON (enough for hook payloads): up to the first quote no backslash escapes (a
# backslash keeps the next character, and a lone one at the end is kept). One match(), not a loop that added a
# character at a time. Why (Windows): that loop took 35 s on a 300-line heredoc, past the 5 s hook timeout, and a
# timed-out hook lets the command run.
json_field() {
  awk -v key="$1" 'BEGIN {RS="\001"} {
    k="\"" key "\""; i=index($0,k); if(!i) exit
    s=substr($0,i+length(k)); sub(/^[[:space:]]*:[[:space:]]*"/,"",s)
    match(s, /^([^"\\]|\\.)*/); out=substr(s, 1, RLENGTH)
    if (substr(s, RLENGTH + 1) == "\\") out = out "\\"
    gsub(/\\"/,"\"",out); gsub(/\\\\/,"\\",out); print out}'
}
# The same field, read by builtins into JF. Why (Windows): command substitution, printf and awk were three of the
# processes every guarded command waited for. Over 4 KB the loop below copies the rest at every escape, so awk
# reads it; awk also reads a payload with \001, its record separator.
# A backslash in an expanded pattern escapes the next character, as in a literal one.
P_ESC='[\\"]' P_QQ='\\"' P_BB='\\\\' Q='"' B='\' P_SOH=$'\001'
json_field_var() { # $1 key, $2 JSON → JF
  local s=$2 k="\"$1\"" t pre
  JF=
  # Bash 3.2 (macOS): its pattern operations are slow and a process is cheap there; awk reads it.
  [ "${BASH_VERSINFO[0]}" -ge 4 ] || { JF=$(printf '%s' "$s" | json_field "$1"); return 0; }
  if [ "${#s}" -gt 4096 ]; then JF=$(printf '%s' "$s" | json_field "$1"); return 0; fi
  case "$s" in *$P_SOH*) JF=$(printf '%s' "$s" | json_field "$1"); return 0;; esac
  case "$s" in *"$k"*) ;; *) return 0;; esac
  s=${s#*"$k"}
  # As sub(/^[[:space:]]*:[[:space:]]*"/): all of it or nothing.
  t=${s#"${s%%[![:space:]]*}"}
  case "$t" in :*) t=${t#:}; t=${t#"${t%%[![:space:]]*}"}; case "$t" in \"*) s=${t#\"};; esac;; esac
  # Up to the first quote that no backslash escapes; a backslash keeps the next character.
  while :; do
    pre=${s%%$P_ESC*}
    JF=$JF$pre
    [ "${#pre}" -lt "${#s}" ] || break
    s=${s:${#pre}}
    case "$s" in \\*) JF=$JF${s:0:2}; s=${s:2};; *) break;; esac
  done
  JF=${JF//$P_QQ/"$Q"}; JF=${JF//$P_BB/"$B"}   # kit-lint: ok (at most 4 KB, and bash 3.2 returned to awk above)
  while :; do case "$JF" in *"$NL") JF=${JF%"$NL"};; *) break;; esac; done
}

# Subagent resource manager (PreToolUse matcher Agent|Task, and SubagentStop).
# Why: ultracode is exempt from Claude Code's concurrency cap, and one prompt can fan out dozens of
# Opus subagents. Budgets come from .uak/PROJECT.md: Max-Parallel-Subagents, Opus-Subagents-Per-Session.
cfg() { top=$(git rev-parse --show-toplevel 2>/dev/null) || { printf '%s' "$2"; return; }
  uak_cfg_var "$top/.uak/PROJECT.md" "$1"
  case "$CFG" in ''|*[!0-9]*) printf '%s' "$2";; *) printf '%s' "$CFG";; esac; }
model_of_agent() { # $1 agent type → model declared by its definition in any harness
  top=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
  for f in "$top/.cursor/agents/$1.md" "$top/.claude/agents/$1.md" "$top/.gemini/agents/$1.md"; do
    [ -f "$f" ] && { sed -n 's/^model:[[:space:]]*//p' "$f" | head -n 1 | tr -d '\r"'"'"; return; }
  done
  f="$top/.codex/agents/$1.toml"
  [ -f "$f" ] && sed -n 's/^model[[:space:]]*=[[:space:]]*//p' "$f" | head -n 1 | tr -d '\r"'"'"
}
# Tiers are harness-neutral. Order matters: gpt-5.6-sol is the strong model of its family, gpt-6.1-sol the balanced one.
tier_class() {
  case "$(printf '%s' "$1" | tr 'A-Z' 'a-z')" in
    ''|inherit) printf inherit;;
    *opus*|*fable*|*mythos*|*astra*|*gpt-5.6-sol*|*gpt-5-6-sol*|best) printf strong;;
    *haiku*|*luna*|*composer*|*flash*|*-mini*|*-nano*) printf fast;;
    *sonnet*|*sol*|*terra*|*gemini*pro*|*gpt-*) printf balanced;;
    *) printf inherit;;
  esac
}
tier_of() { # $1 model param, $2 subagent type → strong|balanced|fast|inherit
  m=$1
  [ -n "$m" ] || m=$(model_of_agent "$2")
  if [ -z "$m" ]; then
    case "$2" in
      general-purpose|Explore|Plan) m=${CLAUDE_CODE_SUBAGENT_MODEL:-};;
      default|worker|explorer)
        top=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
        m=$(sed -n 's/^default_subagent_model[[:space:]]*=[[:space:]]*//p' "$top/.codex/config.toml" 2>/dev/null | head -n 1 | tr -d '\r"');;
    esac
  fi
  tier_class "$m"
}
# One launch at a time reads, checks and writes the reservations: 12 parallel launches with Max-Parallel 4 let 6
# through and lost reservations (audit, Oct 2026). mkdir is atomic everywhere; a lock older than 10 s is a crashed
# hook's (the hook timeout is 5 s), and the wait stays under that timeout.
agents_lock() {
  local l="$1/uak-agents.lock" i=0 t now pid
  while ! mkdir "$l" 2>/dev/null; do
    now=$(date +%s); t=$(cat "$l/at" 2>/dev/null); pid=$(cat "$l/pid" 2>/dev/null)
    case "$t" in ''|*[!0-9]*) t=$now;; esac
    # Stale: its hook died (no such process), or it has no PID and is older than 10 s. Broken by renaming it first, which only one
    # waiter can do: two waiters removing it in turn freed a lock a third had just taken (CI: 7 launches with cap 4).
    if { [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; } || { [ -z "$pid" ] && [ $((now - t)) -gt 10 ]; }; then
      if mv "$l" "$l.stale.$$" 2>/dev/null; then rm -rf "$l.stale.$$"; fi
      continue
    fi
    i=$((i + 1)); [ "$i" -lt 80 ] || block "another subagent launch is being counted; try again in a few seconds."
    sleep 0.1 2>/dev/null || sleep 1
  done
  printf '%s\n' "$$" > "$l/pid" 2>/dev/null; date +%s > "$l/at" 2>/dev/null
  AGENTS_LOCK=$l
  trap 'rm -f "$AGENTS_LOCK/at" "$AGENTS_LOCK/pid"; rmdir "$AGENTS_LOCK" 2>/dev/null' EXIT
}
check_agent() {
  input=$1 gd=$(git rev-parse --git-dir 2>/dev/null || printf '%s' "${TMPDIR:-/tmp}")
  now=${UAK_NOW:-$(date +%s)}
  type=$(printf '%s' "$input" | json_field subagent_type); [ -n "$type" ] || type=$(printf '%s' "$input" | json_field agent_type)
  # Claude Code puts the chosen model in tool_input; Codex/Cursor start events carry the PARENT's model, so ignore it.
  case "$input" in *'"tool_name"'*) model=$(printf '%s' "$input" | json_field model);; *) model=;; esac
  sid=$(printf '%s' "$input" | json_field session_id); sid=${sid:-default}
  tier=$(tier_of "$model" "$type")
  # `uak pace` scales both caps with plan usage: surge 2x, conserve 1/2, critical 1 and no strong model.
  set -- $(bash "$here/pace" --caps 2>/dev/null)
  level=${1:-unknown} max=${2:-} opus_max=${3:-}
  case "$max" in ''|*[!0-9]*) max=$(cfg Max-Parallel-Subagents 4);; esac
  case "$opus_max" in ''|*[!0-9]*) opus_max=$(cfg Opus-Subagents-Per-Session 2);; esac
  why=; case "$level" in surge|conserve|critical) why=" (pace $level: uak pace)";; esac
  # Hard limits: fixed numbers that pacing can lower but never raise. Why: if a usage reading is wrong
  # (stale cache, a bad manual entry, a vendor format change), a surge must not empty the plan in minutes.
  case "$(mode)" in marathon) d_hard=4 d_strong=4 d_total=30 d_machine=6;; *) d_hard=6 d_strong=3 d_total=40 d_machine=8;; esac
  hard=$(cfg Subagent-Hard-Cap "$d_hard"); strong_hard=$(cfg Strong-Hard-Cap "$d_strong")
  total_max=$(cfg Subagents-Per-Session "$d_total"); machine_max=$(cfg Subagents-Per-Machine "$d_machine")
  burst_max=$(cfg Subagent-Burst-Per-Minute 6)
  [ "$max" -le "$hard" ] || max=$hard
  [ "$opus_max" -le "$strong_hard" ] || opus_max=$strong_hard
  act="$gd/uak-agents.active" log="$gd/uak-agents.log"
  agents_lock "$gd"
  touch "$act" "$log"
  # Reservations older than 20 min are stale (a crashed subagent never sent SubagentStop).
  awk -v now="$now" '$1 + 1200 > now' "$act" > "$act.tmp" && mv "$act.tmp" "$act"
  spawned=$(awk -v s="$sid" '$2 == s' "$log" | awk 'END {print NR+0}')
  [ "$spawned" -lt "$total_max" ] ||
    block "this session already spawned $spawned subagents (Subagents-Per-Session: $total_max). Hand off (/uak-handoff) and start a fresh session, or a human raises the limit in .uak/PROJECT.md."
  burst=$(awk -v s="$sid" -v now="$now" '$2 == s && $1 + 60 > now' "$log" | awk 'END {print NR+0}')
  [ "$burst" -lt "$burst_max" ] ||
    block "$burst subagents spawned in the last minute (Subagent-Burst-Per-Minute: $burst_max). A loop that spawns agents is a bug: stop and check the plan."
  # Machine-wide: every worktree of this repo shares one plan, so count all of their running subagents.
  cd_common=$(git rev-parse --git-common-dir 2>/dev/null) && cd_common=$(cd "$cd_common" 2>/dev/null && pwd -P) || cd_common=
  if [ -n "$cd_common" ]; then
    machine=$(for f in "$cd_common/uak-agents.active" "$cd_common"/worktrees/*/uak-agents.active; do
      [ -f "$f" ] && awk -v now="$now" '$1 + 1200 > now' "$f"; done | awk 'END {print NR+0}')
    [ "$machine" -lt "$machine_max" ] ||
      block "$machine subagents are running across all worktrees on this machine (Subagents-Per-Machine: $machine_max). Wait for one, or do the step yourself."
  fi
  running=$(awk 'END {print NR+0}' "$act")
  [ "$running" -lt "$max" ] ||
    block "$running subagents already running (Max-Parallel-Subagents: $max$why). Wait for one to finish, or do the step yourself; a swarm costs more than it saves."
  if [ "$tier" = strong ] && [ "${UAK_ALLOW_OPUS:-}" != 1 ]; then
    used=$(awk -v s="$sid" '$2 == s && ($3 == "strong" || $3 == "opus")' "$log" | awk 'END {print NR+0}')
    [ "$used" -lt "$opus_max" ] ||
      block "Opus subagent budget (strong tier: Opus, Astra, GPT-5.6 Sol) for this session is spent ($used/$opus_max$why). Use the advisor at a checkpoint, a fast scout to read, or a balanced reviewer. A human can raise Opus-Subagents-Per-Session or set UAK_ALLOW_OPUS=1."
  fi
  printf '%s %s %s %s\n' "$now" "$sid" "$tier" "${type:-unknown}" >> "$log"
  printf '%s %s %s\n' "$now" "$tier" "${type:-unknown}" >> "$act"
  return 0
}
agent_stop() {
  gd=$(git rev-parse --git-dir 2>/dev/null) || return 0
  act="$gd/uak-agents.active"; [ -s "$act" ] || return 0
  agents_lock "$gd"
  sed '1d' "$act" > "$act.tmp" && mv "$act.tmp" "$act"
}

shell_tool() { # tool names of the shell in each harness' PreToolUse/BeforeTool payload
  # PowerShell: Claude Code's shell on Windows without Git Bash (audit: no rule applied to it).
  case "$1" in *'"tool_name":"Bash"'*|*'"tool_name": "Bash"'*|*'"tool_name":"Shell"'*|*'"tool_name": "Shell"'*|\
    *'"tool_name":"PowerShell"'*|*'"tool_name": "PowerShell"'*|\
    *'"tool_name":"shell"'*|*'"tool_name": "shell"'*|*'"tool_name":"exec_command"'*|*'"tool_name": "exec_command"'*|\
    *'"tool_name":"local_shell"'*|*'"tool_name": "local_shell"'*|*'"tool_name":"run_shell_command"'*|*'"tool_name": "run_shell_command"'*) return 0;; esac
  return 1
}
case "${1:-}" in
  agent)
    input=$(cat 2>/dev/null || true)
    case "$input" in
      *'"tool_name":"Agent"'*|*'"tool_name": "Agent"'*|*'"tool_name":"Task"'*|*'"tool_name": "Task"'*) ;;   # Claude Code, Cursor preToolUse
      *'"hook_event_name":"SubagentStart"'*|*'"hook_event_name": "SubagentStart"'*|*'"hook_event_name":"subagentStart"'*|*'"hook_event_name": "subagentStart"'*) ;;  # Codex, Cursor
      *) exit 0;;
    esac
    check_agent "$input";;
  agent-stop) cat >/dev/null 2>&1 || true; agent_stop;;
  # stdin by read, not $(cat): one process less on every hook call.
  bash)
    IFS= read -r -d '' input || true
    shell_tool "$input" || exit 0
    [ "${2:-}" != claude ] || GUARD_HARNESS=claude
    json_field_var command "$input"; check_bash "$JF";;
  shell)
    IFS= read -r -d '' input || true
    json_field_var command "$input"; check_bash "$JF";;
  prompt)
    IFS= read -r -d '' input || true
    json_field_var prompt "$input"; check_prompt "$JF";;
  check) GUARD_HARNESS=check; check_bash "${2:-}"; printf 'UAK_GUARD: allowed\n';;
  check-prompt) check_prompt "${2:-}"; printf 'UAK_GUARD: allowed\n';;
  # The pre-push hook asks about the ref git is about to update (its real name, not text): blocked when it is the base
  # branch or the claims branch. Why (review of UAK-111): a ref built by a command or a script is invisible to the text
  # filter above; at push time git knows it.
  push-ref) ref=${2:-}; ref=${ref#refs/heads/}; base=${UAK_BASE:-main}
    case "$ref" in
      "$base"|main|master) block "$(push_base_msg "$base")";;
      claims) block "$(push_claims_msg)";;
    esac; exit 0;;
  tier) printf '%s\n' "$(tier_class "${2:-}")";;
  *) printf '%s\n' 'Usage: guard bash|shell|prompt|agent|agent-stop (hook JSON on stdin) · guard check "CMD" · guard check-prompt "TEXT" · guard tier MODEL' >&2; exit 2;;
esac
exit 0
