#!/usr/bin/env bash
# uak guards for agent hooks: Claude Code, Codex, Cursor and Gemini CLI (also callable by hand). Bash 3.2+, no jq.
#   guard bash     (PreToolUse/BeforeTool on the shell tool): blocks destructive or publishing commands
#                  even when chained (`cd x && git push --force`).
#   guard shell    (Cursor beforeShellExecution): the same rule on a top-level "command".
#   guard agent / agent-stop   subagent parallel cap + strong-model budget, scaled by `uak pace`.
#   guard prompt   (UserPromptSubmit): blocks human messages that contain secrets.
#   guard check "COMANDO"   manual test of the bash rule (exit 2 = blocked).
# Why: at Hack-Nation 2026 the settings.json deny list (prefix match) missed a chained force-push
# and `worktree remove --force`, and a human pasted an API key and a sudo password into the chat.
# Exit: 0 = allowed; 2 = blocked (Claude Code shows stderr to the agent or human).
set -u
LC_ALL=C; export LC_ALL
MSYS2_ARG_CONV_EXCL="refs/;origin/;HEAD;FETCH_HEAD;:"; export MSYS2_ARG_CONV_EXCL

# The first "Mode:" line of PROJECT.md, read with builtins (as sed | head | tr did).
mode_var() { # sets m: sprint or marathon
  m=sprint
  top=$(git rev-parse --show-toplevel 2>/dev/null) || return 0
  uak_cfg_var "$top/.uak/PROJECT.md" Mode
  [ "$CFG" != marathon ] || m=marathon
}
mode() { mode_var; printf '%s' "$m"; }

# No dirname and no subshell: guard never changes directory, so the relative path works. Why (Windows): a process
# costs 20-50 ms in Git Bash, and guard runs before every command of the agent.
case $0 in */*|*\\*) here=${0%[/\\]*};; *) here=.;; esac   # a Windows caller may pass D:\a\…\guard
# The one PROJECT.md reader (builtins, no process).
. "$here/lib/config.sh" 2>/dev/null || . "$(dirname "$0")/lib/config.sh"
# Every block also goes to the black box: a rule that fires often is friction worth fixing.
block() { printf 'UAK_GUARD: blocked · %s\n' "$*" >&2; bash "$here/bb" auto guard guard "$*" >/dev/null 2>&1 || true; exit 2; }

# Split into segments on ; && || | and newlines (including JSON-escaped \n). `<` becomes a space: `cat<.env` is a read.
# Parameter expansion, not awk: no process. A doubled delimiter (|| or a lone & next to &&) only adds an empty
# segment, which no rule matches.
# The patterns are variables: bash 3.2 misparses ( ) < > & inside ${…}.
# ${s//…} with many matches costs matches × length on bash 3.2 (macOS): 0.6 s at 1.8 KB, 437 s at 18 KB (a 300-line
# heredoc outlasted the 5 s hook timeout). There tr always does it (a process is cheap on macOS); on bash 4+ only
# past 1 KB (a process costs 20-50 ms on Git Bash).
SHORT=1024; [ "${BASH_VERSINFO[0]}" -ge 4 ] || SHORT=0
SHORT=${UAK_TEST_SHORT:-$SHORT}   # the tests run the long paths on short input
NL=$'\n' P_LT='<' P_AND='&&' P_SEP='[;|]' P_RULE='[;|&()`<>]'
segments() { # sets SEGS
  local s=$1 bs='\'
  if [ "${#s}" -gt "$SHORT" ]; then   # the awk of v5.9.1: a heredoc of HTML has thousands of <
    SEGS=$(printf '%s\n' "$s" | awk '{ gsub(/</, " "); gsub(/\\n|&&|\|\||;|\|/, "\n"); print }'); return 0
  fi
  s=${s//$P_LT/ }; s=${s//"$bs"n/$NL}; s=${s//$P_AND/$NL}; s=${s//$P_SEP/$NL}   # kit-lint: ok (at most SHORT chars: longer went to awk)
  SEGS=$s
}
# Rule segments also split on ( ) & > and backticks: `(cd x && git push -f)`, `git push --force&`, `…>/dev/null`.
rule_segments() { # sets SEGS
  local s=$1 bs='\'
  if [ "${#s}" -gt "$SHORT" ]; then
    SEGS=$(printf '%s\n' "$s" | awk '{ gsub(/\\n|&&|\|\||;|\||&|\(|\)|`|<|>/, "\n"); print }'); return 0
  fi
  s=${s//"$bs"n/$NL}; s=${s//$P_RULE/$NL}   # kit-lint: ok (at most SHORT chars: longer went to awk)
  SEGS=$s
}
# The command as the rules read it. JSON escapes the hook payload keeps: a backslash-newline continuation (\\ + \n)
# and \t are spaces. Why (audit, Oct 2026): `git push \<newline> --force` and `git push<TAB>--force` passed.
norm_cmd() { # sets cmd
  local c=$1 bs='\'
  if [ "${#c}" -gt "$SHORT" ]; then   # a Makefile or Go heredoc has a tab on every line
    cmd=$(printf '%s' "$c" | awk 'BEGIN { RS = "\001"; ORS = "" } { gsub(/\\\\n/, " "); gsub(/\\\n/, " "); gsub(/\\t/, " "); gsub(/\t/, " "); print }')
    return 0
  fi
  c=${c//"$bs$bs"n/ }; c=${c//"$bs"$'\n'/ }; c=${c//"$bs"t/ }; c=${c//$'\t'/ }
  cmd=$c
}

# The command runs text as code (sh -c, bash -x -c, $SHELL -c, eval, ssh, xargs, a here-string, a pipe into a
# shell): its quoted text is code, not prose. Why (audit): `bash -x -c "cat .env …"`, `bash <<< "…"` and
# `echo "…" | bash` passed, because their quotes were read as a message.
runs_code() {
  # Each branch of the pattern needs one of these words: most commands have none, and grep is a process.
  case "$1" in *sh*|*SH*|*eval*|*xargs*|*'<<<'*) ;; *) return 1;; esac
  grep -Eq '(^|[[:space:]/])((ba|z|da)?sh|\$\{?(SHELL|BASH|shell|bash)\}?)([[:space:]]+-[A-Za-z]+)*[[:space:]]+-[A-Za-z]*c([[:space:]]|$)|(^|[[:space:]])(eval|ssh|xargs)([[:space:]]|$)|<<<|\|[[:space:]]*(sudo[[:space:]]+)?([^[:space:]]*/)?((ba|z|da)?sh|\$\{?(SHELL|BASH)\}?)([[:space:]]|$)' <<< "$1"
}
# A segment that sets VAR for the command it runs: `VAR=x cmd`, `A=1 VAR=x cmd`, `env VAR=x cmd`,
# `export VAR=x`, `export VAR`, or the same inside `bash -c`. A search for the text (`rg UAK_NOW= bin/`) does not.
assigns() { # $1 VAR, $2 segment
  printf '%s' "$2" | grep -Eq "(^[[:space:]]*|[[:space:]]-[A-Za-z]*c[[:space:]]+)((export|env|declare|typeset|readonly|local|command|exec|nohup|time)([[:space:]]+-[A-Za-z-]+)*[[:space:]]+)*([A-Za-z_][A-Za-z0-9_]*=[^[:space:]]*[[:space:]]+)*$1=|(^|[[:space:]])(export|declare[[:space:]]+-[A-Za-z]*x[A-Za-z]*|typeset[[:space:]]+-[A-Za-z]*x[A-Za-z]*)([[:space:]]+[A-Za-z_][A-Za-z0-9_]*(=[^[:space:]]*)?)*[[:space:]]+$1([[:space:]]|$)"
}
# Human-only commands (UAK_HUMAN: plan, allow, retire, register-reviewer, handover of others' tasks, a human
# integrate) need the human's yes. Claude Code (`guard bash claude`): "ask", so the prompt shows even for an
# allow-listed `bash .uak/bin/uak`. Harnesses without "ask": blocked; the human runs it in their own terminal.
# Why (Hacktoberfest second autopsy): an agent prefixed UAK_HUMAN to record a human's approval and merge.
GUARD_HARNESS=
ask_human() {
  case "$GUARD_HARNESS" in
    claude)
      bash "$here/bb" auto guard guard "ask: $*" >/dev/null 2>&1 || true
      printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"ask","permissionDecisionReason":"UAK_GUARD: %s"}}\n' "$*"
      exit 0;;
    check) printf 'UAK_GUARD: ask · %s\n' "$*" >&2; exit 3;;
  esac
  block "$* This harness cannot ask the human, so the human runs it in their own terminal."
}

check_bash() {
  norm_cmd "$1"; m=
  # Quoted prose (3+ words: a commit message, a uak msg) is not a command, unless the command runs it as code.
  # Quotes go, so "--force" is --force. Why (audit): `git commit -m "fix: push -d flag parsing"` was blocked as a
  # remote branch delete, and `git push "--force"` passed.
  # Speed (Windows, a process costs 20-50 ms in Git Bash): each rule runs grep only when its words are in the
  # segment (case is a builtin), and a command with no quotes has no prose to strip.
  rcmd=$cmd code=no
  if runs_code "$cmd"; then code=yes; else case "$cmd" in *[\"\']*) rcmd=$(strip_prose "$cmd");; esac; fi
  # envcmd: the .env checks read the command with its prose removed but its quotes kept.
  envcmd=$rcmd
  if [ "${#rcmd}" -le "$SHORT" ]; then rcmd=${rcmd//[\"\']/}; else rcmd=$(printf '%s' "$rcmd" | tr -d "\"'"); fi
  human_cmd=
  base=${UAK_BASE:-main}
  # Only segments with a risky word go through the rules: a 300-line heredoc took 7.5 s, past the hook's 5 s
  # timeout (and a timed-out hook lets the command run). A command with none of them has no such segment.
  case "$rcmd" in *git*|*rm*|*kill*|*sudo*|*curl*|*wget*|*publish*|*upload*|*gh*|*docker*|*npm*|*pnpm*|*yarn*|*pip*|*uv*|*UAK_*) rule_segments "$rcmd";; *) SEGS=;; esac
  # No segment, no here-document: Git Bash forks a child to feed one (Windows CI: 4 processes for `ls`).
  [ -z "$SEGS" ] || while IFS= read -r seg; do
    s=" $seg "
    case "$s" in *git*|*rm*|*kill*|*sudo*|*curl*|*wget*|*publish*|*upload*|*gh*|*docker*|*npm*|*pnpm*|*yarn*|*pip*|*uv*|*UAK_*) ;; *) continue;; esac
    # The clock is the engine's: a lease, a freeze or an offer window read at another time is a lie to everyone.
    case "$s" in *UAK_NOW*|*UAK_TEST_CLOCK*)
      { assigns UAK_NOW "$seg" || assigns UAK_TEST_CLOCK "$seg"; } &&
        block "UAK_NOW/UAK_TEST_CLOCK set the uak clock; only the test suite sets them. Run the command without it.";;
    esac
    case "$s" in *UAK_HUMAN*) assigns UAK_HUMAN "$seg" && human_cmd=yes;; esac
    # Merges reach main only through the gate (uak merge) or a human on the forge. Why (Hacktoberfest second
    # autopsy): 5 of 33 sprint merges were an agent's gh pr merge, and the only out-of-Paths merges were among them.
    case "$s" in *gh*merge*)
      grep -Eq '(^|[[:space:]/])gh[[:space:]]+pr[[:space:]]+merge([[:space:]]|$)|(^|[[:space:]/])gh[[:space:]]+api[[:space:]].*pulls/[0-9]+/merge' <<< "$s" &&
        block "gh pr merge skips the merge gate. Run bash .uak/bin/uak merge ID (Verify, scope and review on the merged result); a human merges on GitHub themselves.";;
    esac
    # A URL with user@ goes to the host after the @: `curl http://localhost:1@other-host/` passes an allow rule for
    # localhost (audit). A credential in a URL also lands in shell history and logs.
    case "$s" in *curl*@*|*wget*@*|*@*curl*|*@*wget*)
      grep -Eq '(^|[[:space:]/])(curl|wget)[[:space:]]' <<< "$s" && grep -Eq '[A-Za-z][A-Za-z0-9+.-]*://[^/[:space:]?#]*@' <<< "$s" &&
        block "a URL with user@host: it goes to the host after the @, and the credential lands in logs. Use the plain URL (curl -u reads a credential from .env through a variable).";;
    esac
    case "$s" in *git*push*)
      # Short flags cluster (-fu), long ones abbreviate (--for, --mirr): git accepts both.
      if grep -Eq -- '[[:space:]](-[A-Za-z]*f[A-Za-z]*|--for(c(e(-with-lease|-if-includes)?)?)?(=[^[:space:]]*)?|--mi(r(r(o(r)?)?)?)?)([[:space:]]|$)|[[:space:]]\+[A-Za-z0-9_./*:-]+|remote\.[^[:space:]]*\.mirror' <<< "$s"; then
        block "forced push rewrites shared history. Use git merge --no-edit origin/main and a normal push."
      fi
      if grep -Eq -- '[[:space:]](-[A-Za-z]*d[A-Za-z]*|--del(e(t(e)?)?)?|--prune)([[:space:]]|$)|[[:space:]]:[A-Za-z0-9_./-]+' <<< "$s"; then
        block "deleting remote branches is for the branch's human owner."
      fi
      grep -Eq -- "(^|[[:space:]/])git[[:space:]].*push[[:space:]].*[[:space:]:+](refs/heads/)?(main|master|$base)([[:space:]]|$)" <<< "$s" &&
        block "a push to $base skips the merge gate. Push your feat/ branch; bash .uak/bin/uak merge ID lands it on $base.";;
    esac
    case "$s" in *git*reset*--ha*)
      grep -Eq '(^|[[:space:]/])git[[:space:]].*reset[[:space:]](.*[[:space:]])?--ha(r(d)?)?([[:space:]]|$)' <<< "$s" &&
        block "git reset --hard destroys uncommitted work. Use git stash or a wip: commit.";;
    esac
    case "$s" in *git*clean*-*)
      grep -Eq '(^|[[:space:]/])git[[:space:]].*clean[[:space:]](.*[[:space:]])?(-[A-Za-z]*f[A-Za-z]*|--fo(r(c(e)?)?)?)([[:space:]]|$)' <<< "$s" &&
        block "git clean -f deletes untracked files (including .env). Delete your files one by one.";;
    esac
    case "$s" in *git*worktree*remove*)
      grep -Eq '(^|[[:space:]/])git[[:space:]].*worktree[[:space:]]+remove.*(--fo(r(c(e)?)?)?|[[:space:]]-[A-Za-z]*f[A-Za-z]*)([[:space:]]|$)' <<< "$s" &&
        block "worktree remove --force loses uncommitted changes. Use bash .uak/bin/wt rm ID (your task) or bash .uak/bin/wt rm --review PATH (a detached review checkout).";;
    esac
    # `branch` must be the git subcommand and -D a flag of its own: "git clone --branch X …/app-DATA.git" is not a
    # branch delete (MLB hackathon: a clone of the team repo was blocked). -d with -f/--force is -D.
    case "$s" in *-*git*branch*|*git*-*branch*|*git*branch*-*)
      if grep -Eq '(^|[[:space:]/])git([[:space:]]+(-[Cc][[:space:]]+[^[:space:]]+|--git-dir[= ][^[:space:]]+|--work-tree[= ][^[:space:]]+|-[^[:space:]]+))*[[:space:]]+branch[[:space:]]' <<< "$s"; then
        { grep -Eq '[[:space:]](-[A-Za-z]*D[A-Za-z]*)([[:space:]]|$)' <<< "$s" ||
          { grep -Eq '[[:space:]](-[A-Za-z]*d[A-Za-z]*|--del(e(t(e)?)?)?)([[:space:]]|$)' <<< "$s" &&
            grep -Eq '[[:space:]](-[A-Za-z]*f[A-Za-z]*|--fo(r(c(e)?)?)?)([[:space:]]|$)' <<< "$s"; }; } &&
          block "git branch -D: delete only your merged branches, with -d."
      fi;;
    esac
    case "$s" in *--no-verify*|*git*commit*-*)
      grep -Eq '(^|[[:space:]])--no-verify([[:space:]]|$)|(^|[[:space:]/])git[[:space:]].*commit[[:space:]](.*[[:space:]])?-[A-Za-z]*n[A-Za-z]*([[:space:]]|$)' <<< "$s" &&
        block "--no-verify skips the pre-commit secret scanner.";;
    esac
    case "$s" in *kill*)
      grep -Eq '(^|[[:space:]])(pkill[[:space:]]+(-[A-Za-z0-9]+[[:space:]]+)*(-[A-Za-z]*f|--full)|killall)([[:space:]]|$)' <<< "$s" &&
        block "pkill -f/killall match by pattern and can kill your own shell or other agents' servers (UpiixSol). Kill exact PIDs: bash .uak/bin/wt stop, or kill \$(lsof -ti tcp:\$UAK_PORT).";;
    esac
    case "$s" in *sudo*)
      grep -Eq '(^|[[:space:]])sudo([[:space:]]|$)' <<< "$s" &&
        block "sudo needs the human: ask them to run it themselves. Never ask for or use their password.";;
    esac
    # rm with -r anywhere among its flags and any argument that is /, ~, $HOME, .., .git or *.
    case "$s" in *-*rm*|*rm*-*)
      if grep -Eq '(^|[[:space:]/])rm[[:space:]]' <<< "$s" && grep -Eq '[[:space:]](-[A-Za-z]*[rR][A-Za-z]*|--recursive)([[:space:]]|$)' <<< "$s"; then
        grep -Eq '[[:space:]](/|~|~/[^[:space:]]*|\$HOME|\$\{HOME\}|\.\.|\.\./[^[:space:]]*|\.git|\.git/[^[:space:]]*|\*)/?([[:space:]]|$)' <<< "$s" &&
          block "rm -r outside your worktree or on .git. Delete concrete relative paths of your task."
      fi;;
    esac
    case "$s" in *curl*|*wget*)
      case "$cmd" in *'|'*)
        grep -Eq '(curl|wget)[[:space:]].*' <<< "$s" && grep -Eq '(curl|wget)[^|]*\|[[:space:]]*(sudo[[:space:]]+)?(ba|z|da)?sh([[:space:]]|$)' <<< "$cmd" &&
          block "curl | sh runs unreviewed remote code. Download, read, then run.";;
      esac;;
    esac
    case "$s" in *publish*|*upload*|*gh*|*docker*)
      grep -Eq '(npm|pnpm|yarn)[[:space:]]+publish|(uv|poetry)[[:space:]]+publish|twine[[:space:]]+upload|gh[[:space:]]+(repo[[:space:]]+(create|delete|edit)|release[[:space:]]+create)|docker[[:space:]]+push' <<< "$s" &&
        block "publishing outside the repo is a human action.";;
    esac
    # Marathon rules need the mode: read once, and only for a segment they could match.
    case "$s" in *git*push*|*npm*|*yarn*|*uv*|*pip*) [ -n "$m" ] || mode_var;; *) continue;; esac
    if [ "$m" = marathon ]; then
      # A refspec destination counts too (HEAD:main, feat/x:refs/heads/main). Why (audit): both pushed to main.
      case "$s" in *git*push*release*)
        grep -Eq 'git[[:space:]].*push[[:space:]].*[[:space:]:+](refs/heads/)?(release/[^[:space:]]*|release)([[:space:]]|$)' <<< "$s" &&
          block "marathon mode: main changes only via PR with green CI and human CODEOWNERS approval.";;
      esac
      case "$s" in *npm*|*yarn*|*uv*add*|*pip*install*)
        grep -Eq '(npm|pnpm|yarn)[[:space:]]+(install|add|i)([[:space:]]+-[^[:space:]]+)*[[:space:]]+[^-[:space:]]|uv[[:space:]]+add[[:space:]]|pip[[:space:]]+install([[:space:]]+-[^[:space:]]+)*[[:space:]]+[^-[:space:]]' <<< "$s" &&
          block "marathon mode: a new dependency needs uak decision (license, maintenance, audit) and approval.";;
      esac
    fi
  done <<UAK_SEGMENTS
$SEGS
UAK_SEGMENTS
  # .env reads, checked on the command with prose removed: a quoted text of 3+ words is a prompt or a message,
  # not a file operation, unless the command runs it as code (sh -c, eval, ssh).
  # Why (Reap buildathon): `codex exec "... never cat .env ..."` was blocked as a .env read.
  # Both checks need the text ".env".
  case "$envcmd" in *.env*) ;; *) envcmd=;; esac
  # Input redirection from .env, and git show REV:.env.
  [ -z "$envcmd" ] || ! grep -Eq '<[[:space:]]*["'"'"']?\.env(\.[a-z]+)?["'"'"']?([[:space:]]|$)|:\.env(\.[a-z]+)?([[:space:]]|$)' <<< "$envcmd" ||
    block ".env holds secrets and never enters context. Read .env.example or ask which variable exists."
  SEGS=; [ -z "$envcmd" ] || segments "$envcmd"
  [ -z "$SEGS" ] || while IFS= read -r seg; do
    # cp only when .env is the source: `cp .env.example .env` is the standard setup step (audit: it was blocked).
    case "$seg" in *.env*) ;; *) continue;; esac
    grep -Eq '(cat|less|more|head|tail|bat|grep|rg|sed|awk|scp|base64|xxd|strings|source|nl|tac|cut|od|hexdump|diff|paste|sort|\.)[[:space:]]([^#]*[[:space:]/"'"'"'])?["'"'"']?\.env(\.(local|production|prod|dev|development|staging|test))?\*?["'"'"']?([[:space:]]|$)|(^|[[:space:]])cp[[:space:]]+(-[A-Za-z]+[[:space:]]+)*["'"'"']?\.env(\.(local|production|prod|dev|development|staging|test))?["'"'"']?[[:space:]]' <<< " $seg " &&
      block ".env holds secrets and never enters context. Read .env.example or ask which variable exists."
  done <<UAK_SEGMENTS
$SEGS
UAK_SEGMENTS
  [ -z "$human_cmd" ] || ask_human "UAK_HUMAN is human authority (plan, allow, retire, register-reviewer, handover of another agent's task, a human integrate). Run it only if the human asked for exactly this."
  return 0
}
strip_prose() {
  awk 'BEGIN { q = sprintf("%c", 39); re = "\"[^\"]*\"|" q "[^" q "]*" q }
  {
    s = $0; out = ""
    while (match(s, re)) {
      t = substr(s, RSTART, RLENGTH); n = split(t, w, /[[:space:]]+/)
      out = out substr(s, 1, RSTART - 1) (n >= 3 ? "\"\"" : t); s = substr(s, RSTART + RLENGTH)
    }
    print out s }' <<< "$1"
}

check_prompt() {
  text=$1
  hit=
  # A key starts at a word boundary and mixes in digits: "task-assignment-notification-service" is a word, not
  # sk-… (audit, Oct 2026: three feature names were blocked as keys). sk_live_/rk_test_: Stripe.
  # Each grep runs only when its literal prefix is in the text (case is a builtin; most messages have none).
  case "$text" in *sk-*|*sk_*|*rk_*)
    grep -Eq '(^|[^A-Za-z0-9])(sk-(proj|ant|live|test|svcacct|admin)[-_]|[sr]k_(live|test)_)[A-Za-z0-9_-]{16,}' <<< "$text" && hit='API key (sk-…)';;
  esac
  case "$text" in *sk-*)
    grep -Eo '(^|[^A-Za-z0-9])sk-[A-Za-z0-9_-]{20,}' <<< "$text" | grep -q '[0-9]' && hit='API key (sk-…)';;
  esac
  case "$text" in *gh[pousr]_*|*github_pat_*)
    grep -Eq 'gh[pousr]_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{30,}' <<< "$text" && hit='GitHub token';;
  esac
  case "$text" in *AKIA*|*ASIA*) grep -Eq 'AKIA[0-9A-Z]{16}|ASIA[0-9A-Z]{16}' <<< "$text" && hit='AWS key';; esac
  case "$text" in *AIza*) grep -Eq 'AIza[0-9A-Za-z_-]{35}' <<< "$text" && hit='Google API key';; esac
  case "$text" in *xox*) grep -Eq 'xox[abprs]-[A-Za-z0-9-]{10,}' <<< "$text" && hit='Slack token';; esac
  case "$text" in *'PRIVATE KEY-----'*) grep -Eq -- '-----BEGIN [A-Z ]*PRIVATE KEY-----' <<< "$text" && hit='private key';; esac
  # A password is a whole word, then `:`, `=`, or the word is/es/of sudo…, then a value with a digit or a symbol:
  # "the password reset email is broken" is a bug report (audit: blocked, and so was "La contraseña es obligatoria").
  # The prefilter folds ASCII case as grep -i does in the C locale.
  case "$text" in *[Pp][Aa][Ss][Ss][Ww]*|*[Cc][Ll][Aa][Vv][Ee]*|*[Cc][Oo][Nn][Tt][Rr][Aa][Ss][Ee]*)
    grep -Eio '(^|[^A-Za-z])(contrase(n|ñ|\\u00f1)a|password|passwd|clave)([[:space:]]+(de|of|for|del|para)[[:space:]]+[^[:space:]]+)?[[:space:]]*(:|=|[[:space:]](es|is|sudo|root|admin)[[:space:]:=]+)[[:space:]]*[^[:space:]]{6,}' <<< "$text" |
      sed 's/.*[[:space:]:=]//' | grep -q '[0-9!@#$%^&*_+?~-]' && hit='password';;
  esac
  [ -z "$hit" ] && return 0
  printf 'UAK_GUARD: your message looks like it contains a secret (%s); it was NOT sent to the agent.\n' "$hit" >&2
  printf '%s\n' '- Put it in .env (git-ignored) from your editor; the agent only needs the variable name.' \
    '- If you already pasted it elsewhere, rotate it.' \
    '- Run sudo commands yourself; the agent never needs your password.' >&2
  exit 2
}

# Extract a string field from flat JSON (enough for hook payloads): up to the first quote no backslash escapes (a
# backslash keeps the next character, and a lone one at the end is kept). One match(), not a loop that added a
# character at a time. Why (Windows): that loop took 35 s on a 300-line heredoc, past the 5 s hook timeout, and a
# timed-out hook lets the command run.
json_field() {
  awk -v key="$1" 'BEGIN {RS="\001"} {
    k="\"" key "\""; i=index($0,k); if(!i) exit
    s=substr($0,i+length(k)); sub(/^[[:space:]]*:[[:space:]]*"/,"",s)
    match(s, /^([^"\\]|\\.)*/); out=substr(s, 1, RLENGTH)
    if (substr(s, RLENGTH + 1) == "\\") out = out "\\"
    gsub(/\\"/,"\"",out); gsub(/\\\\/,"\\",out); print out}'
}
# The same field, read by builtins into JF. Why (Windows): command substitution, printf and awk were three of the
# processes every guarded command waited for. Over 4 KB the loop below copies the rest at every escape, so awk
# reads it; awk also reads a payload with \001, its record separator.
# A backslash in an expanded pattern escapes the next character, as in a literal one.
P_ESC='[\\"]' P_QQ='\\"' P_BB='\\\\' Q='"' B='\' P_SOH=$'\001'
json_field_var() { # $1 key, $2 JSON → JF
  local s=$2 k="\"$1\"" t pre
  JF=
  # Bash 3.2 (macOS): its pattern operations are slow and a process is cheap there; awk reads it.
  [ "${BASH_VERSINFO[0]}" -ge 4 ] || { JF=$(printf '%s' "$s" | json_field "$1"); return 0; }
  if [ "${#s}" -gt 4096 ]; then JF=$(printf '%s' "$s" | json_field "$1"); return 0; fi
  case "$s" in *$P_SOH*) JF=$(printf '%s' "$s" | json_field "$1"); return 0;; esac
  case "$s" in *"$k"*) ;; *) return 0;; esac
  s=${s#*"$k"}
  # As sub(/^[[:space:]]*:[[:space:]]*"/): all of it or nothing.
  t=${s#"${s%%[![:space:]]*}"}
  case "$t" in :*) t=${t#:}; t=${t#"${t%%[![:space:]]*}"}; case "$t" in \"*) s=${t#\"};; esac;; esac
  # Up to the first quote that no backslash escapes; a backslash keeps the next character.
  while :; do
    pre=${s%%$P_ESC*}
    JF=$JF$pre
    [ "${#pre}" -lt "${#s}" ] || break
    s=${s:${#pre}}
    case "$s" in \\*) JF=$JF${s:0:2}; s=${s:2};; *) break;; esac
  done
  JF=${JF//$P_QQ/"$Q"}; JF=${JF//$P_BB/"$B"}   # kit-lint: ok (at most 4 KB, and bash 3.2 returned to awk above)
  while :; do case "$JF" in *"$NL") JF=${JF%"$NL"};; *) break;; esac; done
}

# Subagent resource manager (PreToolUse matcher Agent|Task, and SubagentStop).
# Why: ultracode is exempt from Claude Code's concurrency cap, and one prompt can fan out dozens of
# Opus subagents. Budgets come from .uak/PROJECT.md: Max-Parallel-Subagents, Opus-Subagents-Per-Session.
cfg() { top=$(git rev-parse --show-toplevel 2>/dev/null) || { printf '%s' "$2"; return; }
  uak_cfg_var "$top/.uak/PROJECT.md" "$1"
  case "$CFG" in ''|*[!0-9]*) printf '%s' "$2";; *) printf '%s' "$CFG";; esac; }
model_of_agent() { # $1 agent type → model declared by its definition in any harness
  top=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
  for f in "$top/.cursor/agents/$1.md" "$top/.claude/agents/$1.md" "$top/.gemini/agents/$1.md"; do
    [ -f "$f" ] && { sed -n 's/^model:[[:space:]]*//p' "$f" | head -n 1 | tr -d '\r"'"'"; return; }
  done
  f="$top/.codex/agents/$1.toml"
  [ -f "$f" ] && sed -n 's/^model[[:space:]]*=[[:space:]]*//p' "$f" | head -n 1 | tr -d '\r"'"'"
}
# Tiers are harness-neutral. Order matters: gpt-5.6-sol is the strong model of its family, gpt-6.1-sol the balanced one.
tier_class() {
  case "$(printf '%s' "$1" | tr 'A-Z' 'a-z')" in
    ''|inherit) printf inherit;;
    *opus*|*fable*|*mythos*|*astra*|*gpt-5.6-sol*|*gpt-5-6-sol*|best) printf strong;;
    *haiku*|*luna*|*composer*|*flash*|*-mini*|*-nano*) printf fast;;
    *sonnet*|*sol*|*terra*|*gemini*pro*|*gpt-*) printf balanced;;
    *) printf inherit;;
  esac
}
tier_of() { # $1 model param, $2 subagent type → strong|balanced|fast|inherit
  m=$1
  [ -n "$m" ] || m=$(model_of_agent "$2")
  if [ -z "$m" ]; then
    case "$2" in
      general-purpose|Explore|Plan) m=${CLAUDE_CODE_SUBAGENT_MODEL:-};;
      default|worker|explorer)
        top=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
        m=$(sed -n 's/^default_subagent_model[[:space:]]*=[[:space:]]*//p' "$top/.codex/config.toml" 2>/dev/null | head -n 1 | tr -d '\r"');;
    esac
  fi
  tier_class "$m"
}
# One launch at a time reads, checks and writes the reservations: 12 parallel launches with Max-Parallel 4 let 6
# through and lost reservations (audit, Oct 2026). mkdir is atomic everywhere; a lock older than 10 s is a crashed
# hook's (the hook timeout is 5 s), and the wait stays under that timeout.
agents_lock() {
  local l="$1/uak-agents.lock" i=0 t now pid
  while ! mkdir "$l" 2>/dev/null; do
    now=$(date +%s); t=$(cat "$l/at" 2>/dev/null); pid=$(cat "$l/pid" 2>/dev/null)
    case "$t" in ''|*[!0-9]*) t=$now;; esac
    # Stale: its hook died (no such process), or it has no PID and is older than 10 s. Broken by renaming it first, which only one
    # waiter can do: two waiters removing it in turn freed a lock a third had just taken (CI: 7 launches with cap 4).
    if { [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; } || { [ -z "$pid" ] && [ $((now - t)) -gt 10 ]; }; then
      if mv "$l" "$l.stale.$$" 2>/dev/null; then rm -rf "$l.stale.$$"; fi
      continue
    fi
    i=$((i + 1)); [ "$i" -lt 80 ] || block "another subagent launch is being counted; try again in a few seconds."
    sleep 0.1 2>/dev/null || sleep 1
  done
  printf '%s\n' "$$" > "$l/pid" 2>/dev/null; date +%s > "$l/at" 2>/dev/null
  AGENTS_LOCK=$l
  trap 'rm -f "$AGENTS_LOCK/at" "$AGENTS_LOCK/pid"; rmdir "$AGENTS_LOCK" 2>/dev/null' EXIT
}
check_agent() {
  input=$1 gd=$(git rev-parse --git-dir 2>/dev/null || printf '%s' "${TMPDIR:-/tmp}")
  now=${UAK_NOW:-$(date +%s)}
  type=$(printf '%s' "$input" | json_field subagent_type); [ -n "$type" ] || type=$(printf '%s' "$input" | json_field agent_type)
  # Claude Code puts the chosen model in tool_input; Codex/Cursor start events carry the PARENT's model, so ignore it.
  case "$input" in *'"tool_name"'*) model=$(printf '%s' "$input" | json_field model);; *) model=;; esac
  sid=$(printf '%s' "$input" | json_field session_id); sid=${sid:-default}
  tier=$(tier_of "$model" "$type")
  # `uak pace` scales both caps with plan usage: surge 2x, conserve 1/2, critical 1 and no strong model.
  set -- $(bash "$here/pace" --caps 2>/dev/null)
  level=${1:-unknown} max=${2:-} opus_max=${3:-}
  case "$max" in ''|*[!0-9]*) max=$(cfg Max-Parallel-Subagents 4);; esac
  case "$opus_max" in ''|*[!0-9]*) opus_max=$(cfg Opus-Subagents-Per-Session 2);; esac
  why=; case "$level" in surge|conserve|critical) why=" (pace $level: uak pace)";; esac
  # Hard limits: fixed numbers that pacing can lower but never raise. Why: if a usage reading is wrong
  # (stale cache, a bad manual entry, a vendor format change), a surge must not empty the plan in minutes.
  case "$(mode)" in marathon) d_hard=4 d_strong=4 d_total=30 d_machine=6;; *) d_hard=6 d_strong=3 d_total=40 d_machine=8;; esac
  hard=$(cfg Subagent-Hard-Cap "$d_hard"); strong_hard=$(cfg Strong-Hard-Cap "$d_strong")
  total_max=$(cfg Subagents-Per-Session "$d_total"); machine_max=$(cfg Subagents-Per-Machine "$d_machine")
  burst_max=$(cfg Subagent-Burst-Per-Minute 6)
  [ "$max" -le "$hard" ] || max=$hard
  [ "$opus_max" -le "$strong_hard" ] || opus_max=$strong_hard
  act="$gd/uak-agents.active" log="$gd/uak-agents.log"
  agents_lock "$gd"
  touch "$act" "$log"
  # Reservations older than 20 min are stale (a crashed subagent never sent SubagentStop).
  awk -v now="$now" '$1 + 1200 > now' "$act" > "$act.tmp" && mv "$act.tmp" "$act"
  spawned=$(awk -v s="$sid" '$2 == s' "$log" | awk 'END {print NR+0}')
  [ "$spawned" -lt "$total_max" ] ||
    block "this session already spawned $spawned subagents (Subagents-Per-Session: $total_max). Hand off (/uak-handoff) and start a fresh session, or a human raises the limit in .uak/PROJECT.md."
  burst=$(awk -v s="$sid" -v now="$now" '$2 == s && $1 + 60 > now' "$log" | awk 'END {print NR+0}')
  [ "$burst" -lt "$burst_max" ] ||
    block "$burst subagents spawned in the last minute (Subagent-Burst-Per-Minute: $burst_max). A loop that spawns agents is a bug: stop and check the plan."
  # Machine-wide: every worktree of this repo shares one plan, so count all of their running subagents.
  cd_common=$(git rev-parse --git-common-dir 2>/dev/null) && cd_common=$(cd "$cd_common" 2>/dev/null && pwd -P) || cd_common=
  if [ -n "$cd_common" ]; then
    machine=$(for f in "$cd_common/uak-agents.active" "$cd_common"/worktrees/*/uak-agents.active; do
      [ -f "$f" ] && awk -v now="$now" '$1 + 1200 > now' "$f"; done | awk 'END {print NR+0}')
    [ "$machine" -lt "$machine_max" ] ||
      block "$machine subagents are running across all worktrees on this machine (Subagents-Per-Machine: $machine_max). Wait for one, or do the step yourself."
  fi
  running=$(awk 'END {print NR+0}' "$act")
  [ "$running" -lt "$max" ] ||
    block "$running subagents already running (Max-Parallel-Subagents: $max$why). Wait for one to finish, or do the step yourself; a swarm costs more than it saves."
  if [ "$tier" = strong ] && [ "${UAK_ALLOW_OPUS:-}" != 1 ]; then
    used=$(awk -v s="$sid" '$2 == s && ($3 == "strong" || $3 == "opus")' "$log" | awk 'END {print NR+0}')
    [ "$used" -lt "$opus_max" ] ||
      block "Opus subagent budget (strong tier: Opus, Astra, GPT-5.6 Sol) for this session is spent ($used/$opus_max$why). Use the advisor at a checkpoint, a fast scout to read, or a balanced reviewer. A human can raise Opus-Subagents-Per-Session or set UAK_ALLOW_OPUS=1."
  fi
  printf '%s %s %s %s\n' "$now" "$sid" "$tier" "${type:-unknown}" >> "$log"
  printf '%s %s %s\n' "$now" "$tier" "${type:-unknown}" >> "$act"
  return 0
}
agent_stop() {
  gd=$(git rev-parse --git-dir 2>/dev/null) || return 0
  act="$gd/uak-agents.active"; [ -s "$act" ] || return 0
  agents_lock "$gd"
  sed '1d' "$act" > "$act.tmp" && mv "$act.tmp" "$act"
}

shell_tool() { # tool names of the shell in each harness' PreToolUse/BeforeTool payload
  # PowerShell: Claude Code's shell on Windows without Git Bash (audit: no rule applied to it).
  case "$1" in *'"tool_name":"Bash"'*|*'"tool_name": "Bash"'*|*'"tool_name":"Shell"'*|*'"tool_name": "Shell"'*|\
    *'"tool_name":"PowerShell"'*|*'"tool_name": "PowerShell"'*|\
    *'"tool_name":"shell"'*|*'"tool_name": "shell"'*|*'"tool_name":"exec_command"'*|*'"tool_name": "exec_command"'*|\
    *'"tool_name":"local_shell"'*|*'"tool_name": "local_shell"'*|*'"tool_name":"run_shell_command"'*|*'"tool_name": "run_shell_command"'*) return 0;; esac
  return 1
}
case "${1:-}" in
  agent)
    input=$(cat 2>/dev/null || true)
    case "$input" in
      *'"tool_name":"Agent"'*|*'"tool_name": "Agent"'*|*'"tool_name":"Task"'*|*'"tool_name": "Task"'*) ;;   # Claude Code, Cursor preToolUse
      *'"hook_event_name":"SubagentStart"'*|*'"hook_event_name": "SubagentStart"'*|*'"hook_event_name":"subagentStart"'*|*'"hook_event_name": "subagentStart"'*) ;;  # Codex, Cursor
      *) exit 0;;
    esac
    check_agent "$input";;
  agent-stop) cat >/dev/null 2>&1 || true; agent_stop;;
  # stdin by read, not $(cat): one process less on every hook call.
  bash)
    IFS= read -r -d '' input || true
    shell_tool "$input" || exit 0
    [ "${2:-}" != claude ] || GUARD_HARNESS=claude
    json_field_var command "$input"; check_bash "$JF";;
  shell)
    IFS= read -r -d '' input || true
    json_field_var command "$input"; check_bash "$JF";;
  prompt)
    IFS= read -r -d '' input || true
    json_field_var prompt "$input"; check_prompt "$JF";;
  check) GUARD_HARNESS=check; check_bash "${2:-}"; printf 'UAK_GUARD: allowed\n';;
  check-prompt) check_prompt "${2:-}"; printf 'UAK_GUARD: allowed\n';;
  tier) printf '%s\n' "$(tier_class "${2:-}")";;
  *) printf '%s\n' 'Usage: guard bash|shell|prompt|agent|agent-stop (hook JSON on stdin) · guard check "CMD" · guard check-prompt "TEXT" · guard tier MODEL' >&2; exit 2;;
esac
exit 0
