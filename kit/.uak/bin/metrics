#!/usr/bin/env bash
# uak metrics: every speed number next to its instability number, from the claims branch. Read-only.
#   bash .uak/bin/uak metrics [--since DAYS] [--task ID] [--json] [--claims DIR]
# Python 3.8+ standard library (lib/metrics.py), like `uak dash`; the rest of uak works without it.
set -u
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
for p in python3 python py; do
  "$p" -c 'import sys; sys.exit(sys.version_info < (3, 8))' 2>/dev/null && exec "$p" "$here/lib/metrics.py" "$@"
done
printf '%s\n' 'uak metrics needs Python 3.8+ (python3, python or py). The rest of uak works without it.' >&2
exit 2
