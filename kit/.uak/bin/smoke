#!/usr/bin/env bash
# UAK_SMOKE_SCOPE: syntax + secrets + product (.uak/bin/smoke-project); --package-only/--full add the kit suite.
# Why: uak merge runs this smoke on every merge; the kit suite takes minutes and does not test the product.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
cd "$root"
mode=product
jobs=''
usage() { printf '%s\n' 'Usage: .uak/bin/smoke [--package-only|--full] [--jobs N|auto]' >&2; exit 2; }
while [ "$#" -gt 0 ]; do
  case "$1" in
    --package-only) mode=package; shift ;;
    --full) mode=full; shift ;;
    --jobs) [ "$#" -ge 2 ] || usage; jobs=$2; shift 2 ;;
    --jobs=*) jobs=${1#--jobs=}; shift ;;
    *) usage ;;
  esac
done
for script in .uak/bin/uak .uak/bin/uak-coordination .uak/bin/guard .uak/bin/doctor .uak/bin/graph .uak/bin/loop .uak/bin/board .uak/bin/stats .uak/bin/up .uak/bin/demo .uak/bin/policy .uak/bin/secret-scan .uak/bin/wt .uak/bin/q .uak/bin/hook .uak/bin/tokens .uak/bin/map .uak/bin/cap .uak/bin/clock .uak/bin/lib/*.sh .githooks/pre-commit; do
  [ ! -f "$script" ] || bash -n "$script"
done
if git rev-parse --show-toplevel >/dev/null 2>&1; then
  bash .uak/bin/secret-scan --tracked
else
  bash .uak/bin/secret-scan --directory "$root"
fi
if [ "$mode" != product ]; then
  python_runtime=''
  for candidate in python3 python; do
    if command -v "$candidate" >/dev/null 2>&1 && "$candidate" -c 'import sys; assert sys.version_info >= (3, 8)' >/dev/null 2>&1; then
      python_runtime=$candidate
      break
    fi
  done
  [ -n "$python_runtime" ] || { printf '%s\n' 'PACKAGE_UNVERIFIED: tests need Python 3.8+ (standard library).' >&2; exit 2; }
  PYTHONIOENCODING=utf-8; PYTHONUTF8=1; export PYTHONIOENCODING PYTHONUTF8  # a Windows console is cp1252: "→" crashed a print
  # Every .uak/tests/test_*.py, in C order: a new test file runs here with no edit (kit_lint checks the discovery).
  # shellcheck disable=SC2012
  tests=$(LC_ALL=C ls -1 .uak/tests 2>/dev/null | LC_ALL=C grep -E '^test_[A-Za-z0-9_]+[.]py$' || :)
  [ -n "$tests" ] || { printf '%s\n' 'PACKAGE_UNVERIFIED: no .uak/tests/test_*.py found.' >&2; exit 2; }
  # CI runs the suite in shards (UAK-018: 15.6 min on one macOS job): UAK_SMOKE_TESTS names this shard's files, as
  # `scripts/kit_lint.py --ci-shards` prints them. Every name must be a test found here, or the shard fails: a typo never
  # runs less quietly. Unset (the merge gate, a laptop), every test runs.
  # Merge-Smoke: affected with no affected test file (UAK-052): the merge gate says so with this internal variable (a token file only the gate creates), never
  # with a value of UAK_SMOKE_TESTS, so a user's export cannot skip the suite. Lint and the rest of the gate still ran.
  if [ -f "${UAK_SMOKE_GATE_NONE:-/nonexistent}" ] && [ "$(cat "$UAK_SMOKE_GATE_NONE" 2>/dev/null)" = affected-none ] && [ -z "${UAK_SMOKE_TESTS+set}" ]; then
    printf 'Shard: 0 of %s test files (merge gate: no test file affected).\n' "$(printf '%s\n' $tests | wc -l | tr -d ' ')"
    tests=''
  elif [ -n "${UAK_SMOKE_TESTS+set}" ]; then
    picked='' n_all=0 n_picked=0
    for t in $tests; do n_all=$((n_all + 1)); done
    set -f
    for want in $UAK_SMOKE_TESTS; do
      found=''
      for t in $tests; do [ "$t" != "$want.py" ] || found=1; done
      [ -n "$found" ] || { set +f; printf 'PACKAGE_UNVERIFIED: UAK_SMOKE_TESTS names %s: no .uak/tests/%s.py here.\n' "$want" "$want" >&2; exit 2; }
      picked="$picked $want.py"; n_picked=$((n_picked + 1))
    done
    set +f
    [ -n "$picked" ] || { printf '%s\n' 'PACKAGE_UNVERIFIED: UAK_SMOKE_TESTS is set and empty: no test to run.' >&2; exit 2; }
    printf 'Shard: %s of %s test files (UAK_SMOKE_TESTS).\n' "$n_picked" "$n_all"
    tests=$picked
  fi
  # The shard list and the gate's none-signal are this run's choice, not the tests': a test that starts its own smoke
  # inherited them and looked for files its package does not have. Why (v6.1.1 CI, the second time after lesson #4).
  unset UAK_SMOKE_TESTS UAK_SMOKE_GATE_NONE
  # UAK-054 parallel shards: --jobs N, else `Smoke-Jobs: N` in .uak/PROJECT.md (the kit's one reader), else 1. N = auto is the
  # CPU count minus one, at most 4. Why (v6.1.0, v6.1.1): the whole suite ran serially on every merge, 10+ min.
  if [ -z "$jobs" ] && [ -f ".uak/bin/lib/config.sh" ]; then
    # shellcheck disable=SC1091
    . ".uak/bin/lib/config.sh"
    uak_cfg_var "$root/.uak/PROJECT.md" Smoke-Jobs 1; jobs=$CFG
  fi
  [ -n "$jobs" ] || jobs=1
  if [ "$jobs" = auto ]; then
    cpus=$( (nproc || sysctl -n hw.ncpu || printf '%s' "${NUMBER_OF_PROCESSORS:-1}") 2>/dev/null | head -n 1)
    case "$cpus" in ''|*[!0-9]*) cpus=1 ;; esac
    jobs=$((cpus - 1)); [ "$jobs" -le 4 ] || jobs=4; [ "$jobs" -ge 1 ] || jobs=1
  fi
  case "$jobs" in ''|*[!0-9]*|0|0[0-9]*) printf 'smoke: --jobs / Smoke-Jobs must be a number of 1 or more, or auto, not %s\n' "$jobs" >&2; exit 2 ;; esac
  n_tests=$(printf '%s\n' $tests | grep -c . || :)
  [ "$jobs" -le "$n_tests" ] || jobs=$n_tests
  if [ "$jobs" -gt 1 ]; then
    # Balance by the seconds the CI split already knows (scripts/kit_lint.py CI_SECONDS, source repository only): longest
    # first, each file to the lightest shard. Without kit_lint every file counts the same.
    lint=''
    for c in "$root/../scripts/kit_lint.py" "$root/scripts/kit_lint.py"; do
      if [ -z "$lint" ] && [ -f "$c" ]; then lint=$c; fi
    done
    work=$(mktemp -d "${TMPDIR:-/tmp}/uak-smoke-shards.XXXXXX")
    trap 'rm -rf "$work"' EXIT
    secs=''
    if [ -n "$lint" ]; then
      secs=$(for t in $tests; do printf '%s\n' "${t%.py}"; done | "$python_runtime" -c 'import importlib.util as u, sys
s = u.spec_from_file_location("kit_lint_for_smoke", sys.argv[1]); m = u.module_from_spec(s); s.loader.exec_module(m)
for line in sys.stdin:
    t = line.strip()
    if t: print("%d %s" % (m.ci_seconds(t), t))' "$lint" 2>/dev/null || :)
    fi
    [ -n "$secs" ] || secs=$(for t in $tests; do printf '60 %s\n' "${t%.py}"; done)
    printf '%s\n' "$secs" | LC_ALL=C sort -k1,1nr -k2,2 | awk -v n="$jobs" '
      { best = 1; for (k = 2; k <= n; k++) if (load[k] < load[best]) best = k
        load[best] += $1; print best, $2 ".py" }' > "$work/plan"
    printf 'Jobs: %s shards of %s test files.\n' "$jobs" "$n_tests"
    k=1; pids=''
    while [ "$k" -le "$jobs" ]; do
      mkdir -p "$work/shard$k/tmp" "$work/shard$k/home"
      [ ! -f "${HOME:-/nonexistent}/.gitconfig" ] || cp "$HOME/.gitconfig" "$work/shard$k/home/.gitconfig" 2>/dev/null || :
      list=$(awk -v k="$k" '$1 == k { print $2 }' "$work/plan")
      (
        TMPDIR="$work/shard$k/tmp" TEMP="$work/shard$k/tmp" TMP="$work/shard$k/tmp" HOME="$work/shard$k/home"
        export TMPDIR TEMP TMP HOME
        for t in $list; do
          [ "$t" != test_v57_install.py ] || [ -f "$root/../install.sh" ] || continue
          "$python_runtime" ".uak/tests/$t" --package "$root" || exit 1
        done
      ) < /dev/null > "$work/shard$k.log" 2>&1 &
      pids="$pids $!"; k=$((k + 1))
    done
    k=1; failed=''
    for pid in $pids; do
      if wait "$pid"; then
        printf 'Shard %s of %s passed (%s).\n' "$k" "$jobs" "$(awk -v k="$k" '$1 == k { printf "%s ", $2 }' "$work/plan" | sed 's/ $//')"
        cat "$work/shard$k.log"
      else
        failed="$failed $k"
      fi
      k=$((k + 1))
    done
    if [ -n "$failed" ]; then
      for k in $failed; do
        printf 'Shard %s of %s failed (%s); last 40 lines:\n' "$k" "$jobs" "$(awk -v k="$k" '$1 == k { printf "%s ", $2 }' "$work/plan" | sed 's/ $//')"
        tail -n 40 "$work/shard$k.log"
      done
      printf 'PACKAGE_FAIL: shard%s failed.\n' "$failed" >&2
      exit 1
    fi
  else
    # Names are [A-Za-z0-9_.] only: plain word splitting, and stdin stays the caller's (a test may read it).
    for t in $tests; do
      # The installer lives next to the kit in the source repository, not in an installed project.
      [ "$t" != test_v57_install.py ] || [ -f "$root/../install.sh" ] || continue
      "$python_runtime" ".uak/tests/$t" --package "$root"
    done
  fi
  printf '%s\n' 'PACKAGE_PASS: coordination verified with real Git processes and a local bare remote.'
fi
if [ "$mode" = package ]; then
  printf '%s\n' 'PRODUCT_UNVERIFIED: --package-only does not run the app nor enable product auto-merge.'
  exit 0
fi
bash .uak/bin/lib/smoke-init.sh gate
