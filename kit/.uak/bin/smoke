#!/usr/bin/env bash
# UAK_SMOKE_SCOPE: syntax + secrets + product (.uak/bin/smoke-project); --package-only/--full add the kit suite.
# Why: uak merge runs this smoke on every merge; the kit suite takes minutes and does not test the product.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
cd "$root"
mode=product
case "${1:-}" in
  "") ;;
  --package-only) mode=package; shift ;;
  --full) mode=full; shift ;;
  *) printf '%s\n' 'Usage: .uak/bin/smoke [--package-only|--full]' >&2; exit 2 ;;
esac
[ "$#" -eq 0 ] || { printf '%s\n' 'Extra arguments not allowed.' >&2; exit 2; }
for script in .uak/bin/uak .uak/bin/uak-coordination .uak/bin/guard .uak/bin/doctor .uak/bin/graph .uak/bin/loop .uak/bin/board .uak/bin/stats .uak/bin/up .uak/bin/demo .uak/bin/policy .uak/bin/secret-scan .uak/bin/wt .uak/bin/q .uak/bin/hook .uak/bin/tokens .uak/bin/map .uak/bin/cap .uak/bin/clock .uak/bin/lib/*.sh .githooks/pre-commit; do
  [ ! -f "$script" ] || bash -n "$script"
done
if git rev-parse --show-toplevel >/dev/null 2>&1; then
  bash .uak/bin/secret-scan --tracked
else
  bash .uak/bin/secret-scan --directory "$root"
fi
if [ "$mode" != product ]; then
  python_runtime=''
  for candidate in python3 python; do
    if command -v "$candidate" >/dev/null 2>&1 && "$candidate" -c 'import sys; assert sys.version_info >= (3, 8)' >/dev/null 2>&1; then
      python_runtime=$candidate
      break
    fi
  done
  [ -n "$python_runtime" ] || { printf '%s\n' 'PACKAGE_UNVERIFIED: tests need Python 3.8+ (standard library).' >&2; exit 2; }
  PYTHONIOENCODING=utf-8; PYTHONUTF8=1; export PYTHONIOENCODING PYTHONUTF8  # a Windows console is cp1252: "→" crashed a print
  # Every .uak/tests/test_*.py, in C order: a new test file runs here with no edit (kit_lint checks the discovery).
  # shellcheck disable=SC2012
  tests=$(LC_ALL=C ls -1 .uak/tests 2>/dev/null | LC_ALL=C grep -E '^test_[A-Za-z0-9_]+[.]py$' || :)
  [ -n "$tests" ] || { printf '%s\n' 'PACKAGE_UNVERIFIED: no .uak/tests/test_*.py found.' >&2; exit 2; }
  # CI runs the suite in shards (UAK-018: 15.6 min on one macOS job): UAK_SMOKE_TESTS names this shard's files, as
  # `scripts/kit_lint.py --ci-shards` prints them. Every name must be a test found here, or the shard fails: a typo never
  # runs less quietly. Unset (the merge gate, a laptop), every test runs.
  if [ -n "${UAK_SMOKE_TESTS+set}" ]; then
    picked='' n_all=0 n_picked=0
    for t in $tests; do n_all=$((n_all + 1)); done
    set -f
    for want in $UAK_SMOKE_TESTS; do
      found=''
      for t in $tests; do [ "$t" != "$want.py" ] || found=1; done
      [ -n "$found" ] || { set +f; printf 'PACKAGE_UNVERIFIED: UAK_SMOKE_TESTS names %s: no .uak/tests/%s.py here.\n' "$want" "$want" >&2; exit 2; }
      picked="$picked $want.py"; n_picked=$((n_picked + 1))
    done
    set +f
    [ -n "$picked" ] || { printf '%s\n' 'PACKAGE_UNVERIFIED: UAK_SMOKE_TESTS is set and empty: no test to run.' >&2; exit 2; }
    printf 'Shard: %s of %s test files (UAK_SMOKE_TESTS).\n' "$n_picked" "$n_all"
    tests=$picked
  fi
  # Names are [A-Za-z0-9_.] only: plain word splitting, and stdin stays the caller's (a test may read it).
  for t in $tests; do
    # The installer lives next to the kit in the source repository, not in an installed project.
    [ "$t" != test_v57_install.py ] || [ -f "$root/../install.sh" ] || continue
    "$python_runtime" ".uak/tests/$t" --package "$root"
  done
  printf '%s\n' 'PACKAGE_PASS: coordination verified with real Git processes and a local bare remote.'
fi
if [ "$mode" = package ]; then
  printf '%s\n' 'PRODUCT_UNVERIFIED: --package-only does not run the app nor enable product auto-merge.'
  exit 0
fi
bash .uak/bin/lib/smoke-init.sh gate
