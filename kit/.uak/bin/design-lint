#!/usr/bin/env bash
# design-lint: product screens use the design system, never their own colors or components. Bash 3.2+, grep -E.
#   design-lint [SRC_DIR]   default: web/src, else src, else app (Next.js); UI kit: SRC/lib/ui, SRC/components/ui, components/ui
# Fails on, outside the UI kit: raw Tailwind palette classes (bg-stone-400, text-emerald-900), hex colors in code
# (#c2410c; a fallback inside var(--x, #fff) is fine), and a local component named like one of the UI kit's.
# A line with "design-lint: ok" is skipped (say why on that line).
# Why (Chilangatón): view agents started before the design system landed; each built its own badge, toggle and boxes
# from stone-*/emerald-* and a hand-typed orange, and the first UI was redone 3 hours in.
set -u
LC_ALL=C; export LC_ALL
root=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
cd "$root" || exit 2
src=${1:-}
if [ -z "$src" ]; then for d in web/src src app; do [ -d "$d" ] && { src=$d; break; }; done; fi
[ -n "$src" ] && [ -d "$src" ] || { printf 'DESIGN_LINT_SKIP: no web/src, src or app folder\n'; exit 0; }
ui=
for d in "$src/lib/ui" "$src/components/ui" components/ui; do [ -d "$d" ] && { ui=$d; break; }; done
# Tokens exist when some stylesheet defines custom properties (or a Tailwind @theme). Without them there is nothing to enforce yet.
if ! find "$src" "${ui:-$src}" -name '*.css' -type f 2>/dev/null | while IFS= read -r f; do grep -Eq -- '(--[a-z][a-z0-9-]*:|@theme)' "$f" && echo y; done | grep -q y; then
  printf 'DESIGN_LINT_SKIP: no design tokens yet (CSS custom properties or @theme): the design lock writes them\n'; exit 0
fi
list=$(mktemp "${TMPDIR:-/tmp}/uak-dlint.XXXXXX") || exit 2
out=$(mktemp "${TMPDIR:-/tmp}/uak-dlint.XXXXXX") || exit 2
trap 'rm -f "$list" "$out"' EXIT
find "$src" -type f \( -name '*.tsx' -o -name '*.jsx' -o -name '*.ts' -o -name '*.js' -o -name '*.vue' -o -name '*.svelte' \) \
  ! -name '*.d.ts' ! -name '*.test.*' ! -name '*.spec.*' ! -path '*/node_modules/*' 2>/dev/null |
  while IFS= read -r f; do case "$f" in "$ui"/*) [ -n "$ui" ] && continue;; esac; printf '%s\n' "$f"; done > "$list"
palette='(^|[^A-Za-z0-9-])(bg|text|border|ring|fill|stroke|from|via|to|outline|divide|decoration|shadow|accent|caret|placeholder)-(slate|gray|zinc|neutral|stone|red|orange|amber|yellow|lime|green|emerald|teal|cyan|sky|blue|indigo|violet|purple|fuchsia|pink|rose)-(50|100|200|300|400|500|600|700|800|900|950)([^0-9]|$)'
hex='(^|[^,&0-9A-Za-z_])#([0-9a-fA-F]{8}|[0-9a-fA-F]{6}|[0-9a-fA-F]{3})([^0-9A-Za-z_]|$)'
names=
[ -z "$ui" ] || names=$(for f in "$ui"/*; do [ -f "$f" ] || continue; b=$(basename "$f"); b=${b%.*}
  case "$b" in index|*.test|*.stories|*[!A-Za-z0-9_]*) continue;; esac
  case "$b" in [A-Z]*) printf '%s|' "$b";; esac; done)
names=${names%|}
while IFS= read -r f; do
  [ -n "$f" ] || continue
  grep -nE "$palette" "$f" 2>/dev/null | grep -v 'design-lint: ok' | while IFS= read -r l; do
    cls=$(printf '%s' "${l#*:}" | grep -Eo '(bg|text|border|ring|fill|stroke|from|via|to|outline|divide|decoration|shadow|accent|caret|placeholder)-(slate|gray|zinc|neutral|stone|red|orange|amber|yellow|lime|green|emerald|teal|cyan|sky|blue|indigo|violet|purple|fuchsia|pink|rose)-[0-9]+' | head -n 1)
    printf '%s:%s · raw palette class %s: use a design token (web/DESIGN.md) or a UI kit component\n' "$f" "${l%%:*}" "$cls"
  done
  grep -nE "$hex" "$f" 2>/dev/null | grep -v 'design-lint: ok' | while IFS= read -r l; do
    h=$(printf '%s' "${l#*:}" | grep -Eo '#[0-9a-fA-F]{3,8}' | head -n 1)
    printf '%s:%s · hex color %s in code: read it from a token (var(--…)) so every screen shares one palette\n' "$f" "${l%%:*}" "$h"
  done
  [ -z "$names" ] || grep -nE "(function|const|class)[[:space:]]+($names)([^A-Za-z0-9_]|$)" "$f" 2>/dev/null | grep -v 'design-lint: ok' |
    while IFS= read -r l; do
      n=$(printf '%s' "${l#*:}" | grep -Eo "(function|const|class)[[:space:]]+($names)" | awk '{print $2}' | head -n 1)
      printf '%s:%s · local %s: %s already has it; import it (missing a variant? ask its owner with uak msg --kind request)\n' "$f" "${l%%:*}" "$n" "$ui"
    done
done < "$list" > "$out"
files=$(awk 'END {print NR + 0}' "$list")
if [ -s "$out" ]; then
  head -n 30 "$out" | sed 's/^/DESIGN_LINT /'
  n=$(awk 'END {print NR + 0}' "$out")
  [ "$n" -le 30 ] || printf 'DESIGN_LINT … %s more\n' "$((n - 30))"
  printf 'DESIGN_LINT_FAIL %s finding(s) in %s file(s) of %s · fix them, or mark a deliberate line with "design-lint: ok"\n' "$n" "$(cut -d: -f1 "$out" | sort -u | awk 'END {print NR + 0}')" "$files"
  exit 1
fi
printf 'DESIGN_LINT_PASS files=%s ui=%s\n' "$files" "${ui:--}"
