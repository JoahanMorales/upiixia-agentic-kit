#!/usr/bin/env bash
# One-command task start: branch + worktree + identity (.uak-env) + port + claim. Bash 3.2+.
# Why: the manual ritual (4 commands with flags) is the most common session-start error.
set -u
set -o pipefail
# Git Bash rewrites "rev:.path" arguments for native git unless told not to (the same list as uak).
MSYS2_ARG_CONV_EXCL="refs/;origin/;${UAK_REMOTE:-origin}/;HEAD;FETCH_HEAD;:"; export MSYS2_ARG_CONV_EXCL
LC_ALL=C; export LC_ALL
REMOTE=${UAK_REMOTE:-origin}
BASE=${UAK_BASE:-main}
WT_SELF="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/$(basename -- "$0")"
say() { printf '%s\n' "$*"; }
die() { say "WT_ERROR: $*" >&2; exit 2; }
usage() {
  cat <<'USAGE'
wt new ID [--agent NAME] [--human NAME] [--next TEXT]   create branch/worktree, write .uak-env, claim; without
                                                        --agent: reuse this machine's free identity or the next one
wt session                                                          rotate UAK_SESSION of this worktree (new session)
wt rm ID                                                      remove your worktree (no --force; keeps the branch)
wt rm --review PATH                                           remove a detached review checkout and its build output
wt stop [ID]                                                  stop the servers listening on this worktree's ports (exact PIDs)
wt pr                                                         print the GitHub "open PR" URL when gh pr create is not allowed
wt ls                                                               list worktrees
USAGE
}
wt_windows() { case "$(uname -s 2>/dev/null)" in MINGW*|MSYS*|CYGWIN*) return 0;; esac; return 1; }
# On Windows a /dev/tcp connect to a closed port takes ~2 s (SYN retries): netstat answers at once.
port_busy() { if wt_windows && command -v netstat >/dev/null 2>&1; then [ -n "$(port_pids "$1")" ]; else (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null; fi; }
port_pids() { # PIDs listening on a TCP port; empty if no tool is available
  if wt_windows && command -v netstat >/dev/null 2>&1; then
    # Git Bash has neither lsof nor ss. A listening row has the remote port 0; its state word is localized
    # ("LISTENING", "ESCUCHANDO"), so it is not matched. Why (Hacktoberfest): wt stop said "nothing listening"
    # while the task's API kept serving.
    netstat -ano 2>/dev/null | tr -d '\r' | awk -v p=":$1" '$1 ~ /^TCP/ && $3 ~ /:0$/ && substr($2, length($2) - length(p) + 1) == p { print $NF }'
  elif command -v lsof >/dev/null 2>&1; then lsof -nP -t -iTCP:"$1" -sTCP:LISTEN 2>/dev/null
  elif command -v ss >/dev/null 2>&1; then ss -ltnpH "sport = :$1" 2>/dev/null | sed -n 's/.*pid=\([0-9]*\).*/\1/p'
  fi | grep -E '^[1-9][0-9]*$' | sort -u
}
# A Windows PID from netstat is not a Git Bash PID: taskkill stops it and its children (npm -> node).
kill_pid() { if wt_windows; then MSYS_NO_PATHCONV=1 taskkill /F /T /PID "$1" >/dev/null 2>&1; else kill "$1" 2>/dev/null; fi; }
clean_id() { printf '%s' "$1" | grep -Eq '^[A-Za-z0-9_.-]+$'; }
main_root() { git worktree list --porcelain 2>/dev/null | sed -n '1s/^worktree //p'; }
# This machine's identities (from its worktrees' .uak-env). wt new without --agent reuses a free one (no claim on
# the claims branch, not retired), so its inbox and reviews stay under one name, or takes the next number of this
# machine's prefix. Why (MLB hackathon): one human ran 8 identities (a bare name plus -1..-7) and reviews and requests
# kept going to the ones whose sessions had closed.
wt_machine_agents() {
  git -C "$1" worktree list --porcelain 2>/dev/null | sed -n 's/^worktree //p' | while IFS= read -r d; do
    [ -f "$d/.uak-env" ] && sed -n 's/^UAK_AGENT=//p' "$d/.uak-env" | tr -d '\r'
  done | awk 'NF && !seen[$0]++'
}
WT_PICKED= WT_PICK_NOTE= WT_PICK_REUSE=no
wt_pick_agent() { # $1 main root, $2 human; sets WT_PICKED, WT_PICK_NOTE, WT_PICK_REUSE
  local root=$1 human=$2 known held= retired= all= a f base n max=0
  known=$(wt_machine_agents "$root")
  # A ref of this process, not FETCH_HEAD: another wt new fetching main in between rewrote FETCH_HEAD, `held` came
  # back empty and an identity that held a claim was reused (audit, Oct 2026).
  local ref="refs/uak/wt-claims-$$"
  if git -C "$root" fetch -q "$REMOTE" "+refs/heads/claims:$ref" 2>/dev/null; then
    held=$(git -C "$root" ls-tree --name-only "$ref" claims/ 2>/dev/null | while IFS= read -r f; do
      git -C "$root" cat-file -p "$ref:$f" 2>/dev/null | sed -n 's/^Owner: //p'; done | sort -u | tr '\n' ' ')
    retired=$(git -C "$root" ls-tree --name-only "$ref" meta/retired/ 2>/dev/null | sed 's@.*/@@;s@\.md$@@' | tr '\n' ' ')
    all=$(git -C "$root" ls-tree --name-only "$ref" meta/agents/ 2>/dev/null | sed 's@.*/@@;s@\.md$@@' | tr '\n' ' ')
    git -C "$root" update-ref -d "$ref" 2>/dev/null
  fi
  WT_PICK_REUSE=no
  for a in $known; do
    case " $held $retired " in *" $a "*) continue;; esac
    WT_PICKED=$a WT_PICK_REUSE=yes
    WT_PICK_NOTE="reusing $a (an identity of this machine with no claim): its inbox and review history stay under one name"
    return 0
  done
  base=$(git config --get uak.name 2>/dev/null || true)
  [ -n "$base" ] || base=$(printf '%s\n' $known | sed 's/-[0-9][0-9]*$//' | sort | uniq -c | sort -rn | awk 'NR == 1 {print $2}')
  [ -n "$base" ] || base=$(printf '%s' "$human" | tr 'A-Z' 'a-z' | tr -c 'a-z0-9_.\n-' '-' | tr -d '\n')
  [ -n "$base" ] || base=agent
  for a in $known $held $all; do
    case "$a" in "$base"-[0-9]*) n=${a#"$base"-}; case "$n" in *[!0-9]*) ;; *) [ "$n" -le "$max" ] || max=$n;; esac;; esac
  done
  WT_PICKED="$base-$((max + 1))"
  WT_PICK_NOTE="new identity $WT_PICKED (prefix: git config uak.name NAME)"
}
wt_path() { printf '%s/%s-wt/%s' "$(dirname "$1")" "$(basename "$1")" "$(printf '%s' "$2" | tr 'A-Z' 'a-z')"; }
# Claude Code's .claude/settings.local.json: the UAK_* env entries change, every other key stays. Claude Code saves
# "don't ask again" permissions in this file; wt session rewrote it whole and they were gone (audit, Oct 2026).
# An old UAK_HUMAN entry (before v5.1) becomes UAK_AGENT_HUMAN: in a worktree it granted human authority.
write_local_settings() { # $1 file; values in WT_AGENT WT_HUMAN WT_SESSION WT_TASK WT_PORT
  local f=$1 k missing= tmp
  if [ ! -s "$f" ] || [ -z "$(tr -d '{}[:space:]' < "$f")" ]; then
    printf '{\n  "env": {\n    "UAK_AGENT": "%s",\n    "UAK_AGENT_HUMAN": "%s",\n    "UAK_SESSION": "%s",\n    "UAK_TASK": "%s",\n    "UAK_PORT": "%s"\n  }\n}\n' \
      "$WT_AGENT" "$WT_HUMAN" "$WT_SESSION" "$WT_TASK" "$WT_PORT" > "$f"
    return 0
  fi
  for k in UAK_AGENT UAK_AGENT_HUMAN UAK_SESSION UAK_TASK UAK_PORT; do
    grep -q "\"$k\"[[:space:]]*:" "$f" || { [ "$k" = UAK_AGENT_HUMAN ] && grep -q '"UAK_HUMAN"[[:space:]]*:' "$f"; } || missing="$missing $k"
  done
  tmp="$f.tmp.$$"
  awk -v missing="$missing" -v a="$WT_AGENT" -v h="$WT_HUMAN" -v se="$WT_SESSION" -v t="$WT_TASK" -v po="$WT_PORT" '
    function val(k) { return k == "UAK_AGENT" ? a : k == "UAK_AGENT_HUMAN" ? h : k == "UAK_SESSION" ? se : k == "UAK_TASK" ? t : po }
    BEGIN { n = split(missing, miss, " ") }
    {
      rest = $0; line = ""
      while (match(rest, /"UAK_(AGENT|AGENT_HUMAN|HUMAN|SESSION|TASK|PORT)"[[:space:]]*:[[:space:]]*"[^"]*"/)) {
        k = substr(rest, RSTART + 1); k = substr(k, 1, index(k, "\"") - 1); if (k == "UAK_HUMAN") k = "UAK_AGENT_HUMAN"
        line = line substr(rest, 1, RSTART - 1) "\"" k "\": \"" val(k) "\""; rest = substr(rest, RSTART + RLENGTH)
      }
      line = line rest
      # Missing keys go first in the env object: on their own lines when the object opens a line, inline otherwise.
      if (!done && n > 0 && match(line, /"env"[[:space:]]*:[[:space:]]*\{/)) {
        head = substr(line, 1, RSTART + RLENGTH - 1); tail = substr(line, RSTART + RLENGTH); done = 1
        if (tail ~ /^[[:space:]]*$/) {
          print line; ind = line; sub(/[^[:space:]].*/, "", ind)
          for (i = 1; i <= n; i++) printf "%s  \"%s\": \"%s\",\n", ind, miss[i], val(miss[i])
          next
        }
        ins = ""
        for (i = 1; i <= n; i++) ins = ins (i > 1 ? ", " : "") "\"" miss[i] "\": \"" val(miss[i]) "\""
        line = head ins (tail ~ /^[[:space:]]*\}/ ? "" : ", ") tail
      }
      print line
    }
    END { if (n > 0 && !done) exit 3 }' "$f" > "$tmp"
  if [ $? -eq 0 ]; then mv "$tmp" "$f"; return 0; fi
  rm -f "$tmp"
  # No "env" object yet: one goes right after the opening brace.
  if ! grep -q '"env"[[:space:]]*:' "$f" && [ "$(sed -n '1p' "$f" | tr -d '[:space:]')" = "{" ]; then
    { printf '{\n  "env": {\n    "UAK_AGENT": "%s",\n    "UAK_AGENT_HUMAN": "%s",\n    "UAK_SESSION": "%s",\n    "UAK_TASK": "%s",\n    "UAK_PORT": "%s"\n  },\n' \
        "$WT_AGENT" "$WT_HUMAN" "$WT_SESSION" "$WT_TASK" "$WT_PORT"; sed '1d' "$f"; } > "$tmp" && mv "$tmp" "$f" && return 0
  fi
  say "wt: could not update the env block of $f; set UAK_AGENT=$WT_AGENT UAK_SESSION=$WT_SESSION UAK_TASK=$WT_TASK UAK_PORT=$WT_PORT there by hand." >&2
}
write_env() {
  # $1 dir, $2 agent, $3 human, $4 task, $5 port to keep (wt session)
  local session
  session="$2-$(date +%s)"
  # Own port per worktree: agents on one machine run their apps without clashing.
  # API on UAK_PORT, web on UAK_PORT+1. Why: on the Jetson port 8000 was taken.
  num=$(printf '%s' "$4" | sed 's/.*-0*//'); case "$num" in ''|*[!0-9]*) num=0;; esac
  port=${5:-}
  case "$port" in
    ''|*[!0-9]*)
      port=$(( ${UAK_PORT_BASE:-8100} + (num % 90) * 10 ))
      # Why (UpiixSol): "address already in use" 3 times; a leftover server or a task 90 IDs apart held the port.
      tries=0
      while [ "$tries" -lt 20 ] && { port_busy "$port" || port_busy $((port + 1)); }; do port=$((port + 900)); [ "$port" -lt 65000 ] || port=$((port - 56000)); tries=$((tries + 1)); done;;
  esac
  printf 'UAK_AGENT=%s\nUAK_AGENT_HUMAN=%s\nUAK_SESSION=%s\nUAK_TASK=%s\nUAK_PORT=%s\n' "$2" "$3" "$session" "$4" "$port" > "$1/.uak-env"
  # Claude Code applies this env to every agent Bash command in this worktree. UAK_AGENT_HUMAN names the agent's
  # human; it is not UAK_HUMAN, which grants human authority (allow, plan, retire) and only a human sets.
  mkdir -p "$1/.claude"
  WT_AGENT=$2 WT_HUMAN=$3 WT_SESSION=$session WT_TASK=$4 WT_PORT=$port write_local_settings "$1/.claude/settings.local.json"
}
cmd=${1:-help}; [ "$#" -eq 0 ] || shift
case "$cmd" in
  help|-h|--help) usage; exit 0;;
  ls) git worktree list; exit $?;;
  session)
    top=$(git rev-parse --show-toplevel 2>/dev/null) || die "Run inside a worktree."
    [ -f "$top/.uak-env" ] || die "This worktree has no .uak-env; use wt new."
    agent=$(sed -n 's/^UAK_AGENT=//p' "$top/.uak-env" | tr -d '\r'); human=$(sed -n 's/^UAK_AGENT_HUMAN=//p;s/^UAK_HUMAN=//p' "$top/.uak-env" | head -n 1 | tr -d '\r')
    task=$(sed -n 's/^UAK_TASK=//p' "$top/.uak-env" | tr -d '\r')
    # The port stays: the worktree's own server holds it, and a new one orphaned that server (audit, Oct 2026).
    oldport=$(sed -n 's/^UAK_PORT=//p' "$top/.uak-env" | head -n 1 | tr -d '\r')
    write_env "$top" "$agent" "$human" "$task" "$oldport"
    say "SESSION: $(sed -n 's/^UAK_SESSION=//p' "$top/.uak-env")"; exit 0;;
  rm)
    # A review checkout (detached, `git worktree add ../review-ID origin/<branch>`) keeps Verify's untracked build
    # output, so a plain `worktree remove` refuses and the guard blocks --force. It holds no work: no branch, no
    # tracked edits. Why (Chilangatón): 11 guard blocks on `worktree remove --force` and 1 on a recursive rm outside
    # the worktree; the leftovers were reviewers' detached checkouts, and the hint `wt rm ID` names the owner's worktree.
    if [ "${1:-}" = --review ]; then
      [ -n "${2:-}" ] || die "Usage: wt rm --review PATH"
      root=$(main_root); [ -n "$root" ] || die "Not a Git repository."
      path=$(cd "$2" 2>/dev/null && pwd -P) || die "No such folder: $2"
      listed=no
      while IFS= read -r d; do
        [ "$(cd "$d" 2>/dev/null && pwd -P)" != "$path" ] || listed=yes
      done <<EOF_WT
$(git -C "$root" worktree list --porcelain | sed -n 's/^worktree //p')
EOF_WT
      [ "$listed" = yes ] && [ "$path" != "$(cd "$root" && pwd -P)" ] || die "$path is not a worktree of this repository."
      # A task worktree (it has .uak-env) is never a review checkout, even with a detached HEAD: `git rebase` leaves
      # one, and --review removed a task's new files with it (audit, Oct 2026).
      [ ! -f "$path/.uak-env" ] || die "$path is a task worktree (.uak-env): use wt rm ID, which keeps uncommitted work."
      wgd=$(git -C "$path" rev-parse --absolute-git-dir 2>/dev/null)
      for s in rebase-merge rebase-apply BISECT_LOG MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD; do
        [ -z "$wgd" ] || [ ! -e "$wgd/$s" ] || die "$path is in the middle of a ${s%%[-_]*} (git -C $path status): finish or abort it first."
      done
      ! git -C "$path" symbolic-ref -q HEAD >/dev/null 2>&1 || die "$path is on a branch: it may hold work. Use wt rm ID for a task worktree."
      [ -n "$(git -C "$path" for-each-ref --count=1 --contains HEAD refs/heads refs/remotes 2>/dev/null)" ] ||
        die "$path has commits on no branch; push or branch them first (git -C $path log -1)."
      [ -z "$(git -C "$path" status --porcelain --untracked-files=no 2>/dev/null)" ] ||
        die "$path has edits to tracked files; a review changes nothing. Look at them (git -C $path status) first."
      untracked=$(git -C "$path" ls-files --others --exclude-standard 2>/dev/null)
      git -C "$root" worktree remove --force "$path" || die "Did not remove $path."
      if [ -n "$untracked" ]; then
        say "WT_REMOVED: $path (review checkout); dropped $(printf '%s\n' "$untracked" | wc -l | tr -d ' ') untracked file(s) git does not ignore: $(printf '%s\n' "$untracked" | head -n 10 | tr '\n' ' ')"
      else say "WT_REMOVED: $path (review checkout; untracked build output dropped)"; fi
      exit 0
    fi
    id=${1:-}; printf '%s' "$id" | grep -Eq '^[A-Z][A-Z0-9]*-[0-9]{3,}$' || die "Usage: wt rm ID"
    root=$(main_root); [ -n "$root" ] || die "Not a Git repository."
    path=$(wt_path "$root" "$id")
    [ ! -f "$path/.uak-env" ] || (cd "$path" && bash "$WT_SELF" stop >/dev/null 2>&1) || true
    git -C "$root" worktree remove "$path" || die "Did not remove $path (uncommitted changes). Check it; never --force someone else's work."
    say "WT_REMOVED: $path (branch kept)"; exit 0;;
  stop)
    top=$(git rev-parse --show-toplevel 2>/dev/null) || die "Run inside a worktree."
    if [ -n "${1:-}" ]; then top=$(wt_path "$(main_root)" "$1"); fi
    [ -f "$top/.uak-env" ] || die "No .uak-env in $top; nothing to stop."
    port=$(sed -n 's/^UAK_PORT=//p' "$top/.uak-env" | tr -d '\r'); case "$port" in ''|*[!0-9]*) die "No UAK_PORT in .uak-env.";; esac
    stopped=
    for p in "$port" $((port + 1)); do
      for pid in $(port_pids "$p"); do [ "$pid" = "$$" ] || { kill_pid "$pid" && stopped="$stopped $pid@$p"; }; done
    done
    say "WT_STOPPED:${stopped:- nothing listening on $port/$((port + 1))}"; exit 0;;
  pr)
    url=$(git config --get "remote.$REMOTE.url" 2>/dev/null) || die "No remote $REMOTE."
    # Host aliases from ~/.ssh/config (git@github.com-work:o/r.git) and ssh://…:22/ forms: the path is what is
    # after the host. Why (audit, Oct 2026): an alias produced https://github.com/git@github.com-work:o/r/compare/…
    case "$url" in
      *://*) repo=${url#*://}; repo=${repo#*@}; repo=${repo#*/};;
      *) repo=${url#*@}; repo=${repo#*:};;
    esac
    repo=${repo%.git}; repo=${repo%/}
    branch=$(git symbolic-ref --short HEAD 2>/dev/null) || die "Detached HEAD."
    case "$url" in *github.com*) ;; *) die "Not a GitHub remote: open the PR in your forge's web UI for $branch.";; esac
    # Why (UpiixSol): a fine-grained token without "Pull requests: write" made gh pr create fail for a day.
    say "Open this URL to create the PR (gh pr create needs a token with Pull requests: write):"
    say "https://github.com/$repo/compare/$BASE...$branch?expand=1"
    task=$(sed -n 's/^UAK_TASK=//p' "$(git rev-parse --show-toplevel)/.uak-env" 2>/dev/null | tr -d '\r')
    say "Then: bash .uak/bin/uak done ${task:-ID} --pr <the PR's URL> --evidence \"<Verify command> exit 0; <criteria checked>\""; exit 0;;
  new) ;;
  *) usage >&2; exit 2;;
esac

id=${1:-}; [ "$#" -eq 0 ] || shift
printf '%s' "$id" | grep -Eq '^[A-Z][A-Z0-9]*-[0-9]{3,}$' || die "Usage: wt new ID [--agent NAME] [--human NAME] [--next TEXT]"
agent=${UAK_AGENT:-} human=${UAK_HUMAN:-} next_text= agent_flag=no
while [ "$#" -gt 0 ]; do
  case "$1" in
    --agent) [ "$#" -gt 1 ] || die "--agent needs a value"; agent=$2; agent_flag=yes; shift $(($# > 1 ? 2 : 1));;
    --human) [ "$#" -gt 1 ] || die "--human needs a value"; human=$2; shift $(($# > 1 ? 2 : 1));;
    --next) [ "$#" -gt 1 ] || die "--next needs a value"; next_text=$2; shift $(($# > 1 ? 2 : 1));;
    *) die "Unknown option: $1";;
  esac
done
[ -n "$human" ] || human=$(git config user.name 2>/dev/null | tr -c 'A-Za-z0-9_.\n-' '-' | tr -s '-' | tr -d '\n')
if [ -z "$agent" ] || [ "$agent" = auto ]; then
  wt_pick_agent "$(main_root)" "$human"; agent=$WT_PICKED
  say "wt: $WT_PICK_NOTE" >&2
elif [ "$agent_flag" = yes ] && ! wt_machine_agents "$(main_root)" | grep -qxF -- "$agent"; then
  # A new name while this machine has a free identity: say so (a hint, not a block).
  wt_pick_agent "$(main_root)" "$human"
  [ "$WT_PICK_REUSE" != yes ] || say "wt: $WT_PICKED on this machine holds no claim; reusing it keeps one inbox: wt new $id (or --agent $WT_PICKED)." >&2
fi
[ "$agent_flag" = yes ] || [ -z "${UAK_AGENT:-}" ] || say "wt: no --agent given; using UAK_AGENT=$UAK_AGENT from your shell. A subagent needs its own: --agent NAME." >&2
clean_id "$agent" || die "--agent: letters, digits, dot, dash or underscore only."
clean_id "$human" || die "--human: letters, digits, dot, dash or underscore only."

root=$(main_root); [ -n "$root" ] || die "Not a Git repository."
lower=$(printf '%s' "$id" | tr 'A-Z' 'a-z')
branch="feat/$lower"
path=$(wt_path "$root" "$id")
[ ! -e "$path" ] || die "$path exists. If yours: cd \"$path\". If not: leave it."
git -C "$root" show-ref --verify --quiet "refs/heads/$branch" && die "Branch $branch already exists locally; check uak status --task $id --summary."

# Writes .git/config only if needed: several agents on one machine start at once.
hooks_dir=.uak/githooks; [ -d "$root/$hooks_dir" ] || hooks_dir=.githooks   # v5.2 moved them under .uak
[ "$(git -C "$root" config --get core.hooksPath)" = "$hooks_dir" ] || git -C "$root" config core.hooksPath "$hooks_dir"
git -C "$root" fetch -q "$REMOTE" "$BASE" || die "Could not fetch $REMOTE/$BASE."
# The task was claimed before (released, expired, handed over from another machine): its branch is on the remote,
# and the new worktree continues it. Why (Hacktoberfest second autopsy): 7 takeovers started from main and one agent
# redid work that was already on origin/feat/hack-012.
start="$REMOTE/$BASE"
if git -C "$root" fetch -q "$REMOTE" "+refs/heads/$branch:refs/remotes/$REMOTE/$branch" 2>/dev/null &&
   git -C "$root" rev-parse -q --verify "refs/remotes/$REMOTE/$branch" >/dev/null 2>&1; then
  start="$REMOTE/$branch"
  behind=$(git -C "$root" rev-list --count "$start..$REMOTE/$BASE" 2>/dev/null || echo 0)
  say "wt: $branch is already on $REMOTE ($(git -C "$root" rev-list --count "$REMOTE/$BASE..$start" 2>/dev/null || echo '?') commit(s) of earlier work): the worktree starts from it.$([ "${behind:-0}" -eq 0 ] || printf ' It is %s commit(s) behind %s: git merge --no-edit %s/%s.' "$behind" "$BASE" "$REMOTE" "$BASE")" >&2
fi
mkdir -p "$(dirname "$path")"
# --no-track: no upstream means no .git/config write (avoids lock contention).
added=no
for attempt in 1 2 3 4 5; do
  if git -C "$root" worktree add -q --no-track -b "$branch" "$path" "$start" 2> "${TMPDIR:-/tmp}/wt-add.$$"; then added=yes; break; fi
  # A failed attempt may leave the branch without a worktree: reuse it only if still at base.
  if [ ! -e "$path" ] && git -C "$root" show-ref --verify --quiet "refs/heads/$branch" &&
     [ -z "$(git -C "$root" rev-list "$start..$branch" 2>/dev/null)" ]; then
    git -C "$root" worktree add -q "$path" "$branch" 2>> "${TMPDIR:-/tmp}/wt-add.$$" && { added=yes; break; }
  fi
  sleep "$attempt"
done
[ "$added" = yes ] || { cat "${TMPDIR:-/tmp}/wt-add.$$" >&2; rm -f "${TMPDIR:-/tmp}/wt-add.$$"; die "Could not create the worktree."; }
rm -f "${TMPDIR:-/tmp}/wt-add.$$"
write_env "$path" "$agent" "$human" "$id"

set -- claim "$id" --branch "$branch" --worktree "$path"
[ -z "$next_text" ] || set -- "$@" --next "$next_text"
code=0
(cd "$path" && bash .uak/bin/uak "$@") || code=$?
if [ "$code" -ne 0 ]; then
  # Undo only what this command created and that has no own commits yet.
  if [ -z "$(git -C "$root" rev-list "$start..$branch" 2>/dev/null)" ]; then
    rm -f "$path/.uak-env" "$path/.claude/settings.local.json"
    git -C "$root" worktree remove "$path" >/dev/null 2>&1 && git -C "$root" branch -D "$branch" >/dev/null 2>&1
  fi
  say "WT_CLAIM_FAILED ($code): pick another task with bash .uak/bin/uak next." >&2
  exit "$code"
fi
(cd "$path" && bash .uak/bin/uak inbox --task "$id" 2>/dev/null | tail -n 20)
say "WT_READY: $id · branch $branch · worktree $path"
say "Next: cd \"$path\" and open your agent there (claude / codex / cursor)."
# Codex's sandbox writes only inside the worktree; git and uak also write the shared .git (index, refs, uak-out).
# Why (Hacktoberfest, Windows): 5 black-box lines of "Git metadata writes require sandbox escalation".
common=$(cd "$path" && cd "$(git rev-parse --git-common-dir)" 2>/dev/null && pwd -P) &&
  { ! wt_windows || ! command -v cygpath >/dev/null 2>&1 || common=$(cygpath -m "$common" 2>/dev/null || printf '%s' "$common"); } &&
  say "Codex: codex --add-dir \"$common\" (its sandbox must write the shared .git: commits, refs, uak state)"
