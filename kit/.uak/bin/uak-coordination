#!/usr/bin/env bash
# CLI module; Bash 3.2+, Git and POSIX tools, no jq/Python.
# Why: the remote publishes decisions and deadlines with CAS evidence.

coord_read() {
  local coord_line coord_prefix="$2: "
  [ -f "$1" ] || return 0
  while IFS= read -r coord_line; do
    coord_line=${coord_line%$'\r'}
    case "$coord_line" in "$coord_prefix"*) printf '%s\n' "${coord_line#"$coord_prefix"}"; return 0;; esac
  done < "$1"
}
coord_put() {
  local coord_line coord_seen=no coord_prefix="$2: "
  {
    while IFS= read -r coord_line; do
      case "$coord_line" in "$coord_prefix"*) printf '%s\n' "$2: $3"; coord_seen=yes;; *) printf '%s\n' "$coord_line";; esac
    done < "$1"
    [ "$coord_seen" = yes ] || printf '%s\n' "$2: $3"
  } > "$TXROOT/coord-edit"
  mv "$TXROOT/coord-edit" "$1"
}
coord_config() { coord_cfg "$@"; printf '%s\n' "$coord_v"; }
# coord_cfg KEY [DEFAULT]: the same value into coord_v, no subshell (the read path asks for a dozen keys per call).
coord_cfg() {
  coord_v=
  # Authority keys come from PROJECT.md on the remote base (coord-auth, written by coord_init), never from
  # claims. Why (audit, Oct 2026): a raw push of meta/config.md with the public Config-Source hash and
  # "Autonomy: yes, Auto-Merge: yes, Review-Mode: claims" passed every gate while main said no.
  [ ! -f "${TXROOT:-/nonexistent}/coord-auth" ] || { coord_rv "$TXROOT/coord-auth" "$1"; coord_v=$coord_r; }
  [ -n "$coord_v" ] || [ ! -f "$TX/meta/config.md" ] || { coord_rv "$TX/meta/config.md" "$1"; coord_v=$coord_r; }
  [ -n "$coord_v" ] || coord_v=${2:-}
}
# coord_rv FILE KEY: coord_read into coord_r, no subshell.
coord_rv() {
  local coord_line coord_prefix="$2: "
  coord_r=
  [ -f "$1" ] || return 0
  while IFS= read -r coord_line; do
    coord_line=${coord_line%$'\r'}
    case "$coord_line" in "$coord_prefix"*) coord_r=${coord_line#"$coord_prefix"}; return 0;; esac
  done < "$1"
}
coord_uint() {
  case "$2" in ''|*[!0-9]*) die "$1 must be an integer >= 0.";; esac
}
coord_yesno() { case "$2" in yes|no) ;; *) die "$1 must be yes or no.";; esac; }
coord_source_field() {
  # Same reading as lint and doctor: "- **Freeze-Epoch:** N" counts. Why (audit, Oct 2026): written in bold, the
  # freeze passed lint and doctor and did not exist for the engine.
  uak_cfg_var "$TXROOT/coord-source" "$1" "$2"; coord_v=$CFG
  printf '%s\n' "$coord_v"
}
# A key whose value is a list on the next lines ("- **Depends on:**" then "  - HACK-001") becomes one line, and IDs
# in Depends on are upper case: every reader of the backlog reads one line per key. Why (audit, Oct 2026): a
# Depends on written as a list, or as hack-001, was ignored and the task was claimed before its dependency.
coord_fold_backlog() {
  awk '
    function flush(   o) { if (held != "") { o = held (items != "" ? " " items : ""); if (hk ~ /^Depends on/) o = upids(o); print o; held = ""; items = "" } }
    function upids(s,   out) { out = ""
      while (match(s, /[A-Za-z][A-Za-z0-9]*-[0-9][0-9][0-9]+/)) { out = out substr(s, 1, RSTART - 1) toupper(substr(s, RSTART, RLENGTH)); s = substr(s, RSTART + RLENGTH) }
      return out s }
    held != "" && /^[[:space:]]+[-*][[:space:]]+/ { x = $0; sub(/\r$/, "", x); sub(/^[[:space:]]+[-*][[:space:]]+/, "", x); items = items (items != "" ? ", " : "") x; next }
    { flush(); line = $0; sub(/\r$/, "", line)
      key = line; gsub(/\*\*/, "", key); sub(/^[[:space:]]*[-*][[:space:]]*/, "", key)
      if (key ~ /^Depends on[[:space:]]*:/) line = upids(line)
      if (line ~ /^[-*][[:space:]]/ && key ~ /^[A-Za-z][A-Za-z -]*:[[:space:]]*$/) { held = line; hk = key; next }
      print line }
    END { flush() }' "$1" > "$1.fold" && mv "$1.fold" "$1"
}
coord_init() {
  [ "${COORD_INITIALIZED_TX:-}" != "$TX" ] || return 0
  mkdir -p "$TX/meta/agents" "$TX/meta/sessions" "$TX/meta/task-sessions" "$TX/meta/decisions" "$TX/deadlines" "$TX/queue"
  git check-ref-format "refs/heads/$BASE" >/dev/null 2>&1 || die "Invalid UAK_BASE."
  # Config comes from the remote base, never from a stale worktree.
  # Depth 1 unless the command proves ancestry on the base (done/integrate/merge): a full fetch of main on
  # every status/next was a clone of the product repo per call.
  case "$CMD" in done|integrate|merge) coord_depth=;; *) coord_depth=--depth=1;; esac
  # Already fetched in this transaction directory (status/next reuse the tick's clone): no second fetch.
  # The whole base is the heaviest fetch of a call: 3 tries, like the claims fetch, and git's own reason.
  # Why (Chilangatón, venue Wi-Fi): 10 `done` failed as "Could not read PROJECT.md" over 2 hours, never retried,
  # and git's error was dropped, so nobody saw the cause.
  local coord_try=0
  # A retry of the same call (claims contention: a new try directory) reuses the base it already fetched, from the
  # previous try's objects: no second download. Why (Chilangatón): "done/review/status retry 10+ times and take
  # over 8 min" on venue Wi-Fi, and done/integrate/merge fetched the whole base again on every retry.
  if [ -n "${COORD_BASE_FROM:-}" ] && [ "$COORD_BASE_FROM" != "$TX" ] && [ -d "$COORD_BASE_FROM/.git" ]; then
    git -C "$TX" fetch -q "$COORD_BASE_FROM" refs/uak/config:refs/uak/config 2>/dev/null || true
  fi
  until git -C "$TX" rev-parse -q --verify refs/uak/config >/dev/null 2>&1 ||
        git -C "$TX" fetch -q $coord_depth origin "refs/heads/$BASE:refs/uak/config" 2> "$TXROOT/config-error"; do
    coord_try=$((coord_try + 1))
    [ "$coord_try" -lt 3 ] || gitfail "Could not read PROJECT.md on remote $BASE (3 tries). $(head -n 1 "$TXROOT/config-error")"
    sleep $((coord_try * 2))
  done
  COORD_BASE_FROM=$TX
  git -C "$TX" show refs/uak/config:.uak/TASKS.md > "$TXROOT/canonical-TASKS.md" 2>/dev/null || : > "$TXROOT/canonical-TASKS.md"
  git -C "$TX" show refs/uak/config:.uak/OWNERS.md > "$TXROOT/canonical-OWNERS.md" 2>/dev/null || : > "$TXROOT/canonical-OWNERS.md"
  # Backlog published with `uak plan` on claims is appended to main's, no PR.
  # Why: at Hack-Nation 8 PRs only added tasks and 3 merges fell to the human queue over TASKS.md.
  [ ! -f "$TX/backlog/TASKS.md" ] || { printf '\n'; cat "$TX/backlog/TASKS.md"; } >> "$TXROOT/canonical-TASKS.md"
  # `plan --amend`: the last amended section of an ID replaces its section, in place.
  if [ -f "$TX/backlog/AMEND.md" ]; then
    awk 'FNR == NR { if ($0 ~ /^## [A-Z][A-Z0-9]*-[0-9]/) { id = $2; sec[id] = "" } else if ($0 ~ /^# /) id = ""
                     if (id != "") sec[id] = sec[id] $0 "\n"; next }
         /^## [A-Z][A-Z0-9]*-[0-9]/ { skip = 0; if ($2 in sec) { if (!($2 in done)) { printf "%s", sec[$2]; done[$2] = 1 }; skip = 1; next } }
         /^# / { skip = 0 }
         !skip { print }' "$TX/backlog/AMEND.md" "$TXROOT/canonical-TASKS.md" > "$TXROOT/canonical-TASKS.amended" &&
      mv "$TXROOT/canonical-TASKS.amended" "$TXROOT/canonical-TASKS.md"
  fi
  [ ! -f "$TX/backlog/OWNERS.md" ] || { printf '\n'; cat "$TX/backlog/OWNERS.md"; } >> "$TXROOT/canonical-OWNERS.md"
  coord_fold_backlog "$TXROOT/canonical-TASKS.md"
  BACKLOG="$TXROOT/canonical-TASKS.md"; OWNERS="$TXROOT/canonical-OWNERS.md"
  coord_source=$(git -C "$TX" rev-parse --verify 'refs/uak/config:.uak/PROJECT.md' 2>/dev/null || printf '%s' '-')
  git -C "$TX" show refs/uak/config:.uak/PROJECT.md > "$TXROOT/coord-source" 2>/dev/null || : > "$TXROOT/coord-source"
  # One pass, the same reading as coord_source_field (lib/config.sh), for the 15 authority keys at once. A key with a default is always written (absent from
  # PROJECT.md = its default, not whatever claims says); the timing keys only when PROJECT.md sets them.
  awk -v keys="Backlog-Approved=no Autonomy=no Auto-Merge=no Freeze-Epoch=0 Events-Per-Session=100 Checkpoint-Percent=60 Review-Mode=auto Merge-Lease-Seconds=1800 Merge-Wait-Seconds=180 Review-Independence=agent Claims-Signing=no Presence-Seconds= Stall-Seconds= Review-Offer-Seconds= Merge-Adopt-Seconds=" '
    BEGIN { n = split(keys, kv, " "); for (i = 1; i <= n; i++) { e = index(kv[i], "="); k[i] = substr(kv[i], 1, e - 1); d[i] = substr(kv[i], e + 1) } }
    { l = $0; sub(/\r$/, "", l); sub(/^[-* ]*/, "", l)
      for (i = 1; i <= n; i++) if (!(i in got) && index(l, k[i] ":") == 1) {
        v = substr(l, length(k[i]) + 2); sub(/^[* ]*/, "", v); gsub(/`/, "", v); got[i] = v } }
    END { for (i = 1; i <= n; i++) if (i in got) print k[i] ": " got[i]; else if (d[i] != "") print k[i] ": " d[i] }' \
    "$TXROOT/coord-source" > "$TXROOT/coord-auth"
  COORD_INITIALIZED_TX=$TX
  # Lease per mode (sprint 45 min, marathon 4 h); UAK_LEASE_SECONDS wins if set. REVIEW waits longer:
  # reviewers and humans are slow; an expired REVIEW lease forced pointless recovery.
  if [ -z "${UAK_LEASE_SECONDS:-}" ]; then uak_cfg_var "$TXROOT/coord-source" Lease-Seconds "$LEASE"; LEASE=$CFG; fi
  uak_cfg_var "$TXROOT/coord-source" Review-Lease-Seconds $((LEASE * 4)); REVIEW_LEASE=$CFG
  case "$LEASE$REVIEW_LEASE" in *[!0-9]*) die "Lease-Seconds and Review-Lease-Seconds must be integers.";; esac
  coord_cfg Config-Source UNINITIALIZED; coord_old_source=$coord_v
  # Schema 2 carries the timing keys below; an older config.md is rewritten once even if PROJECT.md did not change.
  coord_cfg Config-Schema 1
  [ "$coord_old_source" != "$coord_source" ] || [ "$coord_v" != 2 ] || return 0
  uak_cfg_var "$TXROOT/coord-source" Backlog-Proposed-Epoch 0; coord_proposed=$CFG
  coord_uint Backlog-Proposed-Epoch "$coord_proposed"
  if [ "$coord_proposed" -eq 0 ]; then
    coord_cfg Backlog-Proposed-Epoch "$NOW"; coord_proposed=$coord_v
  fi
  uak_cfg_var "$TXROOT/coord-source" Backlog-Approved no; coord_approved=$CFG
  uak_cfg_var "$TXROOT/coord-source" Autonomy no; coord_autonomy=$CFG
  uak_cfg_var "$TXROOT/coord-source" Auto-Merge no; coord_auto_merge=$CFG
  uak_cfg_var "$TXROOT/coord-source" Freeze-Epoch 0; coord_freeze=$CFG
  uak_cfg_var "$TXROOT/coord-source" Events-Per-Session 100; coord_budget=$CFG
  uak_cfg_var "$TXROOT/coord-source" Checkpoint-Percent 60; coord_percent=$CFG
  uak_cfg_var "$TXROOT/coord-source" Review-Mode auto; coord_review_mode=$CFG
  uak_cfg_var "$TXROOT/coord-source" Merge-Lease-Seconds 1800; coord_merge_lease=$CFG
  uak_cfg_var "$TXROOT/coord-source" Merge-Wait-Seconds 180; coord_merge_wait=$CFG
  # Timing keys read with coord_config (presence, stalls, review offers, merge adoption): PROJECT.md wins, then what
  # claims already had. Why: they were read from meta/config.md but never written there, so setting them in
  # PROJECT.md (as CLI.md says) did nothing.
  local coord_k coord_timing=
  for coord_k in Presence-Seconds:1800 Stall-Seconds:5400 Review-Offer-Seconds:900 Merge-Adopt-Seconds:1200; do
    coord_cfg "${coord_k%%:*}" "${coord_k#*:}"; uak_cfg_var "$TXROOT/coord-source" "${coord_k%%:*}" "$coord_v"; coord_v=$CFG
    coord_uint "${coord_k%%:*}" "$coord_v"; coord_timing="$coord_timing${coord_k%%:*}: $coord_v
"
  done
  coord_yesno Backlog-Approved "$coord_approved"; coord_yesno Autonomy "$coord_autonomy"
  coord_yesno Auto-Merge "$coord_auto_merge"
  coord_uint Freeze-Epoch "$coord_freeze"; coord_uint Events-Per-Session "$coord_budget"
  coord_uint Checkpoint-Percent "$coord_percent"; coord_uint Merge-Lease-Seconds "$coord_merge_lease"
  coord_uint Merge-Wait-Seconds "$coord_merge_wait"
  [ "$coord_budget" -gt 0 ] && [ "$coord_percent" -gt 0 ] && [ "$coord_percent" -le 100 ] && [ "$coord_merge_lease" -gt 0 ] || die "Invalid budget, percent or merge lease."
  case "$coord_review_mode" in auto|claims|gh) ;; *) die "Review-Mode must be auto, claims or gh.";; esac
  {
    printf '# Verifiable config\n'
    printf '%s\n' "Config-Source: $coord_source" "Backlog-Proposed-Epoch: $coord_proposed" \
      "Backlog-Approved: $coord_approved" "Autonomy: $coord_autonomy" "Auto-Merge: $coord_auto_merge" \
      "Freeze-Epoch: $coord_freeze" "Events-Per-Session: $coord_budget" "Checkpoint-Percent: $coord_percent" \
      "Review-Mode: $coord_review_mode" "Merge-Lease-Seconds: $coord_merge_lease" "Merge-Wait-Seconds: $coord_merge_wait"
    printf '%s' "$coord_timing"
    printf '%s\n' "Config-Schema: 2"
  } > "$TX/meta/config.md"
}
coord_receipt() {
  coord_kind=$1 coord_key=$2 coord_deadline=$3 coord_effect=$4 coord_detail=$5
  case "$coord_kind:$coord_key" in *[!A-Za-z0-9_.:-]*) die "Invalid deadline key.";; esac
  coord_uint Deadline "$coord_deadline"
  coord_receipt_file="$TX/deadlines/$coord_kind-$coord_key-$coord_deadline.md"
  [ ! -f "$coord_receipt_file" ] || return 1
  mkdir -p "$TX/deadlines"
  {
    printf '# Evaluated deadline\n'
    printf '%s\n' "Kind: $coord_kind" "Key: $coord_key" "Deadline: $coord_deadline" \
      "Evaluated: $NOW" "Effect: $coord_effect" "Detail: $(one_line "$coord_detail")"
  } > "$coord_receipt_file"
  [ -f "$TX/DECISIONS.md" ] || printf '# DECISIONS\n' > "$TX/DECISIONS.md"
  printf '%s\n' "- $NOW | deadline $coord_kind/$coord_key/$coord_deadline | $coord_effect | $(one_line "$coord_detail")" >> "$TX/DECISIONS.md"
  return 0
}
coord_apply_decision() {
  # CLI globals stay intact when tick processes another task.
  local ID RECORD CLAIM WL STATE coord_dfile=$1 coord_doption=$2 coord_dwhy=$3 coord_duntil coord_dnext coord_dstats
  ID=$(coord_read "$coord_dfile" Task); RECORD=$(task_file); CLAIM=$(claim_file)
  [ -f "$RECORD" ] && [ -f "$CLAIM" ] || return 0
  [ "$(coord_read "$RECORD" Owner)" = "$(coord_read "$coord_dfile" Owner)" ] || return 0
  WL=$(coord_read "$RECORD" Worklog); valid_worklog "$WL" && [ -f "$TX/$WL" ] || return 0
  STATE=$(coord_read "$RECORD" State); coord_duntil=$(coord_read "$CLAIM" Lease-Until)
  coord_dnext="Apply option: $coord_doption"
  if [ "$NOW" -ge "$coord_duntil" ]; then
    coord_dnext="Recover lease with token; then apply option: $coord_doption"
  elif [ "$STATE" = BLOCKED ]; then
    STATE=CLAIMED; coord_put "$RECORD" State "$STATE"; coord_put "$CLAIM" State "$STATE"
  fi
  coord_put "$RECORD" Next "$coord_dnext"; coord_put "$CLAIM" Next "$coord_dnext"
  update_summary_field Decision "$coord_doption"; update_summary_field Why "$coord_dwhy"
  update_summary_field Next "$coord_dnext"
  # Scheduler event: does not consume the budget of the agent that called tick.
  printf '%s\n' "- $NOW | $STATE | scheduler | deadline decision $(basename "$coord_dfile" .md); option: $(one_line "$coord_doption"); Why: $(one_line "$coord_dwhy")" >> "$TX/$WL"
  mkdir -p "$TX/meta/tasks"
  coord_dstats="$TX/meta/tasks/$ID.md"
  if [ ! -f "$coord_dstats" ]; then
    printf '%s\n' "Task: $ID" "Events: 0" "Checkpoints: 0" "Sessions: 0" "Last-Checkpoint: 0" > "$coord_dstats"
  fi
  coord_counter_inc "$coord_dstats" Events
  coord_put "$RECORD" Events "$(coord_read "$coord_dstats" Events)"
}
coord_tick_mutate() {
  coord_init
  coord_cfg Backlog-Proposed-Epoch "$NOW"; coord_proposed=$coord_v
  coord_deadline=$((coord_proposed + 600))
  coord_cfg Backlog-Approved no
  if [ "$coord_v" = no ] && [ "$NOW" -ge "$coord_deadline" ]; then
    coord_effect=WAIT_AUTHORIZATION
    coord_cfg Autonomy no; [ "$coord_v" != yes ] || coord_effect=ALLOW_P0
    coord_receipt backlog proposed "$coord_deadline" "$coord_effect" "Only P0 with active autonomy; a timeout grants no permissions." || true
  fi
  coord_cfg Freeze-Epoch 0; coord_freeze=$coord_v
  if [ "$coord_freeze" -gt 0 ] && [ "$NOW" -ge "$coord_freeze" ]; then
    coord_receipt freeze event "$coord_freeze" FREEZE_DEMO_FIXES_ONLY "New claims only with Freeze-Allowed: yes; respect authorization." || true
  fi
  for coord_claim in "$TX"/claims/*.md; do
    [ -f "$coord_claim" ] || continue
    coord_rv "$coord_claim" Lease-Until; coord_until=$coord_r
    # One damaged claim must not stop every command of every agent: it counts as expired. Why (audit, Oct 2026):
    # a non-numeric Lease-Until in any claim made claim, heartbeat, status and next die for the whole team.
    case "$coord_until" in ''|*[!0-9]*) coord_until=1;; esac
    # A REVIEW claim waits on others (reviewer, merge): its lease expiry needs no recovery; any agent can merge
    # it once approved. Why (MLB hackathon): 22 of 62 DECISIONS lines were REQUIRES_RECOVERY, 19 on REVIEW tasks.
    coord_rv "$coord_claim" State; [ "$coord_r" != REVIEW ] || continue
    if [ "$coord_until" -gt 0 ] && [ "$NOW" -ge "$coord_until" ]; then
      coord_rv "$coord_claim" ID; coord_id=$coord_r
      coord_receipt lease "$coord_id" "$coord_until" REQUIRES_RECOVERY "Claim kept; read the summary and use release --expired --read-summary. No work is deleted." || true
    fi
  done
  for coord_decision in "$TX"/meta/decisions/*.md; do
    [ -f "$coord_decision" ] || continue
    coord_rv "$coord_decision" Status; [ "$coord_r" = PENDING ] || continue
    coord_rv "$coord_decision" Opened; coord_opened=$coord_r; case "$coord_opened" in ''|*[!0-9]*) coord_opened=0;; esac
    coord_deadline=$((coord_opened + 900))
    [ "$NOW" -ge "$coord_deadline" ] || continue
    coord_effect=BLOCKED_OTHER_TASK
    coord_rv "$coord_decision" Class; coord_dc=$coord_r; coord_rv "$coord_decision" Authorized; coord_da=$coord_r
    coord_rv "$coord_decision" Reversible; coord_dr=$coord_r; coord_cfg Autonomy no
    if [ "$coord_dc" = routine ] && [ "$coord_da" = yes ] && [ "$coord_dr" = yes ] && [ "$coord_v" = yes ]; then
      coord_effect=REVERSIBLE_AND_LOG
    fi
    coord_key=${coord_decision##*/}; coord_key=${coord_key%.md}
    coord_rv "$coord_decision" Option; coord_option=$coord_r; coord_rv "$coord_decision" Why; coord_why=$coord_r
    if coord_receipt decision "$coord_key" "$coord_deadline" "$coord_effect" "Option: $coord_option; Why: $coord_why; no money, accounts, publishing or scope expansion."; then
      [ "$coord_effect" != REVERSIBLE_AND_LOG ] || coord_apply_decision "$coord_decision" "$coord_option" "$coord_why"
    fi
    coord_put "$coord_decision" Status "$coord_effect"; coord_put "$coord_decision" Evaluated "$NOW"
  done
  # Reconciling the queue keeps human reasons and task states.
  for coord_task in "$TX"/tasks/*.md; do
    [ -f "$coord_task" ] || continue
    coord_rv "$coord_task" ID; coord_id=$coord_r; coord_rv "$coord_task" State; coord_state=$coord_r
    coord_q="$TX/queue/$coord_id.md"
    if [ "$coord_state" = REVIEW ] && [ ! -f "$coord_q" ]; then
      coord_rv "$coord_task" Owner; coord_qo=$coord_r; coord_rv "$coord_task" Task-Tip; coord_qt=$coord_r
      coord_rv "$coord_task" PR
      printf '%s\n' "# Integration queue" "Task: $coord_id" "State: PENDING" \
        "Owner: $coord_qo" "Task-Tip: $coord_qt" "PR: $coord_r" "Updated: $NOW" > "$coord_q"
    elif [ "$coord_state" = INTEGRATED ] && [ -f "$coord_q" ] && { coord_rv "$coord_q" State; [ "$coord_r" != INTEGRATED ]; }; then
      coord_put "$coord_q" State INTEGRATED; coord_put "$coord_q" Updated "$NOW"
    fi
  done
  if typeset -f msg_reoffer_reviews >/dev/null 2>&1; then msg_reoffer_reviews; fi
  if typeset -f merge_tick_lock >/dev/null 2>&1; then merge_tick_lock; fi
}
coord_threshold() { coord_threshold_var; printf '%s\n' "$coord_th"; }
coord_threshold_var() {
  coord_cfg Events-Per-Session 100; coord_budget=$coord_v
  coord_cfg Checkpoint-Percent 60; coord_percent=$coord_v
  coord_th=$(((coord_budget * coord_percent + 99) / 100))
}
coord_agent_file() { printf '%s/meta/agents/%s.md\n' "$TX" "$AGENT"; }
coord_remote_task_field() {
  [ -f "$BACKLOG" ] || return 1
  awk -v id="$ID" -v key="$1" '
    /^## / { on=($2==id) }
    on {
      s=$0; gsub(/\*\*/, "", s); sub(/^[[:space:]]*-[[:space:]]*/, "", s); sub(/^[[:space:]]*/, "", s);
      if (index(s,key ":")==1) { sub(/^[^:]*:[[:space:]]*/, "", s); print s; exit }
    }' "$BACKLOG"
}
coord_claim_gate() {
  coord_cfg Autonomy no
  [ "$coord_v" = yes ] || UAK_CODE=autonomy-off conflict "Missing explicit Autonomy: yes in remote .uak/PROJECT.md; a timeout does not authorize."
  coord_cfg Backlog-Approved no
  if [ "$coord_v" != yes ]; then
    coord_cfg Backlog-Proposed-Epoch "$NOW"; coord_proposed=$coord_v
    # Why (a solo marathon project, Oct 2026): "no eligible candidate" for the first 10 min, and nothing said why.
    coord_left=$(( (coord_proposed + 600 - NOW + 59) / 60 )); [ "$coord_left" -gt 0 ] || coord_left=0
    [ "$NOW" -ge "$((coord_proposed + 600))" ] && [ "$(coord_remote_task_field Priority)" = P0 ] ||
      UAK_CODE=backlog-unapproved conflict "Backlog pending approval: Backlog-Approved is not yes in .uak/PROJECT.md on $BASE, so only P0 tasks, and only after 10 min ($coord_left min left). The human approves the plan: set Backlog-Approved: yes there and push it to $BASE."
  fi
  coord_cfg Freeze-Epoch 0; coord_freeze=$coord_v
  if [ "$coord_freeze" -gt 0 ] && [ "$NOW" -ge "$coord_freeze" ]; then
    coord_freeze_allowed || UAK_CODE=freeze conflict "FREEZE: $ID is not allowed after the freeze. A human can allow it: UAK_HUMAN=NAME bash .uak/bin/uak allow $ID --reason TEXT"
  fi
  coord_af="$TX/meta/agents/$AGENT.md"; coord_since=0
  [ ! -f "$coord_af" ] || { coord_rv "$coord_af" Events-Since-Checkpoint; coord_since=$coord_r; }
  # An agent file written by `uak away` or a human command has no counters yet (audit: no claim was ever possible).
  case "$coord_since" in ''|*[!0-9]*) coord_since=0;; esac
  coord_threshold_var
  [ "$coord_since" -lt "$coord_th" ] || UAK_CODE=checkpoint-now conflict "CHECKPOINT NOW: a recent checkpoint is required before claiming new tasks: bash .uak/bin/uak checkpoint --session --done T --decision T --why T --fails T --commands T --next T (- for none; with a task: checkpoint ID instead of --session)."
}
# Freeze exception: `Freeze-Allowed: yes` in the remote TASKS, or a human's `uak allow` on claims.
# Why (Reap buildathon): with no command, humans opened 3 PRs (#10, #11, #14) just to flip Freeze-Allowed,
# and agents relayed "the human authorizes everything", which the rules rightly refuse.
coord_freeze_allowed() {
  [ "$(coord_remote_task_field Freeze-Allowed)" = yes ] && return 0
  [ -f "$TX/backlog/ALLOW.md" ] && grep -q "^- $ID |" "$TX/backlog/ALLOW.md"
}
coord_allow_mutate() {
  local coord_ids= coord_a coord_c
  [ -n "$HUMAN" ] || UAK_CODE=human-only conflict "allow is a human decision: UAK_HUMAN=NAME bash .uak/bin/uak allow ID --reason TEXT."
  [ -n "$WHY_TEXT" ] || die "allow needs --reason TEXT (recorded in DECISIONS.md)."
  if [ "$ALLOW_INFLIGHT" = yes ]; then
    for coord_c in "$TX"/claims/*.md; do [ -f "$coord_c" ] && coord_ids="$coord_ids $(coord_read "$coord_c" ID)"; done
    [ -n "$coord_ids" ] || conflict "No in-flight task (CLAIMED, BLOCKED or REVIEW) to allow."
  else coord_ids=$ALLOW_IDS; fi
  mkdir -p "$TX/backlog"
  # A test change: the human read why an existing test is wrong. Why (v5.10): tests only grow unless a human says so.
  if [ "$ALLOW_TESTS" = yes ]; then
    [ "$ALLOW_INFLIGHT" != yes ] || die "allow --tests names its task: allow ID --tests --reason TEXT."
    [ -f "$TX/backlog/TEST-CHANGES.md" ] || printf '%s\n' '# Existing tests a human allowed to change (uak allow --tests)' '' \
      'Append-only. Format: - ID | epoch | human | reason. Why: a test is a spec; changing one is a human decision.' '' > "$TX/backlog/TEST-CHANGES.md"
    ALLOW_DONE=
    for coord_a in $coord_ids; do
      ! grep -q "^- $coord_a |" "$TX/backlog/TEST-CHANGES.md" || continue
      printf -- '- %s | %s | %s | %s\n' "$coord_a" "$NOW" "$HUMAN" "$(one_line "$WHY_TEXT" | tr '|' '/')" >> "$TX/backlog/TEST-CHANGES.md"
      ALLOW_DONE="$ALLOW_DONE $coord_a"
    done
    [ -n "$ALLOW_DONE" ] || return 0
    [ -f "$TX/DECISIONS.md" ] || printf '# DECISIONS\n' > "$TX/DECISIONS.md"
    printf '%s\n' "- $NOW | allow | $HUMAN | test change:$ALLOW_DONE | Why: $(one_line "$WHY_TEXT")" >> "$TX/DECISIONS.md"
    ID=; msg_append all info - "Test change allowed by $HUMAN:$ALLOW_DONE. Why: $WHY_TEXT"
    return 0
  fi
  [ -f "$TX/backlog/ALLOW.md" ] || printf '%s\n' '# Freeze exceptions (uak allow)' '' \
    'Append-only. Format: - ID | epoch | human | reason. Why: a freeze exception is a human decision with a name.' '' > "$TX/backlog/ALLOW.md"
  ALLOW_DONE=
  for coord_a in $coord_ids; do
    awk -v id="$coord_a" '/^## / && $2==id {f=1} END {exit !f}' "$BACKLOG" || die "$coord_a is not in TASKS.md."
    ! grep -q "^- $coord_a |" "$TX/backlog/ALLOW.md" || continue
    printf -- '- %s | %s | %s | %s\n' "$coord_a" "$NOW" "$HUMAN" "$(one_line "$WHY_TEXT" | tr '|' '/')" >> "$TX/backlog/ALLOW.md"
    ALLOW_DONE="$ALLOW_DONE $coord_a"
  done
  [ -n "$ALLOW_DONE" ] || return 0
  [ -f "$TX/DECISIONS.md" ] || printf '# DECISIONS\n' > "$TX/DECISIONS.md"
  printf '%s\n' "- $NOW | allow | $HUMAN | freeze exception:$ALLOW_DONE | Why: $(one_line "$WHY_TEXT")" >> "$TX/DECISIONS.md"
  ID=; msg_append all info - "Freeze exception by $HUMAN:$ALLOW_DONE (claim and merge allowed). Why: $WHY_TEXT"
}
coord_session() {
  coord_sid=${UAK_SESSION:-stable}
  printf '%s\n' "$coord_sid" | grep -Eq '^[A-Za-z0-9_.-]{1,64}$' || die "UAK_SESSION must be 1-64 letters, digits, dot or dash."
}
coord_counter_inc() {
  coord_counter_file=$1 coord_counter_key=$2
  coord_n=$(coord_read "$coord_counter_file" "$coord_counter_key")
  [ -n "$coord_n" ] || coord_n=0
  coord_uint "$coord_counter_key" "$coord_n"
  coord_put "$coord_counter_file" "$coord_counter_key" "$((coord_n + 1))"
}
# A human acting under their own name (UAK_HUMAN): any command they write with marks them `Role: human`, so the
# reviewer rotation never offers them a review. Why (Chilangatón): a human's allow made "Alexis" an identity seen on
# claims, and 3 review offers went to it, the last PR of the event among them.
coord_mark_human() {
  [ -n "$HUMAN" ] && [ "$AGENT" = "$HUMAN" ] || return 0
  case "$HUMAN" in *[!A-Za-z0-9_.-]*) return 0;; esac
  local f="$TX/meta/agents/$HUMAN.md"
  mkdir -p "$TX/meta/agents"
  [ -f "$f" ] || printf '%s\n' "# $HUMAN" "Agent: $HUMAN" "Started: $NOW" > "$f"
  [ "$(coord_read "$f" Role)" = human ] || coord_put "$f" Role human
}
coord_event() {
  [ -n "$AGENT" ] && [ -n "$ID" ] || return 0
  coord_session
  mkdir -p "$TX/meta/agents" "$TX/meta/sessions/agent-$AGENT" "$TX/meta/tasks" "$TX/meta/task-sessions/$ID/agent-$AGENT"
  coord_af=$(coord_agent_file)
  if [ ! -f "$coord_af" ]; then
    printf '%s\n' "# $AGENT" "Agent: $AGENT" "Started: $NOW" "Events: 0" "Events-Since-Checkpoint: 0" "Checkpoints: 0" "Sessions: 0" "Last-Checkpoint: 0" > "$coord_af"
  fi
  # Whose agent this is (from the worktree): presence and reviewer choice tell humans from agents with it.
  coord_h=${UAK_AGENT_HUMAN:-}
  if [ -n "$coord_h" ] && [ "$coord_h" != "$AGENT" ] && [ "$(coord_read "$coord_af" Human)" != "$coord_h" ]; then coord_put "$coord_af" Human "$coord_h"; fi
  coord_sf="$TX/meta/sessions/agent-$AGENT/session-$coord_sid.md"
  if [ ! -f "$coord_sf" ]; then
    printf '%s\n' "# Observed session" "Agent: $AGENT" "Session: $coord_sid" "Started: $NOW" "Events: 0" "Checkpoints: 0" > "$coord_sf"
    coord_counter_inc "$coord_af" Sessions
  fi
  coord_tf="$TX/meta/task-sessions/$ID/agent-$AGENT/session-$coord_sid.md"
  coord_taskstats="$TX/meta/tasks/$ID.md"
  if [ ! -f "$coord_taskstats" ]; then
    printf '%s\n' "Task: $ID" "Events: 0" "Checkpoints: 0" "Sessions: 0" "Last-Checkpoint: 0" > "$coord_taskstats"
  fi
  if [ ! -f "$coord_tf" ]; then
    printf '%s\n' "Agent: $AGENT" "Session: $coord_sid" "Started: $NOW" > "$coord_tf"
    coord_counter_inc "$coord_taskstats" Sessions
  fi
  coord_counter_inc "$coord_af" Events; coord_counter_inc "$coord_sf" Events
  coord_counter_inc "$coord_taskstats" Events
  if [ "$CMD" = checkpoint ]; then
    coord_put "$coord_af" Events-Since-Checkpoint 0; coord_put "$coord_af" Last-Checkpoint "$NOW"
    coord_counter_inc "$coord_af" Checkpoints; coord_counter_inc "$coord_sf" Checkpoints
    coord_counter_inc "$coord_taskstats" Checkpoints; coord_put "$coord_taskstats" Last-Checkpoint "$NOW"
  else coord_counter_inc "$coord_af" Events-Since-Checkpoint; fi
  coord_put "$coord_af" Last-Session "$coord_sid"; coord_put "$coord_af" Updated "$NOW"
  coord_put "$coord_sf" Updated "$NOW"
  for coord_stats_key in Events Checkpoints Sessions Last-Checkpoint; do
    coord_put "$RECORD" "$coord_stats_key" "$(coord_read "$coord_taskstats" "$coord_stats_key")"
  done
}
coord_status_budget() {
  if [ -z "$AGENT" ]; then say "Budget: set UAK_AGENT to see events/checkpoint."; return; fi
  coord_af="$TX/meta/agents/$AGENT.md"; coord_since=0 coord_total=0
  if [ -f "$coord_af" ]; then coord_rv "$coord_af" Events-Since-Checkpoint; coord_since=$coord_r; coord_rv "$coord_af" Events; coord_total=$coord_r; fi
  # A human's file (Role: human) has no counters: 0, not blanks ("Events: /90 alert (total )").
  case "$coord_since" in ''|*[!0-9]*) coord_since=0;; esac; case "$coord_total" in ''|*[!0-9]*) coord_total=0;; esac
  coord_threshold_var; coord_alert=$coord_th; coord_left=$((coord_alert - coord_since)); coord_suffix=
  if [ "$coord_left" -le 0 ]; then coord_left=0; coord_suffix=' | CHECKPOINT NOW: uak checkpoint ID|--session --done T --decision T --why T --fails T --commands T --next T'; fi
  say "Events: $coord_since/$coord_alert alert (total $coord_total); checkpoint required in $coord_left events$coord_suffix"
}
coord_handoff() {
  coord_sessions=$(coord_read "$RECORD" Sessions); [ -n "$coord_sessions" ] || coord_sessions=0
  say "Observed sessions: $coord_sessions | Pending: $(coord_read "$RECORD" Next)"
}
coord_checkpoint_session() {
  # Writes only its own profile; touches no tasks and creates no claims.
  coord_session
  mkdir -p "$TX/meta/agents" "$TX/meta/profiles" "$TX/meta/sessions/agent-$AGENT"
  coord_af=$(coord_agent_file)
  if [ ! -f "$coord_af" ]; then
    printf '%s\n' "# $AGENT" "Agent: $AGENT" "Started: $NOW" "Events: 0" "Events-Since-Checkpoint: 0" "Checkpoints: 0" "Sessions: 0" "Last-Checkpoint: 0" > "$coord_af"
  fi
  coord_sf="$TX/meta/sessions/agent-$AGENT/session-$coord_sid.md"
  if [ ! -f "$coord_sf" ]; then
    printf '%s\n' "# Observed session" "Agent: $AGENT" "Session: $coord_sid" "Started: $NOW" "Events: 0" "Checkpoints: 0" > "$coord_sf"
    coord_counter_inc "$coord_af" Sessions
  fi
  coord_pf="$TX/meta/profiles/agent-$AGENT.md"
  {
    printf '# Session checkpoint · %s\n\n' "$AGENT"
    printf '%s\n' "Agent: $AGENT" "Session: $coord_sid" "Checkpoint: $NOW"
    printf '\n## Live summary\n'
    printf '%s\n' "- Done: $(one_line "$DONE_TEXT")" "- Decision: $(one_line "$DECISION_TEXT")" \
      "- Why: $(one_line "$WHY_TEXT")" "- Failing: $(one_line "$FAILS_TEXT")" \
      "- Commands: $(one_line "$COMMANDS_TEXT")" "- Next: $(one_line "$NEXT_TEXT")"
    printf '\n## History\n'
    [ ! -f "$coord_pf" ] || awk 'on {print} /^## History$/ {on=1}' "$coord_pf"
    printf '%s\n' "- $NOW | checkpoint | $AGENT | session $coord_sid; next: $(one_line "$NEXT_TEXT")"
  } > "$TXROOT/coord-profile"
  mv "$TXROOT/coord-profile" "$coord_pf"
  coord_counter_inc "$coord_af" Events; coord_counter_inc "$coord_sf" Events
  coord_counter_inc "$coord_af" Checkpoints; coord_counter_inc "$coord_sf" Checkpoints
  coord_put "$coord_af" Events-Since-Checkpoint 0; coord_put "$coord_af" Last-Checkpoint "$NOW"
  coord_put "$coord_af" Last-Session "$coord_sid"; coord_put "$coord_af" Updated "$NOW"
  coord_put "$coord_sf" Last-Checkpoint "$NOW"; coord_put "$coord_sf" Updated "$NOW"
}
coord_decision_mutate() {
  # A human opens a decision on any task, claimed or not (AGENTS.md: "the human runs uak decision personally").
  # Why (audit, Oct 2026): require_owner refused every human decision ("has no active claim", "belongs to").
  if [ -n "$HUMAN" ] && [ "$AGENT" = "$HUMAN" ]; then
    RECORD=$(task_file); CLAIM=$(claim_file)
    if [ ! -f "$RECORD" ] && ! awk -v id="$ID" '/^## / && $2==id {f=1} END {exit !f}' "$BACKLOG" 2>/dev/null; then
      conflict "$ID is not a task (uak status lists them)."
    fi
  else
    require_owner
  fi
  coord_yesno Reversible "$DECISION_REVERSIBLE"; coord_yesno Authorized "$DECISION_AUTHORIZED"
  case "$DECISION_CLASS" in routine|money|accounts|publish|scope) ;; *) die "Invalid decision class.";; esac
  [ -n "$DECISION_OPTION" ] && [ -n "$WHY_TEXT" ] || die "decision needs --option and --why: uak decision ID --option \"TEXT\" --why \"TEXT\" --reversible yes|no --authorized yes|no --class routine|money|accounts|publish|scope."
  mkdir -p "$TX/meta/decisions"
  coord_df="$TX/meta/decisions/$ID-$NOW.md"
  [ ! -f "$coord_df" ] || conflict "A decision for $ID already exists at epoch $NOW."
  printf '%s\n' "# Pending decision" "Task: $ID" "Owner: $AGENT" "Opened: $NOW" "Status: PENDING" \
    "Class: $DECISION_CLASS" "Authorized: $DECISION_AUTHORIZED" "Reversible: $DECISION_REVERSIBLE" \
    "Option: $(one_line "$DECISION_OPTION")" "Why: $(one_line "$WHY_TEXT")" > "$coord_df"
  if [ -f "$RECORD" ]; then
    WL=$(coord_read "$RECORD" Worklog); STATE=$(coord_read "$RECORD" State)
    ! valid_worklog "$WL" || [ ! -f "$TX/$WL" ] || event "pending decision $ID-$NOW; option: $DECISION_OPTION; Why: $WHY_TEXT"
  fi
  msg_append human human "$ID" "Pending decision ($DECISION_CLASS): $DECISION_OPTION. Why: $WHY_TEXT. Applied after 15 min without answer if routine and authorized"
}
coord_clock() {
  CLOCK_NOTE=
  coord_remote_now=${UAK_REMOTE_NOW:-}
  if [ -n "$coord_remote_now" ]; then coord_uint UAK_REMOTE_NOW "$coord_remote_now"
  elif [ -n "${UAK_NOW:-}" ]; then
    CLOCK_NOTE='Clock: simulated; remote comparison not checked.'; return
  elif command -v gh >/dev/null 2>&1 && printf '%s\n' "$REMOTE_URL" | grep -Eq '(^|[/:@])github\.com[:/]'; then
    # The drift of this machine's clock changes slowly: one GitHub call per hour, not one per status/next
    # (each call was ~1 s of a 12 s `uak next`).
    local cache skew_at=0 skew=
    cache="$(git -C "$ROOT" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)/uak-clock"
    [ ! -f "$cache" ] || read -r skew_at skew < "$cache" || skew_at=0
    case "$skew_at$skew" in *[!0-9-]*|'') skew_at=0;; esac
    if [ $((NOW - skew_at)) -lt 3600 ] && [ -n "${skew:-}" ]; then
      coord_remote_now=$((NOW - skew))
    else
      coord_date=$(gh api --include /rate_limit 2>/dev/null | sed -n 's/^[Dd][Aa][Tt][Ee]:[[:space:]]*//p' | head -n 1 | tr -d '\r')
      if [ -n "$coord_date" ]; then
        coord_remote_now=$(date -d "$coord_date" +%s 2>/dev/null || date -j -f '%a, %d %b %Y %T %Z' "$coord_date" +%s 2>/dev/null || true)
        [ -z "$coord_remote_now" ] || printf '%s %s\n' "$NOW" "$((NOW - coord_remote_now))" > "$cache" 2>/dev/null
      fi
    fi
  fi
  if [ -z "$coord_remote_now" ]; then CLOCK_NOTE='Remote clock not checked: needs the GitHub API Date header.'; return; fi
  coord_uint Remote-Date "$coord_remote_now"
  coord_delta=$((NOW - coord_remote_now)); [ "$coord_delta" -ge 0 ] || coord_delta=$((-coord_delta))
  if [ "$coord_delta" -gt 60 ]; then CLOCK_NOTE="CLOCK_SKEW: drift $coord_delta s > 60 s; sync clocks before relying on leases."
  else CLOCK_NOTE="Clock: remote skew $coord_delta s (<=60 s)."; fi
}
coord_degraded_status() {
  say "NO REMOTE: local tests, rehearsal and local review only"
  say "No offline claims. When the remote returns, status reads claims and reconciles via tick."
  say "Remote clock not checked. Keep a local checkpoint for your next session."
}
# A gate run quietly; a refusal leaves its one CONFLICT/ERROR line on stderr (next's probe keeps it for coord_why).
coord_gate() {
  ( "$@" ) > /dev/null 2> "$TXROOT/coord-gate" && return 0
  grep -m 1 -E '^(CONFLICT|ERROR): ' "$TXROOT/coord-gate" >&2; return 1
}
coord_candidate() {
  load_task
  coord_gate coord_claim_gate || return 1
  [ ! -f "$TX/claims/$ID.md" ] || return 1
  if [ -f "$TX/tasks/$ID.md" ]; then
    coord_rv "$TX/tasks/$ID.md" State; case "$coord_r" in INTEGRATED|CANCELLED) return 1;; esac
  fi
  coord_gate check_owners || return 1
  coord_gate check_dependencies || return 1
  local coord_oid coord_oow
  for coord_other in "$TX"/claims/*.md; do
    [ -f "$coord_other" ] || continue
    coord_rv "$coord_other" Paths
    normalize_paths "$coord_r" > "$TXROOT/coord-paths" || return 1
    overlaps "$TXROOT/paths-request" "$TXROOT/coord-paths" &&
      { coord_rv "$coord_other" ID; coord_oid=$coord_r; coord_rv "$coord_other" Owner; coord_oow=$coord_r; coord_rv "$coord_other" State
        say "CONFLICT: its Paths overlap $coord_oid of $coord_oow ($coord_r); it opens when that one merges." >&2; return 1; }
  done
  return 0
}
# "ID PR" of the review this agent should do, into coord_rc: one offered to it by name first, then any REVIEW task of
# another owner with no verdict on its tip and nobody reviewing that SHA right now.
coord_review_candidate() {
  local f rid rv tip lk lu mine= any= st ow
  coord_rc=
  [ -n "$AGENT" ] || return 0
  for f in "$TX"/claims/*.md; do
    [ -f "$f" ] || continue
    coord_rv "$f" State; st=$coord_r; coord_rv "$f" Owner; ow=$coord_r
    [ "$st" = REVIEW ] && [ "$ow" != "$AGENT" ] || continue
    coord_rv "$f" ID; rid=$coord_r; rv="$TX/reviews/$rid.md"
    coord_rv "$TX/tasks/$rid.md" Task-Tip; tip=$coord_r
    # A SHA that already has a verdict needs a merge or a fix, not a second reviewer (Reap: HACK-005 approved 7 times).
    if [ -f "$rv" ]; then coord_rv "$rv" SHA; [ "$coord_r" != "$tip" ] || continue; fi
    lk="$TX/reviews/$rid.reviewing"
    if [ -f "$lk" ] && { coord_rv "$lk" Reviewer; [ "$coord_r" != "$AGENT" ]; }; then
      coord_rv "$lk" Until; lu=${coord_r//[!0-9]/}   # kit-lint: ok (one field: an epoch)
      [ "$NOW" -ge "${lu:-0}" ] || { coord_rv "$lk" SHA; [ "$coord_r" != "$tip" ]; } || continue
    fi
    coord_rv "$f" PR
    [ -n "$any" ] || any="$rid $coord_r"
    if [ -z "$mine" ] && awk -F' [|] ' -v id="$rid" -v me="agent:$AGENT" '/^- [0-9]/ && $5 == "review" && $6 == id { to = $4 } END { exit !(index("," to ",", "," me ",")) }' "$TX/$MSG_LOG" 2>/dev/null; then
      mine="$rid $coord_r"
    fi
  done
  coord_rc=${mine:-$any}
}
# Why each open task is not offered: the gate's own refusal, or the dependency it waits on.
# Why (a solo marathon project, Oct 2026): two hours of "No eligible candidate" with no reason; the reasons were an
# unapproved backlog and an OWNERS row, both one line to fix.
coord_why() {
  local id w l ids= n=0 first=
  if [ ! -f "$BACKLOG" ] || ! grep -q '^## [A-Z][A-Z0-9]*-[0-9]' "$BACKLOG"; then
    say "Why: the backlog has no tasks (.uak/TASKS.md on $BASE, or uak plan on claims). The human plans first: /uak-plan."
    return 0
  fi
  # next-candidates is "ID PRIORITY" per line (coord_next); the IDs, in order, read with builtins.
  [ ! -f "$TXROOT/next-candidates" ] || while IFS=' ' read -r id l || [ -n "$id" ]; do ids="$ids $id"; done < "$TXROOT/next-candidates"
  # Tasks refused for the same reason share one line (an unapproved backlog refuses them all).
  for id in $ids; do
    [ -s "$TXROOT/next-why-$id" ] || continue
    w=$(grep -m 1 -E '^(CONFLICT|ERROR|GIT_ERROR): ' "$TXROOT/next-why-$id" 2>/dev/null | sed 's/^[A-Z_]*: //' | cut -c 1-300)
    [ -z "$w" ] || printf '%s|%s\n' "$id" "$w"
  done | awk -F'|' '{ r = substr($0, length($1) + 2); if (!(r in ids)) order[++n] = r; ids[r] = ids[r] (ids[r] == "" ? "" : ", ") $1 }
    END { for (i = 1; i <= n && i <= 4; i++) print "Why not " ids[order[i]] ": " order[i] }' | while IFS= read -r w; do say "$w"; done
  [ ! -f "$TXROOT/next-waiting" ] || while IFS= read -r l || [ -n "$l" ]; do n=$((n + 1)); [ -n "$first" ] || first=$l; done < "$TXROOT/next-waiting"
  [ "$n" -eq 0 ] || { set -- $first; say "Waiting on dependencies: $n task(s); ${1:-} waits on ${2:-} (${3:-})."; }
}
coord_next() {
  [ -z "$AGENT" ] || identity
  local coord_kv= coord_lv= coord_ids= coord_l coord_pri coord_rst coord_wt coord_until coord_ow
  # Each worktree runs the kit copy of its own branch: a branch from before an upgrade keeps the old engine.
  # Why (MLB hackathon): 37 black box events came from v4.2.1 days after main moved to v5.0.0.
  if git -C "$TX" show refs/uak/config:.uak/VERSION > "$TXROOT/base-version" 2>/dev/null; then
    IFS= read -r coord_kv < "$TXROOT/base-version" || :
  fi
  IFS= read -r coord_lv 2>/dev/null < "$UAK_BIN/../VERSION" || :
  coord_kv=${coord_kv//$'\r'/}; coord_lv=${coord_lv//$'\r'/}
  [ -z "$coord_kv" ] || [ -z "$coord_lv" ] || [ "$coord_kv" = "$coord_lv" ] ||
    say "KIT: this worktree runs uak $coord_lv; $BASE has $coord_kv. Get its fixes: git fetch origin && git merge --no-edit origin/$BASE"
  # Every record of claims in one awk pass (lib/state.awk): the loops below read variables, no process per field.
  state_load
  coord_found=
  for coord_state in CLAIMED BLOCKED REVIEW; do
    for coord_id in $UAK_S_claims; do
      sv claims "$coord_id" Owner; [ "$SV" = "$AGENT" ] || continue
      sv claims "$coord_id" State; [ "$SV" = "$coord_state" ] || continue
      sv claims "$coord_id" ID; coord_found=$SV; break
    done
    [ -z "$coord_found" ] || break
  done
  if [ -n "$coord_found" ]; then
    ID=$coord_found; RECORD="$TX/tasks/$ID.md"
    sv tasks "$ID" Worklog; WL=$SV; sv tasks "$ID" State; coord_rst=$SV
    say "$ID | $coord_rst | $AGENT"
    sv tasks "$ID" Worktree; coord_wt=$SV
    sv tasks "$ID" Branch; say "Branch: $SV"; say "Worktree: $coord_wt"
    sv tasks "$ID" Next; say "Next: $SV"
    say "Live summary:"; summary_text | head -n 6
    mem_for_task "$ID"
    sv tasks "$ID" Lease-Until; coord_until=$SV
    # A new session on a claimed task hears the test-first step too, until its red is recorded.
    if [ "$coord_rst" = CLAIMED ] && [ "$NOW" -lt "$coord_until" ]; then
      git_dir_var "$coord_wt"
      [ -s "$GD/uak-red/$ID.txt" ] || test_brief next
    fi
    freeze_warning
    if [ "$NOW" -ge "$coord_until" ] && [ "$coord_rst" != REVIEW ]; then say "LEASE EXPIRED: read status --task $ID --summary; recover with its token before editing."; fi
    coord_st=$(task_stalled "$RECORD")
    [ -z "$coord_st" ] || say "STALLED: no work moved on $ID in $coord_st min. The same failure twice: bash .uak/bin/uak log $ID --state BLOCKED \"<exact error>\". Out of ideas: checkpoint, then handover or release, and take other work."
    # Waiting on your own review is idle time: review someone else meanwhile. Why (MLB hackathon): agents in
    # REVIEW got only their own task from next, while 22 messages asked around for a reviewer.
    if [ "$coord_rst" = REVIEW ]; then
      coord_review_candidate
      [ -z "$coord_rc" ] || say "Meanwhile (yours waits on its review): review ${coord_rc#* } of ${coord_rc%% *}: /uak-review ${coord_rc%% *}"
    fi
    msg_orphans
    coord_status_budget
    [ -z "${CLOCK_NOTE:-}" ] || say "$CLOCK_NOTE"
    return 0
  fi
  if [ -f "$BACKLOG" ]; then
    # Cheap prefilter before the full gates: skip tasks that are taken or done, and tasks whose dependencies are
    # not INTEGRATED. Why: `next` probed every task of the backlog in a subshell (4.5 s of CPU on 36 tasks).
    # Each candidate comes with its Priority (read like task_field): a probe runs only in its own priority's pass.
    # A dependency's state is read with `(x in st)` first: in awk `st[x]` alone creates the key, and a task with no
    # record yet, listed after a task that depends on it, then failed `t in st` and vanished from next (UAK-017).
    for coord_id in $UAK_S_tasks; do sv tasks "$coord_id" State; printf '%s %s\n' "$coord_id" "$SV"; done > "$TXROOT/next-states"
    awk -v sf="$TXROOT/next-states" '
      BEGIN { while ((getline l < sf) > 0) { split(l, a, " "); st[a[1]] = a[2] } }
      /^## [A-Z][A-Z0-9]*-[0-9]/ { id = $2; order[++n] = id; next }
      id != "" { s = $0; gsub(/\*\*/, "", s); sub(/^[[:space:]]*-[[:space:]]*/, "", s)
        p = s; sub(/^[[:space:]]*/, "", p)
        if (!(id in pr) && index(p, "Priority:") == 1) { sub(/^[^:]*:[[:space:]]*/, "", p); pr[id] = p }
        if (s ~ /^Depends on:/) { gsub(/\([^)]*\)/, "", s); d[id] = s } }
      END { for (i = 1; i <= n; i++) { t = order[i]; if (t in st && st[t] != "AVAILABLE") continue
              ok = 1; w = ""; s = d[t]; while (match(s, /[A-Z][A-Z0-9]*-[0-9][0-9][0-9]+/)) { x = substr(s, RSTART, RLENGTH); s = substr(s, RSTART + RLENGTH); xs = (x in st) ? st[x] : ""; if (xs != "INTEGRATED") { ok = 0; if (w == "") w = x " " (xs != "" ? xs : "AVAILABLE") } }
              if (ok) print t, (pr[t] ~ /^P[012]$/ ? pr[t] : "any"); else print t, w > wf } }' wf="$TXROOT/next-waiting" "$BACKLOG" > "$TXROOT/next-candidates"
    : >> "$TXROOT/next-waiting"
    while IFS=' ' read -r coord_id coord_pri || [ -n "$coord_id" ]; do coord_ids="$coord_ids $coord_id:$coord_pri"; done < "$TXROOT/next-candidates"
    for coord_p in P0 P1 P2; do
      for coord_l in $coord_ids; do
        coord_id=${coord_l%%:*}; coord_pri=${coord_l#*:}
        # Another priority's task: its probe would stop at the priority check, silently. A Priority that is not
        # P0/P1/P2 ("any") is probed in every pass, so its load_task error is the reason coord_why gives.
        [ "$coord_pri" = "$coord_p" ] || [ "$coord_pri" = any ] || continue
        ID=$coord_id
        # A gate may exit with conflict; the subshell lets us try another candidate (quietly: not an error).
        # The refusal is kept: with no candidate, next says why for each task (coord_why). The winner hands back
        # what its load_task read (next-pick), so it is not read a second time.
        if (UAK_PROBE=1; load_task; [ "$PRIORITY" = "$coord_p" ] && coord_candidate &&
            printf '%s\n' "$PRIORITY" "$PATHS" "$DEPENDS" "$VERIFY" "$DEFAULT_NEXT" > "$TXROOT/next-pick") > "$TXROOT/next-probe" 2>&1; then
          { IFS= read -r PRIORITY; IFS= read -r PATHS; IFS= read -r DEPENDS; IFS= read -r VERIFY; IFS= read -r DEFAULT_NEXT; } < "$TXROOT/next-pick"
          say "$ID | AVAILABLE | $PRIORITY"
          say "Next: $DEFAULT_NEXT"; say "Verify: $VERIFY"; say "Paths: $PATHS"
          say "Before editing: bash .uak/bin/wt new $ID${AGENT:+ --agent $AGENT} (branch + worktree + claim)."
          mem_for_task "$ID"
          msg_orphans
          coord_status_budget; [ -z "${CLOCK_NOTE:-}" ] || say "$CLOCK_NOTE"
          return 0
        fi
        [ ! -s "$TXROOT/next-probe" ] || mv "$TXROOT/next-probe" "$TXROOT/next-why-$coord_id"
      done
    done
  fi
  coord_cfg Freeze-Epoch 0; coord_freeze=$coord_v
  if [ "$coord_freeze" -gt 0 ] && [ "$NOW" -ge "$coord_freeze" ]; then
    # Why (Reap buildathon): agents kept calling next after the freeze; say once what to do instead.
    say "FREEZE since $(( (NOW - coord_freeze) / 60 )) min: no new tasks unless a human runs: UAK_HUMAN=NAME bash .uak/bin/uak allow ID --reason TEXT"
  else
    say 'No eligible candidate (priority, dependencies, claims or authorization).'
    coord_why
  fi
  # An approval older than Merge-Adopt-Seconds whose owner did not merge: the most valuable idle work.
  coord_cfg Merge-Adopt-Seconds 1200; coord_adopt=$coord_v; case "$coord_adopt" in ''|*[!0-9]*) coord_adopt=1200;; esac
  for coord_id in $UAK_S_claims; do
    [ -n "$AGENT" ] || continue
    sv claims "$coord_id" State; [ "$SV" = REVIEW ] || continue
    sv claims "$coord_id" Owner; coord_ow=$SV; [ "$coord_ow" != "$AGENT" ] || continue
    sv claims "$coord_id" ID; coord_rid=$SV
    [ -f "$TX/reviews/$coord_rid.md" ] || continue
    sv reviews "$coord_rid" Verdict; [ "$SV" = approve ] || continue
    sv reviews "$coord_rid" SHA; coord_l=$SV; sv tasks "$coord_rid" Task-Tip; [ "$coord_l" = "$SV" ] || continue
    sv reviews "$coord_rid" Reviewed; coord_rt=${SV//[!0-9]/}   # kit-lint: ok (one field: an epoch)
    [ $((NOW - ${coord_rt:-$NOW})) -ge "$coord_adopt" ] || continue
    sv queue "$coord_rid" State; [ "$SV" != HUMAN ] || continue
    say "Idle: $coord_rid is approved ($(( (NOW - coord_rt) / 60 )) min ago) and its owner $coord_ow has not merged it: bash .uak/bin/uak merge $coord_rid"
    coord_status_budget; [ -z "${CLOCK_NOTE:-}" ] || say "$CLOCK_NOTE"; return 0
  done
  coord_review_candidate
  if [ -n "$coord_rc" ]; then
    msg_orphans
    say "Idle: review ${coord_rc#* } of ${coord_rc%% *} (not yours; no verdict or reviewer on its SHA yet): /uak-review ${coord_rc%% *}"
    coord_status_budget; [ -z "${CLOCK_NOTE:-}" ] || say "$CLOCK_NOTE"; return 0
  fi
  msg_orphans
  # Someone else's task that stopped moving: the idle agent can ask (it cannot take a live claim).
  for coord_id in $UAK_S_tasks; do
    sv tasks "$coord_id" Owner; coord_ow=$SV; [ "$coord_ow" != "$AGENT" ] || continue
    sv tasks "$coord_id" State; [ "$SV" = CLAIMED ] || continue
    coord_st=$(task_stalled "$TX/tasks/$coord_id.md"); [ -n "$coord_st" ] || continue
    sv tasks "$coord_id" ID
    say "Stalled: $SV of $coord_ow: no work moved in $coord_st min. Ask once (uak msg $SV --kind request \"stuck? what failed\"); its human can hand it over."
    break
  done
  if [ "$coord_freeze" -gt 0 ] && [ "$NOW" -ge "$coord_freeze" ]; then
    say 'Idle after freeze: rehearse the demo (/uak-demo), check the submission, then stop. Do not poll uak next; a message will reach you.'
  else
    say 'Idle: improve tests → polish demo → rehearse. Do not poll uak next in a loop; wait for a message or a new task.'
  fi
  coord_status_budget; [ -z "${CLOCK_NOTE:-}" ] || say "$CLOCK_NOTE"
}
