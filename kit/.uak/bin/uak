#!/usr/bin/env bash
# Bash 3.2+; Git y utilidades POSIX. No requiere jq ni Python.
# Why: works on Git Bash, macOS and Linux with no services.
set -u
set -o pipefail
LC_ALL=C
export LC_ALL
# Git Bash (Windows) rewrites arguments such as refs/x:.uak/TASKS.md into Windows path lists.
# Why (Reap buildathon): `git show refs/uak/config:.uak/TASKS.md` returned nothing, so claims said "not in TASKS.md".
MSYS2_ARG_CONV_EXCL="refs/;origin/;${UAK_REMOTE:-origin}/;HEAD;FETCH_HEAD;:"
export MSYS2_ARG_CONV_EXCL
. "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/lib/net.sh" 2>/dev/null && ssh_mux
# Per-worktree identity: .uak-env (written by .uak/bin/wt, git-ignored) only fills empty variables.
# Why: every terminal or agent in the worktree inherits its identity without manual exports.
hack_env_file="$(git rev-parse --show-toplevel 2>/dev/null)/.uak-env"
if [ -f "$hack_env_file" ]; then
  while IFS='=' read -r hack_key hack_value || [ -n "$hack_key" ]; do
    case "$hack_key" in
      UAK_AGENT|UAK_HUMAN|UAK_AGENT_HUMAN|UAK_SESSION|UAK_TASK)
        case "$hack_value" in ''|*[!A-Za-z0-9_.-]*) continue;; esac
        # The worktree names its agent's human, but that grants no human authority (allow, plan, handover of
        # others' tasks, retire, register-reviewer): only an explicit UAK_HUMAN in the shell does. Why: every agent
        # in a task worktree inherited UAK_HUMAN from .uak-env and could pass the human-only gates.
        case "$hack_key" in UAK_HUMAN|UAK_AGENT_HUMAN) [ -n "${UAK_AGENT_HUMAN:-}" ] || export "UAK_AGENT_HUMAN=$hack_value"; continue;; esac
        hack_current=$(eval "printf '%s' \"\${$hack_key:-}\"")
        # Identity and task of a worktree win over an inherited shell export (UpiixSol: a lead's exported
        # UAK_AGENT made a subagent's claim land under the lead's name). UAK_ENV_OVERRIDE=1 keeps the export.
        if [ -z "$hack_current" ] || { [ "$hack_current" != "$hack_value" ] && [ "${UAK_ENV_OVERRIDE:-}" != 1 ] &&
             case "$hack_key" in UAK_AGENT|UAK_TASK|UAK_SESSION) true;; *) false;; esac; }; then
          [ -z "$hack_current" ] || printf 'uak: using %s=%s from .uak-env (the shell had %s)\n' "$hack_key" "$hack_value" "$hack_current" >&2
          export "$hack_key=$hack_value"
        fi;;
    esac
  done < "$hack_env_file"
fi
LEASE=${UAK_LEASE_SECONDS:-1800}
REMOTE=${UAK_REMOTE:-origin}
BASE=${UAK_BASE:-main}
AGENT=${UAK_AGENT:-}
HUMAN=${UAK_HUMAN:-}
ROOT= TX= TXROOT= NOW=
CMD=${1:-help}
[ "$#" -eq 0 ] || shift
# The names agents guessed for existing commands. Why (MLB hackathon): tasks, task, show, backlog and
# status --verbose/--available were errors, each followed by a retry.
case "$CMD" in
  tasks|backlog) CMD=status;;
  task|show) CMD=status; [ "$#" -eq 0 ] || case "$1" in -*) ;; *) set -- --task "$@";; esac;;
esac
if [ "$CMD" = status ] || [ "$CMD" = next ]; then
  for a in "$@"; do shift; case "$a" in --verbose|-v) set -- "$@" --full;; --available|--all) ;; *) set -- "$@" "$a";; esac; done
fi
say() { printf '%s\n' "$*"; }
UAK_BIN=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
# Black box (.uak/docs/BLACKBOX.md): every error is also recorded locally; flushed later in one push.
# UAK_PROBE: next tests every candidate in a subshell; those expected refusals are not errors.
# Why (Reap buildathon): 153 of 290 black box lines were one FREEZE refusal per candidate of `uak next`.
bb_auto() {
  [ -z "${UAK_PROBE:-}" ] || return 0
  bash "$UAK_BIN/bb" auto "$1" "$CMD" "$2" >/dev/null 2>&1 || true
  loop_hint "$2"
}
# The same error 3 times in 10 min on this machine = a retry loop that burns tokens. Say so once per repeat.
loop_hint() {
  [ -n "${bb_common:-}" ] && [ -d "$bb_common" ] || return 0
  local f="$bb_common/uak-errors.recent" t key n
  t=$(date +%s); key=$(printf '%s %s' "$CMD" "$1" | cksum | awk '{print $1}')
  printf '%s %s\n' "$t" "$key" >> "$f" 2>/dev/null || return 0
  n=$(awk -v now="$t" -v k="$key" '$1 >= now - 600 && $2 == k {n++} END {print n+0}' "$f")
  tail -n 200 "$f" > "$f.tmp" 2>/dev/null && mv "$f.tmp" "$f" 2>/dev/null
  [ "$n" -lt 3 ] || say "LOOP: the same error $n times in 10 min. Stop retrying: read the message above, do other work, or ask the human." >&2
}
die() { say "ERROR: $*" >&2; bb_auto 2 "ERROR: $*"; exit 2; }
conflict() { say "CONFLICT: $*" >&2; bb_auto 3 "CONFLICT: $*"; exit 3; }
gitfail() { say "GIT_ERROR: $*" >&2; bb_auto 1 "GIT_ERROR: $*"; exit 1; }
valid_id() { printf '%s\n' "$1" | grep -Eq '^[A-Z][A-Z0-9]*-[0-9][0-9][0-9]+$'; }
# hack-021 means HACK-021. Why (MLB hackathon): 4 "Invalid ID." errors from Cursor with no hint of the value.
norm_id() { case "$1" in *[a-z]*-[0-9]*) printf '%s' "$1" | tr '[:lower:]' '[:upper:]';; *) printf '%s' "$1";; esac; }
bad_id() { die "Invalid ID '$1': use the task ID as in TASKS.md, e.g. HACK-012 (uak status lists them)."; }
one_line() { local text=$1; text=${text//$'\r'/ }; text=${text//$'\n'/ }; printf '%s' "$text"; }
field() {
  local line prefix="$2: "
  [ -f "$1" ] || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in "$prefix"*) printf '%s\n' "${line#"$prefix"}"; return 0;; esac
  done < "$1"
}
clock_now() {
  NOW=${UAK_NOW:-$(date +%s)}
  case "$NOW" in ''|*[!0-9]*) die "UAK_NOW must be epoch seconds.";; esac
  case "$LEASE" in ''|*[!0-9]*|0) die "UAK_LEASE_SECONDS must be positive.";; esac
}
identity() {
  [ -n "$AGENT" ] || AGENT=$(git config --get uak.agent 2>/dev/null || true)
  [ -n "$AGENT" ] || AGENT=$HUMAN
  # Why (MLB hackathon): 16 "No identity" errors, mostly reviews and inbox from the main checkout, where several
  # agents share one git config: a per-command prefix is the only identity that cannot leak to another agent.
  [ -n "$AGENT" ] || die "No identity. Prefix the command with your agent name: UAK_AGENT=NAME bash .uak/bin/uak $CMD ... (inside a task worktree, .uak-env sets it). A human: UAK_HUMAN=NAME."
  case "$AGENT" in *[!A-Za-z0-9_.-]*) die "Identity: use letters, digits, dot, dash or underscore.";; esac
}
cleanup() {
  # Why: only the temp dir created by this invocation is removed.
  if [ -n "$TXROOT" ] && [ -n "${TMP_BASE:-}" ]; then
    case "$TXROOT" in "$TMP_BASE"/hack.??????)
      # Links into real node_modules go first, so the recursive delete can never follow one into its target.
      if [ -f "$TXROOT/gate-links" ]; then
        while IFS= read -r l; do
          case "$(uname -s 2>/dev/null)" in
            MINGW*|MSYS*|CYGWIN*) cmd //c rmdir "$(cygpath -w "$l")" >/dev/null 2>&1 || rm -f "$l";;
            *) rm -f "$l";;
          esac
        done < "$TXROOT/gate-links"
      fi
      rm -rf "$TXROOT";;
    esac
  fi
}
trap cleanup EXIT
trap 'exit 130' INT TERM
usage() {
  cat <<'USAGE'
uak v5 — multi-agent coordination on the remote claims branch
status [ID | --task ID] [--summary] [--full]
claim ID --branch RAMA --worktree RUTA [--next TEXTO]
heartbeat ID
release ID [--expired --read-summary TOKEN] [--cancel MOTIVO]
log ID [--state CLAIMED|BLOCKED] TEXTO
checkpoint ID|--session --done TEXTO --decision TEXTO --why TEXTO --fails TEXTO --commands TEXTO --next TEXTO
handoff ID
done ID --pr URL --evidence TEXTO [--to REVIEWER] [--note "what changed since the last review"] [--integrated COMMIT --reviewer OTRO]
digest
tick
next
review ID --start | --stop | --sha SHA --verdict approve|reject [--note "file:line · what · how to reproduce"] [--learn]
followup ID --title TEXT   new task on ID's Paths after ID is INTEGRATED (fixes and polish; no human needed)
handover ID --to NAME   pass your claim (or an expired one, or as UAK_HUMAN) to another agent without AVAILABLE
pr-sync [ID]   failed checks and new human review comments on a task's GitHub PR → one message to the task (gh)
away   this identity closed its session (SessionEnd hooks run it): no reviews for it until its next command
retire NAME...   an identity that no longer runs leaves the reviewer rotation (its human or itself)
register-reviewer NAME...  (UAK_HUMAN, from the main checkout)
merge ID
decision ID --option TEXTO --why TEXTO --reversible yes|no --authorized yes|no --class routine|money|accounts|publish|scope
secret-exception ID --path RUTA --rule REGLA --reason TEXTO
init-smoke --command COMANDO
lint [--secrets]
doctor [--fix]   preflight: remote, gh permissions, hooks, freeze, ports
graph [--mermaid] [--min-wave1 N] | graph --assign   backlog DAG: waves, critical path, cycles; --assign suggests an idle agent per ready task
loop --verify CMD [--agent CMD] [--max N] [--task ID]   bounded verify → fix loop
board [--md] [--watch S]   team kanban from the claims branch
dash [--watch [S]] [--open]   the whole team on one local page: progress %, agents, conversation, reviews, black box
stats   retro numbers: messages, reviews, recoveries, queue
up N [--tool CMD] [--tmux]   claim the N best tasks into worktrees and launch agents
demo [--keep]   30-second real 3-agent run in a temp repo
integrate ID   any agent records a task whose approved SHA is already in main (owner offline)
allow ID... --reason TEXT | allow --in-flight --reason TEXT   human freeze exception (UAK_HUMAN), audited
clock "START" "DEADLINE" [ZONE] [--write]   sprint schedule scaled to the event length (freeze, rehearsal)
pace [--caps|--json|set USED --resets +3h [--window 5h]]   plan-usage pacing: surge, normal, conserve, critical
tokens [--team] [--by task|harness|model|scope|agent] [--since DAYS] [--publish]   real token spend from Claude Code/Codex transcripts
map [show|find|callers|calls|deps|users|path|related|impact|notes]   code graph: symbols, imports, calls (+ optional semantic notes)
bb add bug|friction|idea|need|praise TEXT [--fix IDEA] · bb flush · bb show · bb export   black box for kit fixes
plan FILE [--amend]   publish new tasks to claims without a PR, or amend published ones before review (Plan-Channel: claims; UAK_HUMAN)
msg DESTINO TEXTO [--kind TIPO] [--task HACK-NNN]   DESTINO: NOMBRE|HACK-NNN|related:HACK-NNN|all|human
inbox [--ack] [--all] [--peek] [--task HACK-NNN] [--human]
wait [ID] --for approve|integrated|message [--timeout S]   one call that returns when it happens (instead of polling)
learn "TEXT" [--path P,Q] [--task ID] · learn --forget N   a lesson tied to paths; next shows it to the next agent there
recall [ID|PATH] [--similar | --search "words"]   lessons for a task or a path; --similar/--search: lessons, rejects, contracts and decisions ranked by words (BM25)
UAK_AGENT / UAK_HUMAN · UAK_REMOTE=origin · UAK_BASE=main · lease=1800s
Why: the remote serializes claims; every session keeps an exact next step.
USAGE
}
case "$CMD" in help|-h|--help) usage; exit 0;; esac
# `uak CMD --help` prints that command's usage line. Why (MLB hackathon): `uak status --help` was an error.
for a in "$@"; do case "$a" in -h|--help)
  usage | grep -E "^($CMD)( |\$)" || usage; exit 0;; esac; done
case "$CMD" in version|--version) cat "$UAK_BIN/../VERSION" 2>/dev/null || say unknown; exit 0;; esac
# Call counts give the black box a denominator (error rate per command). Local file, flushed by bb.
bb_common=$(git rev-parse --git-common-dir 2>/dev/null) || bb_common=
case "${UAK_BLACKBOX:-}" in off|0|no|false) ;; *)
  [ -z "$bb_common" ] || printf '%s\n' "${UAK_CALLER:+$UAK_CALLER-}$CMD" >> "$bb_common/uak-blackbox.calls" 2>/dev/null;;
esac
case "$CMD" in doctor|graph|loop|board|stats|up|demo|bb|pace|clock|tokens|map|dash) exec bash "$UAK_BIN/$CMD" "$@";; esac
case "$CMD" in status|claim|heartbeat|away|pr-sync|release|log|checkpoint|handoff|done|integrate|digest|lint|tick|next|review|register-reviewer|merge|decision|secret-exception|init-smoke|msg|inbox|plan|allow|retire|followup|handover|wait|learn|recall) ;; *) die "Unknown command: $CMD (uak help lists them)";; esac
ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || {
  case "$CMD" in lint|init-smoke) ;; *) gitfail "Run inside a Git repository with a remote.";; esac
  ROOT=$(pwd -P)
}
ROOT=$(cd "$ROOT" && pwd -P) || gitfail "Cannot open the repository."
BACKLOG="$ROOT/.uak/TASKS.md"
OWNERS="$ROOT/.uak/OWNERS.md"
source "$ROOT/.uak/bin/uak-coordination"
source "$ROOT/.uak/bin/lib/review-merge.sh"
source "$ROOT/.uak/bin/lib/security.sh"
source "$ROOT/.uak/bin/lib/smoke-init.sh"
source "$ROOT/.uak/bin/lib/messages.sh"
source "$ROOT/.uak/bin/lib/memory.sh"
source "$ROOT/.uak/bin/lib/github.sh"
# Reads one section; accepts - **Field:** value, **Field**: value and Field: value.
task_field() {
  awk -v id="$ID" -v key="$1" '
    /^## / { on=($2==id) }
    on {
      s=$0; gsub(/\*\*/, "", s); sub(/^[[:space:]]*-[[:space:]]*/, "", s);
      sub(/^[[:space:]]*/, "", s);
      if (index(s,key ":")==1) {
        sub(/^[^:]*:[[:space:]]*/, "", s); print s; exit
      }
    }' "$BACKLOG"
}
load_task() {
  [ -f "$BACKLOG" ] || die "Missing .uak/TASKS.md."
  awk -v id="$ID" '/^## / && $2==id {found=1} END {exit !found}' "$BACKLOG" ||
    die "$ID is not in TASKS.md."
  PRIORITY=$(task_field Priority)
  case "$PRIORITY" in P0|P1|P2) ;; *) die "$ID needs Priority P0/P1/P2.";; esac
  PATHS=$(task_field "Paths")
  [ -n "$PATHS" ] || die "$ID needs Paths."
  DEPENDS=$(task_field "Depends on")
  VERIFY=$(task_field "Verify")
  [ -n "$VERIFY" ] || die "$ID needs Verify."
  DEFAULT_NEXT=$(task_field "Next step")
  [ -n "$DEFAULT_NEXT" ] || DEFAULT_NEXT="Implement $ID and run: $VERIFY"
  normalize_paths "$PATHS" > "$TXROOT/paths-request" || die "Invalid paths in $ID."
}
# Globs reserve their whole prefix; a root glob reserves the repo.
# Why: reversible over-reservation avoids conflicts a glob would hide.
normalize_paths() {
  printf '%s\n' "$1" | awk '
    BEGIN {bad=0}
    {
      n=split($0,a,",");
      for(i=1;i<=n;i++) {
        p=a[i]; gsub(sprintf("%c",96),"",p);
        sub(/^[[:space:]]*/,"",p); sub(/[[:space:]]*$/,"",p);
        gsub(/\\/,"/",p); while(p ~ /^\.\//) sub(/^\.\//,"",p);
        gsub(/\/+/,"/",p);
        while(p ~ /\/\.\//) gsub(/\/\.\//,"/",p);
        sub(/\/\.$/,"",p); p=tolower(p);
        if(p=="" || p ~ /^\// || p ~ /^[A-Za-z]:/ || p ~ /(^|\/)\.\.(\/|$)/) {bad=1; continue}
        at=match(p,/[*?\[]/);
        if(at) {
          p=substr(p,1,at-1); sub(/[^\/]*$/,"",p);   # escaped \/: BSD awk (macOS) ends the regex at an unescaped /
          if(p=="") p=".";
        }
        sub(/\/$/,"",p); if(p=="") p=".";
        print p;
      }
    }
    END {exit bad}' | sort -u
}
overlaps() {
  awk 'NR==FNR {a[++n]=$0;next}
    {for(i=1;i<=n;i++) if(a[i]=="." || $0=="." || a[i]==$0 ||
      index(a[i],$0 "/")==1 || index($0,a[i] "/")==1) exit 1}' "$1" "$2"
  [ "$?" -eq 1 ]
}
owner_rows() {
  [ -f "$OWNERS" ] || return 0
  awk -F'|' '{
    for(i=1;i<NF;i++) {
      p=$i; q=$(i+1); gsub(sprintf("%c",96),"",p); gsub(sprintf("%c",96),"",q);
      sub(/^[[:space:]]*/,"",p);sub(/[[:space:]]*$/,"",p);
      sub(/^[[:space:]]*/,"",q);sub(/[[:space:]]*$/,"",q);
      if(q ~ /^[A-Z][A-Z0-9]*-[0-9][0-9][0-9]+$/) print p "|" q
    }}' "$OWNERS"
}
# The task itself, or a task it follows up (the "Follow-up of" chain): a follow-up works on its parent's owned paths.
# Why (MLB hackathon): 4 black box notes; every `uak followup` of a task that owned paths in OWNERS.md was refused.
owner_is_self() {
  local id=$ID i=0
  while [ -n "$id" ] && [ "$i" -lt 6 ]; do
    [ "$1" != "$id" ] || return 0
    id=$(ID=$id task_field "Follow-up of" | grep -Eo '^[A-Z][A-Z0-9]*-[0-9]+' | head -n 1); i=$((i + 1))
  done
  return 1
}
check_owners() {
  owner_rows > "$TXROOT/owners"
  while IFS='|' read -r pat owner; do
    [ -n "$pat" ] || continue
    normalize_paths "$pat" > "$TXROOT/owner-paths" || die "Invalid OWNERS pattern: $pat"
    if overlaps "$TXROOT/paths-request" "$TXROOT/owner-paths" && ! owner_is_self "$owner"; then
      conflict "$pat belongs to $owner; split the work or request its contract."
    fi
  done < "$TXROOT/owners"
  while IFS= read -r path; do
    case "/$path/" in
      */package-lock.json/*|*/npm-shrinkwrap.json/*|*/pnpm-lock.yaml/*|*/*.lock/*|*/*.lockb/*|*/go.sum/*|*/gradle.lockfile/*|*/lockfiles/*|*/migrations/*|*/db/migration/*|*/contracts/*|*/types/*|*/shared-types/*|*/.github/workflows/*|*/.gitlab-ci.yml/*|*/azure-pipelines.yml/*)
        assigned=no
        printf '%s\n' "$path" > "$TXROOT/one-path"
        while IFS='|' read -r pat owner; do
          normalize_paths "$pat" > "$TXROOT/owner-paths" || die "Invalid OWNERS."
          if overlaps "$TXROOT/one-path" "$TXROOT/owner-paths" && owner_is_self "$owner"; then assigned=yes; fi
        done < "$TXROOT/owners"
        [ "$assigned" = yes ] || conflict "Shared resource without an owner in OWNERS.md: $path"
        ;;
    esac
  done < "$TXROOT/paths-request"
}
init_temp() {
  TMP_BASE=$(cd "${TMPDIR:-/tmp}" && pwd -P) || gitfail "Cannot open TMPDIR."
  TXROOT=$(mktemp -d "$TMP_BASE/hack.XXXXXX") || gitfail "Cannot create temp dir."
}
remote_setup() {
  REMOTE_URL=$(git -C "$ROOT" config --get "remote.$REMOTE.url") ||
    gitfail "Missing remote $REMOTE. Offline claims are not allowed."
  # A relative remote is relative to the main checkout, not to this worktree.
  case "$REMOTE_URL" in /*|[A-Za-z]:*|*://*|*@*:*) ;; *)
    main_dir=$(cd "$ROOT" && cd "$(git rev-parse --git-common-dir)/.." 2>/dev/null && pwd -P) || main_dir=$ROOT
    REMOTE_URL="$main_dir/$REMOTE_URL";; esac
  USER_NAME=$(git -C "$ROOT" config user.name 2>/dev/null || true)
  USER_EMAIL=$(git -C "$ROOT" config user.email 2>/dev/null || true)
  [ -n "$USER_NAME" ] || USER_NAME=${AGENT:-uak}
  [ -n "$USER_EMAIL" ] || USER_EMAIL=uak@localhost
}
fresh_state() {
  TX="$TXROOT/try-$ATTEMPT"
  mkdir "$TX" || gitfail "Cannot create transaction."
  # Windows (antivirus, OneDrive, indexers) can lock a just-created directory for a moment: 3 tries, and the
  # real cause in the message. Why (MLB hackathon): 6 "git init failed." from Cursor on Windows, cause unknown.
  init_try=0
  until git -C "$TX" init -q 2> "$TXROOT/init-error"; do
    init_try=$((init_try + 1))
    # A sandbox that forbids git in the system temp dir (Codex on macOS: "Operation not permitted" in /var/folders)
    # gets a temp dir inside the repo's own .git. Why (MLB hackathon): 12 tick/next/status/inbox calls failed this way.
    if [ "$init_try" -ge 2 ] && [ -z "${UAK_TMP_FALLBACK:-}" ] && grep -qi 'not permitted\|permission denied\|read-only' "$TXROOT/init-error"; then
      UAK_TMP_FALLBACK="$(git -C "$ROOT" rev-parse --absolute-git-dir 2>/dev/null)/uak-tmp"
      if mkdir -p "$UAK_TMP_FALLBACK" 2>/dev/null && fb_root=$(mktemp -d "$UAK_TMP_FALLBACK/hack.XXXXXX" 2>/dev/null); then
        case "$TXROOT" in "$TMP_BASE"/hack.??????) rm -rf "$TXROOT";; esac
        TMP_BASE=$(cd "$UAK_TMP_FALLBACK" && pwd -P); TXROOT=$(cd "$fb_root" && pwd -P); TX="$TXROOT/try-$ATTEMPT"
        mkdir "$TX" || gitfail "Cannot create transaction."; init_try=0; continue
      fi
    fi
    [ "$init_try" -lt 3 ] || gitfail "git init failed in $TX: $(head -n 1 "$TXROOT/init-error"). Check TMPDIR (now ${TMPDIR:-/tmp}) is writable, or set TMPDIR to another folder."
    sleep "$init_try"; rm -rf "$TX"; mkdir "$TX" || gitfail "Cannot create transaction."
  done
  git -C "$TX" config user.name "$USER_NAME"
  git -C "$TX" config user.email "$USER_EMAIL"
  git -C "$TX" remote add origin "$REMOTE_URL" || gitfail "Invalid remote."
  # One fetch brings claims and the base's config (PROJECT.md, TASKS.md) together: one network round trip instead
  # of three (ls-remote, fetch claims, fetch config). done/integrate/merge prove ancestry on the base, so they
  # fetch it whole later (coord_init). Wi-Fi at events drops for seconds: 3 tries (Reap: 8 "Remote unreachable").
  local refs="+refs/heads/claims:refs/uak/claims"
  case "$CMD" in done|integrate|merge) ;; *) refs="$refs +refs/heads/$BASE:refs/uak/config";; esac
  net_try=0 HAS_REMOTE=yes
  until git -C "$TX" fetch -q --depth 2 origin $refs 2> "$TXROOT/git-error"; do
    if grep -qi "couldn't find remote ref refs/heads/claims" "$TXROOT/git-error"; then
      HAS_REMOTE=no
      case "$CMD" in done|integrate|merge) break;; esac
      git -C "$TX" fetch -q --depth 2 origin "+refs/heads/$BASE:refs/uak/config" 2> "$TXROOT/git-error" && break
    fi
    net_try=$((net_try + 1)); [ "$net_try" -lt 3 ] || gitfail "Remote unreachable (3 tries). $(head -n 1 "$TXROOT/git-error")"
    sleep $((net_try * 2))
  done
  if [ "$HAS_REMOTE" = yes ]; then
    # HEAD^ (depth 2) is enough for the append-only lint; the full claims history (600+ commits at Reap) is not.
    git -C "$TX" checkout -q -b claims refs/uak/claims || gitfail "checkout claims failed."
  else
    git -C "$TX" checkout -q --orphan claims || gitfail "Cannot initialize claims."
  fi
  mkdir -p "$TX/tasks" "$TX/claims" "$TX/worklog"
}
is_reserved() { case "$1" in CLAIMED|BLOCKED|REVIEW) return 0;; *) return 1;; esac; }
task_file() { printf '%s/tasks/%s.md\n' "$TX" "$ID"; }
claim_file() { printf '%s/claims/%s.md\n' "$TX" "$ID"; }
require_owner() {
  RECORD=$(task_file); CLAIM=$(claim_file)
  [ -f "$CLAIM" ] && [ -f "$RECORD" ] || conflict "$ID has no active claim; do not modify someone else's work."
  [ "$(field "$CLAIM" Owner)" = "$AGENT" ] || conflict "$ID belongs to $(field "$CLAIM" Owner)."
  WL=$(field "$RECORD" Worklog)
  valid_worklog "$WL" || die "Invalid worklog path."
  [ -f "$TX/$WL" ] || die "Missing worklog $WL."
}
valid_worklog() { printf '%s\n' "$1" | grep -Eq '^worklog/WL-[A-Za-z0-9_.-]+\.md$'; }
put() {
  file=$1 key=$2 value=$(one_line "$3")
  UAK_AWK_VALUE="$value" awk -v key="$key" '
    BEGIN {value=ENVIRON["UAK_AWK_VALUE"]}
    index($0,key ": ")==1 {$0=key ": " value; seen=1} {print}
    END {if(!seen) print key ": " value}' "$file" > "$TXROOT/edit"
  mv "$TXROOT/edit" "$file"
}
summary_text() {
  valid_worklog "$WL" || die "Invalid worklog path."
  awk '/^## Live summary$/ {on=1;next} /^## History$/ {on=0} on && NF {print}' "$TX/$WL"
}
read_token() { { cat "$(claim_file)"; summary_text; } | cksum | awk '{print $1 "-" $2}'; }
set_summary() {
  {
    printf '# %s · %s\n\n## Live summary\n' "$WL" "$ID"
    printf '%s\n' "- Done: $(one_line "$DONE_TEXT")" "- Decision: $(one_line "$DECISION_TEXT")" \
      "- Why: $(one_line "$WHY_TEXT")" "- Failing: $(one_line "$FAILS_TEXT")" \
      "- Commands: $(one_line "$COMMANDS_TEXT")" "- Next: $(one_line "$NEXT_TEXT")"
    printf '\n## History\n'
    [ ! -f "$TX/$WL" ] || awk 'on {print} /^## History$/ {on=1}' "$TX/$WL"
  } > "$TXROOT/summary"
  mv "$TXROOT/summary" "$TX/$WL"
}
event() { printf '%s\n' "- $NOW | $STATE | $AGENT | $(one_line "$1")" >> "$TX/$WL"; coord_event; }
update_summary_field() {
  label=$1 text=$(one_line "$2")
  UAK_AWK_TEXT="$text" awk -v label="$label" '
    BEGIN {text=ENVIRON["UAK_AWK_TEXT"]}
    /^## Live summary$/ {on=1} /^## History$/ {on=0}
    on && index($0,"- " label ": ")==1 {$0="- " label ": " text}
    {print}' "$TX/$WL" > "$TXROOT/summary"
  mv "$TXROOT/summary" "$TX/$WL"
}
refresh_lease() {
  UNTIL=$((NOW + LEASE))
  [ "$(field "$RECORD" State)" != REVIEW ] || UNTIL=$((NOW + ${REVIEW_LEASE:-$LEASE}))
  put "$RECORD" Lease-Until "$UNTIL"; put "$RECORD" Updated "$NOW"
  put "$CLAIM" Lease-Until "$UNTIL"; put "$CLAIM" Updated "$NOW"
}
check_dependencies() {
  deps=$(printf '%s\n' "$DEPENDS" | awk '{
    s=$0; gsub(/\([^)]*\)/, "", s); while(match(s,/[A-Z][A-Z0-9]*-[0-9][0-9][0-9]+/)) {
      print substr(s,RSTART,RLENGTH); s=substr(s,RSTART+RLENGTH)
    }}')
  for dep in $deps; do
    dep_state=$(field "$TX/tasks/$dep.md" State)
    [ "$dep_state" = INTEGRATED ] && continue
    [ "$dep_state" != REVIEW ] || conflict "$ID depends on $dep (REVIEW). If its PR is already merged, any agent can run: uak integrate $dep"
    conflict "$ID depends on $dep; claim it after INTEGRATED."
  done
}
check_collisions() {
  [ ! -f "$(claim_file)" ] || conflict "$ID already has claims/$ID.md; read its summary."
  if [ -f "$(task_file)" ]; then
    old_state=$(field "$(task_file)" State)
    case "$old_state" in INTEGRATED|CANCELLED) conflict "$ID is already $old_state.";; esac
  fi
  check_owners; check_dependencies
  for other in "$TX"/claims/*.md; do
    [ -f "$other" ] || continue
    # One identity = one live task. Why (Reap buildathon): two sessions shared agent-2 on two tasks and
    # overwrote each other's claims; REVIEW tasks do not count (waiting is not working).
    if [ "${UAK_MULTI_CLAIM:-}" != 1 ] && [ "$(field "$other" Owner)" = "$AGENT" ]; then
      case "$(field "$other" State)" in CLAIMED|BLOCKED)
        other_until=$(field "$other" Lease-Until)
        case "$other_until" in ''|*[!0-9]*) other_until=0;; esac
        [ "$NOW" -ge "$other_until" ] ||
          conflict "$AGENT already holds $(field "$other" ID) ($(field "$other" State)). One identity = one live task: finish or release it, or let another agent take it: bash .uak/bin/wt new $ID (picks a free identity of this machine).";;
      esac
    fi
    if [ "$(field "$other" Branch)" = "$BRANCH" ] || [ "$(field "$other" Worktree)" = "$WORKTREE" ]; then
      conflict "Branch/worktree already claimed by $(field "$other" ID); use one per task."
    fi
    normalize_paths "$(field "$other" Paths)" > "$TXROOT/other-paths" || die "Claim with invalid Paths."
    if overlaps "$TXROOT/paths-request" "$TXROOT/other-paths"; then
      # Why (MLB hackathon): HACK-033 and HACK-022 were refused for 9 h by an expired claim of a retired identity.
      other_until=$(field "$other" Lease-Until); case "$other_until" in ''|*[!0-9]*) other_until=0;; esac
      if [ "$other_until" -gt 0 ] && [ "$NOW" -ge "$other_until" ] && [ "$(field "$other" State)" != REVIEW ]; then
        conflict "$ID overlaps $(field "$other" ID) ($(field "$other" Owner)), whose lease expired $(( (NOW - other_until) / 60 )) min ago. Take that one over: uak status --task $(field "$other" ID) --summary, then uak release $(field "$other" ID) --expired --read-summary TOKEN."
      fi
      conflict "$ID overlaps $(field "$other" ID) ($(field "$other" Owner)); pick another task."
    fi
  done
}
snapshot() {
  [ -f "$TX/DECISIONS.md" ] || {
    printf '# DECISIONS\n\nCoordination decisions on the claims branch.\nWhy: a reversible option after 15 min keeps work moving.\n' > "$TX/DECISIONS.md"
  }
  {
    phase='execution'
    freeze=$(coord_config Freeze-Epoch 0)
    if [ "$freeze" -gt 0 ] && [ "$NOW" -ge "$freeze" ]; then phase='feature freeze; authorized fixes, rehearsal and submission only'; fi
    printf '# STATE\n\nPhase: %s\nUpdated: %s\n' "$phase" "$NOW"
    for state in AVAILABLE CLAIMED BLOCKED REVIEW INTEGRATED CANCELLED; do
      ids=$(for record in "$TX"/tasks/*.md; do
        [ -f "$record" ] || continue
        [ "$(field "$record" State)" != "$state" ] || field "$record" ID
      done | tr '\n' ' ')
      if [ "$state" = AVAILABLE ] && [ -f "$BACKLOG" ]; then
        ids=$(awk '/^## [A-Z][A-Z0-9]*-[0-9]/ {print $2}' "$BACKLOG" | while IFS= read -r id; do
          [ -f "$TX/tasks/$id.md" ] || printf '%s ' "$id"
        done; printf '%s' "$ids")
      fi
      # Why (UpiixSol): a silent cut at 120 chars made INTEGRATED look stuck at UPS-015 with 26 done.
      n_ids=$(printf '%s' "$ids" | wc -w | tr -d ' ')
      [ "${#ids}" -le 120 ] || ids="($n_ids; last 12) ... $(printf '%s' "$ids" | awk '{for(i=(NF>12?NF-11:1);i<=NF;i++) printf "%s ", $i}')"
      printf '%s: %s\n' "$state" "${ids:--}"
    done
    printf '\nClaims (first 24; status --task ID shows detail):\n'
    for c in "$TX"/claims/*.md; do
      [ -f "$c" ] || continue
      printf '%s | %s | %s | until %s\n' "$(field "$c" ID)" "$(field "$c" State)" "$(field "$c" Owner)" "$(field "$c" Lease-Until)"
    done | head -n 24
    printf '\nBlockers: BLOCKED tasks; use status --task ID --summary.\nCurrent decisions (last 5):\n'
    grep '^-' "$TX/DECISIONS.md" | tail -n 5 | cut -c 1-180
    printf '\nGlobal next step: available P0; else review PRs, tests, demo, rehearsal.\nWhy: bounded snapshot to resume without rereading history.\n'
  } > "$TX/STATE.md"
}
# An identity whose human closed its terminal keeps receiving reviews by rotation until it is retired.
# Why (MLB hackathon): three identities of one human had no session left, got 15 rotation reviews, and a human had to tell
# every agent by message that they "no longer exist".
retire_mutate() {
  local who c
  mkdir -p "$TX/meta/retired"
  for who in $RETIRE_NAMES; do
    [ "$who" = "$AGENT" ] || [ -n "$HUMAN" ] || conflict "Retiring $who needs its human: UAK_HUMAN=NAME uak retire $who (or $who retires itself)."
    for c in "$TX"/claims/*.md; do
      [ -f "$c" ] && [ "$(field "$c" Owner)" = "$who" ] || continue
      case "$(field "$c" State)" in CLAIMED|BLOCKED)
        conflict "$who still holds $(field "$c" ID): release or hand it off first (uak release ID, or release --expired).";; esac
    done
    printf '%s\n' "Agent: $who" "Retired-By: ${HUMAN:-$AGENT}" "Retired: $NOW" > "$TX/meta/retired/$who.md"
  done
  ID=
}
# One call that blocks until something happens on claims, instead of an agent polling status/inbox.
# A cheap `git ls-remote` every WAIT_EVERY s (0.4 s with SSH reuse); claims are read only when their tip moves.
# Why (MLB hackathon): 225 `status` and 172 `inbox` calls, most of them an agent checking whether its review,
# a dependency or a reply had arrived; every call re-sends its output into the agent's context.
#   approve     your REVIEW task (or ID): exit 0 on approve or INTEGRATED, 3 on reject
#   integrated  ID becomes INTEGRATED (a dependency): exit 0
#   message     a new unread message for you: printed, exit 0
# Timeout (default 540 s, under a 10-min tool limit): WAIT_TIMEOUT, exit 4. Rerun to keep waiting.
wait_run() {
  local deadline last= tip n=0 rv st c
  deadline=$(( $(date +%s) + WAIT_TIMEOUT ))
  if [ "$WAIT_FOR" = approve ] && [ -z "$ID" ]; then
    ATTEMPT=wait-0; fresh_state
    for c in "$TX"/claims/*.md; do
      [ -f "$c" ] && [ "$(field "$c" Owner)" = "$AGENT" ] && [ "$(field "$c" State)" = REVIEW ] && { ID=$(field "$c" ID); break; }
    done
    [ -n "$ID" ] || die "wait --for approve: you have no task in REVIEW; name one: uak wait ID --for approve"
  fi
  [ "$WAIT_FOR" = message ] || [ -n "$ID" ] || die "wait --for $WAIT_FOR needs an ID."
  say "WAITING ${ID:+$ID }for $WAIT_FOR (up to $WAIT_TIMEOUT s; checks every $WAIT_EVERY s)"
  while :; do
    tip=$(git -C "$ROOT" ls-remote "$REMOTE" refs/heads/claims 2>/dev/null | awk '{print $1; exit}')
    if [ -n "$tip" ] && [ "$tip" != "$last" ]; then
      last=$tip; n=$((n + 1)); ATTEMPT="wait-$n"; [ -n "${UAK_NOW:-}" ] || NOW=$(date +%s)
      fresh_state
      case "$WAIT_FOR" in
        approve)
          st=$(field "$TX/tasks/$ID.md" State); rv="$TX/reviews/$ID.md"
          if [ "$st" = INTEGRATED ]; then say "INTEGRATED $ID ($(field "$TX/tasks/$ID.md" Merge-Commit | cut -c 1-7))"; return 0; fi
          if [ -f "$rv" ] && [ "$(field "$rv" SHA)" = "$(field "$TX/tasks/$ID.md" Task-Tip)" ]; then
            case "$(field "$rv" Verdict)" in
              approve) say "APPROVED $ID by $(field "$rv" Reviewer) on $(field "$rv" SHA | cut -c 1-7). Next: bash .uak/bin/uak merge $ID"; return 0;;
              reject) say "REJECTED $ID by $(field "$rv" Reviewer) on $(field "$rv" SHA | cut -c 1-7). Read it: bash .uak/bin/uak inbox --task $ID"; return 3;;
            esac
          fi;;
        integrated)
          st=$(field "$TX/tasks/$ID.md" State)
          if [ "$st" = INTEGRATED ]; then say "INTEGRATED $ID ($(field "$TX/tasks/$ID.md" Merge-Commit | cut -c 1-7)). git fetch origin && git merge origin/$BASE"; return 0; fi;;
        message)
          c=$(msg_select unread)
          if [ -n "$c" ]; then say "NEW for $AGENT:"; say "$c"; say "Handle them, then uak inbox --ack."; return 0; fi;;
      esac
    fi
    [ "$(date +%s)" -lt "$deadline" ] || { say "WAIT_TIMEOUT ${ID:+$ID }$WAIT_FOR after $WAIT_TIMEOUT s: nothing yet. Do other work, or run the same wait again."; return 4; }
    sleep "$WAIT_EVERY"
  done
}
# Progress facts from the task's worktree, written by every heartbeat (the hooks send them): commits since the claim,
# the last one, uncommitted files. The next owner sees them even when nobody checkpointed. Why (MLB hackathon): 74
# checkpoints for 130 claims, 43 lease recoveries, and a summary that said what the task was, not where it stood.
task_progress() {
  local wt base n last dirty
  wt=$(field "$RECORD" Worktree); [ -d "$wt" ] || wt=$ROOT
  [ "$(git -C "$wt" symbolic-ref --short HEAD 2>/dev/null)" = "$(field "$RECORD" Branch)" ] || return 0
  base=$(field "$RECORD" Task-Base)
  n=$(git -C "$wt" rev-list --count "${base:-HEAD}..HEAD" 2>/dev/null || echo 0)
  last=$(git -C "$wt" log -1 --format='%h %s (%cr)' 2>/dev/null | cut -c 1-120 | tr '|' '/')
  dirty=$(git -C "$wt" status --porcelain 2>/dev/null | grep -vc '^??' || true)
  put "$RECORD" Progress "$n commit(s) since the claim · last: ${last:--} · $dirty uncommitted tracked file(s) · at $NOW"
  # When the work last moved (a new HEAD, or a different set of uncommitted files): stall detection reads it.
  local head; head="$(git -C "$wt" rev-parse --short HEAD 2>/dev/null)/$(git -C "$wt" status --porcelain 2>/dev/null | cksum | awk '{print $1}')"
  if [ "$(field "$RECORD" Progress-Head)" != "$head" ]; then put "$RECORD" Progress-Head "$head"; put "$RECORD" Progress-Changed "$NOW"; fi
}
# Stalled: a CLAIMED task whose work has not moved for Stall-Seconds (default 90 min) while its lease is live.
# Prints "minutes" or nothing. Why (MLB hackathon): 43 lease recoveries; Addy Osmani's orchestra notes: kill and
# reassign an agent stuck three iterations on one error instead of letting it spin.
task_stalled() { # $1 record file
  local ch lim; [ "$(field "$1" State)" = CLAIMED ] || return 0
  ch=$(field "$1" Progress-Changed); case "$ch" in ''|*[!0-9]*) return 0;; esac
  lim=$(coord_config Stall-Seconds 5400 2>/dev/null); case "$lim" in ''|*[!0-9]*) lim=5400;; esac
  [ $((NOW - ch)) -ge "$lim" ] || return 0
  printf '%s' $(( (NOW - ch) / 60 ))
}
# `uak away`: this identity closed its session. It leaves the reviewer rotation and messages to it reach its tasks
# at once (not after 30 min of silence); its claims keep their leases. The next uak command brings it back.
# SessionEnd hooks run it. Why (MLB hackathon): sessions closed without a handoff (5 handoffs, 14 releases for 130
# claims), and their identities kept getting reviews for hours.
away_mutate() {
  local c n=0
  mkdir -p "$TX/meta/agents"
  [ -f "$TX/meta/agents/$AGENT.md" ] || printf '%s\n' "# $AGENT" "Agent: $AGENT" "Started: $NOW" > "$TX/meta/agents/$AGENT.md"
  for c in "$TX"/claims/*.md; do
    [ -f "$c" ] && [ "$(field "$c" Owner)" = "$AGENT" ] || continue
    ID=$(field "$c" ID); RECORD=$(task_file)
    case "$(field "$c" State)" in CLAIMED|BLOCKED) task_progress; put "$RECORD" Away "$NOW"; n=$((n + 1));; esac
  done
  ID=
  put "$TX/meta/agents/$AGENT.md" Session-Ended "$NOW"
  AWAY_TASKS=$n
}
# Explicit transfer of a live task: same claim, branch, worktree and summary; only the owner changes.
# Allowed to the owner, to a human (UAK_HUMAN) and to anyone once the lease has expired.
# Why (MLB hackathon): the tasks of three abandoned identities were redistributed by messages ("you take 033, I
# take 020"), then each one needed release --expired with a read token and a new claim.
handover_mutate() {
  local owner until c wt
  [ -f "$CLAIM" ] && [ -f "$RECORD" ] || conflict "$ID has no claim to hand over."
  owner=$(field "$CLAIM" Owner); until=$(field "$CLAIM" Lease-Until); case "$until" in ''|*[!0-9]*) until=0;; esac
  [ "$DONE_TO" != "$owner" ] || conflict "$ID already belongs to $DONE_TO."
  # Also another identity of the same human once the owner has been offline for 1 h (or closed its session, uak away): a human's closed session must
  # not strand its task in review (MLB: verdicts and requests reached closed identities while the same human ran a live one).
  local seen_o; seen_o=$(msg_seen "$owner")
  [ "$owner" = "$AGENT" ] || [ -n "$HUMAN" ] || [ "$NOW" -ge "$until" ] ||
    { [ "${owner%-*}" = "${AGENT%-*}" ] && { [ $((NOW - seen_o)) -ge 3600 ] || msg_away "$owner"; }; } ||
    conflict "$ID belongs to $owner with a live lease: only $owner, a human (UAK_HUMAN) or another identity of the same human after 1 h offline can hand it over."
  [ ! -f "$TX/meta/retired/$DONE_TO.md" ] || conflict "$DONE_TO is retired; a claim by $DONE_TO brings it back, a handover does not."
  if [ "${UAK_MULTI_CLAIM:-}" != 1 ]; then
    for c in "$TX"/claims/*.md; do
      [ -f "$c" ] && [ "$c" != "$CLAIM" ] && [ "$(field "$c" Owner)" = "$DONE_TO" ] || continue
      case "$(field "$c" State)" in CLAIMED|BLOCKED) conflict "$DONE_TO already holds $(field "$c" ID): one identity = one live task.";; esac
    done
  fi
  put "$RECORD" Owner "$DONE_TO"; put "$CLAIM" Owner "$DONE_TO"
  WL=$(field "$RECORD" Worklog); STATE=$(field "$RECORD" State)
  local saved=$AGENT; refresh_lease
  event "handover; $owner → $DONE_TO by ${HUMAN:-$saved}"
  # The worktree's .uak-env wins over the shell, so it must name the new owner when the worktree is here.
  wt=$(field "$RECORD" Worktree)
  if [ -f "$wt/.uak-env" ]; then
    sed "s/^UAK_AGENT=.*/UAK_AGENT=$DONE_TO/" "$wt/.uak-env" > "$wt/.uak-env.tmp" && mv "$wt/.uak-env.tmp" "$wt/.uak-env"
  fi
  msg_append "agent:$DONE_TO" request "$ID" "$ID is yours now (from $owner): branch $(field "$RECORD" Branch), worktree $wt. Read uak status --task $ID --summary and continue its Next. Another machine: git fetch origin && git worktree add <dir> $(field "$RECORD" Branch), then write UAK_AGENT=$DONE_TO and UAK_TASK=$ID in <dir>/.uak-env."
}
# A follow-up of an INTEGRATED task (fix, polish, a reviewer's non-blocking notes) is a new task on the same
# Paths, so it gets a claim, a review and a merge. Why (MLB hackathon): 3 follow-up PRs of integrated tasks
# went around the kit; `uak review` refused them ("already INTEGRATED") and one was approved only by message.
followup_mutate() {
  local parent=$ID prefix n paths verify freeze
  RECORD=$(task_file)
  local st; st=$(field "$RECORD" State); st=${st:-AVAILABLE}
  [ "$st" = INTEGRATED ] || conflict "$parent is $st, not INTEGRATED: keep working on it, or push to its branch and run done again."
  [ "$(coord_source_field Plan-Channel main)" = claims ] ||
    conflict "Plan-Channel is not claims in .uak/PROJECT.md: add the follow-up task to TASKS.md by PR."
  paths=$(field "$RECORD" Paths); verify=$(field "$RECORD" Verify)
  prefix=${parent%-*}
  n=$(awk -v p="$prefix" '/^## / {split($2, a, "-"); if (a[1] == p && a[2] ~ /^[0-9]+$/ && a[2] + 0 > m) m = a[2] + 0} END {print m + 0}' "$BACKLOG")
  for f in "$TX"/tasks/"$prefix"-*.md; do [ -f "$f" ] || continue; f=${f##*-}; f=${f%.md}; case "$f" in *[!0-9]*) continue;; esac
    [ "$((10#$f))" -le "$n" ] || n=$((10#$f)); done
  NEW_ID=$(printf '%s-%03d' "$prefix" $((n + 1)))
  mkdir -p "$TX/backlog"
  [ -f "$TX/backlog/TASKS.md" ] || printf '%s\n' '# Backlog published on claims (uak plan)' '' \
    'Append-only; added to .uak/TASKS.md from main. Why: adding tasks never waits for a PR.' > "$TX/backlog/TASKS.md"
  printf '%s\n' '' "## $NEW_ID · $(one_line "$FOLLOWUP_TITLE") (follow-up of $parent)" '' '- **Type:** follow-up' '- **Priority:** P1' \
    "- **Depends on:** $parent" "- **Follow-up of:** $parent" "- **Paths:** $paths" '- **Freeze-Allowed:** no' \
    '- **Acceptance:**' "  - $(one_line "$FOLLOWUP_TITLE")" "- **Verify:** $verify" >> "$TX/backlog/TASKS.md"
  [ -f "$TX/DECISIONS.md" ] || printf "# DECISIONS\n" > "$TX/DECISIONS.md"
  printf '%s\n' "- $NOW | $NEW_ID | follow-up of $parent by $AGENT: $(one_line "$FOLLOWUP_TITLE") | Why: same Paths, no scope change" >> "$TX/DECISIONS.md"
}
mutate() {
  coord_init
  RECORD=$(task_file); CLAIM=$(claim_file)
  case "$CMD" in
    claim)
      coord_tick_mutate; load_task
      [ -n "$REQUEST_NEXT" ] || NEXT_TEXT=$DEFAULT_NEXT
      coord_claim_gate
      check_collisions; STATE=CLAIMED; UNTIL=$((NOW + LEASE))
      WL="worklog/WL-$NOW-$AGENT-$ID-$(basename "$TXROOT").md"
      task_base=$CLAIM_BASE
      if [ -f "$RECORD" ]; then
        prior_wl=$(field "$RECORD" Worklog)
        if [ -f "$TX/$prior_wl" ]; then
          WL=$prior_wl
          task_base=$(field "$RECORD" Task-Base)
          [ -n "$REQUEST_NEXT" ] || NEXT_TEXT=$(field "$RECORD" Next)
        fi
      fi
      {
        printf '# %s\n' "$ID"
        printf '%s\n' "ID: $ID" "State: $STATE" "Owner: $AGENT" "Branch: $BRANCH" "Worktree: $WORKTREE" \
          "Worklog: $WL" "Priority: $PRIORITY" "Paths: $(one_line "$PATHS")" \
          "Depends: $(one_line "$DEPENDS")" "Verify: $(one_line "$VERIFY")" \
          "Lease-Until: $UNTIL" "Updated: $NOW" "Task-Base: $task_base" "Next: $(one_line "$NEXT_TEXT")" "PR: -" "Evidence: -"
      } > "$RECORD"
      cp "$RECORD" "$CLAIM"; rm -f "$TX/meta/retired/$AGENT.md"
      DONE_TEXT="Claim created; implementation pending"
      DECISION_TEXT="Own branch and worktree"
      WHY_TEXT="Parallel work without touching the main checkout"
      FAILS_TEXT="No validation run yet"; COMMANDS_TEXT=$VERIFY
      if [ -f "$TX/$WL" ]; then update_summary_field Next "$NEXT_TEXT"; else set_summary; fi
      event "claim; next: $NEXT_TEXT"
      ;;
    away) away_mutate;;
    pr-sync) pr_sync_mutate;;
    heartbeat)
      coord_tick_mutate
      # Your own task that already left CLAIMED/REVIEW: nothing to renew, not an error.
      # Why (MLB hackathon): Cursor agents heartbeated integrated tasks and logged "no active claim" conflicts.
      if [ ! -f "$CLAIM" ] && [ -f "$RECORD" ] && [ "$(field "$RECORD" Owner)" = "$AGENT" ]; then
        say "OK heartbeat $ID | $(field "$RECORD" State): nothing to renew. Next: uak next"; return 0
      fi
      require_owner; STATE=$(field "$RECORD" State)
      refresh_lease; event "heartbeat; lease until $UNTIL"
      task_progress
      ;;
    release)
      [ -f "$CLAIM" ] && [ -f "$RECORD" ] || conflict "$ID has no claim."
      WL=$(field "$RECORD" Worklog); STATE=$(field "$RECORD" State)
      valid_worklog "$WL" || die "Invalid worklog path."
      [ -f "$TX/$WL" ] || die "Missing live summary."
      if [ "$(field "$CLAIM" Owner)" != "$AGENT" ]; then
        [ "$EXPIRED" = yes ] || conflict "Only the owner can release an unexpired claim."
        until=$(field "$CLAIM" Lease-Until)
        case "$until" in ''|*[!0-9]*) die "Invalid lease.";; esac
        [ "$NOW" -ge "$until" ] || conflict "Lease of $ID still active."
        [ -n "$TOKEN" ] && [ "$TOKEN" = "$(read_token)" ] ||
          conflict "Read status --task $ID --summary and pass its current Read-token."
      fi
      STATE=AVAILABLE
      if [ -n "$CANCEL_REASON" ]; then
        [ "$(field "$CLAIM" Owner)" = "$AGENT" ] || conflict "Only the owner can cancel."
        STATE=CANCELLED
        put "$RECORD" Next "Cancelled: $CANCEL_REASON"
        update_summary_field Next "Cancelled: $CANCEL_REASON"
      fi
      put "$RECORD" State "$STATE"; put "$RECORD" Updated "$NOW"; put "$RECORD" Lease-Until 0
      rm "$CLAIM"; event "release; claim released by $AGENT; reason: ${CANCEL_REASON:--}; summary kept"
      ;;
    log)
      require_owner; STATE=$(field "$RECORD" State)
      if [ -n "$NEW_STATE" ]; then
        case "$STATE" in CLAIMED|BLOCKED) ;; *) conflict "log cannot move $ID out of $STATE.";; esac
        STATE=$NEW_STATE; put "$RECORD" State "$STATE"; put "$CLAIM" State "$STATE"
      fi
      [ "$STATE" != BLOCKED ] || update_summary_field Failing "$LOG_TEXT"
      refresh_lease; event "$LOG_TEXT"
      ;;
    checkpoint)
      if [ "$SESSION_ONLY" = yes ]; then coord_checkpoint_session
      else
        if [ -f "$CLAIM" ]; then require_owner
        else
          [ -f "$RECORD" ] && [ "$(field "$RECORD" Owner)" = "$AGENT" ] || conflict "Checkpoint needs your own task record or --session."
          WL=$(field "$RECORD" Worklog); valid_worklog "$WL" && [ -f "$TX/$WL" ] || die "Missing valid worklog."
        fi
        STATE=$(field "$RECORD" State); set_summary
        put "$RECORD" Next "$NEXT_TEXT"
        if [ -f "$CLAIM" ]; then put "$CLAIM" Next "$NEXT_TEXT"; refresh_lease
        else put "$RECORD" Updated "$NOW"; fi
        if [ "$DECISION_TEXT" != "-" ] && [ -n "$DECISION_TEXT" ]; then
          [ -f "$TX/DECISIONS.md" ] || printf '# DECISIONS\n' > "$TX/DECISIONS.md"
          printf '%s\n' "- $NOW | $ID | $(one_line "$DECISION_TEXT") | Why: $(one_line "$WHY_TEXT")" >> "$TX/DECISIONS.md"
        fi
        event "checkpoint; next: $NEXT_TEXT"
      fi
      ;;
    handoff)
      if [ -f "$CLAIM" ]; then require_owner; refresh_lease
      else
        [ -f "$RECORD" ] && [ "$(field "$RECORD" Owner)" = "$AGENT" ] || conflict "Only the owner can close a handoff."
        WL=$(field "$RECORD" Worklog)
      fi
      STATE=$(field "$RECORD" State); event "handoff; next: $(field "$RECORD" Next)"
      ;;
    tick) coord_tick_mutate;;
    retire) retire_mutate;;
    learn) learn_mutate;;
    handover) handover_mutate;;
    followup) followup_mutate;;
    allow) coord_allow_mutate;;
    msg) msg_mutate;;
    inbox) msg_ack_mutate;;
    review) review_mutate;;
    register-reviewer) register_reviewer_mutate;;
    decision) coord_decision_mutate;;
    plan) plan_mutate;;
    secret-exception) secret_exception_action;;
    integrate)
      # Why (UpiixSol): a human merged on GitHub while the owner agent was offline; the task sat in REVIEW and
      # blocked its dependents for hours. The proof is verifiable, so any identity may record it.
      if [ -f "$RECORD" ] && [ "$(field "$RECORD" State)" = INTEGRATED ]; then
        say "OK integrate $ID | already INTEGRATED ($(field "$RECORD" Merge-Commit | cut -c 1-7)); nothing to do"; return 0
      fi
      [ -f "$RECORD" ] && [ "$(field "$RECORD" State)" = REVIEW ] ||
        conflict "$ID is $(st=$(field "$RECORD" State); printf '%s' "${st:-AVAILABLE}"), not REVIEW; integrate records the merged PR of a task under review (INTEGRATED needs nothing)."
      WL=$(field "$RECORD" Worklog); valid_worklog "$WL" || die "Invalid worklog path."
      [ -f "$TX/$WL" ] || die "Missing worklog $WL."
      PR_URL=$(field "$RECORD" PR)
      git check-ref-format "refs/heads/$BASE" >/dev/null 2>&1 || die "Invalid UAK_BASE."
      git -C "$TX" fetch -q origin "refs/heads/$BASE:refs/uak/base" || gitfail "Could not verify remote base branch $BASE."
      resolve_task_tip || conflict "$RM_REASON"
      tip=$RM_TIP
      approval_check "$tip" "$PR_URL" || conflict "$RM_REASON. Approve the merged SHA first: uak review $ID --sha ${tip:-SHA} --verdict approve"
      if [ -n "$MERGE_COMMIT" ]; then
        merged=$(git -C "$TX" rev-parse --verify "$MERGE_COMMIT^{commit}" 2>/dev/null) || conflict "COMMIT not in the remote history of $BASE."
      elif [ "$RM_REVIEW_MODE" = gh ] && [ -n "$RM_GH_MERGE" ]; then merged=$RM_GH_MERGE
      else merged=$(git -C "$TX" rev-parse refs/uak/base); fi
      integrated_check "$tip" "$merged" || conflict "$RM_REASON (squash merge: pass --integrated COMMIT)"
      STATE=INTEGRATED
      put "$RECORD" Integration-Proof "$RM_PROOF"; put "$RECORD" Merge-Commit "$merged"
      put "$RECORD" Reviewer "$APPROVED_BY"; put "$RECORD" Task-Tip "$tip"; put "$RECORD" State INTEGRATED
      put "$RECORD" Next "Integrated in $BASE: $merged; claim next P0"
      put "$RECORD" Lease-Until 0; put "$RECORD" Updated "$NOW"
      update_summary_field Next "Integrated in $BASE: $merged (recorded by $AGENT)"
      rm -f "$CLAIM"
      event "integrate; recorded by $AGENT; PR $PR_URL; merged $merged; proof $RM_PROOF"
      msg_notify_related "$ID" integrated "$ID integrated in $BASE ($merged), recorded by $AGENT. If you depend on it: git fetch origin && git merge origin/$BASE"
      ;;
    done)
      require_owner; STATE=REVIEW
      task_branch=$(field "$RECORD" Branch)
      task_worktree=$(field "$RECORD" Worktree)
      tip=$(field "$RECORD" Task-Tip)
      if [ -z "$MERGE_COMMIT" ]; then
        tip=$(git -C "$task_worktree" rev-parse HEAD 2>/dev/null) || die "Missing worktree to record Task-Tip."
      else
        git check-ref-format "refs/heads/$BASE" >/dev/null 2>&1 || die "Invalid UAK_BASE."
        git -C "$TX" fetch -q origin "refs/heads/$BASE:refs/uak/base" ||
          gitfail "Could not verify remote base branch $BASE."
        resolve_task_tip || conflict "$RM_REASON"
        tip=$RM_TIP
        [ -n "$tip" ] || conflict "Missing Task-Tip; record done (REVIEW) or push the branch first."
        task_base=$(field "$RECORD" Task-Base)
        [ -n "$task_base" ] && [ "$tip" != "$task_base" ] ||
          conflict "TIP equals the claim base; nothing implemented."
        merged=$(git -C "$TX" rev-parse --verify "$MERGE_COMMIT^{commit}" 2>/dev/null) ||
          conflict "COMMIT not in the remote history of $BASE."
        approval_check "$tip" "$PR_URL" || conflict "$RM_REASON"
        [ -z "$REVIEWER" ] || [ "$REVIEWER" = "$APPROVED_BY" ] || conflict "--reviewer does not match the verified approval."
        integrated_check "$tip" "$merged" || conflict "$RM_REASON"
        REVIEWER=$APPROVED_BY
        put "$RECORD" Integration-Proof "$RM_PROOF"
        STATE=INTEGRATED
        put "$RECORD" Merge-Commit "$merged"; put "$RECORD" Reviewer "$REVIEWER"
      fi
      put "$RECORD" Task-Tip "$tip"
      put "$RECORD" State "$STATE"; put "$CLAIM" State "$STATE"
      put "$RECORD" PR "$PR_URL"; put "$CLAIM" PR "$PR_URL"; put "$RECORD" Evidence "$EVIDENCE"
      put "$RECORD" Next "Another agent reviews $PR_URL; run .uak/bin/smoke"
      put "$CLAIM" Next "Another agent reviews $PR_URL; run .uak/bin/smoke"
      update_summary_field Done "$EVIDENCE"
      update_summary_field Next "Another agent reviews $PR_URL; run .uak/bin/smoke"
      # Contract check at the moment of shipping: does this diff touch files that other live tasks import, with no
      # contract message from you on this task? Why (adoption eval): with the rule in context (AGENTS.md §5.1) a
      # Sonnet agent changed a function another claimed task imported, pushed and shipped without telling it.
      if [ "$STATE" = REVIEW ] && [ -d "$task_worktree" ] && [ -f "$task_worktree/.uak/bin/map" ]; then
        local cfiles ctasks
        cfiles=$(git -C "$task_worktree" diff --name-only "$(field "$RECORD" Task-Base)" "$tip" 2>/dev/null | head -n 30)
        ctasks=$( [ -z "$cfiles" ] || (cd "$task_worktree" && bash .uak/bin/map impact --tasks --backlog "$BACKLOG" $cfiles 2>/dev/null) | grep -v "^$ID\$" |
          while IFS= read -r t; do [ -f "$TX/claims/$t.md" ] && printf '%s ' "$t"; done)
        if [ -n "$ctasks" ] && ! awk -F' [|] ' -v me="$AGENT" -v id="$ID" '$3 == me && $5 == "contract" && ($6 == id || index($4, "impact:" id)) {f = 1} END {exit !f}' "$TX/$MSG_LOG" 2>/dev/null; then
          DONE_HINT="CONTRACT? Your diff changes files that live tasks import (${ctasks% }) and you sent them no contract. If the shape changed: bash .uak/bin/uak msg impact:$ID --kind contract --task $ID \"what changed · what to do\""
        fi
      fi
      # Upstream drift at the moment of shipping: the base changed what this branch edits or imports since it last
      # synced (the merge gate would find it later, after a review). Why: STORM, arXiv 2605.20563.
      if [ "$STATE" = REVIEW ] && [ -d "$task_worktree" ] && [ -f "$task_worktree/.uak/bin/map" ]; then
        local drift
        drift=$(cd "$task_worktree" && git fetch -q origin "$BASE" 2>/dev/null && bash .uak/bin/map drift --ref "origin/$BASE" 2>/dev/null | head -n 4)
        [ -z "$drift" ] || DONE_HINT="${DONE_HINT}${DONE_HINT:+
}$drift"
      fi
      if [ "$STATE" = INTEGRATED ]; then
        put "$RECORD" Next "Integrated in $BASE: $merged; claim next P0"
        put "$RECORD" Lease-Until 0; put "$RECORD" Updated "$NOW"
        update_summary_field Next "Integrated in $BASE: $merged; claim next P0"
        rm "$CLAIM"
      else refresh_lease; fi
      event "done; PR $PR_URL; evidence: $EVIDENCE; reviewer: ${REVIEWER:--}"
      if [ "$STATE" = INTEGRATED ]; then
        msg_notify_related "$ID" integrated "$ID integrated in $BASE ($merged). If you depend on it: git fetch origin && git merge origin/$BASE"
      else
        # One review message: --to picks the reviewer, --note says what changed. Why (MLB hackathon): a re-review
        # was 3 messages (rotation + "re-review X" to the task + "ready" to the rejecter) 9 times.
        local why_r="your turn by rotation" note_r=; [ -z "$REVIEW_NOTE" ] || note_r=" · $REVIEW_NOTE"
        if [ -n "$DONE_TO" ]; then
          [ "$DONE_TO" != "$AGENT" ] || conflict "--to: the reviewer is never the author."
          reviewer=$DONE_TO; why_r="asked by $AGENT"
        else
          reviewer=$(msg_pick_reviewer "$AGENT" "$ID")
          [ -z "$reviewer" ] || [ "$reviewer" != "$(msg_last_rejecter "$AGENT" "$ID")" ] || why_r="you rejected the previous SHA"
        fi
        if [ -n "$reviewer" ]; then
          msg_append "agent:$reviewer" review "$ID" "$ID ready for review ($why_r): $PR_URL (SHA $tip)$note_r. /uak-review $ID; if you can't, reply and any free agent takes it (uak next shows it)."
        else
          msg_append all review "$ID" "$ID ready for review: $PR_URL (SHA $tip)$note_r. First free agent: /uak-review $ID"
        fi
      fi
      ;;
  esac
  # An idempotent read changes no STATE and creates no empty commit.
  if [ -n "$(git -C "$TX" status --porcelain)" ]; then snapshot; fi
}
# `plan FILE --amend`: new Paths, Verify or criteria for tasks already published, before their review.
# The amended section replaces the old one wherever the backlog is read (claims backlog/AMEND.md, last one wins);
# a claimed task's record and claim take the new Paths and Verify, so the merge gate checks the new scope.
# Why (MLB hackathon, v5 week): a fix had to touch fixtures and tests the plan missed, `uak plan` refused to
# republish the task, and the only way out was a new task or edits outside Paths.
plan_amend_mutate() {
  local id st c old_p new_p old_v new_v changes=
  for id in $plan_ids; do
    valid_id "$id" || die "Invalid ID in plan: $id"
    [ "$(awk -v id="$id" '/^## / && $2==id {n++} END {print n+0}' "$BACKLOG")" -eq 1 ] || conflict "$id is not in the backlog: publish it with uak plan FILE (no --amend)."
    [ "$(awk -v id="$id" '/^## / && $2==id {n++} END {print n+0}' "$PLAN_FILE")" -eq 1 ] || die "$id appears more than once in $PLAN_FILE."
    for key in Priority "Paths" "Depends on" "Verify"; do
      [ -n "$(ID=$id BACKLOG=$PLAN_FILE task_field "$key")" ] || die "$id needs $key."
    done
    st=$(field "$TX/tasks/$id.md" State); st=${st:-AVAILABLE}
    case "$st" in
      AVAILABLE|CLAIMED|BLOCKED) ;;
      REVIEW) conflict "$id is in REVIEW: its review covers the old criteria. A reviewer rejects it first (or it merges), then amend; more work after INTEGRATED is uak followup $id.";;
      *) conflict "$id is $st: more work on it is uak followup $id --title TEXT.";;
    esac
    new_p=$(ID=$id BACKLOG=$PLAN_FILE task_field Paths); new_v=$(ID=$id BACKLOG=$PLAN_FILE task_field Verify)
    old_p=$(ID=$id task_field Paths); old_v=$(ID=$id task_field Verify)
    # New Paths must not take files of other live claims or of OWNERS rows (same checks as a claim).
    ( ID=$id; normalize_paths "$new_p" > "$TXROOT/paths-request" || die "Invalid Paths for $id."
      check_owners
      for c in "$TX"/claims/*.md; do
        [ -f "$c" ] && [ "$(field "$c" ID)" != "$id" ] || continue
        normalize_paths "$(field "$c" Paths)" > "$TXROOT/other-paths" || continue
        ! overlaps "$TXROOT/paths-request" "$TXROOT/other-paths" || conflict "The new Paths of $id overlap $(field "$c" ID) (claimed by $(field "$c" Owner)): split the work or ask them."
      done ) || exit $?
    if [ -f "$TX/tasks/$id.md" ] && [ "$st" != AVAILABLE ]; then
      put "$TX/tasks/$id.md" Paths "$(one_line "$new_p")"; put "$TX/tasks/$id.md" Verify "$(one_line "$new_v")"
      [ ! -f "$TX/claims/$id.md" ] || { put "$TX/claims/$id.md" Paths "$(one_line "$new_p")"; put "$TX/claims/$id.md" Verify "$(one_line "$new_v")"; }
    fi
    changes="$changes $id"
    [ "$old_p" = "$new_p" ] || changes="$changes Paths: $old_p → $new_p;"
    [ "$old_v" = "$new_v" ] || changes="$changes Verify changed;"
    msg_append "task:$id" info "$id" "$id amended by $HUMAN: Paths $(one_line "$new_p") · Verify $(one_line "$new_v"). uak status --task $id; the merge gate checks the new Paths."
  done
  [ -f "$TX/backlog/AMEND.md" ] || printf '%s\n' '# Amended tasks (uak plan --amend)' '' \
    'Append-only; the last section of an ID replaces its section in the backlog. Why: Paths can grow before review.' '' > "$TX/backlog/AMEND.md"
  awk '/^## [A-Z][A-Z0-9]*-[0-9]/ {on=1} /^# / {on=0} on {print}' "$PLAN_FILE" >> "$TX/backlog/AMEND.md"
  if grep -Eq '^\|.*\|[[:space:]]*[A-Z][A-Z0-9]*-[0-9]+[[:space:]]*\|' "$PLAN_FILE"; then
    [ -f "$TX/backlog/OWNERS.md" ] || printf '%s\n' '# Owners published on claims' '' '| Pattern | Owner task |' '|---|---|' > "$TX/backlog/OWNERS.md"
    grep -E '^\|.*\|[[:space:]]*[A-Z][A-Z0-9]*-[0-9]+[[:space:]]*\|' "$PLAN_FILE" >> "$TX/backlog/OWNERS.md"
  fi
  ID=
  [ -f "$TX/DECISIONS.md" ] || printf "# DECISIONS\n\nCoordination decisions on the claims branch.\n" > "$TX/DECISIONS.md"
  printf '%s\n' "- $NOW | plan --amend | $HUMAN/$AGENT | amended:$(one_line "$changes" | tr '|' '/') | Why: scope or criteria fixed before review" >> "$TX/DECISIONS.md"
}
plan_mutate() {
  [ "$(coord_source_field Plan-Channel main)" = claims ] ||
    conflict "Plan-Channel is not claims in .uak/PROJECT.md: publish the backlog by PR to $BASE."
  plan_ids=$(awk '/^## [A-Z][A-Z0-9]*-[0-9]/ {print $2}' "$PLAN_FILE")
  [ -n "$plan_ids" ] || die "The file has no ## ID sections."
  if [ "$PLAN_AMEND" = yes ]; then plan_amend_mutate; return; fi
  for ID in $plan_ids; do
    valid_id "$ID" || die "Invalid ID in plan: $ID"
    [ "$(awk -v id="$ID" '/^## / && $2==id {n++} END {print n+0}' "$BACKLOG" "$PLAN_FILE")" -eq 1 ] ||
      conflict "$ID already exists in the backlog or is duplicated. To change its Paths, Verify or criteria before review: uak plan FILE --amend."
    for key in Priority "Paths" "Depends on" "Verify"; do
      [ -n "$(BACKLOG=$PLAN_FILE task_field "$key")" ] || die "$ID needs $key."
    done
  done
  mkdir -p "$TX/backlog"
  [ -f "$TX/backlog/TASKS.md" ] || printf '%s\n' '# Backlog published on claims (uak plan)' '' \
    'Append-only; added to .uak/TASKS.md from main. Why: adding tasks never waits for a PR.' > "$TX/backlog/TASKS.md"
  awk '/^## [A-Z][A-Z0-9]*-[0-9]/ {on=1} /^# / {on=0} on {print}' "$PLAN_FILE" >> "$TX/backlog/TASKS.md"
  if grep -Eq '^\|.*\|[[:space:]]*[A-Z][A-Z0-9]*-[0-9]+[[:space:]]*\|' "$PLAN_FILE"; then
    [ -f "$TX/backlog/OWNERS.md" ] || printf '%s\n' '# Owners published on claims' '' '| Pattern | Owner task |' '|---|---|' > "$TX/backlog/OWNERS.md"
    grep -E '^\|.*\|[[:space:]]*[A-Z][A-Z0-9]*-[0-9]+[[:space:]]*\|' "$PLAN_FILE" >> "$TX/backlog/OWNERS.md"
  fi
  ID=
  [ -f "$TX/DECISIONS.md" ] || printf "# DECISIONS\n\nCoordination decisions on the claims branch.\n" > "$TX/DECISIONS.md"
  printf '%s\n' "- $NOW | plan | $HUMAN/$AGENT | tasks added: $(printf '%s ' $plan_ids)| Why: backlog without PR (Plan-Channel: claims)" >> "$TX/DECISIONS.md"
  msg_append all info - "Backlog: new tasks $(printf '%s ' $plan_ids)published by $HUMAN. uak next shows them."
}
transaction() {
  ATTEMPT=0
  while :; do
    ATTEMPT=$((ATTEMPT + 1)); fresh_state; mutate
    git -C "$TX" add -A || gitfail "git add failed."
    if git -C "$TX" diff --cached --quiet; then
      [ "$CMD" != allow ] || say "OK allow (already allowed) | nothing to record"
      [ "$CMD" != learn ] || say "OK learn $MEM_DONE | nothing to record"
      return 0
    fi
    git -C "$TX" commit -q -m "uak: $CMD $ID ($AGENT)" || gitfail "git commit failed."
    if git -C "$TX" push --porcelain origin HEAD:refs/heads/claims > "$TXROOT/push" 2>&1; then
      if [ "${QUIET:-no}" != yes ]; then
        if [ "$SESSION_ONLY" = yes ]; then say "OK checkpoint --session | budget reset | attempt $ATTEMPT"
        elif [ "$CMD" = tick ]; then say "OK tick | deadlines reconciled | attempt $ATTEMPT"
        elif [ "$CMD" = plan ] && [ "$PLAN_AMEND" = yes ]; then say "OK plan --amend$(printf ' %s' $plan_ids) | new Paths/Verify/criteria on claims; their owners got one message | attempt $ATTEMPT"
        elif [ "$CMD" = plan ]; then say "OK plan | tasks published on claims | attempt $ATTEMPT"
        elif [ "$CMD" = allow ]; then say "OK allow${ALLOW_DONE:- (already allowed)} | claim and merge allowed after the freeze | attempt $ATTEMPT"
        elif [ "$CMD" = register-reviewer ]; then say "OK register-reviewer $REGISTER_REVIEWER | attempt $ATTEMPT"
        elif [ "$CMD" = handover ]; then say "OK handover $ID → $DONE_TO | lease renewed; $DONE_TO continues from the live summary"
        elif [ "$CMD" = learn ]; then say "OK learn $MEM_DONE | uak next shows it to whoever works there"
        elif [ "$CMD" = away ]; then say "OK away $AGENT | out of the reviewer rotation; messages to you reach your tasks; ${AWAY_TASKS:-0} claim(s) keep their leases. Any uak command brings you back."
        elif [ "$CMD" = retire ]; then say "OK retire$RETIRE_NAMES | out of the reviewer rotation; a new claim brings an identity back"
        elif [ "$CMD" = followup ]; then say "OK followup $NEW_ID (after $ID, same Paths) | take it: bash .uak/bin/wt new $NEW_ID --agent ${AGENT}"
        elif [ "$REVIEW_STARTED" = yes ]; then say "OK review --start $ID | yours for $(( ${UAK_REVIEW_LOCK_SECONDS:-1200} / 60 )) min; finish with --verdict"
        else say "OK $CMD $ID | $(field "$RECORD" State) | attempt $ATTEMPT"
          # The next step in the output itself: it reaches every harness, Cursor included (no post-tool hook there).
          case "$CMD" in
            done) [ "$(field "$RECORD" State)" != REVIEW ] ||
                    say "Next: bash .uak/bin/uak wait $ID --for approve (one call; returns on approve or reject). Meanwhile: uak next for other work; do not poll status.";;
            # The task's slice of the code map, not a pointer to it (MLB, v5 week: 9 map calls in 67 tasks).
            claim) brief=$(bash "$UAK_BIN/map" brief "$ID" --paths "$PATHS" --backlog "$BACKLOG" 2>/dev/null | head -n 10)
                   [ -z "$brief" ] || say "$brief"
                   say "Query, do not open whole files: uak map find NAME · callers NAME · users FILE · recall $ID (lessons)."
                   mem_for_task "$ID";;
          esac
        fi
      fi
      if [ "$CMD" = handoff ]; then print_task; fi
      [ -z "$REVIEW_HINT" ] || say "$REVIEW_HINT"
      [ -z "$DONE_HINT" ] || say "$DONE_HINT"
      return 0
    fi
    if grep -Eqi 'pre-receive hook declined|hook declined|protected branch|permission denied|authentication failed|remote rejected.*(policy|prohibited)' "$TXROOT/push" ||
       ! grep -Eqi 'fetch first|non-fast-forward|cannot lock ref|already exists|failed to update ref|incorrect old value provided' "$TXROOT/push"; then
      gitfail "push failed; the claim was not confirmed. $(tail -n 2 "$TXROOT/push")"
    fi
    # Why: another valid push means redo from the new remote and revalidate, not give up.
    [ "${QUIET:-no}" = yes ] || say "RETRY $CMD $ID | remote contention; refetch and revalidate" >&2
    previous_tip=$(git -C "$TX" rev-parse HEAD^ 2>/dev/null || true)
    remote_tip=$(git -C "$TX" ls-remote origin refs/heads/claims 2>/dev/null | awk '{print $1; exit}')
    [ -z "$remote_tip" ] || [ "$remote_tip" != "$previous_tip" ] || gitfail "push rejected without remote progress; check permissions/protection."
    [ "$ATTEMPT" -lt "${UAK_MAX_ATTEMPTS:-30}" ] || gitfail "claims contention: $ATTEMPT attempts. Wait a minute and retry."
    # Jittered exponential backoff (0.25 s .. 4 s). Why (Reap): 12 agents retried in lockstep; an approval
    # needed 14 attempts and a checkpoint 8, because everybody refetched and pushed at the same instant.
    backoff_cap=$((250 * (1 << (ATTEMPT > 4 ? 4 : ATTEMPT - 1)))); backoff=$((RANDOM % backoff_cap + 50))
    sleep "$((backoff / 1000)).$(printf '%03d' $((backoff % 1000)))" 2>/dev/null || sleep 1
    # The next loop starts from a fresh clone of the new remote: IDs, leases and overlaps are revalidated.
  done
}
print_task() {
  RECORD=$(task_file)
  if [ -f "$RECORD" ]; then
    WL=$(field "$RECORD" Worklog)
    say "$ID | $(field "$RECORD" State) | $(field "$RECORD" Owner)"
    say "Branch: $(field "$RECORD" Branch)"
    say "Worktree: $(field "$RECORD" Worktree)"
    say "Next: $(field "$RECORD" Next)"
    [ -z "$(field "$RECORD" Progress)" ] || say "Progress: $(field "$RECORD" Progress)"
    [ -z "$(field "$RECORD" Away)" ] || [ "$(field "$RECORD" Away)" -lt "$(field "$RECORD" Updated)" ] 2>/dev/null ||
      say "Away: its session closed $(( (NOW - $(field "$RECORD" Away)) / 60 )) min ago (uak away); the lease still runs"
    say "Worklog: $WL (claims branch)"
    if [ "$SHOW_SUMMARY" = yes ] || [ "$CMD" = handoff ]; then
      say "Live summary:"; summary_text
      [ ! -f "$(claim_file)" ] || say "Read-token: $(read_token)"
    fi
    [ "$CMD" != handoff ] || coord_handoff
  else
    load_task; say "$ID | AVAILABLE | $PRIORITY"; say "Next: $DEFAULT_NEXT"; say "Verify: $VERIFY"
  fi
}
print_status() {
  [ -z "$ID" ] || { print_task; coord_status_budget; say "$CLOCK_NOTE"; return; }
  say "uak v3.0 | remote claims | epoch $NOW | lease ${LEASE}s"
  for state in AVAILABLE CLAIMED BLOCKED REVIEW INTEGRATED CANCELLED; do
    count=0
    for f in "$TX"/tasks/*.md; do
      [ -f "$f" ] || continue
      [ "$(field "$f" State)" != "$state" ] || count=$((count + 1))
    done
    if [ "$state" = AVAILABLE ] && [ -f "$BACKLOG" ]; then
      extra=$(awk '/^## [A-Z][A-Z0-9]*-[0-9]/ {print $2}' "$BACKLOG" | while IFS= read -r id; do
        [ -f "$TX/tasks/$id.md" ] || say "$id"
      done | awk 'END {print NR+0}')
      count=$((count + extra))
    fi
    printf '%s=%s ' "$state" "$count"
  done
  printf '\n'; say "Claims (max 12; use --task ID):"
  for f in "$TX"/claims/*.md; do
    [ -f "$f" ] || continue
    until=$(field "$f" Lease-Until); expiry=active
    [ "$NOW" -lt "$until" ] || expiry=VENCIDA
    say "$(field "$f" ID) | $(field "$f" State) | $(field "$f" Owner) | $expiry | until $until"
  done | head -n 12
  scope=$(sed -n 's/^# UAK_SMOKE_SCOPE: //p' "$ROOT/.uak/bin/smoke" 2>/dev/null | head -n 1)
  say "Smoke: ${scope:-scope not declared; check .uak/bin/smoke}"
  say "Next: run uak next."
  coord_status_budget; say "$CLOCK_NOTE"
}
print_digest() {
  say "Human digest | epoch $NOW | remote claims"; found=no
  for f in "$TX"/tasks/*.md; do
    [ -f "$f" ] || continue
    state=$(field "$f" State)
    case "$state" in REVIEW|BLOCKED)
      found=yes
      say "$(field "$f" ID) | $state | $(field "$f" Owner) | PR $(field "$f" PR)"
      say "  $(field "$f" Next)"
      ;;
    esac
  done
  [ "$found" = yes ] || say "No pending reviews or blockers."
  for f in "$TX"/tasks/*.md; do
    [ -f "$f" ] || continue
    m=$(task_stalled "$f"); [ -n "$m" ] || continue
    say "$(field "$f" ID) | STALLED | $(field "$f" Owner) | no work moved in $m min · $(field "$f" Progress | awk -F' · ' '{print $1 " · " $2}')"
  done
  [ ! -f "$TX/DECISIONS.md" ] || grep '^-' "$TX/DECISIONS.md" | tail -n 5
  freeze_warning
  human_msgs=$(msg_select human | tail -n 10)
  [ -z "$human_msgs" ] || { say "Agent messages for humans (last 5):"; say "$human_msgs"; }
  # Capacity: tasks waiting vs agents online and idle. The commands for it are human ones (`up`, `graph --assign`),
  # so the human's digest is where they come up. Why (MLB hackathon): `up` 0 calls, `graph --assign` 3.
  local avail idle online
  avail=$(awk '/^## [A-Z][A-Z0-9]*-[0-9]/ {print $2}' "$BACKLOG" 2>/dev/null | while read -r t; do
    st=$(field "$TX/tasks/$t.md" State); [ -z "$st" ] || [ "$st" = AVAILABLE ] && echo "$t"; done | wc -l | tr -d ' ')
  msg_seen_all > "$TXROOT/seen"
  online=$(awk -v now="$NOW" -v p="$(msg_presence)" '$1 == "A" {a[$2] = 1} $1 == "H" {h[$2] = 1} $1 == "S" && now - $3 <= p {s[$2] = 1}
    END {for (n in s) if (!(n in a) && !(n in h) && n != "scheduler" && n != "github") print n}' "$TXROOT/seen")
  local busy=' ' c n; idle=0
  for c in "$TX"/claims/*.md; do [ -f "$c" ] || continue; case "$(field "$c" State)" in CLAIMED|BLOCKED) busy="$busy$(field "$c" Owner) ";; esac; done
  for n in $online; do case "$busy" in *" $n "*) ;; *) idle=$((idle + 1));; esac; done
  if [ "${avail:-0}" -ge 3 ] && [ "$idle" -eq 0 ]; then
    say "Capacity: $avail tasks wait and no idle agent is online. More hands: bash .uak/bin/uak up N --tool claude (one worktree and agent each), or uak graph --assign for who takes what next."
  elif [ "${avail:-0}" -gt 0 ] && [ "$idle" -gt 0 ]; then
    say "Capacity: $avail tasks wait, $idle idle agent(s) online: uak graph --assign suggests who takes which."
  fi
  # The bill, from what every machine published (uak tokens --publish; the Stop hook does it every 30 min).
  if ls "$TX"/tokens/*.md >/dev/null 2>&1; then
    sed -n 's/^- //p' "$TX"/tokens/*.md | awk -F' [|] ' '{t = $6 + $7 + $8 + $9; T += t; R += $8; k[$1] += t}
      function M(n) { return n >= 1e6 ? sprintf("%.1fM", n / 1e6) : sprintf("%.0fk", n / 1e3) }
      END { if (!T) exit; b = ""; for (x in k) if (x != "main" && (b == "" || k[x] > k[b])) b = x
            printf "Tokens: %s, cache hit %d%%%s · detail: uak tokens --team\n", M(T), 100 * R / T, (b != "" ? sprintf(", top task %s %s", b, M(k[b])) : "") }'
  fi
  say "Rule: no answer in 15 min → recorded reversible decision, take another task."
  say "Everything on one page (progress, agents, conversation, reviews, black box): bash .uak/bin/uak dash --watch --open"
}
# Repeated reads: the same `status`/`next`/`digest` output in the same agent session prints one line.
# The session is the harness process (grandparent of uak); a new session or --full prints everything.
# Why (Reap buildathon): agents ran status 258 times and inbox 295 times; most outputs were identical and
# every copy stayed in context for the rest of the session ("reading the same thing over and over").
# Session key: the nearest ancestor that is the agent harness (claude, codex, cursor, gemini, aider, node),
# else the grandparent. Every tool call is a new shell, but the harness process lives as long as the session.
session_key() {
  local pid=$PPID i=0 line ppid comm
  while [ "$i" -lt 8 ]; do
    case "$pid" in ''|*[!0-9]*|0|1) break;; esac
    line=$(ps -o ppid= -o comm= -p "$pid" 2>/dev/null) || break
    ppid=$(printf '%s\n' "$line" | awk '{print $1}'); comm=$(printf '%s\n' "$line" | awk '{print $2}' | tr '[:upper:]' '[:lower:]')
    case "$comm" in *claude*|*codex*|*cursor*|*gemini*|*aider*|node*) printf '%s' "$pid"; return 0;; esac
    pid=$ppid; i=$((i + 1))
  done
  # Git Bash has no `ps -o` and the harness is a native Windows process: use the session id that the
  # session-start hook wrote (Why, MLB hackathon: 4 Windows laptops never got "= unchanged").
  line=$(ps -o ppid= -p "$PPID" 2>/dev/null | tr -d ' ')
  case "$line" in ''|*[!0-9]*)
    line=$(awk '{print $1; exit}' "$(git -C "$ROOT" rev-parse --absolute-git-dir 2>/dev/null)/uak-live" 2>/dev/null)
    [ -z "$line" ] || line=$(printf '%s' "$line" | cksum | awk '{print $1}');;
  esac
  printf '%s' "$line"
}
seen_print() {
  local out key=$1 gd gp sum prev
  out=$(cat)
  gp=$(session_key)
  gd=$(git -C "$ROOT" rev-parse --absolute-git-dir 2>/dev/null) || gd=
  case "$gp" in ''|*[!0-9]*) gp=;; esac
  if [ "$FULL" = yes ] || [ -z "$gp" ] || [ -z "$gd" ] || [ "${UAK_DEDUPE:-on}" = off ]; then
    printf '%s\n' "$out"; [ -z "$gd" ] || rm -f "$gd/uak-seen.$key" 2>/dev/null; return 0
  fi
  sum=$(printf '%s\n' "$out" | sed 's/epoch [0-9][0-9]*//' | grep -Ev '^(Clock|Reloj|Remote clock|CLOCK_SKEW)' | cksum | awk '{print $1}')
  prev=$(cat "$gd/uak-seen.$key" 2>/dev/null) || prev=
  set -- $prev
  if [ "${1:-}" = "$gp" ] && [ "${3:-}" = "$sum" ] && [ "$((NOW - ${2:-0}))" -lt 1800 ]; then
    say "= unchanged since $(((NOW - $2) / 60)) min ago (uak $key). Nothing new. Waiting for something? bash .uak/bin/uak wait ID --for approve|integrated|message (one call). --full reprints."
    return 0
  fi
  printf '%s\n' "$out"
  printf '%s %s %s\n' "$gp" "$NOW" "$sum" > "$gd/uak-seen.$key" 2>/dev/null || true
}
# Once per 12 h per checkout: say early when PRs cannot be opened by the agent.
# Why (Reap buildathon): a new checkout reached claims and reviews before finding out gh was missing.
preflight_note() {
  local gd; gd=$(git -C "$ROOT" rev-parse --absolute-git-dir 2>/dev/null) || return 0
  [ ! -f "$gd/uak-preflight" ] || [ -z "$(find "$gd/uak-preflight" -mmin -720 2>/dev/null)" ] || return 0
  touch "$gd/uak-preflight" 2>/dev/null
  if ! command -v gh >/dev/null 2>&1; then
    say "PREFLIGHT: gh is not installed; the agent cannot open PRs. bash .uak/bin/wt pr prints the URL for the human."
  elif ! gh auth status >/dev/null 2>&1; then
    say "PREFLIGHT: gh is not logged in (gh auth login); until then bash .uak/bin/wt pr prints the PR URL for the human."
  fi
}
# 30 min before the freeze, every next/digest says it once. Why (Reap buildathon): 6 PRs were still open at
# the extended deadline; nobody had been told that unfinished work would not get in.
freeze_warning() {
  local f; f=$(coord_config Freeze-Epoch 0 2>/dev/null); case "$f" in ''|*[!0-9]*) return 0;; esac
  [ "$f" -gt 0 ] && [ "$NOW" -lt "$f" ] && [ $((f - NOW)) -le 1800 ] || return 0
  say "FREEZE in $(((f - NOW + 59) / 60)) min: finish the criterion and run uak done, or release; after the freeze a task needs a human uak allow."
}
budget() {
  [ -f "$1" ] || { say "LINT: missing $1" >&2; LINT_ERRORS=$((LINT_ERRORS + 1)); return; }
  lines=$(awk 'END {print NR+0}' "$1"); words=$(awk '{n+=NF} END {print n+0}' "$1")
  say "BUDGET $(basename "$1"): $lines lines / $words words (max $2 / $3)"
  if [ "$lines" -gt "$2" ] || [ "$words" -gt "$3" ]; then LINT_ERRORS=$((LINT_ERRORS + 1)); fi
}
lint_all() {
  LINT_ERRORS=0; budget "$ROOT/AGENTS.md" 100 1300
  state_file="$TX/STATE.md"; [ -f "$state_file" ] || state_file="$ROOT/STATE.md"
  [ ! -f "$state_file" ] || budget "$state_file" 60 700
  pr_template="$ROOT/.github/pull_request_template.md"
  if [ ! -f "$pr_template" ] || [ "$(awk 'END {print NR+0}' "$pr_template")" -ne 5 ]; then
    say "LINT: PR template must have 5 lines" >&2; LINT_ERRORS=$((LINT_ERRORS + 1))
  fi
  for w in "$TX"/worklog/*.md; do
    [ -f "$w" ] || continue
    summary_lines=$(awk '/^## Live summary$/ {on=1;next} /^## History$/ {on=0} on {n++} END {print n+0}' "$w")
    if [ "$summary_lines" -gt 15 ] || [ "$(grep -c '^## Live summary$' "$w")" -ne 1 ] ||
       [ "$(grep -c '^## History$' "$w")" -ne 1 ]; then
      say "LINT: invalid live summary: $(basename "$w")" >&2; LINT_ERRORS=$((LINT_ERRORS + 1))
    fi
    if ! awk '/^## History$/ {on=1;next} on && NF && $0 !~ /^- [0-9]+ \| (AVAILABLE|CLAIMED|BLOCKED|REVIEW|INTEGRATED|CANCELLED) \| / {bad=1} END {exit bad}' "$w"; then
      say "LINT: history must have one line per event: $(basename "$w")" >&2; LINT_ERRORS=$((LINT_ERRORS + 1))
    fi
    rel="worklog/$(basename "$w")"
    if git -C "$TX" show "HEAD^:$rel" > "$TXROOT/previous" 2>/dev/null; then
      awk '/^## History$/ {on=1;next} on {print}' "$TXROOT/previous" > "$TXROOT/history-old"
      awk '/^## History$/ {on=1;next} on {print}' "$w" > "$TXROOT/history-new"
      n=$(awk 'END {print NR+0}' "$TXROOT/history-old")
      head -n "$n" "$TXROOT/history-new" > "$TXROOT/history-prefix"
      if ! cmp -s "$TXROOT/history-old" "$TXROOT/history-prefix"; then
        say "LINT: history modified, must be append-only: $rel" >&2; LINT_ERRORS=$((LINT_ERRORS + 1))
      fi
    fi
  done
  for f in "$TX"/tasks/*.md; do
    [ -f "$f" ] || continue
    state=$(field "$f" State); id=$(field "$f" ID)
    case "$state" in AVAILABLE|CLAIMED|BLOCKED|REVIEW|INTEGRATED|CANCELLED) ;; *)
      say "LINT: invalid state in $id" >&2; LINT_ERRORS=$((LINT_ERRORS + 1));; esac
    reserved=no; is_reserved "$state" && reserved=yes
    if { [ "$reserved" = yes ] && [ ! -f "$TX/claims/$id.md" ]; } ||
       { [ "$reserved" = no ] && [ -f "$TX/claims/$id.md" ]; }; then
      say "LINT: state and claim inconsistent in $id" >&2; LINT_ERRORS=$((LINT_ERRORS + 1))
    fi
    wl=$(field "$f" Worklog)
    if ! valid_worklog "$wl" || [ ! -f "$TX/$wl" ]; then
      say "LINT: missing valid worklog $id" >&2; LINT_ERRORS=$((LINT_ERRORS + 1))
    fi
  done
  for f in "$TX"/claims/*.md; do
    [ -f "$f" ] || continue
    id=$(field "$f" ID)
    [ -f "$TX/tasks/$id.md" ] || { say "LINT: orphan claim $id" >&2; LINT_ERRORS=$((LINT_ERRORS + 1)); }
    if [ -f "$TX/tasks/$id.md" ]; then
      for key in State Owner Branch Worktree Lease-Until Worklog; do
        if [ "$(field "$f" "$key")" != "$(field "$TX/tasks/$id.md" "$key")" ]; then
          say "LINT: claim and task differ in $id/$key" >&2; LINT_ERRORS=$((LINT_ERRORS + 1))
        fi
      done
    fi
  done
  owner_rows > "$TXROOT/owners"
  while IFS='|' read -r pat owner; do
    [ -n "$owner" ] || continue
    if ! awk -v id="$owner" '/^## / && $2==id {found=1} END {exit !found}' "$BACKLOG"; then
      say "LINT: owner not in TASKS: $owner" >&2; LINT_ERRORS=$((LINT_ERRORS + 1))
    fi
  done < "$TXROOT/owners"
  # sprint without a freeze = features until the last minute (Hack-Nation: 8 PRs, incl. a product rename, in the last 6 h).
  if [ -f "$ROOT/.uak/PROJECT.md" ] && grep -Eq '^[-* ]*Mode:[* ]*sprint' "$ROOT/.uak/PROJECT.md" &&
     ! grep -Eq '^[-* ]*Freeze-Epoch:[* ]*[1-9][0-9]*' "$ROOT/.uak/PROJECT.md"; then
    say "LINT: Mode sprint without Freeze-Epoch in .uak/PROJECT.md" >&2; LINT_ERRORS=$((LINT_ERRORS + 1))
  fi
  # Execution graph: cycles and unknown dependencies make tasks unclaimable forever.
  if [ -s "$BACKLOG" ] && [ -f "$ROOT/.uak/bin/graph" ]; then
    bash "$ROOT/.uak/bin/graph" --file "$BACKLOG" > "$TXROOT/graph" 2>&1 ||
      { grep -E '^(CYCLE|MISSING|DUPLICATE)' "$TXROOT/graph" | sed 's/^/LINT: /' >&2; LINT_ERRORS=$((LINT_ERRORS + 1)); }
  fi
  if [ "$LINT_SECRETS" = yes ]; then secrets_lint || LINT_ERRORS=$((LINT_ERRORS + 1)); fi
  [ "$LINT_ERRORS" -eq 0 ] || { say "LINT_FAILED $LINT_ERRORS"; return 1; }
  say "LINT_OK"
}
PLAN_FILE= PLAN_AMEND=no ID= BRANCH= WORKTREE= NEXT_TEXT= REQUEST_NEXT= TOKEN= NEW_STATE= LOG_TEXT= PR_URL= EVIDENCE=
MERGE_COMMIT= REVIEWER= CANCEL_REASON=
REVIEW_LEARN=no WAIT_FOR=message WAIT_TIMEOUT=${UAK_WAIT_TIMEOUT:-540} WAIT_EVERY=${UAK_WAIT_EVERY:-15}
EXPIRED=no SHOW_SUMMARY=no LINT_SECRETS=no QUIET=no SESSION_ONLY=no ALLOW_INFLIGHT=no ALLOW_IDS= ALLOW_DONE= REVIEW_NOTE= FULL=no REVIEW_START=no REVIEW_STARTED=no
RETIRE_NAMES= DONE_TO= FOLLOWUP_TITLE= REVIEW_STOP=no NEW_ID= REVIEW_HINT= DONE_HINT=
REVIEW_SHA= REVIEW_VERDICT= REGISTER_REVIEWER= SMOKE_COMMAND= SECRET_PATH= SECRET_RULE= SECRET_REASON=
DECISION_OPTION= DECISION_REVERSIBLE=no DECISION_AUTHORIZED=no DECISION_CLASS=routine
DONE_TEXT= DECISION_TEXT= WHY_TEXT= FAILS_TEXT= COMMANDS_TEXT=
case "$CMD" in
  # `uak status HACK-005` was the 2nd most common uak error at Reap (8 times): accept the ID positionally.
  status) if [ "$#" -gt 0 ] && valid_id "$(norm_id "$1")"; then ID=$(norm_id "$1"); shift; fi;;
  digest|lint|tick|init-smoke) ;;
  # next works without an identity: it shows the best task and how to claim it with a name.
  # Why (Reap buildathon): "No identity" from `uak next` in the main checkout was the top error (24).
  next) [ -n "$AGENT" ] || AGENT=$(git config --get uak.agent 2>/dev/null || true); [ -n "$AGENT" ] || AGENT=$HUMAN
        [ -z "$AGENT" ] || identity;;
  allow)
    [ "$#" -gt 0 ] || die "Usage: allow ID... --reason TEXT, or allow --in-flight --reason TEXT (UAK_HUMAN)."
    while [ "$#" -gt 0 ]; do
      case "$1" in --in-flight) ALLOW_INFLIGHT=yes;; --*) break;; *) valid_id "$(norm_id "$1")" || bad_id "$1"; ALLOW_IDS="$ALLOW_IDS $(norm_id "$1")";; esac
      shift
    done
    [ "$ALLOW_INFLIGHT" = yes ] || [ -n "$ALLOW_IDS" ] || die "allow needs an ID or --in-flight."
    ID=; identity;;
  checkpoint)
    [ "$#" -gt 0 ] || die "Missing ID or --session."
    if [ "$1" = --session ]; then SESSION_ONLY=yes; shift
    else ID=$(norm_id "$1"); shift; valid_id "$ID" || bad_id "$ID"; fi
    identity;;
  register-reviewer)
    [ "$#" -gt 0 ] || die "Missing NAME."; REGISTER_REVIEWER=$1; ID=$1; shift; identity;;
  msg)
    [ "$#" -gt 1 ] || die "Usage: msg TO TEXT [--kind KIND] [--task ID]."
    MSG_TO=$1; shift; MSG_TASK=${UAK_TASK:-}; identity;;
  inbox) identity;;
  wait)
    if [ "$#" -gt 0 ] && valid_id "$(norm_id "$1")"; then ID=$(norm_id "$1"); shift; fi
    identity;;
  learn) [ "$#" -gt 0 ] || die "Usage: learn \"what bites · where · what to do\" [--path P,Q] [--task ID] · learn --forget N"; identity;;
  recall)
    if [ "$#" -gt 0 ] && valid_id "$(norm_id "$1")"; then ID=$(norm_id "$1"); shift
    elif [ "$#" -gt 0 ]; then case "$1" in --*) ;; *) MEM_PATHS=$1; shift;; esac; fi;;
  plan)
    [ "$#" -gt 0 ] && [ -f "$1" ] || die "Usage: plan FILE [--amend] (## ID sections in TASKS.md format)."
    PLAN_FILE=$(cd "$(dirname "$1")" && pwd -P)/$(basename "$1"); shift
    [ -n "$HUMAN" ] || die "plan publishes backlog: needs UAK_HUMAN (a human authorizes it)."
    identity;;
  away) identity;;
  pr-sync)
    if [ "$#" -gt 0 ] && valid_id "$(norm_id "$1")"; then ID=$(norm_id "$1"); shift; fi
    [ -n "$AGENT" ] || AGENT=scheduler; identity;;
  retire)
    [ "$#" -gt 0 ] || die "Usage: retire NAME... (an identity that no longer runs; its human or the agent itself)."
    while [ "$#" -gt 0 ]; do case "$1" in --*) break;; *[!A-Za-z0-9_.-]*) die "Invalid identity: $1";; *) RETIRE_NAMES="$RETIRE_NAMES $1";; esac; shift; done
    identity;;
  *) [ "$#" -gt 0 ] || die "Missing ID. Usage: $(usage | grep -E "^$CMD( |\$)" | head -n 1)"
     ID=$(norm_id "$1"); valid_id "$ID" || bad_id "$1"; shift; identity;;
esac
while [ "$#" -gt 0 ]; do
  opt=$1; shift
    case "$opt" in
    --secrets) [ "$CMD" = lint ] || die "Invalid option: $opt"; LINT_SECRETS=yes;;
    --expired) [ "$CMD" = release ] || die "Invalid option: $opt"; EXPIRED=yes;;
    --summary) [ "$CMD" = status ] || die "Invalid option: $opt"; SHOW_SUMMARY=yes;;
    --full) case "$CMD" in status|next|digest|inbox) FULL=yes;; *) die "Invalid option: $opt";; esac;;
    --start) [ "$CMD" = review ] || die "Invalid option: $opt"; REVIEW_START=yes;;
    --stop) [ "$CMD" = review ] || die "Invalid option: $opt"; REVIEW_STOP=yes;;
    --learn) [ "$CMD" = review ] || die "Invalid option: $opt"; REVIEW_LEARN=yes;;
    --amend) [ "$CMD" = plan ] || die "Invalid option: $opt"; PLAN_AMEND=yes;;
    --similar) [ "$CMD" = recall ] || die "Invalid option: $opt"; MEM_SIMILAR=yes;;
    --ack|--all|--peek|--human)
      [ "$CMD" = inbox ] || die "Invalid option: $opt"
      case "$opt" in --ack) MSG_ACK=yes;; --all) MSG_MODE=all;; --peek) MSG_MODE=peek;; --human) MSG_MODE=human;; esac;;
    --kind)
      [ "$CMD" = msg ] && [ "$#" -gt 0 ] || die "Invalid option: $opt"
      MSG_KIND=$1; shift; msg_valid_kind "$MSG_KIND" || die "--kind: info|request|contract|blocker|reply|review|approve|reject|integrated|human";;
    --task|--branch|--worktree|--next|--read-summary|--state|--done|--decision|--why|--fails|--commands|--pr|--evidence|--integrated|--reviewer|--cancel|--sha|--verdict|--note|--command|--option|--reversible|--authorized|--class|--path|--rule|--reason|--to|--title|--for|--timeout|--forget|--search)
      [ "$#" -gt 0 ] || die "Missing value for $opt."
      value=$1; shift
      case "$opt" in
        --task)
          value=$(norm_id "$value"); valid_id "$value" || bad_id "$value"
          case "$CMD" in status|learn) ID=$value;; msg) MSG_TASK=$value;; inbox) MSG_MODE="task:$value";; *) die "Invalid option.";; esac;;
        --branch) [ "$CMD" = claim ] || die "Invalid option."; BRANCH=$value;;
        --worktree) [ "$CMD" = claim ] || die "Invalid option."; WORKTREE=$value;;
        --next) case "$CMD" in claim|checkpoint) NEXT_TEXT=$value;; *) die "Invalid option.";; esac;;
        --read-summary) [ "$CMD" = release ] || die "Invalid option."; TOKEN=$value;;
        --state) [ "$CMD" = log ] || die "Invalid option."; NEW_STATE=$value; case "$value" in CLAIMED|BLOCKED) ;; *) die "Invalid state.";; esac;;
        --done) [ "$CMD" = checkpoint ] || die "Invalid option."; DONE_TEXT=$value;;
        --decision) [ "$CMD" = checkpoint ] || die "Invalid option."; DECISION_TEXT=$value;;
        --why) case "$CMD" in checkpoint|decision) ;; *) die "Invalid option.";; esac; WHY_TEXT=$value;;
        --fails) [ "$CMD" = checkpoint ] || die "Invalid option."; FAILS_TEXT=$value;;
        --commands) [ "$CMD" = checkpoint ] || die "Invalid option."; COMMANDS_TEXT=$value;;
        --pr) [ "$CMD" = done ] || die "Invalid option."; PR_URL=$value;;
        --evidence) [ "$CMD" = done ] || die "Invalid option."; EVIDENCE=$value;;
        --integrated) case "$CMD" in done|integrate) MERGE_COMMIT=$value;; *) die "Invalid option.";; esac;;
        --reviewer) [ "$CMD" = done ] || die "Invalid option."; REVIEWER=$value;;
        --sha) [ "$CMD" = review ] || die "Invalid option."; REVIEW_SHA=$value;;
        --verdict) [ "$CMD" = review ] || die "Invalid option."; REVIEW_VERDICT=$value;;
        --note) case "$CMD" in review|done) REVIEW_NOTE=$value;; *) die "Invalid option.";; esac;;
        --for) [ "$CMD" = wait ] || die "Invalid option."; case "$value" in approve|integrated|message) WAIT_FOR=$value;; *) die "--for approve|integrated|message";; esac;;
        --timeout) [ "$CMD" = wait ] || die "Invalid option."; case "$value" in ''|*[!0-9]*) die "--timeout takes seconds";; esac; WAIT_TIMEOUT=$value;;
        --to) case "$CMD" in done|handover) ;; *) die "Invalid option.";; esac; case "$value" in *[!A-Za-z0-9_.-]*) die "--to takes an agent name.";; esac; DONE_TO=$value;;
        --title) [ "$CMD" = followup ] || die "Invalid option."; FOLLOWUP_TITLE=$value;;
        --command) [ "$CMD" = init-smoke ] || die "Invalid option."; SMOKE_COMMAND=$value;;
        --option) [ "$CMD" = decision ] || die "Invalid option."; DECISION_OPTION=$value;;
        --reversible) [ "$CMD" = decision ] || die "Invalid option."; DECISION_REVERSIBLE=$value;;
        --authorized) [ "$CMD" = decision ] || die "Invalid option."; DECISION_AUTHORIZED=$value;;
        --class) [ "$CMD" = decision ] || die "Invalid option."; DECISION_CLASS=$value;;
        --path) case "$CMD" in secret-exception) SECRET_PATH=$value;; learn|recall) MEM_PATHS=$value;; *) die "Invalid option.";; esac;;
        --search) [ "$CMD" = recall ] || die "Invalid option."; MEM_SEARCH=$value;;
        --forget) [ "$CMD" = learn ] || die "Invalid option."; case "$value" in ''|*[!0-9]*) die "--forget takes a lesson number";; esac; MEM_FORGET=$value;;
        --rule) [ "$CMD" = secret-exception ] || die "Invalid option."; SECRET_RULE=$value;;
        --reason) case "$CMD" in secret-exception) SECRET_REASON=$value;; allow) WHY_TEXT=$value;; *) die "Invalid option.";; esac;;
        --cancel) [ "$CMD" = release ] || die "Invalid option."; CANCEL_REASON=$value;;
      esac
      ;;
    *) case "$CMD" in
         log) LOG_TEXT="$LOG_TEXT${LOG_TEXT:+ }$opt";;
         msg) MSG_TEXT="$MSG_TEXT${MSG_TEXT:+ }$opt";;
         learn) MEM_TEXT="$MEM_TEXT${MEM_TEXT:+ }$opt";;
         # One call registers the whole team (Reap: 25 register-reviewer calls, 5 refused as self-grants).
         register-reviewer) case "$opt" in *[!A-Za-z0-9_.-]*) die "Invalid reviewer identity: $opt";; esac
               REGISTER_REVIEWER="$REGISTER_REVIEWER $opt";;
         # Unquoted evidence was the most common uak error at UpiixSol (3 times): accept the words.
         done) [ -n "$EVIDENCE" ] || die "Unexpected argument: $opt. Usage: done ID --pr URL --evidence \"TEXT\""
               EVIDENCE="$EVIDENCE $opt";;
         checkpoint) die "checkpoint takes flags, not free text: checkpoint ID --done T --decision T --why T --fails T --commands T --next T (use - for none).";;
         *) die "Unexpected argument: $opt (quote multi-word values: --flag \"two words\").";;
       esac;;
  esac
done
[ "$SHOW_SUMMARY" = no ] || [ -n "$ID" ] || die "--summary needs --task ID."
if [ -n "$AGENT" ] || [ -n "$HUMAN" ]; then identity; fi
clock_now; init_temp
if [ "$CMD" = init-smoke ]; then init_smoke; exit "$?"; fi
if [ "$CMD" = claim ]; then
  [ -n "$BRANCH" ] && [ -n "$WORKTREE" ] || die "claim needs --branch and --worktree."
  git check-ref-format --branch "$BRANCH" > /dev/null 2>&1 || die "Invalid branch."
  WORKTREE=$(cd "$WORKTREE" 2>/dev/null && pwd -P) || die "Worktree does not exist."
  primary=$(git -C "$ROOT" worktree list --porcelain | sed -n 's/^worktree //p' | head -n 1)
  primary=$(cd "$primary" && pwd -P) || die "Invalid main checkout."
  [ "$WORKTREE" != "$primary" ] || die "Use a worktree separate from the main checkout."
  registered_root=$(git -C "$WORKTREE" rev-parse --show-toplevel 2>/dev/null) || die "Invalid worktree."
  registered_root=$(cd "$registered_root" && pwd -P) || die "Invalid worktree."
  [ "$WORKTREE" = "$registered_root" ] || die "Use the exact root of a registered worktree."
  actual=$(git -C "$WORKTREE" symbolic-ref --short HEAD 2>/dev/null) || die "Worktree detached or invalid."
  [ "$actual" = "$BRANCH" ] || die "Worktree is not on $BRANCH."
  CLAIM_BASE=$(git -C "$WORKTREE" rev-parse HEAD) || die "Missing initial commit in worktree."
  # Why (UpiixSol UPS-030): a claim taken after the code was written stored the finished tip as its base,
  # so done/merge saw "nothing implemented". The fork point with the remote base is the real start.
  fork=$(git -C "$WORKTREE" merge-base HEAD "refs/remotes/$REMOTE/$BASE" 2>/dev/null) && [ -n "$fork" ] && CLAIM_BASE=$fork
  common_main=$(git -C "$ROOT" rev-parse --git-common-dir)
  common_work=$(git -C "$WORKTREE" rev-parse --git-common-dir)
  common_main=$(cd "$ROOT" && cd "$common_main" && pwd -P) || die "Invalid Git common dir."
  common_work=$(cd "$WORKTREE" && cd "$common_work" && pwd -P) || die "Invalid Git common dir."
  [ "$common_main" = "$common_work" ] || die "Worktree belongs to another repository."
  REQUEST_NEXT=$NEXT_TEXT
fi
if [ "$CMD" = checkpoint ]; then
  [ -n "$DONE_TEXT" ] && [ -n "$DECISION_TEXT" ] && [ -n "$WHY_TEXT" ] &&
    [ -n "$FAILS_TEXT" ] && [ -n "$COMMANDS_TEXT" ] && [ -n "$NEXT_TEXT" ] ||
    die "checkpoint needs all six fields; use - for none."
fi
if [ "$CMD" = done ]; then
  case "$PR_URL" in https://*/*) ;; *) die "done needs --pr HTTPS URL.";; esac
  # A GitHub PR URL must name this repository. Why (MLB hackathon): two tasks shipped with a PR link to another of
  # the human's repositories; reviewers opened the wrong compare page.
  pr_remote=$(git -C "$ROOT" config --get "remote.$REMOTE.url" 2>/dev/null || true)
  case "$pr_remote:$PR_URL" in
    *github.com*:https://github.com/*)
      pr_repo=$(printf '%s' "$pr_remote" | sed 's@^git\@github.com:@@;s@^https://github.com/@@;s@^ssh://git\@github.com/@@;s@\.git$@@' | tr 'A-Z' 'a-z')
      pr_url_repo=$(printf '%s' "${PR_URL#https://github.com/}" | cut -d/ -f1-2 | tr 'A-Z' 'a-z')
      [ "$pr_repo" = "$pr_url_repo" ] || die "--pr names github.com/$pr_url_repo, but this repository is github.com/$pr_repo. The right link: bash .uak/bin/wt pr";;
  esac
  [ -n "$EVIDENCE" ] || die "done needs --evidence."
  if [ -n "$REVIEWER" ]; then
    case "$REVIEWER" in *[!A-Za-z0-9_.-]*) die "Reviewer must be a valid identity.";; esac
  fi
fi
[ "$CMD" != log ] || [ -n "$LOG_TEXT" ] || die "log needs an entry."
[ "$CMD" != handover ] || [ -n "$DONE_TO" ] || die "Usage: handover ID --to NAME (the claim, branch and worktree pass to NAME as they are)."
[ "$CMD" != followup ] || [ -n "$FOLLOWUP_TITLE" ] || die "Usage: followup ID --title TEXT (a new task with ID's Paths, after ID)."
[ "$CMD" != msg ] || [ -n "$MSG_TEXT" ] || die "msg needs a text."
[ "$CMD" != msg ] || [ -z "$MSG_TASK" ] || valid_id "$MSG_TASK" || MSG_TASK=
if [ "$CMD" = lint ] && ! git -C "$ROOT" config --get "remote.$REMOTE.url" >/dev/null 2>&1; then
  TX="$TXROOT/local"; mkdir -p "$TX/worklog" "$TX/tasks" "$TX/claims"; lint_all; exit "$?"
fi
# Losing the remote is an explicit read-only mode; no offline writes.
remote_setup
case "$CMD" in
  status|next)
    # The deadline reconcile (tick) is housekeeping: if it fails, status/next still answer from a plain read.
    # Why (MLB hackathon): a failed tick made `uak status` and `uak next` exit with GIT_ERROR on Cursor/Windows.
    saved_cmd=$CMD saved_id=$ID; CMD=tick; ID=; QUIET=yes
    if ( transaction; printf '%s\n' "$TX" > "$TXROOT/tick-tx" ) 2> "$TXROOT/tick-error"; then
      TX=$(cat "$TXROOT/tick-tx")
    else
      # No remote at all: an explicit read-only mode (the fetch already proved it, no extra ls-remote).
      if grep -q 'Remote unreachable' "$TXROOT/tick-error"; then CMD=$saved_cmd; coord_degraded_status; exit 0; fi
      CMD=$saved_cmd; ATTEMPT=read; fresh_state
      say "NOTE: deadline reconcile skipped ($(grep -m 1 -E 'ERROR|CONFLICT' "$TXROOT/tick-error" | cut -c 1-160)); showing the remote state." >&2
    fi
    CMD=$saved_cmd; ID=$saved_id; QUIET=no; COORD_INITIALIZED_TX=; coord_init
    coord_clock
    case "$CMD" in status) print_status | seen_print "status${ID:+-$ID}";; next) coord_next | seen_print next; preflight_note;; esac;;
  digest|lint)
    ATTEMPT=1; fresh_state
    case "$CMD" in digest) print_digest | seen_print digest;; lint) lint_all; exit "$?";; esac;;
  merge) merge_run; exit "$?";;
  inbox) msg_inbox_run; exit "$?";;
  wait) wait_run; exit "$?";;
  recall) recall_run; exit "$?";;
  pr-sync) pr_sync_run; exit "$?";;
  msg) QUIET=yes; transaction; say "OK msg $MSG_SENT"
    [ ! -s "$TXROOT/msg-note" ] || sed 's/^/NOTE: /' "$TXROOT/msg-note" | awk '!seen[$0]++';;
  *) [ "$CMD" != tick ] || AGENT=${AGENT:-scheduler}; transaction;;
esac
