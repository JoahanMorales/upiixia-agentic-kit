#!/usr/bin/env bash
# uak cap: print a command's saved output, cut to head + tail when it is huge, and keep its exit code.
#   cap LOGFILE EXIT_CODE
# Used by the Cursor preToolUse rewrite (`hook wrap`): the shell command runs as
#   { CMD
#   } > LOG 2>&1; rc=$?; bash .uak/bin/cap LOG $rc; (exit $rc)
# Small outputs print unchanged. Cap: Output-Cap-Chars in .uak/PROJECT.md (default 12000).
# Why: Cursor hooks cannot replace a shell result after it runs (postToolUse only edits MCP output), so the
# only documented way to keep a 5,000-line test log out of the context is to shape it before it is printed.
set -u
LC_ALL=C; export LC_ALL
log=${1:-}; rc=${2:-0}
case "$rc" in ''|*[!0-9]*) rc=1;; esac
[ -n "$log" ] && [ -f "$log" ] || exit "$rc"
top=$(git rev-parse --show-toplevel 2>/dev/null) || top=.
cap=$(sed -n 's/^[-* ]*Output-Cap-Chars:[* ]*//p' "$top/.uak/PROJECT.md" 2>/dev/null | head -n 1 | tr -d '\r `')
case "$cap" in off|0) cap=999999999;; ''|*[!0-9]*) cap=12000;; esac
size=$(wc -c < "$log" | tr -d ' ')
if [ "$size" -le "$cap" ]; then
  cat "$log"; rm -f "$log"
else
  lines=$(awk 'END {print NR+0}' "$log")
  head -n 30 "$log" | cut -c 1-400
  printf '\n[uak: %s lines / %s chars cut to head 30 + tail 50 (exit %s). Full output: %s. Read ranges: sed -n 200,260p FILE or grep -n PATTERN FILE. Rerun with UAK_RAW=1 to see it all.]\n\n' "$lines" "$size" "$rc" "$log"
  tail -n 50 "$log" | cut -c 1-400
  # Keep the last 20 saved logs.
  ls -t "$(dirname "$log")"/*.log 2>/dev/null | tail -n +21 | while IFS= read -r old; do rm -f "$old"; done
fi
exit "$rc"
