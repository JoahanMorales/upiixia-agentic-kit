#!/usr/bin/env python3
"""uak MCP server: the harness as native tools for any MCP client (Claude Code, Codex, Cursor, Gemini CLI).

    python3 .uak/bin/uak-mcp            # stdio; started by the client from .mcp.json / config.toml / mcp.json

Dual-era (MCP 2026-07-28 and the handshake-based 2025-11-25, 2025-06-18, 2025-03-26, 2024-11-05):
  modern  every request carries io.modelcontextprotocol/protocolVersion in params._meta; server/discover; results
          carry resultType, and list results ttlMs/cacheScope; an unsupported version gets error -32022
  legacy  initialize (with instructions) → notifications/initialized → requests; ping
Tools wrap the uak CLI (same rules, same errors, same claims branch); nothing here bypasses a gate. Python 3.8+
standard library only. Long calls (wait, merge, map notes) send notifications/progress when the client gave a
progressToken, and notifications/cancelled stops them (no answer is sent for a cancelled request). Arguments are
checked against each tool's inputSchema before anything runs.
Why: the adoption eval showed agents use the harness when it is in front of them at the moment of decision; MCP
tools are listed with a "when to use" description in every harness, unlike Bash commands the agent must remember.
"""
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import threading
import time
from pathlib import Path

MODERN = ["2026-07-28"]
LEGACY = ["2025-11-25", "2025-06-18", "2025-03-26", "2024-11-05"]
BATCHING = ("2025-03-26", "2024-11-05")  # JSON-RPC batches: allowed in these, removed in 2025-06-18
KILL_GRACE = 5  # seconds between SIGTERM and SIGKILL of a tool's process group
CAP = 12000  # characters of tool output returned to the model (Output-Cap-Chars in PROJECT.md wins)
# Started through `git -c alias…` (the launch configs), git exports its own repository to the alias: in a task
# worktree GIT_DIR names that worktree's admin dir. Inherited by uak, its temp `git init` re-initialized the main
# repository instead and set core.bare=true there. The server and every child run with git's own discovery.
for _k in ("GIT_DIR", "GIT_WORK_TREE", "GIT_INDEX_FILE", "GIT_PREFIX", "GIT_COMMON_DIR", "GIT_OBJECT_DIRECTORY",
           "GIT_ALTERNATE_OBJECT_DIRECTORIES", "GIT_CONFIG_PARAMETERS", "GIT_CONFIG_COUNT"):
    os.environ.pop(_k, None)


def repo_root():
    try:
        return Path(subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True,
                                   check=True).stdout.strip())
    except Exception:  # noqa: BLE001
        return Path.cwd()


def find_bash():
    """Git Bash on Windows: CreateProcess looks in System32 before PATH, where bash.exe is WSL's launcher."""
    if os.name != "nt":
        return "bash"
    for explicit in (os.environ.get("UAK_BASH"), os.environ.get("CLAUDE_CODE_GIT_BASH_PATH")):
        if explicit and Path(explicit).is_file():
            return explicit
    roots = []
    git = shutil.which("git")
    if git:  # ...\Git\cmd\git.exe or ...\Git\mingw64\bin\git.exe
        roots += [Path(git).resolve().parent.parent, Path(git).resolve().parent.parent.parent]
    roots += [Path(os.environ[k]) / "Git" for k in ("ProgramFiles", "ProgramW6432", "ProgramFiles(x86)") if os.environ.get(k)]
    if os.environ.get("LOCALAPPDATA"):
        roots.append(Path(os.environ["LOCALAPPDATA"]) / "Programs" / "Git")
    for root in roots:
        for rel in ("bin/bash.exe", "usr/bin/bash.exe"):
            if (root / rel).is_file():
                return str(root / rel)
    found = shutil.which("bash")
    return found if found and "system32" not in found.lower() else "bash"


ROOT = repo_root()
BIN = ROOT / ".uak" / "bin"
BASH = find_bash()
VERSION = (ROOT / ".uak" / "VERSION").read_text(encoding="utf-8").strip() if (ROOT / ".uak" / "VERSION").exists() else "dev"
SERVER_INFO = {"name": "uak", "title": "UPIIXIA Agentic Kit", "version": VERSION}
_out = threading.Lock()
_procs = {}  # request id → Popen, for cancellation
_inflight = set()  # request ids of tools/call and resources/read still running
_cancelled = set()  # in-flight request ids the client cancelled: never answered, never started
_state = {"version": None}  # the protocol version initialize negotiated (legacy clients)
_tl = threading.local()  # .batch: the responses of a JSON-RPC batch, sent together


def send(msg):
    data = json.dumps(msg, ensure_ascii=False, separators=(",", ":"))
    with _out:
        sys.stdout.write(data + "\n")
        sys.stdout.flush()


def respond(rid, msg):
    """A response, unless the client cancelled that request: the spec says the server SHOULD NOT answer it."""
    if isinstance(rid, (str, int)) and rid in _cancelled:
        return
    batch = getattr(_tl, "batch", None)
    if batch is not None:
        batch.append(msg)
    else:
        send(msg)


def cap_chars():
    try:
        m = re.search(r"^[-* ]*Output-Cap-Chars:[* ]*(\S+)", (ROOT / ".uak/PROJECT.md").read_text(encoding="utf-8"), re.M)
        if m:
            v = m.group(1).strip("`")
            return 10 ** 9 if v in ("off", "0") else int(v)
    except Exception:  # noqa: BLE001
        pass
    return CAP


def instructions():
    card = []
    try:
        card = [l.split(": ", 1)[1] for l in (ROOT / ".uak/reminders.md").read_text(encoding="utf-8").splitlines() if l.startswith("card: ")]
    except Exception:  # noqa: BLE001
        pass
    return ("uak coordinates several agents and humans on one repo through a Git branch (claims): tasks, leases, "
            "messages, reviews and a gated merge. The rules are in AGENTS.md; these tools are the same uak CLI.\n"
            # The card is written for the shell; the tool names are given explicitly. Why (audit, Oct 2026):
            # "bash .uak/bin/uak " → "uak_" gave "uak_…", and msg/learn/log/bb read as tools that do not exist.
            + "\n".join(card).replace("(bash .uak/bin/uak …)", "(CLI forms; as tools: map → uak_map, msg → uak_message, "
                                       "wait → uak_wait, learn → uak_memory, checkpoint → uak_checkpoint, log and bb → uak_cli)")
            + "\nTools map to commands: uak_next/uak_status (what to do, state), uak_claim (take a task: worktree + "
              "claim), uak_ship (done → review), uak_wait (block until approve/integrated/message, never poll), "
              "uak_review, uak_merge, uak_message/uak_inbox, uak_map (code graph), uak_memory (lessons), "
              "uak_checkpoint, uak_tokens, uak_cli (any other uak command). In the main checkout pass agent=YOUR_NAME.")


S = {"type": "string"}
AGENT = {"type": "string", "description": "Your agent name (ana-1). Needed only outside a task worktree (whose .uak-env sets it)."}
TASK = {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*-[0-9]+$", "description": "Task ID as in TASKS.md, e.g. HACK-012"}


def obj(props, required=()):
    return {"type": "object", "properties": props, "required": list(required), "additionalProperties": False}


def ann(title, ro, idem, destructive=False):
    return {"title": title, "readOnlyHint": ro, "destructiveHint": destructive, "idempotentHint": idem, "openWorldHint": False}


# name: (description, inputSchema, annotations, argv builder, timeout seconds, long-running)
