TOOL_BY_NAME = {t[0]: t for t in TOOLS}


def need_sha(a):
    if not a.get("sha"):
        raise ValueError("approve and reject need sha: the full SHA you reviewed")
    return a["sha"]


def check_args(schema, args):
    """What is wrong with args against a tool's inputSchema (types, enum, pattern, bounds); [] when valid.
    Why (audit, Oct 2026): args "status" was split into characters, ack "false" acked the inbox, and a NUL byte or a
    number for agent crashed the call with -32603."""
    problems = []
    props = schema.get("properties", {})
    for k in schema.get("required", []):
        if args.get(k) in (None, "", []):
            problems.append("missing " + k)
    for k, v in args.items():
        spec = props.get(k)
        if spec is None:
            problems.append("unknown " + k)
            continue
        kind = spec.get("type")
        if kind == "string":
            if not isinstance(v, str):
                problems.append("%s must be a string" % k)
            elif "\x00" in v:
                problems.append("%s has a NUL byte" % k)
            elif "enum" in spec and v not in spec["enum"]:
                problems.append("%s must be one of %s" % (k, ", ".join(spec["enum"])))
            elif "pattern" in spec and v and not re.match(spec["pattern"], v):
                problems.append("%s: Invalid ID %r (a task ID as in TASKS.md, e.g. HACK-012)" % (k, v) if k == "task" else "%s %r does not match %s" % (k, v, spec["pattern"]))
        elif kind == "integer":
            if isinstance(v, bool) or not isinstance(v, int):
                problems.append("%s must be an integer" % k)
            elif v < spec.get("minimum", v) or v > spec.get("maximum", v):
                problems.append("%s must be between %s and %s" % (k, spec.get("minimum", "-"), spec.get("maximum", "-")))
        elif kind == "boolean":
            if not isinstance(v, bool):
                problems.append("%s must be true or false (a JSON boolean, not a string)" % k)
        elif kind == "array":
            if not isinstance(v, list) or not all(isinstance(x, str) and "\x00" not in x for x in v):
                problems.append("%s must be a list of strings, e.g. [\"board\"]" % k)
            elif len(v) < spec.get("minItems", 0):
                problems.append("%s needs at least %d item(s)" % (k, spec["minItems"]))
    return problems


def run(argv, args, timeout, rid=None, progress=None):
    if isinstance(rid, (str, int)) and rid in _cancelled:  # cancelled before it started: start nothing
        return 130, "[uak-mcp: cancelled]"
    cmd = [BASH, str(BIN / argv[0])] + [str(x) for x in argv[1:]]
    env = dict(os.environ)
    if os.name == "nt":  # Git Bash re-parses a command line (quotes, globs): the arguments go in the environment
        env.update({"UAK_ARGV0": (BIN / argv[0]).as_posix(), "UAK_ARGC": str(len(cmd) - 2)})
        env.update({"UAK_ARG_%d" % i: a for i, a in enumerate(cmd[2:])})
        cmd = [BASH, (BIN / "lib" / "argv.sh").as_posix()]
    if args.get("agent"):
        env["UAK_AGENT"] = args["agent"]
    env.setdefault("UAK_DEDUPE", "off")  # an MCP client shows every result; "= unchanged" helps shells, not tools
    # stdin is the client's JSON-RPC channel: a child must never inherit it.
    p = subprocess.Popen(cmd, cwd=str(ROOT), env=env, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, encoding="utf-8", errors="replace",
                         start_new_session=(os.name != "nt"))
    if isinstance(rid, (str, int)):
        _procs[rid] = p
        if rid in _cancelled:  # the cancel arrived between the check above and the registration
            kill(p)
    started, n, out = time.time(), 0, ""
    try:
        while True:
            try:
                # The deadline is checked every second (every 10 s, the "stopped after" note came after the client
                # had given up); progress still goes out every 10 s.
                out, _ = p.communicate(timeout=1)
                break
            except subprocess.TimeoutExpired:
                elapsed = time.time() - started
                if elapsed > timeout:
                    kill(p)
                    out, _ = p.communicate()
                    out += f"\n[uak-mcp: stopped after {timeout} s]"
                    break
                if int(elapsed) // 10 > n:
                    n = int(elapsed) // 10
                    if progress is not None:
                        send({"jsonrpc": "2.0", "method": "notifications/progress",
                              "params": {"progressToken": progress, "progress": n, "message": f"{argv[0]} {argv[1] if len(argv) > 1 else ''}: {int(elapsed)} s"}})
    finally:
        if isinstance(rid, (str, int)):
            _procs.pop(rid, None)
    return p.returncode, out


def kill(p, grace=KILL_GRACE):
    """SIGTERM to the tool's process group, SIGKILL `grace` seconds later. Why (audit, Oct 2026): a child that traps
    TERM (a dev server, a sleep under trap '' TERM) outlived both the timeout and the cancel."""
    try:
        if os.name != "nt":
            os.killpg(p.pid, signal.SIGTERM)
            def hard():
                try:
                    os.killpg(p.pid, signal.SIGKILL)
                except OSError:
                    pass
            if grace:
                threading.Timer(grace, hard).start()
        else:  # the whole tree: terminate() stops bash and leaves its git and sleep children holding the worktree
            if subprocess.run(["taskkill", "/T", "/F", "/PID", str(p.pid)], capture_output=True, timeout=15).returncode:
                p.terminate()
    except Exception:  # noqa: BLE001
        try:
            p.terminate()
        except Exception:  # noqa: BLE001
            pass


def shape(text):
    text = re.sub(r"\x1b\[[0-9;]*m", "", text).strip()
    limit = cap_chars()
    if len(text) <= limit:
        return text or "(no output)"
    # Head and tail by lines when there are enough lines, by characters otherwise, and never over the limit: with
    # under 100 lines the two halves overlapped and a 1 MB line came back twice (audit, Oct 2026).
    lines = text.splitlines()
    if len(lines) > 100:
        head, tail = "\n".join(lines[:40]), "\n".join(lines[-60:])
    else:
        head, tail = text[: limit * 2 // 5], text[-(limit * 3 // 5):]
    head, tail = head[: limit * 2 // 5], tail[-(limit * 3 // 5):]
    return head + f"\n[uak-mcp: {len(lines)} lines / {len(text)} chars cut to head + tail]\n" + tail


# Subcommands that run a command given as an argument: through MCP, guard (a Bash PreToolUse hook) never sees it.
# Why (audit, Oct 2026): uak_cli ["loop", "--verify", "git reset --hard …"] ran with no prompt and no guard.
RUNS_COMMANDS = {"loop", "init-smoke", "deploy", "up", "q", "smoke"}


def cli_args(a):
    args = a["args"]
    if not isinstance(args, list) or not all(isinstance(x, str) and "\x00" not in x for x in args):
        raise ValueError("args is a list of strings, e.g. [\"board\"]")
    if args and args[0] in RUNS_COMMANDS:
        raise ValueError("uak %s runs a command you pass; run it in the shell (bash .uak/bin/uak %s …), where guard checks it" % (args[0], args[0]))
    return ["uak"] + args


def call_tool(params, rid, meta):
    name, args = params.get("name"), params.get("arguments")
    if args is None:
        args = {}
    if not isinstance(name, str) or not isinstance(args, dict):
        return None, (-32602, "tools/call needs params {name: string, arguments: object}")
    tool = TOOL_BY_NAME.get(name)
    if not tool:
        return None, (-32602, f"Unknown tool: {name}. tools/list names them (uak_next, uak_wait, uak_map, …).")
    problems = check_args(tool[2], args)
    if problems:  # a tool error the model reads and fixes, as the spec asks for input validation
        return {"content": [{"type": "text", "text": f"{name}: {'; '.join(problems)}. "
                             f"Arguments: {', '.join(tool[2]['properties'])}."}], "isError": True}, None
    try:
        argv = tool[4](args)
    except Exception as exc:  # noqa: BLE001
        return {"content": [{"type": "text", "text": f"{name}: invalid arguments ({exc})."}], "isError": True}, None
    progress = (meta or {}).get("progressToken") if tool[6] else None
    code, out = run(argv, args, tool[5], rid, progress)
    # Text only, no structuredContent: Claude Code hands the model structuredContent INSTEAD of the text when both are
    # present, so an agent saw {"ok": true} and not "APPROVED HACK-001 by judge", then polled status and inbox to
    # find out (adoption eval, MCP-only run). The uak output already says the result and the next step.
    text = shape(out) + ("" if code == 0 else f"\n[exit {code}]")
    return {"content": [{"type": "text", "text": text}], "isError": code != 0}, None


def resources():
    gd = ROOT / ".git"
    return [
        {"uri": "uak://card", "name": "quick-card", "title": "When to use which part of the harness", "mimeType": "text/plain"},
        {"uri": "uak://map", "name": "code-map", "title": "Code map (MAP.md): areas, hubs, entry points", "mimeType": "text/markdown"},
        {"uri": "uak://status", "name": "status", "title": "Team status from the claims branch", "mimeType": "text/plain"},
        {"uri": "uak://lessons", "name": "lessons", "title": "Team lessons (all paths)", "mimeType": "text/plain"},
        {"uri": "uak://agents", "name": "agents-md", "title": "AGENTS.md: the rules", "mimeType": "text/markdown"},
    ]


TEMPLATES = [
    {"uriTemplate": "uak://task/{id}", "name": "task", "title": "One task: state, next step, live summary", "mimeType": "text/plain"},
    {"uriTemplate": "uak://recall/{id}", "name": "task-lessons", "title": "Lessons for a task's paths", "mimeType": "text/plain"},
]


def read_resource(uri, rid=None):
    m = re.match(r"^uak://(task|recall)/([A-Za-z][A-Za-z0-9]*-[0-9]+)$", uri if isinstance(uri, str) else "")
    if uri == "uak://card":
        return instructions()
    if uri == "uak://map":
        return run(["uak", "map", "show"], {}, 120, rid)[1]
    if uri == "uak://status":
        return run(["uak", "status", "--full"], {}, 60, rid)[1]
    if uri == "uak://lessons":
        return run(["uak", "recall", "*"], {}, 60, rid)[1]
    if uri == "uak://agents":
        return (ROOT / "AGENTS.md").read_text(encoding="utf-8") if (ROOT / "AGENTS.md").exists() else ""
    if m and m.group(1) == "task":
        return run(["uak", "status", "--task", m.group(2), "--summary", "--full"], {}, 60, rid)[1]
    if m:
        return run(["uak", "recall", m.group(2)], {}, 60, rid)[1]
    return None


def prompts():
    out = []
    for f in sorted((ROOT / ".claude" / "commands").glob("uak-*.md")):
        text = f.read_text(encoding="utf-8")
        desc = re.search(r"^description:\s*(.+)$", text, re.M)
        out.append({"name": f.stem, "title": "/" + f.stem, "description": desc.group(1).strip() if desc else f.stem,
                    "arguments": [{"name": "args", "description": "What the workflow should act on (task ID, mode…)", "required": False}]})
    return out


def get_prompt(name, args):
    f = ROOT / ".claude" / "commands" / f"{name}.md"
    if not re.match(r"^uak-[a-z-]+$", name or "") or not f.exists():
        return None
    body = re.sub(r"^---\n.*?\n---\n", "", f.read_text(encoding="utf-8"), flags=re.S)
    body = body.replace("$ARGUMENTS", (args or {}).get("args", ""))
    return {"description": next((p["description"] for p in prompts() if p["name"] == name), name),
            "messages": [{"role": "user", "content": {"type": "text", "text": body}}]}


CAPS = {"tools": {"listChanged": False}, "resources": {"listChanged": False}, "prompts": {"listChanged": False}}


def handle(msg):
    rid, method, params = msg.get("id"), msg.get("method"), msg.get("params")
    if params is None:
        params = {}
    if not isinstance(method, str):  # a response from the client is ignored; anything else is not a request
        if "result" not in msg and "error" not in msg:
            respond(rid, {"jsonrpc": "2.0", "id": rid, "error": {"code": -32600, "message": "Invalid request: no method"}})
        return
    if not isinstance(params, dict):
        if rid is not None:
            respond(rid, {"jsonrpc": "2.0", "id": rid, "error": {"code": -32602, "message": "params must be an object"}})
        return
    meta = params.get("_meta") or {}
    if not isinstance(meta, dict):
        meta = {}
    version = meta.get("io.modelcontextprotocol/protocolVersion")
    modern = version is not None
    if rid is None:  # notifications
        if method == "notifications/cancelled":
            req = params.get("requestId")
            if isinstance(req, (str, int)) and req in _inflight:  # one that already finished stays answered
                _cancelled.add(req)
                p = _procs.get(req)
                if p:
                    kill(p)
        return
    def ok(result, cacheable=False):
        if modern:
            result = dict(result, resultType="complete")
            result.setdefault("_meta", {})["io.modelcontextprotocol/serverInfo"] = SERVER_INFO
            if cacheable:
                result.update(ttlMs=60000, cacheScope="private")
        respond(rid, {"jsonrpc": "2.0", "id": rid, "result": result})
    def err(code, message, data=None):
        e = {"code": code, "message": message}
        if data is not None:
            e["data"] = data
        respond(rid, {"jsonrpc": "2.0", "id": rid, "error": e})
    if modern and version not in MODERN:
        return err(-32022, "Unsupported protocol version", {"supported": MODERN + LEGACY, "requested": version})
    if method == "initialize":
        asked = params.get("protocolVersion")
        if asked in MODERN:
            return err(-32602, "initialize is legacy; send modern requests with _meta (see server/discover)",
                       {"supported": MODERN + LEGACY})
        _state["version"] = asked if asked in LEGACY else LEGACY[0]  # a 2024-11-05 client got 2025-11-25 and left
        return ok({"protocolVersion": _state["version"], "capabilities": CAPS,
                   "serverInfo": SERVER_INFO, "instructions": instructions()})
    if method == "server/discover":
        return ok({"supportedVersions": MODERN + LEGACY, "capabilities": CAPS, "instructions": instructions()}, True)
    if method == "ping":
        return ok({})
    if method == "tools/list":
        return ok({"tools": [{"name": t[0], "title": t[3]["title"], "description": t[1], "inputSchema": t[2],
                              "annotations": t[3]} for t in TOOLS]}, True)
    if method == "tools/call":
        result, error = call_tool(params, rid, meta)
        return err(*error) if error else ok(result)
    if method == "resources/list":
        return ok({"resources": resources()}, True)
    if method == "resources/templates/list":
        return ok({"resourceTemplates": TEMPLATES}, True)
    if method == "resources/read":
        uri = params.get("uri")
        text = read_resource(uri, rid)
        if text is None:
            return err(-32602 if modern else -32002, f"Resource not found: {uri}", {"uri": uri})
        return ok({"contents": [{"uri": uri, "mimeType": "text/markdown" if uri in ("uak://map", "uak://agents") else "text/plain",
                                 "text": shape(text) if uri != "uak://agents" else text}]}, True)
    if method == "prompts/list":
        return ok({"prompts": prompts()}, True)
    if method == "prompts/get":
        p = get_prompt(params.get("name"), params.get("arguments"))
        return ok(p) if p else err(-32602, f"Unknown prompt: {params.get('name')}")
    return err(-32601, f"Method not found: {method}")


def main():
    # MCP stdio is UTF-8 with \n-delimited messages; Windows defaults to the locale code page and \r\n, and the card
    # and the uak output carry → and ·.
    for stream, kw in ((sys.stdin, {}), (sys.stdout, {"newline": "\n"})):
        try:
            stream.reconfigure(encoding="utf-8", errors="replace", **kw)
        except (AttributeError, ValueError):
            pass
    if "--version" in sys.argv:
        print(f"uak-mcp {VERSION} · protocols {', '.join(MODERN + LEGACY)}")
        return 0
    for sig in ("SIGTERM", "SIGINT", "SIGHUP"):  # children live in their own session: stop them with the server
        try:
            signal.signal(getattr(signal, sig), on_signal)
        except (AttributeError, ValueError, OSError):  # Windows has no SIGHUP
            pass
    workers = []
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            msg = json.loads(line)
        except ValueError:
            send({"jsonrpc": "2.0", "id": None, "error": {"code": -32700, "message": "Parse error"}})
            continue
        if isinstance(msg, list):  # a JSON-RPC batch: part of 2025-03-26, removed in 2025-06-18
            if _state["version"] in BATCHING and msg:
                batch(msg)
            else:
                send({"jsonrpc": "2.0", "id": None, "error": {"code": -32600, "message":
                      "Invalid request (batches: only under protocol %s, and never empty)" % " or ".join(BATCHING)}})
            continue
        if not isinstance(msg, dict):
            send({"jsonrpc": "2.0", "id": None, "error": {"code": -32600, "message": "Invalid request"}})
            continue
        if msg.get("method") in ("tools/call", "resources/read"):
            if isinstance(msg.get("id"), (str, int)):
                _inflight.add(msg["id"])
            w = threading.Thread(target=safe, args=(msg,), daemon=True)   # a long uak_wait does not block others
            w.start()
            workers.append(w)
        else:
            safe(msg)
    # stdin closed: answer the calls already running (a script that writes a request and closes stdin waited for
    # nothing before), at most 60 s, then stop what is left.
    deadline = time.time() + 60
    for w in workers:
        w.join(max(0, deadline - time.time()))
    stop_children()
    return 0


def stop_children(grace=KILL_GRACE):
    """Every tool still running: TERM to its group, KILL after grace. Its children live in their own session, so
    without this they outlived the server (a loop --verify "sleep 77" kept running after terminate())."""
    procs = list(_procs.values())
    for p in procs:
        kill(p, 0)
    end = time.time() + grace
    while time.time() < end and any(p.poll() is None for p in procs):
        time.sleep(0.1)
    if os.name != "nt":
        for p in procs:
            try:
                os.killpg(p.pid, signal.SIGKILL)
            except OSError:
                pass


def on_signal(signum, _frame):
    stop_children(2)
    os._exit(128 + signum)


def batch(msgs):
    """A JSON-RPC batch: each request handled in order, the responses sent as one array (none for notifications)."""
    _tl.batch = []
    try:
        for m in msgs:
            if isinstance(m, dict):
                if m.get("method") in ("tools/call", "resources/read") and isinstance(m.get("id"), (str, int)):
                    _inflight.add(m["id"])
                safe(m)
            else:
                _tl.batch.append({"jsonrpc": "2.0", "id": None, "error": {"code": -32600, "message": "Invalid request"}})
        out = _tl.batch
    finally:
        _tl.batch = None
    if out:
        data = json.dumps(out, ensure_ascii=False, separators=(",", ":"))
        with _out:
            sys.stdout.write(data + "\n")
            sys.stdout.flush()


def safe(msg):
    rid = msg.get("id")
    try:
        handle(msg)
    except Exception as exc:  # noqa: BLE001
        if rid is not None:
            respond(rid, {"jsonrpc": "2.0", "id": rid, "error": {"code": -32603, "message": f"Internal error: {exc}"}})
    finally:
        if isinstance(rid, (str, int)) and msg.get("method") in ("tools/call", "resources/read"):
            _inflight.discard(rid)
            _cancelled.discard(rid)


if __name__ == "__main__":
    sys.exit(main())
