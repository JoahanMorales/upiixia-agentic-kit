{
  "context": {
    "fileName": [
      "AGENTS.md",
      "GEMINI.md"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "uak-start",
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.uak/bin/hook\" session-start gemini",
            "timeout": 45000
          }
        ]
      }
    ],
    "BeforeTool": [
      {
        "matcher": "run_shell_command",
        "hooks": [
          {
            "name": "uak-guard",
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.uak/bin/guard\" bash",
            "timeout": 5000
          },
          {
            "name": "uak-output-cap",
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.uak/bin/hook\" wrap gemini",
            "timeout": 5000
          }
        ]
      }
    ],
    "AfterTool": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "uak-tick",
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.uak/bin/hook\" tick gemini",
            "timeout": 10000
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "uak": {
      "command": "bash",
      "args": [
        "-c",
        "p=$(command -v python3 || command -v python) && exec \"$p\" \"$(git rev-parse --show-toplevel)/.uak/bin/uak-mcp\""
      ],
      "timeout": 600000,
      "trust": false
    }
  }
}
