{
  "context": {
    "fileName": [
      "AGENTS.md",
      "GEMINI.md"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "uak-start",
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.uak/bin/hook\" session-start gemini",
            "timeout": 45000
          }
        ]
      }
    ],
    "BeforeTool": [
      {
        "matcher": "run_shell_command",
        "hooks": [
          {
            "name": "uak-guard",
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.uak/bin/guard\" bash",
            "timeout": 5000
          },
          {
            "name": "uak-output-cap",
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.uak/bin/hook\" wrap gemini",
            "timeout": 5000
          }
        ]
      }
    ],
    "AfterTool": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "uak-tick",
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.uak/bin/hook\" tick gemini",
            "timeout": 10000
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "uak": {
      "command": "bash",
      "args": [
        "-c",
        "for p in python3 python py; do \"$p\" -c 'import sys; sys.exit(sys.version_info < (3, 8))' 2>/dev/null && exec \"$p\" \"$(git rev-parse --show-toplevel)/.uak/bin/uak-mcp\"; done; echo 'uak-mcp needs Python 3.8+ (the uak CLI works without it)' >&2; exit 1"
      ],
      "timeout": 600000,
      "trust": false
    }
  }
}
