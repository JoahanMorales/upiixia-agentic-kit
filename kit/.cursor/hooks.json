{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [{ "command": "bash .uak/bin/guard shell", "timeout": 5 }],
    "beforeSubmitPrompt": [{ "command": "bash .uak/bin/guard prompt", "timeout": 5 }],
    "subagentStart": [{ "command": "bash .uak/bin/guard agent", "timeout": 5 }],
    "subagentStop": [{ "command": "bash .uak/bin/guard agent-stop", "timeout": 5 }],
    "stop": [{ "command": "bash .uak/bin/bb flush --quiet", "timeout": 30 }]
  }
}
