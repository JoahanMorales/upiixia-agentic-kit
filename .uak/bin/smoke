#!/usr/bin/env bash
# UAK_SMOKE_SCOPE: the kit's rules (scripts/kit_lint.py) + its whole protocol suite (kit/.uak/bin/smoke --package-only).
# Dogfooding: what the merge gate runs on the merged result of a task of this repository.
set -eu
cd "$(dirname "$0")/../.."
python3 scripts/kit_lint.py
# The suite runs inside kit/, which has no .uak/PROJECT.md: this repo's Smoke-Jobs (UAK-054) is passed on as --jobs.
jobs=$(sed -n 's/^Smoke-Jobs:[[:space:]]*//p' .uak/PROJECT.md 2>/dev/null | head -n 1 | tr -d '\r ')
cd kit && exec bash .uak/bin/smoke --package-only ${jobs:+--jobs "$jobs"}
